Speech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42608_2413506_2417526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office feature that allows users type queries and find information, sources, citations, quotes, and images, without leaving the application that they are using.</descrip></descripGrp><ntig><termGrp><term id="2413506">Researcher</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2417526">Истраживач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42614_2414369_2415618"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">T​o quickly return to an app, website, or document you were using earlier.</descrip></descripGrp><ntig><termGrp><term id="2414369">jump back</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2415618">вратити се назад</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42615_2414370_2415621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of documents, apps, and websites that, in one click, allows you to pick up your work exactly where you left it earlier, on any device connected with the same Microsoft account.​​</descrip></descripGrp><ntig><termGrp><term id="2414370">jump group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2415621">група за прелазак</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42616_2414371_2415616"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To quickly jump to a document or application on another device that is connected to the same Microsoft account.</descrip></descripGrp><ntig><termGrp><term id="2414371">jump</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2415616">прећи</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42617_2414373_2415623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets customers reset their network settings back to the Windows defaults.</descrip></descripGrp><ntig><termGrp><term id="2414373">network reset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2415623">успостављање почетних вредности мреже</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42617_2414373_2415632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets customers reset their network settings back to the Windows defaults.</descrip></descripGrp><ntig><termGrp><term id="2414373">network reset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2415632">враћање мреже на почетне поставке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42620_2414431_2475678"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To express approval for a certain item.</descrip></descripGrp><ntig><termGrp><term id="2414431">like</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2475678">означити да се свиђа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42621_2414433_2475750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To undo the action of "like."</descrip></descripGrp><ntig><termGrp><term id="2414433">unlike</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2475750">опозвати свиђање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42631_2414544_2775868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A duplicate copy of a volume, share, or repository in a version control system.</descrip></descripGrp><ntig><termGrp><term id="2414544">clone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2775868">клон</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42632_2414547_2697806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A provider of cloud computing services.</descrip></descripGrp><ntig><termGrp><term id="2414547">cloud service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2697806">добављач облака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42632_2685175_2697806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A provider of cloud computing services.</descrip></descripGrp><ntig><termGrp><term id="2685175">cloud provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2697806">добављач облака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42639_2414859_2415624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that contains a customizable and extensible collection of ink-related features for Universal Windows apps. By default, the toolbar may include buttons for drawing, erasing, highlighting, setting ink color and stroke thickness, and displaying a ruler.</descrip></descripGrp><ntig><termGrp><term id="2414859">Windows Ink toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2415624">трака са алаткама за Windows Ink</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42639_2414859_2415633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control that contains a customizable and extensible collection of ink-related features for Universal Windows apps. By default, the toolbar may include buttons for drawing, erasing, highlighting, setting ink color and stroke thickness, and displaying a ruler.</descrip></descripGrp><ntig><termGrp><term id="2414859">Windows Ink toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2415633">алатна трака за Windows Ink</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntr