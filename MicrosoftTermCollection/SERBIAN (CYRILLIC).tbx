ammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53725_3059304_3060591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to share different types of content with others in an online meeting.</descrip></descripGrp><ntig><termGrp><term id="3059304">content sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3060591">дељење садржаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53725_3059304_3060633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to share different types of content with others in an online meeting.</descrip></descripGrp><ntig><termGrp><term id="3059304">content sharing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3060633">дијељење садржаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53727_3059305_3060590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that enables users to join a meeting from a conference room with their own personal device.</descrip></descripGrp><ntig><termGrp><term id="3059305">companion device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3060590">пратећи уређај</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53728_3059306_3060596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology that allows you to share content from physical whiteboards and documents in a high-quality way during meetings.</descrip></descripGrp><ntig><termGrp><term id="3059306">intelligent content capture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3060596">интелигентно снимање садржаја</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53729_3059307_3060592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables Microsoft 365 Enterprise users to streamline communication, collaboration, and meeting-related tasks using spoken natural language.</descrip></descripGrp><ntig><termGrp><term id="3059307">Cortana voice assistance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3060592">Cortana гласовна подршка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53730_3059308_3060594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to join a third-party online meeting from their Teams Rooms just as easily as they can join meetings hosted in Teams.</descrip></descripGrp><ntig><termGrp><term id="3059308">Direct Guest Join</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3060594">директно придруживање гостију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53731_3059309_3060595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A camera that supports AI-powered active speaker tracking, multiple video streams, and people recognition.</descrip></descripGrp><ntig><termGrp><term id="3059309">intelligent camera</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3060595">интелигентна камера</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53732_3187998_3065100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Clipchamp, the paid plan that offers access to premium features for everyday editors.</descrip></descripGrp><ntig><termGrp><term id="3187998">Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065100">Основно</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53733_3060419_3072934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area in Clipchamp's video editor where all components are assembled and arranged on tracks.</descrip></descripGrp><ntig><termGrp><term id="3060419">timeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3072934">временска оса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53734_3060420_3072935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of the timeline where editing elements such as videos, images, audio, stickers, text blocks, etc. are placed and arranged to create a video.</descrip></descripGrp><ntig><termGrp><term id="3060420">track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3072935">трака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53735_3060421_3065080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of branded assets such as logos, fonts, colors and images that are uploaded to be used in graphic designing or video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060421">brand kit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3065080">комплет бренда</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53736_3060422_3072931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video clip from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060422">stock video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3072931">сток видео</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53737_3060423_3072928"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An audio clip from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060423">stock audio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3072928">сток звук</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53738_3060424_3072930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image/photo from a library of professional stock assets that is integrated in the Clipchamp video editor for use in editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060424">stock image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3072930">сток слика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53739_3060425_3067231"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of visual elements such as animated clips, GIFs, images, colored backgrounds or overlays that are used in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060425">graphics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3067231">графика</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53740_3060426_3072927"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animated or still image such as a cartoon figure that can be inserted in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060426">sticker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3072927">налепница</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53740_3060426_3072943"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animated or still image such as a cartoon figure that can be inserted in video editing projects.</descrip></descripGrp><ntig><termGrp><term id="3060426">sticker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3072943">наљепница</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53741_3060427_3070015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name of an aspect ratio preset in Clipchamp that lets users create videos that have the correct height and width to be uploaded as videos on popular social media platforms.</descrip></descripGrp><ntig><termGrp><term id="3060427">Social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3070015">Друштвене мреже</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53742_3060428_3065104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video editing transition effect used to move from one video clip to another.</de