">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34570_1993380_1997274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To redistribute data or resources more evenly in order to change the processing capacity.</descrip></descripGrp><ntig><termGrp><term id="1993380">rebalance</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1997274">прерасподјела</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34571_1993382_1996661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of importing prepared data using a software procedure rather than the end user entering the information.</descrip></descripGrp><ntig><termGrp><term id="1993382">prepopulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1996661">попуњавање унапред</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34571_1993382_1997272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of importing prepared data using a software procedure rather than the end user entering the information.</descrip></descripGrp><ntig><termGrp><term id="1993382">prepopulation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1997272">уношење података унапријед</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34572_1993404_2009666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An IRS tax rule in the United States that requires notified payers to withhold a set percentage from payments made to payees who cannot be identified due to missing or incorrect taxpayer identification numbers on tax forms.</descrip></descripGrp><ntig><termGrp><term id="1993404">backup withholding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009666">пореске обавезе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34573_1993405_2009667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An United States tax law designation given to any corporation that is a unique entity apart from and taxed separately from its owners.</descrip></descripGrp><ntig><termGrp><term id="1993405">C corporation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009667">корпорација „C“</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34574_1993406_2009669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business that is owned by an individual but is not treated as a separate entity from the business owner for tax purposes.</descrip></descripGrp><ntig><termGrp><term id="1993406">disregarded entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009669">савезни порески обвезник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34575_1993407_2009670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual or entity that has no tax liability under US tax laws because they are not a citizen, resident alien, or an organization created or organized under the laws of the United States.</descrip></descripGrp><ntig><termGrp><term id="1993407">exempt payee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009670">корисник ослобађања од плаћања пореза</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34576_1993408_2009672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federal revenue agency under the United States Department of the Treasury that is responsible for the collection of taxes in addition to the interpretation and enforcement of federal tax laws.</descrip></descripGrp><ntig><termGrp><term id="1993408">Internal Revenue Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009672">Пореска управа САД</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34576_1993408_2009673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federal revenue agency under the United States Department of the Treasury that is responsible for the collection of taxes in addition to the interpretation and enforcement of federal tax laws.</descrip></descripGrp><ntig><termGrp><term id="1993408">Internal Revenue Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009673">IRS</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34576_1993409_2009672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The federal revenue agency under the United States Department of the Treasury that is responsible for the collection of taxes in addition to the interpretation and enforcement of federal tax laws.</descrip></descripGrp><ntig><termGrp><term id="1993409">IRS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009672">Пореска управа САД</term><termNote