03">низ е-порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43199_2447217_2450420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery feature that groups emails together into email threads so that review volume is reduced.</descrip></descripGrp><ntig><termGrp><term id="2447217">Email Threads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2450420">Низови е-порука</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="432_107688_1502782"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The timing and sequence of tasks within a project.</descrip></descripGrp><ntig><termGrp><term id="107688">schedule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1502782">распоред</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43200_2447219_2450424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that is half the width of the confidence interval of a population parameter estimated by a sample, such that the true value is likely to be within the sample value +/- the number.</descrip></descripGrp><ntig><termGrp><term id="2447219">margin of error</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2450424">маргина грешке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43201_2447221_2452841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input parameter defined by an expert to determine the quality of executed QA tests and the size of test samples.</descrip></descripGrp><ntig><termGrp><term id="2447221">estimated error margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452841">процењена маргина грешке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43202_2447224_2557419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of similar feedback displayed in search results, instead of showing all the duplicate feedback.</descrip></descripGrp><ntig><termGrp><term id="2447224">collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2557419">колекција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43203_2447225_2450422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that combines precision and recall, and that is calculated with (precision*recall)/(precision + recall).</descrip></descripGrp><ntig><termGrp><term id="2447225">f-measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2450422">F-вредност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43203_2805605_2450422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that combines precision and recall, and that is calculated with (precision*recall)/(precision + recall).</descrip></descripGrp><ntig><termGrp><term id="2805605">F1 score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2450422">F-вредност</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43204_2447226_2450425"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Advanced eDiscovery control that appears as a bar in a bar graph and that can be clicked on to view all the details of what comprises the bar.</descrip></descripGrp><ntig><termGrp><term id="2447226">pivot bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2450425">пивот трака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43205_2447227_2557422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the collection that contains the feedback you submitted.</descrip></descripGrp><ntig><termGrp><term id="2447227">My feedback</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2557422">Моје повратне информације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43206_2447234_2450432"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery feature that allows users to check the accuracy of the program's tagging from a user-defined point down to zero.</descrip></descripGrp><ntig><termGrp><term id="2447234">Test the Rest</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2450432">Тестирање остатка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43208_2447237_2450433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery feature that allows users to check the accuracy of the program's tagging by checking a portion of the files selected by the platform.</descrip></descripGrp><ntig><termGrp><term id="2447237">Test the Slice</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2450433">Тестирање сегмента</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43209_2447238_2450423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subject for which Advance eDiscovery tags documents.</descrip></descripGrp><ntig><termGrp><term id="2447238">issue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2450423">тема</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4323_338552_1503239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of two types of hardware that are connected by an RS-232-C serial connection, the other being a Data Terminal Equipment (DTE) device.</descrip></descripGrp><ntig><termGrp><term id="338552">Data Communications Equipment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503239">опрема за комуникацију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4323_338552_1503240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of two types of hardware that are connected by an RS-232-C serial connection, the other being a Data Terminal Equipment (DTE) device.</descrip></descripGrp><ntig><termGrp><term id="338552">Data Communications Equipment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503240">DCE</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4323_338560_1503239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of two types of hardware that are connected by an RS-232-C serial connection, the other being a Data Terminal Equipment (DTE) device.</descrip></descripGrp><ntig><termGrp><term id="338560">DCE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503239">опрема за комуникацију</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4323_338560_1503240"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of two types of hardware that are connected by an RS-232-C serial connection, the other being a Data Terminal Equipment (DTE) device.</descrip></descripGrp><ntig><termGrp><term id="338560">DCE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503240">DCE</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43243_2447290_3128388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that you select to accept the contents of the dialog.</descrip></descripGrp><ntig><termGrp><term id="2447290">OK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3128388">У реду</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43243_3128054_3128388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that you select to accept the contents of the dialog.</descrip></descripGrp><ntig><termGrp><term id="3128054">OK</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="3128388">У реду</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43257_2450114_2452834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A target error margin for recall that is used to estimate number of additional files necessary needed for review.</descrip></descripGrp><ntig><termGrp><term id="2450114">assessment target</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452834">циљ процене</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43258_2450131_2452836"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A percentage of files that need to be reviewed, which can be defined by the user of Advanced eDiscovery.</descrip></descripGrp><ntig><termGrp><term id="2450131">cut-off point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452836">гранична тачка</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43259_2450137_2452837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery view where detailed interim cumulative results can be viewed after each Relevance training cycle.</descrip></descripGrp><ntig><termGrp><term id="2450137">Detailed Results</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452837">Детаљни резултати</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43261_2450561_2452858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process where an expert labels each file and issue within a sample as relevant, not relevant, or an item that should be skipped as part of Advanced eDiscovery Relevance training.</descrip></descripGrp><ntig><termGrp><term id="2450561">tagging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452858">означавање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43262_2450562_2452859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery panel where users can tag files and issues as relevant, not relevant, or where they can choose to skip it.</descrip></descripGrp><ntig><termGrp><term id="2450562">Tagging panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452859">Табла за означавање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43263_2450563_2452860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A margin of error for the recall value that is used to estimate the number of files that need to be reviewed by Advanced eDiscovery.</descrip></descripGrp><ntig><termGrp><term id="2450563">target error margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452860">циљна маргина грешке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43264_2450798_2452835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery mode that allows users to process new file loads after other file loads were already started, see a comparison of the loads, and decide if they want to merge the new loads with the existing ones or split them.</descrip></descripGrp><ntig><termGrp><term id="2450798">Catch-up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452835">Прикључивање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43265_2450799_2452845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery option that allows users to continue Relevance training, treating new loads and old loads like the same set of files.</descrip></descripGrp><ntig><termGrp><term id="2450799">Merge loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452845">Обједини збирке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43266_2450800_2452856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery option that allows users to perform Relevance training on new file loads separately from old file loads.</descrip></descripGrp><ntig><termGrp><term id="2450800">Split loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452856">Раздвој збирке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43267_2450801_2452853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery mode that allows users to incorporate a new load with existing loads using Catch-up and which triggers any new necessary Relevance training.</descrip></descripGrp><ntig><termGrp><term id="2450801">Rolling loads</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452853">Сукцесивно додавање збирки</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43268_2450802_2452842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery feature that allows users to select a set of parameters that will determine which files are exported in a batch.</descrip></descripGrp><ntig><termGrp><term id="2450802">Export batch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452842">Пакет за извоз</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43269_2450812_2452847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that is in its original file type.</descrip></descripGrp><ntig><termGrp><term id="2450812">native file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452847">оригинална датотека</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43270_2450813_2452851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A phase in e-discovery where native files are prepared to be loaded into a document review platform, metadata is extracted from files, and data culling techniques are employed.</descrip></descripGrp><ntig><termGrp><term id="2450813">processing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452851">обрада</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43271_2450814_2452838"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery metadata type that identifies whether file is a document, email or an attachment.</descrip></descripGrp><ntig><termGrp><term id="2450814">Doc_type</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452838">Doc_type</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43272_2450815_2452839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery metadata type that identifies the subset of exact duplicates.</descrip></descripGrp><ntig><termGrp><term id="2450815">Duplicate_subset</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452839">Duplicate_subset</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43273_2450816_2452840"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery metadata type that identifies an email within an email thread, including the node IDs of all emails in the thread from the root to the current email.</descrip></descripGrp><ntig><termGrp><term id="2450816">Email_thread</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452840">Email_thread</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43274_2450817_2452844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Advanced eDiscovery metadata type that identifies if a file is an inclusive file, an inclusive minus, or an inclusive copy.</descrip></descripGrp><ntig><termGrp><term id="2450817">Inclusive_type</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452844">Inclusive_type</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43275_2450818_2452848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of attributes for a population that includes the number of files and estimated number of relevant files as calculated by Advanced eDiscovery during processing.</descrip></descripGrp><ntig><termGrp><term id="2450818">population parameters</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452848">параметри корпуса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43276_2450819_2452843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique identification number that represents a single Advanced eDiscovery import session.</descrip></descripGrp><ntig><termGrp><term id="2450819">import batch ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452843">ID пакета за увоз</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43277_2450820_2452849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The offering that allows customers to upgrade service, adding additional functionality for a price.</descrip></descripGrp><ntig><termGrp><term id="2450820">Premium</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452849">Premium</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43278_2450822_2452862"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook feature that allows users to create cloud attachments either as a link or as a traditional attachment, and that allows users to set permissions for that attachment when it is sent.</descrip></descripGrp><ntig><termGrp><term id="2450822">Modern Attachments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2452862">Модерни прилози</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Ma