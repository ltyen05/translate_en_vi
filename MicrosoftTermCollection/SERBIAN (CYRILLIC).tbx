ech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2741481">Надгледање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48468_2738468_2741471"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 compliance center view that allows users to search, investigate, and take action on data-related incidents such as a data breach, data spillage, or needing to search for and purge messages that contain a harmful attachment.</descrip></descripGrp><ntig><termGrp><term id="2738468">Data investigations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2741471">Испитивања података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48469_2738471_2741472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 compliance center view that allows users to respond to a data subject request and create data subject request cases.</descrip></descripGrp><ntig><termGrp><term id="2738471">Data subject requests</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2741472">Захтеви лица на која се односе подаци</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48472_2739176_2743380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of targeted information that is meant to change an individual's perception on something in a way that is untrue such that the shift will cause harm.</descrip></descripGrp><ntig><termGrp><term id="2739176">weaponized information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2743380">инструментализоване информације</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48474_2739487_2743375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A condition under which a policy is triggered.</descrip></descripGrp><ntig><termGrp><term id="2739487">policy trigger</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2743375">окидач смернице</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48482_2741337_2744202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to authentication means that do not require a password.</descrip></descripGrp><ntig><termGrp><term id="2741337">password-less</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2744202">без лозинке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48482_2917812_2744202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to authentication means that do not require a password.</descrip></descripGrp><ntig><termGrp><term id="2917812">passwordless</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2744202">без лозинке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48485_2741340_2744203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of authentication in which key-based authentication is used to enable a user credential that is tied to a device and the users are not required to provide a password.</descrip></descripGrp><ntig><termGrp><term id="2741340">password-less authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2744203">потврда идентитета без лозинке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48485_2917816_2744203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A means of authentication in which key-based authentication is used to enable a user credential that is tied to a device and the users are not required to provide a password.</descrip></descripGrp><ntig><termGrp><term id="2917816">passwordless authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2744203">потврда идентитета без лозинке</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48488_2741343_2744210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The security model that requires authentication and encryption of each access request as though it originates from an open network. Principles include segmentation, to make it harder for attackers to move through the network, and restricting user access to the minimum amount needed to do their job.</descrip></descripGrp><ntig><termGrp><term id="2741343">Zero Trust</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2744210">Нулта поузданост</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4849_184188_1503314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection of custom properties for a shape.</descrip></descripGrp><ntig><termGrp><term id="184188">shape data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503314">облици података</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48494_2741547_2744141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cyber security center that is staffed with security professionals, data scientists, and product engineers who are available 24 hours, seven days a week to help protect, detect, and respond to threats in real-time.</descrip></descripGrp><ntig><termGrp><term id="2741547">Cyber Defense Operations Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2744141">CDOC</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="48494_2741547_2744142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cyber security center that is staffed with security professionals, data scientists, and product engineers who are available 24 hours, seven days a week to help protect, detect, and respond to threats in real-time.</descrip></descripGrp><ntig><termGrp><term id="2741547">Cyber Defense Operations Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2744142">Центар</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">