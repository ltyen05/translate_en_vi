ermNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5788_397202_406475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Exchange Mailbox assistant that applies and processes the message retention settings based on retention policies.</descrip></descripGrp><ntig><termGrp><term id="397202">managed folder mailbox assistant</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="406475">помоћник за поштанско сандуче са надгледаним фасциклама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5790_211562_1503434"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any feature in the computer system based on older technology for which compatibility continues to be maintained in other system components.</descrip></descripGrp><ntig><termGrp><term id="211562">legacy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503434">наслијеђе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5809_351298_1503435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limitation or a restriction.</descrip></descripGrp><ntig><termGrp><term id="351298">constraint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503435">ограничење</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5810_119238_1503436"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key, often labeled with both a left-pointing and a right-pointing arrow, that traditionally (as in word processing) is used to insert tab characters into a document. In other applications, such as menu-driven programs, the TAB key is often used to move the on-screen highlight from place to place.</descrip></descripGrp><ntig><termGrp><term id="119238">TAB key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503436">тастер TAB</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5814_17688_1503437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A built-in format that can be applied to a range of data, or to controls and sections in a form or report to change their appearance.</descrip></descripGrp><ntig><termGrp><term id="17688">autoformat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503437">аутоформат</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5814_17688_2527337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A built-in format that can be applied to a range of data, or to controls and sections in a form or report to change their appearance.</descrip></descripGrp><ntig><termGrp><term id="17688">autoformat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527337">аутоматско обликовање</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5819_126909_707190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that uniquely identifies a user in a computer system for the purpose of logging into said system and identifying oneself to other users.</descrip></descripGrp><ntig><termGrp><term id="126909">username</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="707190">корисничко име</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5819_2638662_707190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that uniquely identifies a user in a computer system for the purpose of logging into said system and identifying oneself to other users.</descrip></descripGrp><ntig><termGrp><term id="2638662">user name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="707190">корисничко име</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5821_1275979_1503438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary document used in Excel to store and work with data. A worksheet consists of cells that are organized into columns and rows; a worksheet is always stored in a workbook.</descrip></descripGrp><ntig><termGrp><term id="1275979">sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503438">радни лист</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5821_134416_1503438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary document used in Excel to store and work with data. A worksheet consists of cells that are organized into columns and rows; a worksheet is always stored in a workbook.</descrip></descripGrp><ntig><termGrp><term id="134416">worksheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503438">радни лист</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5834_87984_1503440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific action carried out by a computer in the process of executing a program.</descrip></descripGrp><ntig><termGrp><term id="87984">operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503440">операција</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5835_138731_1523544"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism provided by the common language runtime whereby managed code is granted permissions by security policy and these permissions are enforced, helping to limit the operations that the code will be allowed to perform.</descrip></descripGrp><ntig><termGrp><term id="138731">code access security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1523544">безбедност шифрованог приступа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5835_138731_1916663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism provided by the common language runtime whereby managed code is granted permissions by security policy and these permissions are enforced, helping to limit the operations that the code will be allowed to perform.</descrip></descripGrp><ntig><termGrp><term id="138731">code access security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916663">сигурност кодног приступа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5841_70966_2527389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The date on which bonds, policies, stock, etc. are issued.</descrip></descripGrp><ntig><termGrp><term id="70966">issue date</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527389">датум издавања</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5844_127521_2541585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scripting language that is used to create interactive or animated content for the Internet, such as games or advanced financial applications and that is based on Microsoft Visual Basic syntax.</descrip></descripGrp><ntig><termGrp><term id="127521">VBScript</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541585">VBScript</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5844_127521_2541586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scripting language that is used to create interactive or animated content for the Internet, such as games or advanced financial applications and that is based on Microsoft Visual Basic syntax.</descrip></descripGrp><ntig><termGrp><term id="127521">VBScript</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541586">Visual Basic Scripting Edition</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5844_127522_2541585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scripting language that is used to create interactive or animated content for the Internet, such as games or advanced financial applications and that is based on Microsoft Visual Basic syntax.</descrip></descripGrp><ntig><termGrp><term id="127522">Visual Basic Scripting Edition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541585">VBScript</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5844_127522_2541586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scripting language that is used to create interactive or animated content for the Internet, such as games or advanced financial applications and that is based on Microsoft Visual Basic syntax.</descrip></descripGrp><ntig><termGrp><term id="127522">Visual Basic Scripting Edition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541586">Visual Basic Scripting Edition</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5849_122378_2601156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variety of graphics tablet that uses pressure sensors, rather than the electromagnetics used in more expensive high-resolution tablets, to track the position of a device on its surface.</descrip></descripGrp><ntig><termGrp><term id="122378">touch pad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2601156">тачпед</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5849_783226_2601156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variety of graphics tablet that uses pressure sensors, rather than the electromagnetics used in more expensive high-resolution tablets, to track the position of a device on its surface.</descrip></descripGrp><ntig><termGrp><term id="783226">touchpad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2601156">тачпед</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5853_309073_1503442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of files that modify Windows features. Package types include service packs, security updates, language packs, and hotfixes. Examples of packages include LanguagePack, Windows Foundation, and FeaturePack.</descrip></descripGrp><ntig><termGrp><term id="309073">package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503442">пакет</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5858_184170_1669456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook pane that can be enabled to show an overview of the user's schedule, tasks and frequent contacts.</descrip></descripGrp><ntig><termGrp><term id="184170">To-Do Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1669456">Распоред задатака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5858_184170_2541948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook pane that can be enabled to show an overview of the user's schedule, tasks and frequent contacts.</descrip></descripGrp><ntig><termGrp><term id="184170">To-Do Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2541948">Роковник</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5859_293097_2009729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique number governments issue to companies and citizens in order to track taxes paid on goods and services. VAT IDs in the European Union contain a country prefix followed by up to 12 digits or characters.</descrip></descripGrp><ntig><termGrp><term id="293097">VAT ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2009729">ID за ПДВ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5864_15940_1503444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed, connection-oriented, virtual circuit-based packet switching protocol used to transport many different types of network traffic. ATM packages data in 53-byte, fixed-length cells that can be switched quickly between logical connections on a network.</descrip></descripGrp><ntig><termGrp><term id="15940">ATM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503444">АТМ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5864_15940_1503445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed, connection-oriented, virtual circuit-based packet switching protocol used to transport many different types of network traffic. ATM packages data in 53-byte, fixed-length cells that can be switched quickly between logical connections on a network.</descrip></descripGrp><ntig><termGrp><term id="15940">ATM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503445">мод асинхроног преноса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5864_15941_1503444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed, connection-oriented, virtual circuit-based packet switching protocol used to transport many different types of network traffic. ATM packages data in 53-byte, fixed-length cells that can be switched quickly between logical connections on a network.</descrip></descripGrp><ntig><termGrp><term id="15941">asynchronous transfer mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503444">АТМ</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5864_15941_1503445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed, connection-oriented, virtual circuit-based packet switching protocol used to transport many different types of network traffic. ATM packages data in 53-byte, fixed-length cells that can be switched quickly between logical connections on a network.</descrip></descripGrp><ntig><termGrp><term id="15941">asynchronous transfer mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503445">мод асинхроног преноса</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5870_725947_1503446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows x86-based computers to support more than 4 gigabytes (GB) of physical memory. Up to 64 GB of physical memory can be used as regular 4-kilobyte (KB) pages, and the number of bits that can be used by the kernel to address physical memory can be expanded from 32 to 36.</descrip></descripGrp><ntig><termGrp><term id="725947">physical address expansion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503446">проширење физичке адресе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5870_92106_1503446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows x86-based computers to support more than 4 gigabytes (GB) of physical memory. Up to 64 GB of physical memory can be used as regular 4-kilobyte (KB) pages, and the number of bits that can be used by the kernel to address physical memory can be expanded from 32 to 36.</descrip></descripGrp><ntig><termGrp><term id="92106">physical address extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503446">проширење физичке адресе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5870_92107_1503446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows x86-based computers to support more than 4 gigabytes (GB) of physical memory. Up to 64 GB of physical memory can be used as regular 4-kilobyte (KB) pages, and the number of bits that can be used by the kernel to address physical memory can be expanded from 32 to 36.</descrip></descripGrp><ntig><termGrp><term id="92107">PAE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1503446">проширење физичке адресе</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5874_101275_1916617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of statistical analysis used for forecasting. Regression analysis estimates the relationship between variables so that a given variable can be predicted from one or more other variables.</descrip></descripGrp><ntig><termGrp><term id="101275">regression analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916617">регресиона анализа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5874_101275_2527430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of statistical analysis used for forecasting. Regression analysis estimates the relationship between variables so that a given variable can be predicted from one or more other variables.</descrip></descripGrp><ntig><termGrp><term id="101275">regression analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2527430">регресивна анализа</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5876_86775_1796408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft WOSA (Windows Open System Architecture) structure, an interface providing a common language for Windows applications to gain access to a database on a network.</descrip></descripGrp><ntig><termGrp><term id="86775">ODBC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796408">ODBC</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5876_86776_1796408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft WOSA (Windows Open System Architecture) structure, an interface providing a common language for Windows applications to gain access to a database on a network.</descrip></descripGrp><ntig><termGrp><term id="86776">Open Database Connectivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1796408">ODBC</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5877_144194_1916713"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The name used to represent the same computer on which a TCP/IP message originates. If you access a server-based web site by using http://localhost, the request does not actually go out to the Internet.</descrip></descripGrp><ntig><termGrp><term id="144194">localhost</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1916713">локални главни рачунар</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="589_145348_2541803"><langSet xml:lang="en-US"><descripGrp><descrip type="definitio