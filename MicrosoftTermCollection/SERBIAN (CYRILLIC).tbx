ote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21019_763886_1051345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A horizontal grouping of actions that apply to the container (or containers) with which the toolbar is associated. For example, a container in which mail is viewed might have an action toolbar with options that include Reply, Delete, and Move to.</descrip></descripGrp><ntig><termGrp><term id="763886">toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051345">трака са алаткама за радње</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21019_763886_1051369"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A horizontal grouping of actions that apply to the container (or containers) with which the toolbar is associated. For example, a container in which mail is viewed might have an action toolbar with options that include Reply, Delete, and Move to.</descrip></descripGrp><ntig><termGrp><term id="763886">toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1051369">трака са алаткама</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21019_763886_1527853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A horizontal grouping of actions that apply to the container (or containers) with which the toolbar is associated. For example, a container in which mail is viewed might have an action toolbar with options that include Reply, Delete, and Move to.</descrip></descripGrp><ntig><termGrp><term id="763886">toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1527853">алатна трака</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21022_1216839_1778502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user role that is assigned to a user account, which determines the options that are visible to that user and the tasks that the user can perform in the management interface for Exchange Labs.</descrip></descripGrp><ntig><termGrp><term id="1216839">RBAC role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1778502">RBAC улога</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21022_1216839_1778512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user role that is assigned to a user account, which determines the options that are visible to that user and the tasks that the user can perform in the management interface for Exchange Labs.</descrip></descripGrp><ntig><termGrp><term id="1216839">RBAC role</term><termNote type="partOfS