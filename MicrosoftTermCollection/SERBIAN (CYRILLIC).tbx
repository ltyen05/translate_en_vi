></termGrp></ntig></langSet></termEntry><termEntry id="44214_2484797_2487428"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to send files and documents to their OneNote.</descrip></descripGrp><ntig><termGrp><term id="2484797">Print to OneNote</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2487428">Одштампај у OneNote</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44227_2485133_2487430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The trial version of Visio Pro for Office 365.</descrip></descripGrp><ntig><termGrp><term id="2485133">Visio Pro for Office 365 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="2487430">Visio Pro за Office 365 – пробна верзија</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44236_2485603_2489584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The email search client that provides autocomplete, spell correct, fuzzy name search and that provides relevance-based and time-ordered results.</descrip></descripGrp><ntig><termGrp><term id="2485603">Email Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="s