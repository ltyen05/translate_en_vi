alGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14505_207689_1361780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Presentation Foundation and Silverlight, a property represented by a DependencyProperty identifier that is registered with the property system. Dependency properties can be defined only by DependencyObject types, which typically expose the identifier as a public static field. The property system determines their effective value based on a precedence evaluation of all possible value sources.</descrip></descripGrp><ntig><termGrp><term id="207689">dependency property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1361780">својство зависности</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14509_113733_1504310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user interface control that is equipped with a small bar which slides along a visible line and is used to set a value along a range with a minimum and maximum.</descrip></descripGrp><ntig><termGrp><term id="113733">slider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504310">клизач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14509_641191_1504310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical user interface control that is equipped with a small bar which slides along a visible line and is used to set a value along a range with a minimum and maximum.</descrip></descripGrp><ntig><termGrp><term id="641191">slider control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="1504310">клизач</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14510_565335_765607"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment of the marketplace, not all of it at once.</descrip></descripGrp><ntig><termGrp><term id="565335">vertical</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765607">индустријска вертикала</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14510_565335_765667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A segment of the marketplace, not all of it at once.</descrip></descripGrp><ntig><termGrp><term id="565335">vertical</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="sr-Cyrl"><ntig><termGrp><term id="765667">вертикала</term><termNote type="geographicalUsage">SRB, BIH</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type=