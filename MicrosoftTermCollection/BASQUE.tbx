b</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440234">desegin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52741_2956721_2996564"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A solution that is a rational number, that is any number that can be represented in the form of p/q where q=/=0.</descrip></descripGrp><ntig><termGrp><term id="2956721">rational solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996564">soluzio arrazional</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52742_2956722_2996516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scalar value that is a function of the entries of a square matrix.</descrip></descripGrp><ntig><termGrp><term id="2956722">determinant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996516">determinante</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52743_2956723_2996533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A statement that of two quantities one is specifically less than or greater than another.</descrip></descripGrp><ntig><termGrp><term id="2956723">inequality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996533">desberdintza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52744_2956724_2996675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The replacement of the variables in an algebraic expression by their values in terms of another set of variables.</descrip></descripGrp><ntig><termGrp><term id="2956724">transformation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996675">transformazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52745_2956725_2996514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The derived function of a function.</descrip></descripGrp><ntig><termGrp><term id="2956725">derivative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996514">deribatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52746_2956726_2996543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The coordinate of the point at which a curve intersects an axis.</descrip></descripGrp><ntig><termGrp><term id="2956726">intercept</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996543">ebakidura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52747_2956727_2996512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a right triangle, the reciprocal of the sine of an angle.</descrip></descripGrp><ntig><termGrp><term id="2956727">cosecant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996512">kosekante</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52748_2956728_2996520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A disjunction which is true if only one, but not both, of its disjuncts is true.</descrip></descripGrp><ntig><termGrp><term id="2956728">exclusive disjunction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996520">disjuntzio esklusibo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52749_2956729_2996665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The symbol of the trigonometric function tangent.</descrip></descripGrp><ntig><termGrp><term id="2956729">tan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996665">tan</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52750_2956730_2996527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To show what part of the number line contains values that will “satisfy” the given inequality.</descrip></descripGrp><ntig><termGrp><term id="2956730">Graph Inequality</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996527">Erakutsi grafikoan desberdintza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52751_2956731_2996550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a function, the state of either never decreasing or never increasing as its independent variable increases.</descrip></descripGrp><ntig><termGrp><term id="2956731">Monotonicity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996550">Monotonia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52752_2956732_2996532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complex number, usually denoted with i, that is defined by i2=-1.</descrip></descripGrp><ntig><termGrp><term id="2956732">imaginary unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996532">unitate irudikari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52753_2956733_2996531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of a complex number a+bi, where a and b are real numbers, the value b.</descrip></descripGrp><ntig><termGrp><term id="2956733">imaginary part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996531">zati irudikari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52754_2956734_2996508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function whose derivative is a given function, an indefinite integral.</descrip></descripGrp><ntig><termGrp><term id="2956734">antiderivative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996508">jatorrizko funtzio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52755_2956735_2996553"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An identity that expresses the Pythagorean theorem in terms of trigonometric functions.</descrip></descripGrp><ntig><termGrp><term id="2956735">Pythagorean Identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996553">Nortasun pitagorikoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52756_2956736_2996652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mnemonic device for computing the determinant of a 3x3 matrix named after the French mathematician Pierre Frédéric Sarrus.</descrip></descripGrp><ntig><termGrp><term id="2956736">Sarrus' Rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996652">Sarrusen araua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52757_2956737_2996673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For a polynomial sorted by degree, the last monomial term.</descrip></descripGrp><ntig><termGrp><term id="2956737">trailing term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996673">azken gai</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52758_2956738_2996524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way of representing repeated multiplications of the same number by writing the number as a base with the number of repeats written as a small number to its upper right.</descrip></descripGrp><ntig><termGrp><term id="2956738">exponential form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996524">adierazpen esponentzial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52759_2956739_2996559"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical root expressed with a radical sign, generally a square root or cube root.</descrip></descripGrp><ntig><termGrp><term id="2956739">radical form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996559">erro-adierazpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52760_2956740_2996548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability that gives the user instantaneous access to a device by using a remote shell connection, granting them the power to do in-depth investigative work and take immediate response actions to promptly contain identified threats in real time.</descrip></descripGrp><ntig><termGrp><term id="2956740">Live Response</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2996548">Zuzeneko erantzuna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52773_2997773_2997785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Information Excel function that returns TRUE if the value is any error value.</descrip></descripGrp><ntig><termGrp><term id="2997773">ISERROR</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2997785">ERROREA.DA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52774_2997860_2999508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Edge that allows the user to keep track of their ideas on the web by adding pages, images, links, or text to a nameable collection that can be saved and synced across signed-in devices.</descrip></descripGrp><ntig><termGrp><term id="2997860">Collections</term><termNote type="partOfSpeech">ProperNoun<