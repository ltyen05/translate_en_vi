3044732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows parents to manage their children's activities on Xbox consoles and enable gaming options that are right for their family, including screen time limitations, content restrictions, and friend requests.</descrip></descripGrp><ntig><termGrp><term id="3044723">Xbox Family Settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3044732">Xbox Family Settings</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53438_3045020_3045089"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app within Teams that allows users to capture images and videos.</descrip></descripGrp><ntig><termGrp><term id="3045020">Camera</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3045089">Kamera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53441_3045240_3045417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The root folder in Windows Explorer that shows recently used items.</descrip></descripGrp><ntig><termGrp><term id="3045240">Home</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3045417">Hasiera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53442_3045241_3045406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of Windows Enterprise E3 that automatically keeps Windows and Office software up to date on enrolled endpoints.</descrip></descripGrp><ntig><termGrp><term id="3045241">Windows Autopatch</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3045406">Windows Autopatch</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53444_3045433_3046233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The RPA mode where the automation is executed when users are in front of their computers. This is suitable when they want to automate tasks and processes at an individual level. The automation is often triggered manually whenever the user wants to run it. The process might require human interaction or decisions between steps.</descrip></descripGrp><ntig><termGrp><term id="3045433">attended</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3046233">artatuta</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53445_3045434_3046234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of actions in a flow.</descrip></descripGrp><ntig><termGrp><term id="3045434">block of actions</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3046234">ekintza-bloke</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53446_3045435_3046235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of enabling users to interact with web applications and components through UI elements. UI elements describe uniquely the web components that the action is going to handle.</descrip></descripGrp><ntig><termGrp><term id="3045435">browser automation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3046235">arakatzailearen automatizazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53447_3045436_3046236"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The AI Builder component that allows users to detect business cards and extract their information.</descrip></descripGrp><ntig><termGrp><term id="3045436">Business card reader</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3046236">Bisita-txartelen irakurle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53448_3045437_3046237"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A flow that is being called by the parent flow.</descrip></descripGrp><ntig><termGrp><term id="3045437">child flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3046237">bigarren mailako fluxu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53449_3045438_3046238"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A qualified lead that can become an account, a contact or an opportunity.</descrip></descripGrp><ntig><termGrp><term id="3045438">converted lead</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3046238">bihurtutako bezerogai</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53450_3045439_3046239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that improves models by raising confidence scores in AI Builder. Documents can be flagged by users and sent back to the training wizard queue for retraining if they didn't yield sufficient confidence scores when analyzed by AI Builder.</descrip></descripGrp><ntig><termGrp><term id="3045439">feedback loop</term><termNote type="part