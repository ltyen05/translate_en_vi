pe="definition">A Windows tool used to capture a screen shot, or snip, of any object on the screen, and then annotate, save, or share the image.</descrip></descripGrp><ntig><termGrp><term id="748066">Snipping Tool</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2499180">Mozteko tresna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20848_748169_1140319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an email conversation so that all current and future messages in the conversation are automatically moved to the Deleted Items folder.</descrip></descripGrp><ntig><termGrp><term id="748169">ignore</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140319">ez ikusi egin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20849_748170_1140320"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special control that shows pictures, names and titles of people who are attending a meeting, or who are the recipients of an email message.</descrip></descripGrp><ntig><termGrp><term id="748170">Attendee/Recipient List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140320">Parte-hartzaileen/Hartzaileen zerren