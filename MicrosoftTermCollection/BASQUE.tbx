 displays the name of the paragraph style that is applied to each paragraph.</descrip></descripGrp><ntig><termGrp><term id="232852">style area</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440402">estilo-area</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9326_2767720_2771703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password produced by special password generating software or by a hardware token and that can be used only once.</descrip></descripGrp><ntig><termGrp><term id="2767720">one-time passcode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2771703">erabilera bakarreko pasakode</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9326_493823_2771703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password produced by special password generating software or by a hardware token and that can be used only once.</descrip></descripGrp><ntig><termGrp><term id="493823">one-time password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2771703">erabilera bakarreko pasakode</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGende