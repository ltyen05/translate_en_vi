</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2330874">ikaskuntza automatiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39435_2290443_2330867"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI component that filters all items, tiles, charts, and streams in the dashboard if the filter criteria matches.</descrip></descripGrp><ntig><termGrp><term id="2290443">global filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2330867">iragazki orokor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39436_2290509_2330900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section in the service desk dashboard that displays the visualizations, for example, charts and graphs.</descrip></descripGrp><ntig><termGrp><term id="2290509">Visual Filters</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2330900">iragazki bisualak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39437_2290512_2330883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane in the Service Desk  that is easily accessible by a CSR and provides the CSR with key information related to the primary record in the form, for example, relevant KB article, entitlements, and recent cases.</descrip></descripGrp><ntig><termGrp><term id="2290512">reference panel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2330883">erreferentzia-panel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39438_2290513_2330878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dashboard template that is typically for users who are involved in a high volume of tasks, across multiple data streams and who usually don’t spend a lot of time on each task. A typical example of users of this template are Tier 1 customer service representatives.</descrip></descripGrp><ntig><termGrp><term id="2290513">Tier One Dashboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2330878">Korronte anitzeko panel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39438_2290513_2330896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dashboard template that is typically for users who are involved in a high volume of tasks, across multiple data streams and who usually don’t spend a lot of time on each task. A typical example of users of this template are Tier 1 customer service representatives.</descrip></descripGrp><ntig><termGrp><term id="2290513">Tier One Dashboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2330896">Lehen mailako panel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39438_2295300_2330878"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dashboard template that is typically for users who are involved in a high volume of tasks, across multiple data streams and who usually don’t spend a lot of time on each task. A typical example of users of this template are Tier 1 customer service representatives.</descrip></descripGrp><ntig><termGrp><term id="2295300">Multi-Stream Dashboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2330878">Korronte anitzeko panel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39438_2295300_2330896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dashboard template that is typically for users who are involved in a high volume of tasks, across multiple data streams and who usually don’t spend a lot of time on each task. A typical example of users of this template are Tier 1 customer service representatives.</descrip></descripGrp><nti