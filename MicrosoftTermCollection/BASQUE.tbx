ition">A set of attributes that define a user's access to a given service or application.</descrip></descripGrp><ntig><termGrp><term id="1276167">identity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228374">kontu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21638_779054_1228374"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of attributes that define a user's access to a given service or application.</descrip></descripGrp><ntig><termGrp><term id="779054">account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228374">kontu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21640_779056_1999165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To break a connection.</descrip></descripGrp><ntig><termGrp><term id="779056">disconnect</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1999165">deskonektatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21645_779064_1140422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to something, such as a signal or connection, that is not unbroken but occurs at periodic or occasional intervals.</descrip></descripGrp><ntig><termGrp><term id="779064">intermittent</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140422">aldizkako</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21658_779139_2085301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To call the last person called from a phone or device.</descrip></descripGrp><ntig><termGrp><term id="779139">redial</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2085301">berriro markatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21660_779144_2085353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To send text messages from a mobile phone or device.</descrip></descripGrp><ntig><termGrp><term id="779144">text</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2085353">testu-mezua bidali</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2170_557779_1332854"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that contains the information, such as the email server name and type, that the Microsoft Dynamics CRM system needs to establish a functional E-mail Router.</descrip></descripGrp><ntig><termGrp><term id="557779">E-mail Router configuration profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1332854">posta elektronikoaren bideratzailearen konfigurazio-profil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21758_779693_1228375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to compare or show the relationship between two ideas. Each of the first two lines of Level 1 text corresponds to text at the top of one side of the center point. Emphasizes Level 2 text, which is limited to four shapes on each side of the center point. The balance tips towards the side with the most shapes containing Level 2 text. Unused text does not appear, but remains available if you switch layouts.</descrip></descripGrp><ntig><termGrp><term id="779693">Balance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228375">Oreka</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21787_779722_1228376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show sequential steps or tasks that depict a plan or result. The last Level 1 line of text appears after the equals sign (=).Works best with Level 1 text only.</descrip></descripGrp><ntig><termGrp><term id="779722">Equation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228376">Ekuazioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21822_779757_1228377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic layout used to show grouped or related information of equal value. The first Level 1 line of text corresponds to the top shape and its Level 2 text is used for the subsequent lists.</descrip></descripGrp><ntig><termGrp><term id="779757">Table List</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228377">Taula-zerrenda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21839_779839_2627199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having the ability to make decisions based on predictions driven by machine learning analysis.</descrip></descripGrp><ntig><termGrp><term id="779839">intelligent</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2627199">adimendun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21847_779972_2436123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Marked by the use of serifs. For example, Goudy is a serif typeface, whereas Helvetica is a sans serif typeface.</descrip></descripGrp><ntig><termGrp><term id="779972">serif</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2436123">errematearekin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21853_779994_1789659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of customizing the look and feel of a product to support marketing or promotion of another company.</descrip></descripGrp><ntig><termGrp><term id="779994">co-branding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1789659">lankidetza-marketin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21869_780135_1140423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A classification of words, labels, tags, etc. into groups based on similarities.</descrip></descripGrp><ntig><termGrp><term id="780135">taxonomy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140423">taxonomia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21870_780136_2392400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of policies, roles, responsibilities, and processes that are established in an enterprise to guide, direct, and control how the organization uses technologies to accomplish business goals.</descrip></descripGrp><ntig><termGrp><term id="780136">governance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2392400">gobernamendu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21873_780192_2998739"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formula giving the roots of a quadratic equation.</descrip></descripGrp><ntig><termGrp><term id="780192">quadratic formula</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2998739">formula koadratiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21876_780202_1797811"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Not able to be delivered to an intended recipient. If an email message is undeliverable, it is returned to the sender with information added by the mail server explaining the problem; for example, the email address may be incorrect, or the recipient's mailbox may be full.</descrip></descripGrp><ntig><termGrp><term id="780202">undeliverable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1797811">entregatuezin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21880_780207_2927142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to information that a user has received but has not yet read.</descrip></descripGrp><ntig><termGrp><term id="780207">unread</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2927142">irakurri gabeko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21894_780443_2085182"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To turn off a system notification such as a reminder, a new message alert or an alarm.</descrip></descripGrp><ntig><termGrp><term id="780443">dismiss</term><termNote type="partOfSpeech">Verb</termNote><termNote type=