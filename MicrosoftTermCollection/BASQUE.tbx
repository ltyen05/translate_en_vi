es one-click filtering controls that make it easy to narrow down the portion of a data set that's being looked at.</descrip></descripGrp><ntig><termGrp><term id="1047907">Slicers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140429">Datu-zatitzaileak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22541_1047912_1140430"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A miniature chart that can be inserted into text or embedded within a cell on a worksheet to illustrate highs, lows, and trends in your data.</descrip></descripGrp><ntig><termGrp><term id="1047912">sparkline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140430">sparkline grafiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22543_1047914_1140431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Outlook Calendar view in which each calendar is listed vertically (not side-by-side). This view is optimized for viewing a schedule for a group and scheduling a meeting for a group.</descrip></descripGrp><ntig><termGrp><term id="1047914">Schedule View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140431">Agenda-ikuspegi</term><term