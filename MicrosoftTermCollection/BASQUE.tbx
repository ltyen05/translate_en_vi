cripGrp><descrip type="definition">The UK bank holiday celebrated on June 3, 2022 to commemorate the 70th anniversary of Queen Elizabeth II's accession to the throne.</descrip></descripGrp><ntig><termGrp><term id="3033521">Platinum Jubilee Bank Holiday</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3035330">Platinozko jubileua ospatzeko jaieguna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53248_3033522_3033561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The solution that enables enterprises to easily converge employees with relevant skills necessary to resolve complex cases. It is a structured approach to have a set of SMEs work together to bring a resolution to a complex customer issue.</descrip></descripGrp><ntig><termGrp><term id="3033522">Intelligent swarming</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3033561">Multzokatze adimentsua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53249_3033523_3033562"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of bringing in a team of SMEs from across the organization and working with them to solve complex customer issues.</descrip></descripGrp><ntig><termGrp><term id="3033523">swarm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3033562">multzoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5325_145206_440128"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To minimize the duplication of information in a relational database through effective table design.</descrip></descripGrp><ntig><termGrp><term id="145206">normalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440128">normalizatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53251_3033532_3035336"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Canadian holiday (colloquially known as Orange Shirt Day) celebrated on September 30 to recognize the legacy of the Canadian Indian residential school system.</descrip></descripGrp><ntig><termGrp><term id="3033532">National Day for Truth and Reconciliation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3035336">Egiaren eta Adiskidetzearen Egun Nazionala</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53252_3033536_3035339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The US federal holiday celebrated on June 19 to commemorate the emancipation of African-American slaves, celebrated on the anniversary of June 19, 1865, the date of the announcement of General Order No. 3 by Union Army general Gordon Granger proclaiming freedom for slaves in Texas, the last state of the Confederacy with institutional slavery.</descrip></descripGrp><ntig><termGrp><term id="3033536">Juneteenth</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3035339">Juneteenth</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53254_3033546_3035342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The day on which the US holiday Juneteenth is celebrated if the official holiday itself falls on a weekend.</descrip></descripGrp><ntig><termGrp><term id="3033546">Juneteenth (Observed)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3035342">Juneteenth (ospakizun-eguna)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53255_3033556_3035344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the Authenticator app and Edge that allows users to update their password on a website with one click.</descrip></descripGrp><ntig><termGrp><term id="3033556">easy update</term><termNote type="p