langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enhanced email experience in Dynamics 365 Sales and other model-driven apps that allows users to compose an email without leaving the record they are working on.</descrip></descripGrp><ntig><termGrp><term id="2882010">enhanced email</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882509">mezu elektroniko integratu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51040_2882011_2882510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that enables users to provide feedback and ratings for entity records.</descrip></descripGrp><ntig><termGrp><term id="2882011">feedback entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882510">oharrak bidaltzeko entitate</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51041_2882012_2882511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of a survey question that allows survey designers to combine several question types together into a table.</descrip></descripGrp><ntig><termGrp><term id="2882012">grid question</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882511">saretako galdera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51042_2882013_2882512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual card that helps keep users up to date with their work in Dynamics 365 Sales, letting them know when they need to follow-up on an email, attend a meeting, and more. Insight cards are displayed throughout the application to provide relevant information for the context users are working in.</descrip></descripGrp><ntig><termGrp><term id="2882013">insight card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882512">xehetasun-txartel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51043_2882014_2882513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An answer associated with the survey response.</descrip></descripGrp><ntig><termGrp><term id="2882014">linked answer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882513">lotutako erantzun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51044_2882015_2882514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of the survey question where the categories created are the answers given to a previous/other question.</descrip></descripGrp><ntig><termGrp><term id="2882015">linked question</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882514">lotutako galdera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51045_2882016_2882515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Dynamics 365 Sales Insights, a JSON file containing call recording metadata that is uploaded together with the corresponding audio file to the call recording repository.</descrip></descripGrp><ntig><termGrp><term id="2882016">metadata file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882515">metadatu-fitxategi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51046_2882017_2882516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that provides users with suggestions for actions based on customer-related activities. When a user creates an activity, such as appointment, email, phone call, task, note, post, or custom activities, the notes analysis feature analyzes the descriptions provided in these activities and gives them intelligent suggestions. With these suggestions, users can take actions, such as creating a meeting request and adding a contact.</descrip></descripGrp><ntig><termGrp><term id="2882017">Notes analysis</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882516">Oharren analisia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51047_2882018_2882517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight card flagging the receipt of an email concerning an open opportunity with negative sentiment which can put the opportunity at risk.</descrip></descripGrp><ntig><termGrp><term id="2882018">Opportunity at risk</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882517">Arriskuan dagoen abagunea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51048_2882019_2882518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product associated with the opportunity.</descrip></descripGrp><ntig><termGrp><term id="2882019">opportunity product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882518">abagunearekin lotutako produktu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51049_2882020_2882519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of delivering experiences unique to each individual. It enables marketers to observe customer behavior, and with every action taken, build a profile of customer preferences. Predictive intelligence uses algorithms to deliver content based on estimates of what the customer wants or needs.</descrip></descripGrp><ntig><termGrp><term id="2882020">predictive intelligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882519">adimen iragarle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51050_2882021_2882520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that provides a scoring model to generate scores for leads that are available for a user in their pipeline. Using these scores, users can identify and prioritize leads that have more chances of converting into opportunities.</descrip></descripGrp><ntig><termGrp><term id="2882021">Predictive lead scoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882520">Bezerogaien puntuazio iragarlea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51051_2882022_2882521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that uses a predictive machine learning model to calculate a score for all open opportunities. The score helps salespeople prioritize opportunities, achieve higher opportunity qualification rates, and reduce the time that it takes to qualify an opportunity.</descrip></descripGrp><ntig><termGrp><term id="2882022">Predictive opportunity scoring</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882521">Abaguneen puntuazio iragarlea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51052_2882023_2882522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A score calculated by the predictive machine learning model for all open opportunities. It helps salespeople prioritize opportunities, achieve higher opportunity qualification rates, and reduce the time that it takes to qualify an opportunity.</descrip></descripGrp><ntig><termGrp><term id="2882023">predictive score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882522">puntuazio iragarle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51053_2882024_2882523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that helps salespeople focus on generating revenue instead of spending their time updating Dynamics 365 Sales data and logging every customer-related activity. In addition to activity suggestions based on capturing emails and meetings, premium auto capture also provides suggestions for creating new contacts.</descrip></descripGrp><ntig><termGrp><term id="2882024">premium auto capture</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882523">Premium kaptura automatikoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51054_2882025_2882524"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sales price of an item.</descrip></descripGrp><ntig><termGrp><term id="2882025">price per unit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882524">prezioa unitateko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51055_2882026_2882525"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Several individual goods or services that are sold to consumers as one combined package.</descrip></descripGrp><ntig><termGrp><term id="2882026">product bundle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882525">produktu multzo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51056_2882027_2882526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A participant in the Partner Program who provides a customer referral for a successful relationship.</descrip></descripGrp><ntig><termGrp><term id="2882027">referral partner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882526">erreferentzia ematen duen bazkide</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51057_2882028_2882527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Overall health and trend of each of your business relationships.</descrip></descripGrp><ntig><termGrp><term id="2882028">relationship health</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882527">harremanaren egoera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51058_2882029_2882528"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of asking respondents additional questions in a survey, based on previous responses. A response route consists of conditions and actions. Responses are evaluated based on conditions specified. When a specific condition is met, the response route runs an action that corresponds to that outcome.</descrip></descripGrp><ntig><termGrp><term id="2882029">response routing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882528">erantzunen araberako bideratze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51059_2882030_2882529"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that aims to help inside sellers sell smarter. Building a strong pipeline, offering context, and surfacing automated recommendations throughout a sales sequence, helps to transform the sales process.</descrip></descripGrp><ntig><termGrp><term id="2882030">Sales acceleration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882529">Salmenta-bizkortzea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51060_2882031_2882530"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that provides a tailored experience for sellers by minimizing the time they spend on their search for the best next customer to reach out to. The Sales accelerator gathers information from multiple sources and lets sellers focus on how to best approach their customers. It helps sellers to sell smartly, by building a strong and prioritized pipeline, offering context, and surfacing automated recommendations throughout a sales sequence that helps to speed the sales process.</descrip></descripGrp><ntig><termGrp><term id="2882031">Sales accelerator</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882530">Salmenta-bizkortzailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51061_2882032_2882531"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app built on the Unified Interface framework that uses responsive web design principles to provide an optimal viewing and interaction experience for any screen size, device, or orientation. The Sales Hub app is optimized to work on mobile devices as well as desktops.</descrip></descripGrp><ntig><termGrp><term id="2882032">Sales Hub</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882531">Salmenten atala</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51062_2882033_2882532"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure, on average, how satisfied or unsatisfied customers are with a product or service.</descrip></descripGrp><ntig><termGrp><term id="2882033">satisfaction rating</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882532">asebetetze-balorazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51063_2882034_2882533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Voice of the Customer feature that provides a simple and intuitive experience for survey designers to add, remove, and modify survey pages, sections, questions, and answers.</descrip></descripGrp><ntig><termGrp><term id="2882034">Survey Designer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882533">Inkesta-diseinatzailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51064_2882035_2882534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that helps users in an organization to quickly establish communications with customers by providing a mechanism to automatically identify conversation starters from their emails. The conservation starters include topics that are related to sports, vacation, family, and entertainment.</descrip></descripGrp><ntig><termGrp><term id="2882035">Talking points</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882534">Mintzagaiak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51065_2882036_2882535"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights option that shows the average time top sellers spend talking instead of listening to customers compared to the rest of the sales team.</descrip></descripGrp><ntig><termGrp><term id="2882036">talk-to-listen ratio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882535">"hitz egin / entzun" erlazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51066_2882037_2882536"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in the LinkedIn Sales Navigator Lead control that shows information about a LinkedIn member profile, like name, headline, and more. Additionally, it provides capabilities to message or save the person as a lead in Sales Navigator.</descrip></descripGrp><ntig><termGrp><term id="2882037">Top Card</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882536">Txartel nagusia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51067_2882038_2882537"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A term customers are mentioning most often during the sales calls. Using tracked keywords, sellers can identify new sales opportunities that are related to them.</descrip></descripGrp><ntig><termGrp><term id="2882038">tracked keyword</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882537">jarraitutako gako-hitz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51068_2882039_2882540"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of links used for navigation based on location on the webpage.</descrip></descripGrp><ntig><termGrp><term id="2882039">web link set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882540">webguneko esteka multzo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51069_2882040_2882541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales Insights feature that provides sales representatives with details such as names and email addresses of their colleagues who know the lead. With these details, they can contact their colleagues for help in getting introduced to a lead and increase the chances of a positive outcome during the interaction.</descrip></descripGrp><ntig><termGrp><term id="2882040">Who Knows Whom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882541">Nork nor ezagutzen duen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51070_2882041_2882542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Percentage of opportunities historically won by the seller.</descrip></descripGrp><ntig><termGrp><term id="2882041">win rate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882542">lorpen-tasa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51076_2884323_2885361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual in which report authors can add and tailor dynamic, interactive narratives to reports that are automatically generated by Power BI.</descrip></descripGrp><ntig><termGrp><term id="2884323">Smart narrative</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2885361">Narratiba adimenduna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51077_2884324_2885360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free Power BI licensing option.</descrip></descripGrp><ntig><termGrp><term id="2884324">Power BI free license</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><lan