"25654_1177391_1276777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A deployment-wide container of solutions that can be deployed in multiple organizations.</descrip></descripGrp><ntig><termGrp><term id="1177391">solution repository</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1276777">soluzio-biltegi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25655_1177392_1276774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A partner, such as an ISV, who develops solutions on top of a software platform.</descrip></descripGrp><ntig><termGrp><term id="1177392">solution publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1276774">soluzio-argitaratzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25656_1177393_1276518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A "catch-all" solution that contains a reference to all unprotected components.</descrip></descripGrp><ntig><termGrp><term id="1177393">default solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1276518">soluzio lehenetsi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNo