oud computing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2707758">hodei-informatika</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25214_1177249_2707758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of computing that uses groups of servers and scalable resources, generally a platform as a service and software as a service, over the Internet.</descrip></descripGrp><ntig><termGrp><term id="1177249">mesh computing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2707758">hodei-informatika</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2524_502939_1097107"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a user engaged in a phone conversation.</descrip></descripGrp><ntig><termGrp><term id="502939">in a call</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097107">dei batekin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25261_1172527_2692186"><langSet xml:lang="en-US"><descripGrp><descri