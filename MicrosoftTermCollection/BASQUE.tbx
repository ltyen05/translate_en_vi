mGrp><term id="49777">serial port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439526">komunikazio-ataka</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9331_49777_439527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A serial communications port used to connect a device, such as a modem, printer, or mobile device, to a computer.</descrip></descripGrp><ntig><termGrp><term id="49777">serial port</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439527">serieko ataka</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9333_374315_2094345"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data type of 1 byte (8 bits) that stores whole numbers in the range of 0 through 255.</descrip></descripGrp><ntig><termGrp><term id="374315">tinyint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2094345">tinyint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9334_397201_427699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of object that has an email address on a domain in the organization, but the object does not have a mailbox in the domain at which to receive messages. The object appears in the global address list, which allows other people in the organization to easily locate or send a message to that person, but the administrator does not need to manage an unnecessary mailbox. Contacts, users, and even folders can be mail-enabled.</descrip></descripGrp><ntig><termGrp><term id="397201">mail-enabled object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427699">postarako gaitutako objektu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9336_119369_439946"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database object that stores data in records (rows) and fields (columns). The data is usually about a particular category of things, such as employees or orders.</descrip></descripGrp><ntig><termGrp><term id="119369">table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439946">taula</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="934_76743_439702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A distinctive symbol that identifies a person, business, or organization.</descrip></descripGrp><ntig><termGrp><term id="76743"