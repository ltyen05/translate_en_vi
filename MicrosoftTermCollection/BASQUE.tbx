Note><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33711_1814023_2057492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A path enabling one inbound or outbound call and is a means of having concurrent calls on PBX.</descrip></descripGrp><ntig><termGrp><term id="1814023">calling channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2057492">kanal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33711_1814024_2057491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A path enabling one inbound or outbound call and is a means of having concurrent calls on PBX.</descrip></descripGrp><ntig><termGrp><term id="1814024">channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2057491">deitzeko kanal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33711_1814024_2057492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A path enabling one inbound or outbound call and is a means of having concurrent calls on PBX.</descrip></descripGrp><ntig><termGrp><term id="1814024">channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2057492">ka