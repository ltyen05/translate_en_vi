on">Capable of being retrieved (read), printed or copied but not changed (written) or saved.</descrip></descripGrp><ntig><termGrp><term id="98978">read-only</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228240">irakurtzeko soilik</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_592384_1990034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="592384">MTA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1990034">MTA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_592384_1990035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="592384">MTA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1990035">hainbat hariko apartamentu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_82756_1990034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="82756">multithreaded apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1990034">MTA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14968_82756_1990035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of one or more threads.</descrip></descripGrp><ntig><termGrp><term id="82756">multithreaded apartment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1990035">hainbat hariko apartamentu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14974_84430_439757"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On a local area network (LAN), a drive that other computers on the network can connect to. A network drive allows people to access shared files and folders.</descrip></descripGrp><ntig><termGrp><term id="84430">network drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439757">sareko unitate</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14988_397197_427706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that combines the asynchronous log shipping and replay features built into Exchange 2007 with the failover and management features provided by a failover cluster that is created with the Microsoft Windows Cluster service.</descrip></descripGrp><ntig><termGrp><term id="397197">cluster continuous replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427706">lukuen erreplikatze jarraitu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14988_746537_427706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that combines the asynchronous log shipping and replay features built into Exchange 2007 with the failover and management features provided by a failover cluster that is created with the Microsoft Windows Cluster service.</descrip></descripGrp><ntig><termGrp><term id="746537">CCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427706">lukuen erreplikatze jarraitu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14990_10614_439222"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An on-screen box, in a graphical user interface, that is used to deliver a message or warning.</descrip></descripGrp><ntig><termGrp><term id="10614">alert box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439222">alerta-koadro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14991_446295_1336802"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item on the Set Up menu that opens the Time Off dialog, which defines how much of the user's schedule is affected by a schedule change.</descrip></descripGrp><ntig><termGrp><term id="446295">Time Off</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1336802">Astialdia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14992_129955_2641510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A simulated 3-D environment that a user can experience and manipulate as if it were physical. The user sees the environment on display screens, possibly mounted in a special pair of goggles. Special input devices, such as gloves or suits fitted with motion sensors, detect the user's actions.</descrip></descripGrp><ntig><termGrp><term id="129955">virtual reality</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2641510">EB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14992_685431_2641510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A simulated 3-D environment that a user can experience and manipulate as if it were physical. The user sees the environment on display screens, possibly mounted in a special pair of goggles. Special input devices, such as gloves or suits fitted with motion sensors, detect the user's actions.</descrip></descripGrp><ntig><termGrp><term id="685431">VR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2641510">EB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14994_397171_427724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that uses a single server and built-in technology to create and maintain a copy of a storage group on a second set of disks that are connected to the same server as the primary storage group. LCR provides asynchronous log shipping, log replay, and a quick manual switch to a copy of the data.</descrip></descripGrp><ntig><termGrp><term id="397171">local continuous replication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427724">erreplikatze jarraitu lokal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14994_741948_427724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replication that uses a single server and built-in technology to create and maintain a copy of a storage group on a second set of disks that are connected to the same server as the primary storage group. LCR provides asynchronous log shipping, log replay, and a quick manual switch to a copy of the data.</descrip></descripGrp><ntig><termGrp><term id="741948">LCR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427724">erreplikatze jarraitu lokal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_397227_427636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hidden section of an email message. From the time a message is first created, information about it is added to the message header, including technical details, such as who created the message and the software used to compose it.</descrip></descripGrp><ntig><termGrp><term id="397227">P2 header</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427636">P2 goiburu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14999_397227_439730"><langSet xml:lang="en-US"><descripGrp><descrip type=