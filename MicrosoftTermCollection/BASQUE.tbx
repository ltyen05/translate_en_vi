="35608_2042671_2048463"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables IT administrators to move Personal Folders files (.pst) to a mailbox in Office 365. A .pst file is a data file that stores your messages and other items on your computer.</descrip></descripGrp><ntig><termGrp><term id="2042671">PST import</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2048463">PST inportatze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35609_2106333_2106997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for nonprofit organizations that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Online.</descrip></descripGrp><ntig><termGrp><term id="2106333">Office 365 Nonprofit E1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2106997">Office 365 Nonprofit E1</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35610_2106334_2106998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office 365 subscription for nonprofit organizations ​that is the best plan for nonprofit organizations that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Online.