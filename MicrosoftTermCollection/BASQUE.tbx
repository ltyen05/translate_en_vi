phicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="82_6483_2998699"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The magnitude of a number, irrespective of its sign (+ or -). An absolute value is always greater than or equal to zero. For example, 10 is the absolute value of 10 and of -10. Programming languages and spreadsheet programs commonly include functions that return the absolute value of a number.</descrip></descripGrp><ntig><termGrp><term id="6483">absolute value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2998699">balio absolutu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8200_41830_439447"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar that you create for your application.</descrip></descripGrp><ntig><termGrp><term id="41830">custom toolbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439447">tresna-barra pertsonalizatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8206_346965_441039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Strength exerted; might.</descrip></descripGrp><ntig><termGrp><term id="346965">power</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="441039">indar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="821_39300_439429"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Management of a computer and its processing abilities so as to maintain order as tasks and activities are carried out. Control applies to measures designed to ensure error-free actions carried out at the right time and in the right order relative to other data-handling or hardware-based activities.</descrip></descripGrp><ntig><termGrp><term id="39300">control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439429">kontrol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8218_231957_440371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PivotTable report that supplies the source data to the PivotChart report. It is created automatically when you create a new PivotChart report. When you change the layout of either report, the other also changes.</descrip></descripGrp><ntig><termGrp><term id="231957">associated PivotTable report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440371">PivotTable lotutako txosten</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8221_142727_2094195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replica in which changes are fully tracked and can be exchanged with any global replica in the set. A global replica can also exchange changes with any local or anonymous replicas for which it becomes the hub.</descrip></descripGrp><ntig><termGrp><term id="142727">global replica</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2094195">erreplika orokor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="823_144037_440121"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of buttons representing hyperlinks to pages both within a Web site and to external sites.</descrip></descripGrp><ntig><termGrp><term id="144037">link bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440121">esteka-barra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="824_129372_440000"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Of or pertaining to a device or service that appears to the user as something it actually is not or that does not physically exist.</descrip></descripGrp><ntig><termGrp><term id="129372">virtual</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440000">birtual</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8245_334528_440988"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a check to a check box to specify a desired feature or option.</descrip></descripGrp><ntig><termGrp><term id="334528">select</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440988">hautatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8250_211554_1227648"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device that is added to the base computer system to increase functionality, such as audio, networking, graphics, or SCSI controller.</descrip></descripGrp><ntig><termGrp><term id="211554">add-on device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1227648">gehigarri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8250_