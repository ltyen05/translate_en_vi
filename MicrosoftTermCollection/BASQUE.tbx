/langSet></termEntry><termEntry id="54814_3114837_3115344"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides an automated installation and deployment of a defined set of third-party Teams apps.</descrip></descripGrp><ntig><termGrp><term id="3114837">Auto install approved apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3115344">Onartutako aplikazioen instalatze automatikoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54815_3114838_3115347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to utilize Python libraries to quickly clean up data, explore the relationships within the data, and use sophisticated AI-powered libraries to analyze the data and make predictions.</descrip></descripGrp><ntig><termGrp><term id="3114838">Python in Excel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3115347">Python Excel-en</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5483_88655_439789"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number whose form indicates position in an ordered sequence of items, such as first, third, or twentieth.</descrip></descripGrp><ntig><termGrp><term id="88655">ordinal number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439789">zenbaki ordinal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54832_3115260_3122469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 Copilot capability that delivers relevant, actionable responses to prompts.</descrip></descripGrp><ntig><termGrp><term id="3115260">Semantic Index for Copilot</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3122469">Copilot-en aurkibide semantikoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54833_3115363_3118258"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software extension that augments the capabilities of AI systems, enabling them to interact with APIs from other software and services to retrieve real-time information, incorporate company and other business data, and perform new types of computations.</descrip></descripGrp><ntig><termGrp><term id="3115363">plugin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3118258">plugin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54856_3115477_3115841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method that defines the parameters you want to use to allocate your data, including the sources, destinations, and the parameter you want to use to determine how to distribute your data. You define how much of your emissions go from where, to where.</descrip></descripGrp><ntig><termGrp><term id="3115477">allocation method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3115841">esleipen-metodo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54857_3115478_3115842"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Sustainability Manager that lets you define how to allocate your emissions using your allocation method details.</descrip></descripGrp><ntig><termGrp><term id="3115478">allocation profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3115842">esleipen-profil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54858_3115479_3115843"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emission coming from a natural source, e.g. as a result of a degradation process.</descrip></descripGrp><ntig><termGrp><term id="3115479">biogenic emission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3115843">isuri biogeniko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54859_3115480_3115845"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user-defined extended attribute that does not directly contain emission information, such as mobile combustion. Organizations can track and correlate custom dimensions to emissions impacts.</descrip></descripGrp><ntig><termGrp><term id="3115480">custom dimension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3115845">dimentsio pertsonalizatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54861_3115482_3115847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of emissions created from the waste disposal and treatment of products sold by the reporting company at the end of their life. This category includes the total expected end-of-life emissions from all products sold in the reporting year.</descrip></descripGrp><ntig><termGrp><term id="3115482">End-of-life treatment of sold products</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3115847">Saldutako produktuen bizitzaren amaierako tratamendu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54862_3115483_3115848"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that converts one type of known transaction data into an approximate calculated value when actual usage information isn't available.</descrip></descripGrp><ntig><termGrp><term id="3115483">estimation factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3115848">estimazio-faktore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54863_3115484_3115849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A base-level location to attribute activity data. May contain multiple buildings and organizational units.</descrip></descripGrp><ntig><termGrp><term id="3115484">facility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3115849">instalazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54865_3115486_3115851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Manufactured compounds that contain carbon and fluorine atoms.</descrip></descripGrp><ntig><termGrp><term id="3115486">perfluorocarbons</term><termNote type="partOfSpeech">Noun</termNote><termNot