">Storyline</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2153042">Gidoia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37480_2139120_2152992"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of different visualization patterns and interactions for content shown in Sway.</descrip></descripGrp><ntig><termGrp><term id="2139120">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2152992">txantiloi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37481_2139121_2152990"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that allows the user to select one or more pieces or types of content and change what is selected into a heading.</descrip></descripGrp><ntig><termGrp><term id="2139121">Header</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2152990">Goiburua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37482_2139122_2153035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway card that shows individual pieces of content sequentially, allowing forward and backward navigation one piece of content at a time.</descrip></descripGrp><ntig><termGrp><term id="2139122">Slideshow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2153035">Diapositiba-aurkezpena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37483_2139123_2153039"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway group card that shows individual pieces of content sequentially, as a skeuomorphic stack.</descrip></descripGrp><ntig><termGrp><term id="2139123">Stack</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2153039">Erakustokia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37484_2139125_2152967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button in Sway that allows for the addition of Headers, Text and Media from the Web or local device, and Layout options at the indicated location.</descrip></descripGrp><ntig><termGrp><term id="2139125">Add content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2152967">Gehitu edukia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37485_2139126_2152991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway option button under “Add Content” that allows users to select an office document and import it into Sway.</descrip></descripGrp><ntig><termGrp><term id="2139126">Import Document</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2152991">Inportatu dokumentua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37486_2139127_2153044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu option in Sway under the “Add Content” button that analyzes the user’s Sway to suggest useful content that can be browsed or added as desired.</descrip></descripGrp><ntig><termGrp><term id="2139127">Suggested Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2153044">Iradokitako edukia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3749_380753_1278761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A holding container for work items. Members of a queue must be of the same work item class (for example, only incidents).</descrip></descripGrp><ntig><termGrp><term id="380753">queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1278761">ilara</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37525_2139445_2153045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu option in Sway under the “Add Content” button that allows users to upload images, Word documents, or PowerPoint presentations from their computer or mobile device into their Sway.</descrip></descripGrp><ntig><termGrp><term id="2139445">Upload Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2153045">Kargatu edukia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37527_2139460_2153017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway button that allows users to share a sway with other Sway users via social media or Docs.com, add additional authors to a sway, or generate the HTML embed code for a sway.</descrip></descripGrp><ntig><termGrp><term id="2139460">Share</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2153017">Partekatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech"