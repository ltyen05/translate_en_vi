ermGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2226307">iPhone-rako Skype® for Business</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38335_2220279_2226295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Skype for Business 2015 that runs on iPhone.</descrip></descripGrp><ntig><termGrp><term id="2220279">Skype® for Business for iPhone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2226295">iPhone-rako Skype for Business</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38335_2220279_2226307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version of Skype for Business 2015 that runs on iPhone.</descrip></descripGrp><ntig><termGrp><term id="2220279">Skype® for Business for iPhone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2226307">iPhone-rako Skype® for Business</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38336_2781061_2783263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A cloud communications service that connects people. Skype for Business Online provides intuitive communications capabilities across presence, instant messaging, audio/video calling, and an online meeting experience that includes audio, video, and web conferencing.</descrip></descripGrp><ntig><termGrp><term id="2781061">Skype for Business on the web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2783263">Sareko Skype for Business</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38337_2219973_2226297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Skype for Business web app that allows users, even those without a Skype account, to join Skype meeting from their wed browser.</descrip></descripGrp><ntig><termGrp><term id="2219973">Skype for Business Web App</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2226297">Skype for Business Web App</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38338_2219974_2226298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A plug-in required for audio, video, and screen sharing during a Skype for Business Meeting</descrip></descripGrp><ntig><termGrp><term id="2219974">Skype for Business Web App Plug-in</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2226298">Skype for Business Web App plugin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38339_2219975_2226299"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional feature of Skype for Business Online that enables users to make calls to, and receive calls from, the traditional network by using Skype for Business This feature is available to Voice Plan customers only, and administrators must sign in with a Skype-to-phone provider to get the feature.</descrip></descripGrp><ntig><termGrp><term id="2219975">Skype-to-phone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2226299">Skype-tik telefonora</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38344_2220379_2745545"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The software development process based on the classical spiral model to reduce the number of security-related design and coding defects and the severity of any defects that are left, thus reducing software maintenance costs while increasing reliability of software.</descrip></descripGrp><ntig><termGrp><term id="2220379">SDL</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2745545">Microsoft-en segurtasun-garapenaren bizi-ziklo</term><termNote type="geogra