item that records a possible event with an undesirable outcome.</descrip></descripGrp><ntig><termGrp><term id="252099">risk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2424191">arrisku-gertera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15161_234965_1277469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A span of time during which the financial activities of an organization are calculated. A fiscal year is divided into fiscal periods, typically defined as semesters, quarters, or months. The organization determines the dates that begin and end its fiscal year, which may not correspond to a traditional calendar year.</descrip></descripGrp><ntig><termGrp><term id="234965">fiscal year</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1277469">urte fiskal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15171_460668_1339448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report in the Microsoft Dynamics CRM user interface that provides a table showing each competitor, the number of open opportunities and closed opportunities against each competitor, and the percentage and ratio of won and lost opportunities.</descrip></descripGrp><ntig><termGrp><term id="460668">Competitor Win Loss</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1339448">Lehiakide bakoitzeko irabaziak eta galduak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15172_30240_2094113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that corresponds to an open dynamic data exchange (DDE) channel.</descrip></descripGrp><ntig><termGrp><term id="30240">channel number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2094113">kanalaren zenbaki</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15173_233319_1674119"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An estimate of sales revenue that typically spans a specific period such as a month, quarter of a year, one half of a year, or a full year.</descrip></descripGrp><ntig><termGrp><term id="233319">sales forecast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1674119">salmenta-iragarpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15181_84318_2180131"><langSet xml:lang="en-US"><descripGrp><descrip type="definitio