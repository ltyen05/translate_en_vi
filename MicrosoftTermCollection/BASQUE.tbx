ry id="38885_2259637_2261912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user role within Windows Store for Business that allows the user to acquire apps from Windows Store for Business on behalf of his company.</descrip></descripGrp><ntig><termGrp><term id="2259637">purchaser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2261912">eroslea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38886_2259638_2261929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view of a set of photos that displays them one at a time, sequentially.</descrip></descripGrp><ntig><termGrp><term id="2259638">slideshow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2261929">diapositiba-aurkezpena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38887_2259809_2261898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section in the Settings app for Windows 10 desktop, containing network and Internet settings.</descrip></descripGrp><ntig><termGrp><term id="2259809">Network &amp; Internet</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2261898">Sarea eta Internet</term><termNote type="geographicalUsage">ESP</ter