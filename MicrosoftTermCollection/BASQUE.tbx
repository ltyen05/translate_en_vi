ote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34432_1991542_2917959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Settings that allow parents/guardians to manage the content allowed on the console.</descrip></descripGrp><ntig><termGrp><term id="1991542">family settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2917959">guraso-kontrol</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34433_1991543_2917397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The height, weight, year of birth, and gender that a user chooses to enter as their personal physical characteristics for fitness tracking.</descrip></descripGrp><ntig><termGrp><term id="1991543">attributes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2917397">atributuak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34434_1991544_2917947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Estimates of the results of your physical activity, including calories burned, time spent playing, and physical intensity of movements.</descrip></descripGrp><ntig><termGrp><term id="1991544">exercise stats</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2917947">ariketa fisikoaren estatistikak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34435_1991545_2917985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of game that supports the monitoring and recording of exercise stats from a fitness tracking device worn by a player.</descrip></descripGrp><ntig><termGrp><term id="1991545">fitness tracking game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2917985">ariketa fisikoaren jarraipena egiteko joko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34436_1991546_2917983"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of device worn during exercise that estimates your exercise stats based on your level of physical activity.</descrip></descripGrp><ntig><termGrp><term id="1991546">fitness tracking device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2917983">ariketa fisikoaren jarraipena egiteko gailu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34437_1991547_2920526"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal notice that describes the properties of the system.</descrip></descripGrp><ntig><termGrp><term id="1991547">system information</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2920526">sistemaren informazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34438_1991548_2224956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal notice that establishes the terms under which service is provided.</descrip></descripGrp><ntig><termGrp><term id="1991548">terms of use</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2224956">erabiltzeko baldintzak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34439_1991549_2920491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display when unable to establish a connection to a required non-Xbox Live server or web service.</descrip></descripGrp><ntig><termGrp><term id="1991549">Sorry, [video service name/web service name] isn't available right now. Please try again later. For more information, go to www.xbox.com/status.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2920491">[video service name/web service name] ez dago erabilgarri une honetan. Saiatu berriro geroago. Informazio gehiago lortzeko, joan www.xbox.com/status helbidera.</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3444_14266_1227598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move selected items to another location for long term storage.</descrip></descripGrp><ntig><termGrp><term id="14266">archive</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1227598">artxibatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34440_1991550_2920629"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display when Xbox privacy and online settings prevent the sharing of video status.</descrip></descripGrp><ntig><termGrp><term id="1991550">The Video and Music Status setting for [gamertag1, gamertag2, gamertag3, gamertags4] is set to allow apps to show titles of videos you watch in your Xbox Live online status.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2920629">Aplikazioek Xbox Live-ren lineako egoeran ikusitako bideoen izenburuak erakusteko onartzeko ezarrita dago [gamertag1, gamertag2, gamertag3, gamertag4] etiketako Bideo- eta Musika-egoeraren ezarpena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34441_1991551_2917392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that applications must display if they will serve third-party advertising and cannot contractually guarantee that they will meet the Xbox Creative Acceptance Policy (CAP) for advertising content. The need for this disclaimer will be determined contractually prior to certification, and the inability to comply should be indicated during application submission. Talk to your Developer Account Manager for additional details.</descrip></descripGrp><ntig><termGrp><term id="1991551">All content in this Application, including advertising content, is provided by [video service name].</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2917392">Aplikazio honetako eduki guztia, publizitate-edukia barne, [video service name] zerbitzuak ematen du.</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34442_1991552_2920625"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message that game titles must display when unable to establish a connection to a required non-Xbox Live server or web service. This message also applies to Xbox games on Windows Phone.</descrip></descripGrp><ntig><termGrp><term id="1991552">The [game name] service is not available. Please try again later.</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2920625">[game name] zerbitzua ez dago erabilgarri. Saiatu berriro geroago.</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34443_1991553_2921846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991553">leaderboards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2921846">sailkapenak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34444_1991554_2921841"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991554">achievements</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2921841">lorpenak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34445_1991555_2918063"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Xbox Live Arcade menu item.</descrip></descripGrp><ntig><termGrp><term id="1991555">help &amp; options</