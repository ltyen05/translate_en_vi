ech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35614_2043468_2064492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An out-of-the-box attribute that can be exported, translated into a specified language, and then imported back into CRM.</descrip></descripGrp><ntig><termGrp><term id="2043468">localizable field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2064492">eremu lokalizagarri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35616_2043469_2064501"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Status shown for a task that is assigned in Outlook and tracked in CRM, where the task assignment is declined, and the assigner of the task reassigns the task back to himself or herself.</descrip></descripGrp><ntig><termGrp><term id="2043469">Reclaimed</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2064501">Berreskuratu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35617_2043470_2064487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In telecommunications, a callback occurs when the originator of a call is immediately called back in a second call as a response.