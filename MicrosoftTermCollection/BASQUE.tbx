 products.</descrip></descripGrp><ntig><termGrp><term id="2405922">shared tool</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2408632">tresna partekatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42451_2405928_2408630"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway menu option that makes a sway visible to anyone who has a link to it and who belongs to the same organization as the sway's author.</descrip></descripGrp><ntig><termGrp><term id="2405928">Share with only my organization</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2408630">Partekatu nire erakundearekin bakarrik</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42452_2405929_2408626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sway Customize control that allows users to select whether their headings receive a bold treatment or a subtle treatment.</descrip></descripGrp><ntig><termGrp><term id="2405929">Heading emphasis</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2408626">Tituluaren nabarmentzea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><ter