rmGrp></ntig></langSet></termEntry><termEntry id="39881_2320112_2323880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode in which the UI on the screen slides downward so that the user can reach items that normally would be near the top of the screen with one hand.</descrip></descripGrp><ntig><termGrp><term id="2320112">one-handed use</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2323880">esku bakarreko erabilera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39882_2320437_2323367"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app for purchasing cellular data that is packaged with cellular enabled Dell devices that include a Microsoft SIM card.</descrip></descripGrp><ntig><termGrp><term id="2320437">Dell NetReady</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2323367">Dell NetReady</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39886_2321004_2349362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrative interface for Microsoft® Forefront Identity Manager (FIM) 2010 R2. This interface is used for monitoring status, history, and errors associated with synchronization events and may be also used to evaluate identity objects in the connector space (metaverse).</descrip></descripGrp><ntig><termG