un</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439605">marratxo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15886_63086_439605"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ‐ character, used to break a word between syllables at the end of a line or to separate the parts of a compound word.</descrip></descripGrp><ntig><termGrp><term id="63086">hyphen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439605">marratxo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15888_62684_3041472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color model used in some graphics programs to define a color by three values: Hue, the color itself; Saturation, the purity of the color; and Value, the lightness or darkness of a color.</descrip></descripGrp><ntig><termGrp><term id="62684">HSV</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3041472">HSV</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15888_757192_3041472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color model used in some graphics programs to define a color by three values: Hue, the color itself; Saturation, the purity of the color; and Value, the lightness or darkness of a color.</descrip></descripGrp><ntig><termGrp><term id="757192">hue-saturation-value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3041472">HSV</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15904_138795_440070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of colors in which each color gradually blends into the next one. For example, a blue ramp gradually blends hues of blue from pure black to pure blue.</descrip></descripGrp><ntig><termGrp><term id="138795">color ramp</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440070">kolore-arrapala</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15906_186205_1140070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that must be enabled in Active Directory to run incremental import of profiles.</descrip></descripGrp><ntig><termGrp><term id="186205">Server Side Incremental</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="