m id="3149025">pivot table</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3149547">taula dinamikoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55977_3149113_3149548"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who speaks at a meeting or online event.</descrip></descripGrp><ntig><termGrp><term id="3149113">speaker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3149548">hizlaria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55980_3149769_3150297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Sexually explicit images or videos that are distributed without the consent of the individuals depicted.</descrip></descripGrp><ntig><termGrp><term id="3149769">non-consensual intimate imagery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150297">adostasunik gabeko iruditeria intimoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55981_3149770_3150293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A review process performed by a human, as opposed to automated or AI-driven review.</descrip></descripGrp><ntig><termGrp><term id="3149770">human review</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150293">giza-berrikuspena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55982_3149771_3150302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the context of user interface design, a rectangular component that can have any border-radius from 0px to 100%.</descrip></descripGrp><ntig><termGrp><term id="3149771">pill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150302">kapsula</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55983_3150428_3150653"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ability of an AI-powered system to link together a series of actions or procedures based on changing inputs or conditions. This means the system can adapt its behavior or decision-making process in real-time based on the current context or situation.</descrip></descripGrp><ntig><termGrp><term id="3150428">dynamic chaining</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150653">kateamendu dinamiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55984_3150429_3150654"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An ability of an AI-powered chatbot to understand and remember the context of a conversation and use it to fill in missing information in the current user request.</descrip></descripGrp><ntig><termGrp><term id="3150429">dynamic slot filling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150654">hutsuneen betetze dinamiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55985_3150430_3150655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that can be used for AI-powered bots to create a new topic or edit an existing one by describing what a user wants to happen or have their bot generate conversational responses even if there isn't a matching topic.</descrip></descripGrp><ntig><termGrp><term id="3150430">intelligent authoring</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150655">egiletza adimendun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55986_3150431_3150656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered technology that relies on an ability to understand what a user says. The NLU engine creates a language model from sets of training examples. Once trained, the engine uses the model to predict the intent of an utterance.</descrip></descripGrp><ntig><termGrp><term id="3150431">natural language understanding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150656">hizkuntza naturalaren ulermen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55986_3150431_3150657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered technology that relies on an ability to understand what a user says. The NLU engine creates a language model from sets of training examples. Once trained, the engine uses the model to predict the intent of an utterance.</descrip></descripGrp><ntig><termGrp><term id="3150431">natural language understanding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150657">NLU</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55986_3150452_3150656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered technology that relies on an ability to understand what a user says. The NLU engine creates a language model from sets of training examples. Once trained, the engine uses the model to predict the intent of an utterance.</descrip></descripGrp><ntig><termGrp><term id="3150452">NLU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150656">hizkuntza naturalaren ulermen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55986_3150452_3150657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered technology that relies on an ability to understand what a user says. The NLU engine creates a language model from sets of training examples. Once trained, the engine uses the model to predict the intent of an utterance.</descrip></descripGrp><ntig><termGrp><term id="3150452">NLU</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150657">NLU</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55987_3150432_3150658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action that can be called from a topic, connector, flow, or skill. It extends the capabilities of your bot by using AI to ask your users questions to fill in missing information and can dynamically generate information for your users.</descrip></descripGrp><ntig><termGrp><term id="3150432">plugin action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150658">plugin-ekintza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55988_3150433_3150659"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common topic used in conversations with a bot. System topics are built into Microsoft Copilot Studio and are added to a bot automatically when a user creates it. They help the bot respond to common system events, such as escalation, or carry out essential behavior, such as ending a conversation.</descrip></descripGrp><ntig><termGrp><term id="3150433">system topic</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150659">sistemaren gai</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55989_3150434_3150660"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Power Pages feature that allows makers to embed advanced sequential multistep forms to a webpage without code. Also, makers will be able to preview each step of the form in the design studio canvas.</descrip></descripGrp><ntig><termGrp><term id="3150434">multistep form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150660">urrats anitzeko inprimaki</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55990_3150435_3150661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A self-service diagnostic tool that can be used by administrators to identify common issues in their website. It helps to identify issues with a website by looking at various configuration parameters and provides suggestions on how to fix them.</descrip></descripGrp><ntig><termGrp><term id="3150435">site checker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150661">gune-egiaztatzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55991_3150436_3150662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that can be set up to create targeted app experiences for agents and supervisors, being an alternative to building and maintaining custom apps. With the agent experience profiles, administrators can create custom profiles with specific session templates, conversation channels, and productivity tools. These profiles can then be assigned to users.</descrip></descripGrp><ntig><termGrp><term id="3150436">agent experience profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150662">agentearen esperientziaren profil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55992_3150437_3150663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A script that provides guidance about what an agent should do when they get a customer issue and ensure that they share only accurate and company-endorsed information. Agent scripts help agents be accurate, effective, and efficient in customer handling.</descrip></descripGrp><ntig><termGrp><term id="3150437">agent script</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150663">agenteentzako gidoi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55993_3150438_3150664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Dynamics 365 Customer Service feature that allows agents to easily recap an ongoing customer interaction. Agents can generate a conversation summary when they either transfer a conversation, add a user to consult, or start a linked Teams chat. The summary quickly provides context and relays any steps they've already taken.</descrip></descripGrp><ntig><termGrp><term id="3150438">auto-summarization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150664">laburpen automatiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55994_3150439_3150665"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that can be created in Dynamics 365 Customer Service and assigned to agents to define the types and amount of work they can take. Capacity profiles contain information, such as the amount of work, concurrent or daily capacity, and whether other channels are affected.</descrip></descripGrp><ntig><termGrp><term id="3150439">capacity profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150665">ahalmen-profil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55995_3150440_3150666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that can be configured in Dynamics 365 Customer Service to help supervisors plan the right level of staffing for their business based on predicted volumes of cases to ensure that they have an adequate number of agents available to serve their customers.</descrip></descripGrp><ntig><termGrp><term id="3150440">case forecasting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150666">kasu-iragarpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55996_3150441_3150667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability provided to organizations for using the customer communication functions running on the cloud.</descrip></descripGrp><ntig><termGrp><term id="3150441">CCaaS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150667">CCaaS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55997_3150442_3150668"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A live chat widget that can be displayed on an organization's portal for customers to interact with bots and human agents.</descrip></descripGrp><ntig><termGrp><term id="3150442">chat widget</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150668">berriketa-widget</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55998_3150443_3150669"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A line-of-business application or component whose user interface is hosted in the shell application.</descrip></descripGrp><ntig><termGrp><term id="3150443">hosted application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150669">ostatatutako aplikazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="55999_3150444_3150670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A functionality that helps ingest data from third party sources into Dynamics 365 Customer Service. This gives the ability to identify the most relevant and contextual content across knowledge sources which helps agents find the most suitable solution for customers easily.</descrip></descripGrp><ntig><termGrp><term id="3150444">integrated search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150670">bilaketa integratu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56000_3150445_3150671"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intelligent assistant that provides real-time recommendations to agents, helping them take actions while interacting with customers. It allows organizations to build a custom bot and plug-in to their environment. These custom bots interpret conversations in real time and provide relevant recommendations such as knowledge articles, similar cases, and next-best steps to the agent's user interface.</descrip></descripGrp><ntig><termGrp><term id="3150445">smart assist</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150671">laguntza adimendun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56001_3150446_3150672"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Customer Service feature that provides agents with the ability to receive and make public switched telephone network (PSTN) calls through a native calling experience in Dynamics 365.</descrip></descripGrp><ntig><termGrp><term id="3150446">Omnichannel Voice</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3150672">Orotarako kanalaren ahots-kanal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56002_3150644_3152147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams offering available to customers in the EEA and Switzerland that provides meetings, chat, calling (VOIP), and collaboration without any limitation on seat numbers.</descrip></descripGrp><ntig><termGrp><term id="3150644">Microsoft Teams EEA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3152147">Teams EEE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56002_3150644_3152148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams offering available to customers in the EEA and Switzerland that provides meetings, chat, calling (VOIP), and collaboration without any limitation on seat numbers.</descrip></descripGrp><ntig><termGrp><term id="3150644">Microsoft Teams EEA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3152148">Microsoft Teams EEE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56002_3150645_3152147"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams offering available to customers in the EEA and Switzerland that provides meetings, chat, calling (VOIP), and collaboration without any limitation on seat numbers.</descrip></descripGrp><ntig><termGrp><term id="3150645">Teams EEA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3152147">Teams EEE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56002_3150645_3152148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Teams offering available to customers in the EEA and Switzerland that provides meetings, chat, calling (VOIP), and collaboration without any limitation on seat numbers.</descrip></descripGrp><ntig><termGrp><term id="3150645">Teams EEA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3152148">Microsoft Teams EEE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56003_3150646_3152144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To plan the details of something in advance.</descrip></descripGrp><ntig><termGrp><term id="3150646">blueprint</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3152144">planifikatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56004_3151343_3152145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to blur the background of an image to bring crisp focus to the most important part of the image.</descrip></descripGrp><ntig><termGrp><term id="3151343">blur background</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3152145">atzealdearen desfokuratzea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56005_3151344_3152146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instruction or question you use to tell Copilot what you want.</descrip></descripGrp><ntig><termGrp><term id="3151344">Copilot prompt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3152146">Copilot-en gonbita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56006_3151345_3155893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collaboration feature that allows users to search and discover people across multiple tenants.</descrip></descripGrp><ntig><termGrp><term id="3151345">people search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3155893">pertsonen bilaketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56007_3151346_3155892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Entra ID and Microsoft 365 that enables users to form a tenant group within an organization.</descrip></descripGrp><ntig><termGrp><term id="3151346">multitenant organization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3155892">maizter anitzeko organizazioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56008_3151380_3151491"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collaboration space that can be created in Microsoft Teams to connect people from your organization and customers related to your project together in a team that includes the apps and channels you need to make progress faster.</descrip></descripGrp><ntig><termGrp><term id="3151380">deal room</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3151491">tratu-gela</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56009_3151381_3151492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control in model-driven apps that allows users to view, open, and edit records from views and subgrids. In addition to inline editing, the control provides other capabilities including a modern data browsing experience via infinite scrolling, allowing users to scroll indefinitely through data until they find the records they're interested in, and an ability to customize the visual appearance of columns for specific needs.</descrip></descripGrp><ntig><termGrp><term id="3151381">grid control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3151492">sareta-kontrola</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56010_3151382_3151493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A score that shows the overall health and trend of each of your business relationships. It is calculated by collecting the relevant activities, and weighting the activity by type. The result is normalized to produce a health score between 0 and 100, and the health characterized as good (for a score of 60-100), fair (40-59) or poor (0-39).</descrip></descripGrp><ntig><termGrp><term id="3151382">health score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3151493">egoera-puntuazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56011_3151383_3151494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prompt that a user can use to catch up on the updates to their lead records since the last seven days or the last login. The catch up information is generated from the audit history.</descrip></descripGrp><ntig><termGrp><term id="3151383">lead catchup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3151494">bezerogaien azken eguneratzeak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56012_3151384_3151495"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-powered summary that allows sellers to access a quick overview of leads from various sources. This feature saves time and effort and ensures that sales teams focus on the most promising leads, leading to increased seller productivity and efficiency.</descrip></descripGrp><ntig><termGrp><term id="3151384">lead summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3151495">bezerogaien laburpena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56013_3151385_3151496"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prompt that a user can use to catch up on the updates to their opportunity records since the last seven days or the last login. The catch up information is generated from the audit history.</descrip></descripGrp><ntig><termGrp><term id="3151385">opportunity catchup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3151496">abaguneen azken eguneratzeak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56014_3151386_3151497"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A summary of each opportunity generated by Sales Copilot with key information like sales stage, budget, and close date. This helps you interact better with customers and boost sales and customer satisfaction.</descrip></descripGrp><ntig><termGrp><term id="3151386">opportunity summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3151497">abagunearen laburpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56027_3152018_3153088"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The 2024 public preview version of Microsoft Office Professional Plus that utilizes the LTSC servicing model.</descrip></descripGrp><ntig><termGrp><term id="3152018">Microsof