m id="1516651">CryptoAPI 2.0</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635856">CAPI2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30510_1516651_1635858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that supports PKI and X.509 certificates, such as certificate chain validation, certificate stores, and signature verification.</descrip></descripGrp><ntig><termGrp><term id="1516651">CryptoAPI 2.0</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635858">CryptoAPI 2.0</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30510_1516652_1635856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that supports PKI and X.509 certificates, such as certificate chain validation, certificate stores, and signature verification.</descrip></descripGrp><ntig><termGrp><term id="1516652">CAPI2</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635856">CAPI2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30510_1516652_1635858"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that supports PKI and X.509 certificates, such as certificate chain validation, certificate stores, and signature verification.</descrip></descripGrp><ntig><termGrp><term id="1516652">CAPI2</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635858">CryptoAPI 2.0</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30512_1516655_1635857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension that indicates where the certificate revocation list for a CA can be retrieved. It can contain none, one, or many HTTP, file, or LDAP URLs.</descrip></descripGrp><ntig><termGrp><term id="1516655">certificate revocation list distribution point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635857">CDP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30512_1516655_1635860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension that indicates where the certificate revocation list for a CA can be retrieved. It can contain none, one, or many HTTP, file, or LDAP URLs.</descrip></descripGrp><ntig><termGrp><term id="1516655">certificate revocation list distribution point</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635860">ziurtagirien errebokazio-zerrendaren banaketa-puntu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30512_1516656_1635857"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension that indicates where the certificate revocation list for a CA can be retrieved. It can contain none, one, or many HTTP, file, or LDAP URLs.</descrip></descripGrp><ntig><termGrp><term id="1516656">CDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635857">CDP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30512_1516656_1635860"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension that indicates where the certificate revocation list for a CA can be retrieved. It can contain none, one, or many HTTP, file, or LDAP URLs.</descrip></descripGrp><ntig><termGrp><term id="1516656">CDP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635860">ziurtagirien errebokazio-zerrendaren banaketa-puntu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516657_1635861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516657">issuing certification authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635861">CA jaulkitzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516657_1635863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516657">issuing certification authority</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635863">autoritate ziurtagiri-emaile jaulkitzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516658_1635861"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516658">issuing CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635861">CA jaulkitzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30513_1516658_1635863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a public key infrastructure hierarchy, the certification authority that that issues certificates to users and computers.</descrip></descripGrp><ntig><termGrp><term id="1516658">issuing CA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635863">autoritate ziurtagiri-emaile jaulkitzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30517_1516667_1635885"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A configuration mode for the Certificate Enrollment Web Service in which it will only process renewal requests.</descrip></descripGrp><ntig><termGrp><term id="1516667">renewal only mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635885">berritzeko soilik modu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30520_1516672_1635561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hexadecimal string that contains the SHA-1 hash of the certificate.</descrip></descripGrp><ntig><termGrp><term id="1516672">thumbprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635561">hatz-marka digital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3053_253746_2749561"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A client that waits for and accepts relayed connections.</descrip></descripGrp><ntig><termGrp><term id="253746">listener</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2749561">hautemaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30553_1517506_1694003"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Server Manager and Event Viewer, the urgency of an event or error condition, system fault, failure, or action by either the system or the user. Severity can be any of four industry-standard values: Information, Warning, Error, or Critical. These values are defined in the Event Viewer Help.</descrip></descripGrp><ntig><termGrp><term id="1517506">severity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1694003">larritasun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3056_1738272_439140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that acts as a source of information or signals. The host computer provides services, such as news, mail, or data, to computers that connect to it. The term can refer to almost any kind of computer, from a centralized mainframe that is a host to its terminals, to a server that is host to its clients, to a desktop PC that is host to its devices, such as printers and scanners.</descrip></descripGrp><ntig><termGrp><term id="1738272">host computer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439140">Ostalari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3056_1770_439140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that acts as a source of information or signals. The host computer provides services, such as news, mail, or data, to computers that connect to it. The term can refer to almost any kind of computer, from a centralized mainframe that is a host to its terminals, to a server that is host to its clients, to a desktop PC that is host to its devices, such as printers and scanners.</descrip></descripGrp><ntig><termGrp><term id="1770">host</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439140">Ostalari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3058_71776_439656"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pointing device used mainly but not exclusively for computer games. A joystick has a base, on which control buttons can be mounted, and a vertical stem, which the user can move in any direction to control the movement of an object on the screen.</descrip></descripGrp><ntig><termGrp><term id="71776">joystick</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439656">kontrol-palanka</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30589_1517629_1635859"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process that builds one or more certificate paths. The certificate paths may or may not trace up to a self-signed or root certificate.</descrip></descripGrp><ntig><termGrp><term id="1517629">certificate chaining</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635859">ziurtagiri-kateamendu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517630_1635849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517630">Authority Key Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635849">AKI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517630_1635851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517630">Authority Key Identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635851">autoritatearen gako-identifikatzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517631_1635849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517631">AKI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635849">AKI</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30590_1517631_1635851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate extension used by the certificate chaining engine to determine what certificate was used to sign a presented certificate. The AKI can contain the issuer name, serial number, public key information, or no information at all. By matching the information in a certificate’s AKI extension to a CA certificate’s Subject Key Identifier (SKI) extension, a certificate chain can be built.</descrip></descripGrp><ntig><termGrp><term id="1517631">AKI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635851">autoritatearen gako-identifikatzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3060_87569_1168760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to one or more computers, connected to a network.</descrip></descripGrp><ntig><termGrp><term id="87569">online</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1168760">lineako</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3060_87569_439779"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to one or more computers, connected to a network.</descrip></descripGrp><ntig><termGrp><term id="87569">online</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439779">linean</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30603_1518183_2392392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that works in a cloud computing environment.</descrip></descripGrp><ntig><termGrp><term id="1518183">cloud service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2392392">hodeiko zerbitzu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30608_1518839_1537385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class, interface, or structure whose definition has placeholders, called generic type parameters, for one or more types that are used in its member definitions. A user specifies real types (generic type arguments) for the type parameters when creating an instance of a generic type.</descrip></descripGrp><ntig><termGrp><term id="1518839">generic type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1537385">generiko mota</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3065_142836_440113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that transforms a picture stored in one file format to another format so that it can be displayed in a specific graphics program.</descrip></descripGrp><ntig><termGrp><term id="142836">graphic filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440113">grafiko-iragazki</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3065_142837_440113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that transforms a picture stored in one file format to another format so that it can be displayed in a specific graphics program.</descrip></descripGrp><ntig><termGrp><term id="142837">graphics filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440113">grafiko-iragazki</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30650_1526398_1537386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Presentation Foundation and Silverlight, a technique by which a subset of UI elements are generated from a larger number of data items based on which items are visible on the screen. Virtualization is a performance enhancement, because it is intensive, both in terms of memory and processor, to generate a large number of UI elements when only a few may be on the screen at a given time.</descrip></descripGrp><ntig><termGrp><term id="1526398">virtualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1537386">birtualizazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="30650_1526398_1537387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Presentation Foundation and Silverlight, a technique by which a subset of UI elements are generated from a larger number of data items based on which items are visible on the screen. Virtualization is a performance enhancement, because it is intensive, both in terms of memory and processor, to generate a large number of UI elements when only a few may be on the screen at a given time.</descrip></descripGrp><ntig><termGrp><term id="1526398">virtualization</term><ter