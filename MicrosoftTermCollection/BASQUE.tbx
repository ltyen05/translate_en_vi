"en-US"><descripGrp><descrip type="definition">A task that has been sent to someone as a task request in an email message.</descrip></descripGrp><ntig><termGrp><term id="137523">assigned task</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440060">esleitutako ataza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5983_346955_441035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A place where one lives.</descrip></descripGrp><ntig><termGrp><term id="346955">home</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="441035">etxe</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6004_358356_362868"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of Microsoft Exchange features that offers increased access to documents even when the documents are located on an internal network or the software required to view the documents is not installed on the client computer.</descrip></descripGrp><ntig><termGrp><term id="358356">Enhanced Document Availability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="362868">Dokumentu Erabilgarritasun Hobetua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6015_397176_427666"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of temporary queues that hold messages that are being delivered to a Mailbox server by using encrypted Exchange RPC. Mailbox delivery queues exist on Hub Transport servers only. A different mailbox delivery queue exists for each Mailbox server destination. The destination Mailbox server must exist in the same Active Directory directory service site as the Hub Transport server. Mailbox delivery queues are dynamically created as needed and are automatically removed.</descrip></descripGrp><ntig><termGrp><term id="397176">mailbox delivery queue</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427666">postontziko entrega-ilara</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6017_186210_1137368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of pages with the .master extension that define shared page elements and content place holders.</descrip></descripGrp><ntig><termGrp><term id="186210">Master Page Gallery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1137368">Orrialde Maisuen Galeria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6031_475227_1333290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privilege level that specifies the user has access to objects anywhere within the organization. The application refers to this level as Organization.</descrip></descripGrp><ntig><termGrp><term id="475227">Global</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1333290">Orokorra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6032_178599_1331701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that sells similar products or services and competes for the same customer segment.</descrip></descripGrp><ntig><termGrp><term id="178599">competitor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1331701">lehiakide</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6033_319444_1227636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area within the Control Panel that provides accessibility options and settings to help users interact more easily with the computer.</descrip></descripGrp><ntig><termGrp><term id="319444">Ease of Access Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1227636">Erabilerraztasun-zentro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6036_211259_1227637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu item that opens the About dialog box, which includes the copyright, licensing, and license terms for the product.</descrip></descripGrp><ntig><termGrp><term id="211259">About</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1227637">Honi buruz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6040_139580_440080"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pair of values representing the x- and y-coordinates of a point that are stored in a two-dimensional array that can contain coordinates for many points.</descrip></descripGrp><ntig><termGrp><term id="139580">coordinate pair</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440080">koordenatu-pare</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6043_117185_2408635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A heading in a document, worksheet or other t