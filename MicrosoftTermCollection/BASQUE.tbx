p type="definition">A sequence of words or other text used to gain access to a network, program, or data. A passphrase is generally longer for added security.</descrip></descripGrp><ntig><termGrp><term id="1486351">pass phrase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440626">pasa-esaldi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13076_269325_440626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A sequence of words or other text used to gain access to a network, program, or data. A passphrase is generally longer for added security.</descrip></descripGrp><ntig><termGrp><term id="269325">passphrase</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440626">pasa-esaldi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13077_475237_1335608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pricing method that determines the unit price of the product as a percent of the price that was entered in the List Price field on the Product form.</descrip></descripGrp><ntig><termGrp><term id="475237">percent of list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1335608">zerrendaren ehuneko</term><termNote type="geographical