type="definition">A component-based document model for developers who create collaborative text editing apps that includes options for real-time sharing of edits within documents, shared editable templates, and rich content editing options.</descrip></descripGrp><ntig><termGrp><term id="2858231">Fluid Framework</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2866380">Microsoft Fluid Framework</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50498_2858264_2860276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of hours the person spent in meetings with at least one other person.</descrip></descripGrp><ntig><termGrp><term id="2858264">meeting hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2860276">bilera-orduak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50499_2858268_2860264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of hours the person spent sending and reading email.</descrip></descripGrp><ntig><termGrp><term id="2858268">email hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2860264">posta elektronikoa erabilitako orduak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50500_2858270_2860287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lack of opposition between work and other life roles. It is the state of equilibrium in which demands of personal life, professional life, and family life are equal.</descrip></descripGrp><ntig><termGrp><term id="2858270">work-life balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2860287">lan-bizitzaren eta bizitza pertsonalaren arteko oreka</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50501_2858273_2860280"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a manager, or to a meeting involving a manager, "skip-level" refers to the employee's manager's manager, sometimes referred to as "second line manager". A skip-level manager is the manager of the employee's manager. A skip-level meeting is a meeting between an employee and the manager of his or her manager.</descrip></descripGrp><ntig><termGrp><term id="2858273">skip-level</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2860280">hierarkian goragoko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50502_2858291_2860248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collective name for character images with multiple poses, emotions and props.</descrip></descripGrp><ntig><termGrp><term id="2858291">cutout people</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2860248">moztutako jendea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50505_2859316_2865912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that manages Microsoft Volume Licensing Fulfillment and Subscription orders.</descrip></descripGrp><ntig><termGrp><term id="2859316">MS License</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2865912">MS License</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50505_2859320_2865912"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The application that manages Microsoft Volume Licensing Fulfillment and Subscription orders.</descrip></descripGrp><ntig><termGrp><term id="2859320">Microsoft License</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2865912">MS License</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50507_2860396_2861446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function in Office apps for mobile phones that allows users to make content (text, buttons, etc.) larger.</descrip></descripGrp><ntig><termGrp><term id="2860396">large content viewer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2861446">edukia handiago ikusteko ikustaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50508_2860488_2861178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to import their financial transactions into Excel so they can view and organize their finances in one place and obtain personalized insights.</descrip></descripGrp><ntig><termGrp><term id="2860488">Money in Excel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2861178">Dirua Excel-en</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50509_2860564_2861175"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft marketing campaign to promote The Art of Teamwork [50467], a framework, toolkit, and digital curriculum to equip our customers with the tools to practice the five key dynamics to successful teamwork.</descrip></descripGrp><ntig><termGrp><term id="2860564">The Art of Teamwork Campaign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2861175">Talde-lanaren artea kanpaina</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50510_2860565_2861174"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Collaboration between members of a group organized around a common responsibility, interest, or objective.</descrip></descripGrp><ntig><termGrp><term id="2860565">teamwork</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2861174">talde-lana</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50512_2860581_2861177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to enter into situations that involve risk and emotional exposure.</descrip></descripGrp><ntig><termGrp><term id="2860581">vulnerability</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2861177">ahultasun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50513_2860582_2861176"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feeling that ensues from knowing you can be vulnerable with someone without being put down or hurt.</descrip></descripGrp><ntig><termGrp><term id="2860582">trust</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2861176">konfiantza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50515_2860603_2861438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Function in Office applications that allows users to select stock images.</descrip></descripGrp><ntig><termGrp><term id="2860603">content picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2861438">eduki-hautatzailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50516_2860604_2861440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of PowerPoint slides, often with supporting notes, that can be shared as a stand-alone document.</descrip></descripGrp><ntig><termGrp><term id="2860604">slide deck</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2861440">bilduma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOf