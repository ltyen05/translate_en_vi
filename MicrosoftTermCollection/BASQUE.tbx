u"><ntig><termGrp><term id="3188314">berritze automatikoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56573_3185762_3188315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that automatically renews subscription services before the term expiration date.</descrip></descripGrp><ntig><termGrp><term id="3185762">auto renewal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3188315">berritze automatikoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56585_3186046_3186201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Carbon that derives from biological sources like plants, animals and microorganisms.</descrip></descripGrp><ntig><termGrp><term id="3186046">biogenic carbon</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3186201">karbono biogeniko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56586_3186047_3186202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of measuring, tracking, and reporting the amount of carbon dioxide (CO2) and other greenhouse gases (GHGs) that an organization, project or activity emits or removes from the atmosphere.</descrip></descripGrp><ntig><termGrp><term id="3186047">carbon accounting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3186202">karbono-kontabilitate</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56587_3186048_3186203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fee that company charges itself for each unit of CO2 that it emits. It is market-based approach to drive environmental sustainability and promote a transition to a low-carbon economy.</descrip></descripGrp><ntig><termGrp><term id="3186048">carbon fee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3186203">karbono-tasa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56588_3186049_3186204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A guideline aimed at creating products, systems, and processes that minimize waste and make the most of resources by keeping materials in use for as long as possible.</descrip></descripGrp><ntig><termGrp><term id="3186049">circularity design principle</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3186204">zirkulartasun-diseinuaren printzipio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56589_3186050_3186205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The functionality that helps organizations unify and streamline energy data to achieve their energy sustainability goals. It helps to unify, standardize, and streamline energy data collection and storage for organizations across generation, procurement, and end use into a single unified data model.</descrip></descripGrp><ntig><termGrp><term id="3186050">energy data model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3186205">energiaren datu-eredua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56590_3186051_3186206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of related emission factors.</descrip></descripGrp><ntig><termGrp><term id="3186051">factor library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3186206">faktore-liburutegi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56591_3186052_3186207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The value that measures how much energy the emissions for one ton of a given gas absorb over a period of time, respective to the emissions of one ton of carbon dioxide (CO2).</descrip></descripGrp><ntig><termGrp><term id="3186052">GWP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3186207">GWP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56592_3186053_3186208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to evaluate the environmental impacts associated with all stages of a product's life, from raw material extraction through materials processing, manufacturing, distribution, use, repair and maintenance, and disposal or recycling.</descrip></descripGrp><ntig><termGrp><term id="3186053">LCA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3186208">LCA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56592_3186053_3186209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to evaluate the environmental impacts associated with all stages of a product's life, from raw material extraction through materials processing, manufacturing, distribution, use, repair and maintenance, and disposal or recycling.</descrip></descripGrp><ntig><termGrp><term id="3186053">LCA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3186209">Bizi-zikloaren ebaluazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56592_3186056_3186208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to evaluate the environmental impacts associated with all stages of a product's life, from raw material extraction through materials processing, manufacturing, distribution, use, repair and maintenance, and disposal or recycling.</descrip></descripGrp><ntig><termGrp><term id="3186056">Life Cycle Assessment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3186208">LCA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56592_3186056_3186209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to evaluate the environmental impacts associated with all stages of a product's life, from raw material extraction through materials processing, manufacturing, distribution, use, repair and maintenance, and disposal or recycling.</descrip></descripGrp><ntig><termGrp><term id="3186056">Life Cycle Assessment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3186209">Bizi-zikloaren ebaluazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender