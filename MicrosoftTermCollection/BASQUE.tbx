_3153899_3155883"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows organizations to selectively scan and protect historical older data using the latest enhanced advanced classifiers, to comprehensively identify and protect their sensitive corporate intellectual property and PII.</descrip></descripGrp><ntig><termGrp><term id="3153899">data scan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3155883">datuen azterketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56094_3153900_3155880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables a customer’s Entra ID admin to approve access to identity data in their tenant.</descrip></descripGrp><ntig><termGrp><term id="3153900">customer lockbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3155880">bezeroaren segurtasun-kutxa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56095_3153903_3154204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Edge feature that enables users to perform complex tasks such as more accurate calculations, coding, data analysis, visualization, math and more.</descrip></descripGrp><ntig><termGrp><term id="3153903">code interpreter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatica