rip></descripGrp><ntig><termGrp><term id="1991485">hard drive bay</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2918043">disko gogorraren konpartimentu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34376_1991486_2918045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cover that protects the hard drive bay in the absence of an attached hard drive.</descrip></descripGrp><ntig><termGrp><term id="1991486">hard drive bay cover</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2918045">disko gogorraren konpartimentuaren estalki</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34377_1991487_2918048"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The plug that connects the hard drive to the console.</descrip></descripGrp><ntig><termGrp><term id="1991487">hard drive connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2918048">disko gogorraren konektore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry