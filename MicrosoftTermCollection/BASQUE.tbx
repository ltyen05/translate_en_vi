p type="definition">The settings, related to the domain, a user needs to configure to get messaging up and running.</descrip></descripGrp><ntig><termGrp><term id="1275661">domain settings</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1789721">domeinu-ezarpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26531_1275663_2737575"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To transfer a call to a holding point instead of holding the call at the phone device.</descrip></descripGrp><ntig><termGrp><term id="1275663">park</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2737575">zain utzi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26535_1275693_2776085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To answer a call by dialing the associated number on the network where it has been parked.</descrip></descripGrp><ntig><termGrp><term id="1275693">retrieve</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2776085">eskuratu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber"