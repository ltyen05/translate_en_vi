<descrip type="definition">An email that a customer does not want delivered to their inbox, including spam and phishing messages (identified by the mail service) and messages from blocked senders and domains.</descrip></descripGrp><ntig><termGrp><term id="762951">junk e-mail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097114">posta elektronikoko mezu baztergarri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20992_762956_1097113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email that a customer does not want delivered to their inbox, including spam and phishing messages (identified by the mail service) and messages from blocked senders and domains.</descrip></descripGrp><ntig><termGrp><term id="762956">junk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097113">mezu baztergarri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20992_762956_1097114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email that a customer does not want delivered to their inbox, including spam and phishing messages (identified by the mail service) and messages from blocked senders and domains.</descrip></descripGrp><ntig><termGrp><term id="762956">junk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097114">posta elektronikoko mezu baztergarri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20993_762953_1097115"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email filter that enables the user to set the strictness level that keeps junk email from being delivered to their Inbox.</descrip></descripGrp><ntig><termGrp><term id="762953">junk e-mail filter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097115">mezu baztergarrien iragazki</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20994_762981_1097094"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The default version that includes drag-and-drop functionality, right-click menus, and a reading pane.</descrip></descripGrp><ntig><termGrp><term id="762981">full version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097094">bertsio oso</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20995_762983_1097061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The version that uses checkboxes and does not include a reading pane. It is recommneded for users with a slow internet connection.</descrip></descripGrp><ntig><termGrp><term id="762983">classic version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097061">bertsio klasiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20998_763011_1097247"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of colors and background images that lets users change the appearance of Windows Live pages. The theme is common to all pages, except for group, event, and space pages, which may each have their own theme.</descrip></descripGrp><ntig><termGrp><term id="763011">theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097247">gai</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20999_763132_1097183"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To copy something from a computer to a location online, such as a photo album or a blog post.</descrip></descripGrp><ntig><termGrp><term id="763132">publish</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097183">argitaratu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21_216347_1674133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that can be used in a workflow rule or template as a placeholder for specific values or text in an email. When you send an email, these placeholders are replaced with the data that meet the conditions that have been set in the workflow rule. For example, if you send an email to an account holder about a contract cancellation date, you can use a dynamic data field to automatically find and insert the correct cancellation date for that contract.</descrip></descripGrp><ntig><termGrp><term id="216347">dynamic data field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1674133">datu-eremu dinamiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21_216348_1674133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field that can be used in a workflow rule or template as a placeholder for specific values or text in an email. When you send an email, these placeholders are replaced with the data that meet the conditions that have been set in the workflow rule. For example, if you send an email to an account holder about a contract cancellation date, you can use a dynamic data field to automatically find and insert the correct cancellation date for that contract.</descrip></descripGrp><ntig><termGrp><term id="216348">slug</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSe