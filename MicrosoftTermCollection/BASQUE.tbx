type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113362_3114079"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113362">Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3114079">Lan-kargaren IDa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54588_3101395_3102311"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unity add-in that enables Microsoft Mesh users to upload custom environment templates to suit corporate events and meetings or create digital twins to match real-world environments in Mesh Spaces and Events.</descrip></descripGrp><ntig><termGrp><term id="3101395">Mesh Toolkit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3102311">Mesh tresna-kita</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54591_3101398_3102314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A strategy for fact checking an unfamiliar online source by leaving the webpage and opening a new browser tab to see what additional websites say about the unknown source.</descrip></descripGrp><ntig><termGrp><term id="3101398">lateral reading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3102314">albo-irakurketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54592_3101451_3101593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A layout control which helps to lay out an array of objects in a predefined three-dimensional shape. It supports various surface styles, such as plane, cylinder, sphere, and radial. The radius and size of the objects and the space between them can be adjusted.</descrip></descripGrp><ntig><termGrp><term id="3101451">3D object collection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101593">3D objektuen bilduma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54593_3101452_3101594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Dynamics 365 Guides on HoloLens that allows user and remote collaborator annotate in the environment while on the call. Annotations are useful for pointing out different parts of the space, including parts that may be difficult or dangerous to reach. All call participants can see each others’ additions, and can make their own annotations.</descrip></descripGrp><ntig><termGrp><term id="3101452">annotation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101594">oharpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54594_3101453_3101595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide by gazing at a printed circular code anchor that's attached to a physical object in the real world.</descrip></descripGrp><ntig><termGrp><term id="3101453">circular code anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101595">kode zirkularreko aingura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54595_3101454_3101596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide to a digital 3D hologram that's overlaid on a physical object in the real world.</descrip></descripGrp><ntig><termGrp><term id="3101454">holographic anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101596">aingura holografiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54596_3101455_3101597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of anchor in Dynamics 365 Guides that represents a position and orientation relative to a real-world object in an environment. It provides a common frame of reference that allows to place digital content in the same physical location of a real-world object.</descrip></descripGrp><ntig><termGrp><term id="3101455">object anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101597">objektu-aingura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54597_3101456_3101598"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An anchor in Dynamics 365 Guides used to align guide by gazing at a printed QR code anchor that's attached to a physical object in the real world. QR code anchoring is recommended for small to medium-size objects and spaces because it's the most accurate method, and the anchor can be printed at different sizes.</descrip></descripGrp><ntig><termGrp><term id="3101456">QR code anchor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101598">QR kodearen aingura</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54598_3101457_3101599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Dynamics 365 Remote Assist that enables to capture and annotate a part of the environment during a call. Users can save the snapshot to their mobile device gallery, the in-call text chat, or both.</descrip></descripGrp><ntig><termGrp><term id="3101457">snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101599">argazki</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54599_3101458_3101600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A central building block for creating a guide in Microsoft Dynamics 365 Guides. After creating the structure for guide in the Outline page, Step Editor will need to be used to add instructional text and 3D models or media to support the step.</descrip></descripGrp><ntig><termGrp><term id="3101458">step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101600">urrats</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54600_3102395_3103100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Purview feature that combines the risk scoring and user-activity approach of Insider Risk Management, with the data protection capabilities from Microsoft DLP.</descrip></descripGrp><ntig><termGrp><term id="3102395">Adaptive Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3103100">Babes moldakorra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54601_3102396_3103105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The marketing handle for Threat Intelligence research, content, and resources that serves as a center for teams that collaborate across product engineering, data science, policy, legal, and security services to apply research methods and analysis to protect customers through Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="3102396">Microsoft Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3103105">Microsoft-en mehatxuen aurkako informazioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54601_3102396_3103106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The marketing handle for Threat Intelligence research, content, and resources that serves as a center for teams that collaborate across product engineering, data science, policy, legal, and security services to apply research methods and analysis to protect customers through Microsoft products and services.</descrip></descripGrp><ntig><termGrp><term id="3102396">Microsoft Threat Intelligence</term><termNote type="partOfSpeech">ProperNoun</termN