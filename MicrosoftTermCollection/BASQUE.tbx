pe="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26950_1359313_1385642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows Live ID that is connected to at least one other Windows Live ID. When customers link IDs, they can sign in with one ID and switch to others without having to sign out from the first. Customers set up linked IDs in Windows Live Account.</descrip></descripGrp><ntig><termGrp><term id="1359313">linked ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1385642">ID estekatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2696_557773_1339719"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A secondary report that is displayed when a user clicks an item in a report. Detailed data is displayed in the same report.</descrip></descripGrp><ntig><termGrp><term id="557773">drill-through report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1339719">txosten xehatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26965_1359720_1664652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content processing feature that extracts information from unstructured text in an item and stores that information as additional managed properties for the item. The additional managed properties can be used to refine results.</descrip></descripGrp><ntig><termGrp><term id="1359720">property extractor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1664652">entitate-erauzle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26965_1653098_1664652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content processing feature that extracts information from unstructured text in an item and stores that information as additional managed properties for the item. The additional managed properties can be used to refine results.</descrip></descripGrp><ntig><termGrp><term id="1653098">entity extractor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1664652">entitate-erauzle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26977_1361740_1385645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label in Messenger for the results list of a contacts search.</descrip></descripGrp><ntig><termGrp><term id="1361740">Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term 