pGrp><descrip type="definition">An identifier that specifies the country/region, the administration management domain (ADMD), and the private management domain (PRMD) of an X.400 email address. For example c=us; a=MCI; p=msft.</descrip></descripGrp><ntig><termGrp><term id="397200">global domain identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427741">domeinu globalen identifikatzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15721_2524823_2527276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of outer join in which all rows in all joined tables are included, whether they are matched or not. For example, a full outer join between titles and publishers shows all titles and all publishers, even those that have no match.</descrip></descripGrp><ntig><termGrp><term id="2524823">full outer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2527276">kanpoko osoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15721_57216_2527276"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of outer join in which all rows in all joined tables are included, whether they are matched or not. For example, a full outer join between titles and publishers shows all titles and all publishers, even those that have no match.</descrip></descri