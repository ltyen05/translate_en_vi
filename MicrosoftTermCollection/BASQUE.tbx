taldekidea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54054_3082101_3082414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to search various knowledge sources, e.g. a knowledge base.</descrip></descripGrp><ntig><termGrp><term id="3082101">knowledge search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3082414">jakintza-bilaketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54055_3082102_3082409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight shows the number of calls where the negative customer sentiments are more than average.</descrip></descripGrp><ntig><termGrp><term id="3082102">Customer sentiment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3082409">Bezeroaren sentsazioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54056_3082103_3082419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight shows the tracked keywords that are defined in the application and that customers use the most during the sales calls. Conversation intelligence highlights these tracked keywords in this insight.</descrip></descripGrp><ntig><termGrp><term id="3082103">Tracked keywords</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3082419">Jarraitutako gako-hitzak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54057_3082104_3082418"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight shows the defined competitors' names that customers use most and are trending upwards during the sales calls. Conversation intelligence highlights these competitors in this section.</descrip></descripGrp><ntig><termGrp><term id="3082104">Tracked competitors</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3082418">Jarraitutako lehiakideak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54058_3082105_3082415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The insight in Dynamics 365 Sales Conversation Intelligence. This insight helps to discover new products, brands, and organizations that customers are speaking about in sales calls, which they never spoke of in previous calls. These products, brands, and organizations are not defined in the application (tracked keywords and competitors), and the application uses Microsoft Bing's knowledge repository to identify the products, brands, and organizations to display.</descrip></descripGrp><ntig><termGrp><term id="3082105">Other brands and organizations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3082415">Beste marka eta erakunde batzuk</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54059_3082106_3082412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An intelligent chat bot that can answer frequently asked questions, created by the Employee FAQ template. If an answer cannot be provided, it automatically collects requests and notifies human experts in Microsoft Teams channel. Then experts can chat directly with employees on Teams, in order to resolve the request.</descrip></descripGrp><ntig><termGrp><term id="3082106">FAQ bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3082412">FAQaren bot</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54060_3082107_3082413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A multi-disciplinary team of developers, users, and business leaders that use their specific disciplines and expertise to help build a product that aligns to one common goal. By combining the team’s knowledge with the latest technology, fusion teams can deliver products and solutions faster and more efficiently.</descrip></descripGrp><ntig><termGrp><term id="3082107">fusion team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3082413">fusio-talde</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54062_3083270_3084693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Clock app which helps users minimize distractions by turning on Do Not Disturb and silencing icon flashing and badge notifications for apps in the taskbar.</descrip></descripGrp><ntig><termGrp><term id="3083270">focus session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3084693">kontzentrazio-saioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54063_3083390_3085037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Defender for Business add-on that delivers the same level of protection for both clients and servers within a single admin experience, helping users to protect all endpoints in one location.</descrip></descripGrp><ntig><termGrp><term id="3083390">Microsoft Defender for Business servers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:l