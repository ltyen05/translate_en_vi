sed on Information Technology Infrastructure Library (ITIL) standard.</descrip></descripGrp><ntig><termGrp><term id="3014893">ITIL diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3016412">ITIL diagrama</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53050_3014894_3016415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that is based on Six Sigma methodology.</descrip></descripGrp><ntig><termGrp><term id="3014894">Six Sigma flowchart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3016415">Six Sigma fluxu-diagrama</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53054_3017114_3017784"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work model that involves a mixture of in-office and remote work.</descrip></descripGrp><ntig><termGrp><term id="3017114">hybrid work</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3017784">lan hibridoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53055_3017115_3017788"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option in Presenter Mode in which the content is displayed as one rectangle to the left and the video of the presenter is displayed in another rectangle to the right.</descrip></descripGrp><ntig><termGrp><term id="3017115">Side-by-side</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3017788">Bata bestearen ondoan</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53056_3017116_3017791"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The universal interactive canvas application that moves freely across applications, bringing human connection back into hybrid work to enable teams to think, plan, and create together.</descrip></descripGrp><ntig><termGrp><term id="3017116">Loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3017791">Loop</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53056_3017116_3023368"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The universal interactive canvas application that moves freely across applications, bringing human connection back into hybrid work to enable teams to think, plan, and create together.</descrip></descripGrp><ntig><termGrp><term id="3017116">Loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termN