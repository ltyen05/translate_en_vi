type="definition">An area upon which users can draw multiple shapes, such that the shapes can be moved and resized as a unit.</descrip></descripGrp><ntig><termGrp><term id="141181">drawing canvas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440102">marrazteko oihal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6239_264786_440600"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view for delivering a presentation that provides the presenter with additional options for viewing and controlling its delivery.</descrip></descripGrp><ntig><termGrp><term id="264786">Presenter View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440600">aurkezlearen ikuspegi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6240_30724_439364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of payment card where the supplier is paid by the card issuer. The card holder then pays the card issuer.</descrip></descripGrp><ntig><termGrp><term id="30724">credit card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439364">kreditu-txartel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6247_318716_440879"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of compositions or memorabilia of a specific type or for a particular purpose, such as audio recordings, photographs, or documents.</descrip></descripGrp><ntig><termGrp><term id="318716">album</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440879">album</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6250_105621_439871"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A return to a previous stable condition, as when the contents of a hard disk are restored from a backup after a destructive hard disk error.</descrip></descripGrp><ntig><termGrp><term id="105621">rollback</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439871">desegin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6254_237257_1664263"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of classes that cover aspects of a subject area.</descrip></descripGrp><ntig><termGrp><term id="237257">course</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1664263">ikastaro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6258_210167_1331774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An agreement to provide customer service support during specified coverage dates or for a specified number of cases or length of time. When customers contact customer service, the level of support they receive is determined by their contract.</descrip></descripGrp><ntig><termGrp><term id="210167">contract</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1331774">kontratu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6259_1054660_2522165"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device consisting of a number of connected circuit elements, such as transistors and resistors, fabricated on a small rectangle (a "die") cut from a silicon (or, in some special cases, a sapphire) wafer. Chips are categorized by the number of elements they contain.</descrip></descripGrp><ntig><termGrp><term id="1054660">integrated circuit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2522165">zirkuitu integratu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNo