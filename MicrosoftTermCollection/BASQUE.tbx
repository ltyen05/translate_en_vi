 xml:lang="en-US"><descripGrp><descrip type="definition">A tested, cumulative set of hotfixes, security updates, critical updates, and updates packaged together for easy deployment. A rollup generally targets a specific area, such as security, or component of a product, such as Microsoft Internet Information Services (IIS).</descrip></descripGrp><ntig><termGrp><term id="4707">update rollup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1973513">eguneratze-pakete</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24142_1098959_1718190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A code that grants rights to an individual, for example to use a system or access stored data.</descrip></descripGrp><ntig><termGrp><term id="1098959">authorization code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718190">baimen-kode</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24145_1103189_1355357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An available button for Windows Live Toolbar that highlights, in color, search words on the search results page. It also highlights the search words on the websites included in the search results.</descrip></descripGrp><ntig><termGrp><term id="1103189">Highlight Viewer</term><termNote type="partOfSpeech">ProperNoun</termNot