ote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_2908028_1789657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="2908028">CNAME</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1789657">CNAME erregistro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_686253_1789657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="686253">canonical name record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1789657">CNAME erregistro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19806_686254_1789657"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System that associates a computer's true (canonical) name with any alias names also used by the computer. Some domain registrars use CNAME records to redirect or redelegate domain names.</descrip></descripGrp><ntig><termGrp><term id="686254">CNAME record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1789657">CNAME erregistro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19810_686305_1789718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The owner of the customer relationship with customers who buy second-level domains. There may be many registrars for a single top-level domain. Registrars maintain detailed customer information in their databases, such as the customer's contact address, telephone number, and email address. Customers usually manage their second-level domains at the registrar's Web site, and the registrar updates the registry database when necessary (for example, when a customer renews a domain name).</descrip></descripGrp><ntig><termGrp><term id="686305">domain name registrar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1789718">domeinu-izenaren erregistratzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19828_686821_1794909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System (DNS) specifying how Internet email should be routed using the Simple Mail Transfer Protocol (SMTP). Each MX record contains a preference and a host name, so that the collection of MX records for a given domain name point to the servers that should receive email for that domain, and their priority relative to each other.</descrip></descripGrp><ntig><termGrp><term id="686821">mail exchange record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1794909">MX erregistro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19828_686822_1794909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of resource record in the Domain Name System (DNS) specifying how Internet email should be routed using the Simple Mail Transfer Protocol (SMTP). Each MX record contains a preference and a host name, so that the collection of MX records for a given domain name point to the servers that should receive email for that domain, and their priority relative to each other.</descrip></descripGrp><ntig><termGrp><term id="686822">MX record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1794909">MX erregistro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19838_687152_1140102"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The distance between the camera’s lens and the image plane.</descrip></descripGrp><ntig><termGrp><term id="687152">focal length</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140102">foku-distantzia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19839_687155_1097283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A setting that compensates for the color of light in which a picture was taken. A correct white balance setting makes colors look natural, while an incorrect white balance can result in pictures that have exaggerated colors.</descrip></descripGrp><ntig><termGrp><term id="687155">white balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097283">zurien balantze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19869_690235_2213588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a commercial Microsoft volume licensing agreement, any legal entity that a party owns, that owns a party or that is under its common ownership.</descrip></descripGrp><ntig><termGrp><term id="690235">affiliate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2213588">bazkide</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19881_690307_2224626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To request payment for products and/or services sold.</descrip></descripGrp><ntig><termGrp><term id="690307">bill</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2224626">fakturatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1989_48436_439515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of storage that is formatted with a file system and has an identifier to access it.</descrip></descripGrp><ntig><termGrp><term id="48436">drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439515">unitate</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1992_108620_439886"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program that searches for key words in documents, databases, Internet content or other files.</descrip></descripGrp><ntig><termGrp><term id="108620">search engine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumbe