Speech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2502959">Sprightly</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44422_2501255_2501772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that helps users write things such as book reports and essays with guided prompts and exercises, including speech-to-text and drawing features.</descrip></descripGrp><ntig><termGrp><term id="2501255">Write Ideas</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2501772">Write Ideas</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44423_2501256_2502960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A point at which something begins.</descrip></descripGrp><ntig><termGrp><term id="2501256">start</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2502960">hasiera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44424_2501259_2503016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pilot for Semi-annual Channel</descrip></descripGrp><ntig><termGrp><term id="2501259">Semi-annual Channel (Pilot)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2503016">Sei hilez behingo kanala (pilotua)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44425_2501456_2502971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A point at which something is completed.</descrip></descripGrp><ntig><termGrp><term id="2501456">finish</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2502971">amaiera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44428_2501460_2516587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number of times a hyperlink is clicked; used for monitoring customer interactions.</descrip></descripGrp><ntig><termGrp><term id="2501460">clicked count</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2516587">sakatze kopurua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44429_2501470_2516588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The information in a CRM account or entity record that includes related accounts, opportunities, quotes, competitors, contact information, products, and other details.</descrip></descripGrp><ntig><termGrp><term id="2501470">detail form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2516588">xehetasunen inprimaki</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44430_2501474_2517070"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of input fields that users can add all at once, as a single “block,” to a marketing page in order to create an input form on the page. Each block is preconfigured with the required collection of fields, and is ready for use. When creating a page, designers will typically choose from a limited selection of existing blocks, while managers or administrators will typically create new blocks only occasionally.</descrip></descripGrp><ntig><termGrp><term id="2501474">field block</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2517070">eremu-blokea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44431_2550466_2552186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that enables the users to view, organize, edit and share all of their photos and videos from multiple sources, and tell stories with them by making them into new videos. It replaces the default Photos app in Windows 10.</descrip></descripGrp><ntig><termGrp><term id="2550466">Photos &amp; Videos</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2552186">Argazkiak eta bideoak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44449_2502392_2905155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pre-release version of a service or a feature that are made available to customers for evaluation purposes and at reduced or different service terms.</descrip></descripGrp><ntig><termGrp><term id="2502392">preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2905155">aurreargitalpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44459_2502425_2516589"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A shortcut to a website, document, photo, or other file that can be included in a map.</descrip></descripGrp><ntig><termGrp><term id="2502425">geo pin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2516589">aingura geografikoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44460_2502426_2516590"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web page that operates on a Dynamics 365 server and is created by a Dynamics 365 customer to support their marketing initiatives.</descrip></descripGrp><ntig><termGrp><term id="2502426">marketing page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2516590">marketin-orria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44461_2502427_2516591"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team that owns records and has security roles assigned to the team. The team’s privileges are defined by these security roles. In addition to privileges provided by the team’s security roles, users have the privileges defined by their individual security roles and by the roles from other teams in which they are members. A team has full access rights on the records that the team owns.</descrip></descripGrp><ntig><termGrp><term id="2502427">owning team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2516591">jabetzadun talde</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44462_2502428_2516584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A team that doesn’t own records and doesn’t have security roles assigned to it. The users have privileges defined by their individual security roles and by the roles from other teams in which they are members. The records are shared with an access team and the team members are granted access rights on the records, such as Read, Write, or Append.</descrip></descripGrp><ntig><termGrp><term id="2502428">access team</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2516584">sarbidedun talde</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44463_2502429_2516592"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transient message that provides quick access to a company privacy policy or to its privacy statement.</descrip></descripGrp><ntig><termGrp><term id="2502429">privacy banner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2516592">pribatutasun-gidalerroen banda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44464_2502430_2516593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A competency grouping method for conference breakouts.</descrip></descripGrp><ntig><termGrp><term id="2502430">session track</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2516593">saioen jarraipena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44465_2502431_2516594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database record that matches a (human) speaker to a specific session from a specific event where they will be speaking. It assigns a speaker to a session.</descrip></descripGrp><ntig><termGrp><term id="2502431">speaker engagement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2516594">hizlari-esleipena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44466_2502432_2828392"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A prospect that is contacted by phone. Tele prospecting is the practice of generating interest for a product or service over the phone. The purpose of tele prospecting is to further qualify the lead to determine if a hand off to sales is necessary.</descrip></descripGrp><ntig><termGrp><term id="2502432">tele prospect</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2828392">telefonoz kontaktatutako bezero potentzial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected<