phicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53045_3014886_3016405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram that illustrates how different entities (such as customers and products) relate to each other in a database.</descrip></descripGrp><ntig><termGrp><term id="3014886">entity relationship diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3016405">erakundeen arteko erlazioen diagrama</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53046_3014888_3016407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram for creating medium-fidelity mock-ups of software applications and websites.</descrip></descripGrp><ntig><termGrp><term id="3014888">wireframe diagram</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3016407">erretikula</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53046_3014888_3016408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A diagram for creating medium-fidelity mock-ups of software applications and websites.</descrip></descripGrp><ntig><termGrp><term id="3014888">wireframe diagram</term><te