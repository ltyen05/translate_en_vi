</termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140325">Kendu atzeko planoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21203_767149_1140326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that removes narrations and laser pointer gestures or timings from a presentation or from a specific slide.</descrip></descripGrp><ntig><termGrp><term id="767149">Clear Recordings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140326">Garbitu grabazioak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21208_767313_2108254"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of adding geospatial metadata (e.g. longitude, latitude) to media (e.g. Websites, RSS feeds, or images).</descrip></descripGrp><ntig><termGrp><term id="767313">geotagging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2108254">geoetiketatze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21209_767322_3115844"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sum of carbon dioxide emissions from carbon dioxide-producing activities of a person or industry.</descrip></descripGrp><ntig><termGrp><term id="767322">carbon footprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3115844">karbono-aztarna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2121_375_439109"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of memory reserved for temporarily holding data before that data is used by a receiving device or application. Buffering protects against the interruption of data flow.</descrip></descripGrp><ntig><termGrp><term id="375">buffer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439109">buffer</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21212_767327_1140327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of software to support customer-preferred algorithms for encryption, hashing, entropy and digital signatures.</descrip></descripGrp><ntig><termGrp><term id="767327">cryptographic agility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140327">bizkortasun kriptografiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21212_767328_1140327"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability of software to support customer-preferred algorithms for encryption, hashing, entropy and digital signatures.</descrip></descripGrp><ntig><termGrp><term id="767328">crypto agility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140327">bizkortasun kriptografiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21222_767338_1097132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The checkbox that enables or disables the playing of a sound when a nudge is received.</descrip></descripGrp><ntig><termGrp><term id="767338">Nudge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097132">Dardara</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21227_767357_1227746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security feature that validates files before allowing them to be loaded by the application, in order to protect against file format vulnerabilities.</descrip></descripGrp><ntig><termGrp><term id="767357">Office File Validation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1227746">Office-ko fitxategi-balidazioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21244_767583_1228355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows end users and IT admins to control which file types and versions can be opened and saved in the application.</descrip></descripGrp><ntig><termGrp><term id="767583">File Block</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228355">Fitxategi-blokeo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21253_767590_1227747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows the user to superimpose a dot over a presentation and control its position with the mouse. The appearance of the dot is similar to that of a traditional laser pointer, and it is broadcast to all presentation viewers and can be recorded into video (Save to Video).</descrip></descripGrp><ntig><termGrp><term id="767590">Laser Pointer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1227747">Laser-erakuslea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21265_767631_1140330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that initiates an email response addressed to all of the recipients on the To or Cc lines of the original message.</descrip></descripGrp><ntig><termGrp><term id="767631">Reply to All</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140330">Erantzun denei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21265_767632_1140330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that initiates an email response addressed to all of the recipients on the To or Cc lines of the original message.</descrip></descripGrp><ntig><termGrp><term id="767632">Reply All</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140330">Erantzun denei</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21277_768421_1228356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mode of Windows Photo Viewer which consists of a top level window displaying one photograph at a time, with navigation controls.</descrip></descripGrp><ntig><termGrp><term id="768421">Photo Viewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228356">Argazki-ikustailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21278_768422_1228357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mode of Windows Photo Viewer which displays full-screen slide shows for photos.</descrip></descripGrp><ntig><termGrp><term id="768422">Slideshow</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228357">Diaporama</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2128_493788_1336768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A UI element where the state or province of the location of a record, such as an account or contact, is indicated.</descrip></descripGrp><ntig><termGrp><term id="493788">State/Province</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1336768">Estatua/Probintzia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21290_768424_1228358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recordable media (such as CD-RW) to which you can only write once without reformatting.</descrip></descripGrp><ntig><termGrp><term id="768424">single session-only disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228358">saio bakarreko disko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21291_768440_1228359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A recordable media to which you can write several times without reformatting.</descrip></descripGrp><ntig><termGrp><term id="768440">multi session-capable disc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228359">saio anitzeko disko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768624_1140331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768624">Microsoft Office Isolated Conversion Environment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140331">Microsoft Office-ren Bihurketa Ingurune Isolatua (MOICE)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768624_1140332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768624">Microsoft Office Isolated Conversion Environment</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140332">MOICE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768625_1140331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768625">MOICE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140331">Microsoft Office-ren Bihurketa Ingurune Isolatua (MOICE)</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21299_768625_1140332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that is added to the Microsoft Office Compatibility Pack to open Word, Excel, and PowerPoint binary format files and securely convert them to the Office 2007 file formats.</descrip></descripGrp><ntig><termGrp><term id="768625">MOICE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140332">MOICE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21300_1054681_1140333"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that makes Outlook auto-complete lists available through the default Exchange mailbox.</descrip></descripGrp><ntig><termGrp><term id="1054681">Suggested Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140333">Proposatutako kontaktuak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21301_769458_1228360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common credential store and interface that is used to save and manage user credentials, such as user names and passwords, so you can easily log on to Web sites and connect to other resources, such as computers.</descrip></descripGrp><ntig><termGrp><term id="769458">Credential Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228360">Kredentzial-kudeatzailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21302_769460_1228361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of credentials that users can create, store and manage in Credential Manager.</descrip></descripGrp><ntig><termGrp><term id="769460">vault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228361">kutxa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21303_769462_1228362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of vault that contains Web passwords and secure notes that you can place on a USB flash drive and use on another computer.</descrip></descripGrp><ntig><termGrp><term id="769462">personal vault</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228362">kredentzial pertsonalen kutxa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21309_769803_2085189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To remove data permanently from a storage medium. This is usually done by replacing existing data with zeros or meaningless text or, in magnetic media, by disturbing the magnetic particles' physical arrangement, either with the erase head or with a large magnet.</descrip></descripGrp><ntig><termGrp><term id="769803">erase</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2085189">ezabatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2131_397166_427692"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of permanently deleting something by removing it from the store or moving it to the dumpster when dumpster functionality is enabled.</descrip></descripGrp><ntig><termGrp><term id="397166">hard delete</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427692">betiko ezabatze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2132_125577_439979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">When referring to a device, to remove the corresponding device drivers from the hard disk and physically remove the device from the computer.</descrip></descripGrp><ntig><termGrp><term id="125577">uninstall</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><