<term id="1167275">public group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1796866">talde publiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25061_1167276_2928437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to try to locate the name of a person, from a directory or other information store, based on a telephone number.</descrip></descripGrp><ntig><termGrp><term id="1167276">reverse number lookup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2928437">zenbaki bidezko bilaketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25061_1167277_2928437"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process used to try to locate the name of a person, from a directory or other information store, based on a telephone number.</descrip></descripGrp><ntig><termGrp><term id="1167277">RNL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2928437">zenbaki bidezko bilaketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25064_1167283_1789508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A voice message that's played to callers to let them know that the person they called is away for an extended period of time and unavailable to answer the phone. It can be customized by the user. It's different from the voice mail greeting that's played when the recipient is away for a short period of time.</descrip></descripGrp><ntig><termGrp><term id="1167283">away greeting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1789508">kanpoan dela jakinarazteko agur</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25069_1167297_1168809"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece or slice of the Web that users can directly subscribe to from the browser. The browser checks if the piece of the web has updates, and indicates to the user when there are new updates available. Users can preview the piece of the Web before navigating to the full Web page.</descrip></descripGrp><ntig><termGrp><term id="1167297">Suggested Sites Web Slice</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1168809">Iradokitako webguneen Web Slice</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25093_1167388_1765210"><langSet xml:lang="en-US"><descripGrp