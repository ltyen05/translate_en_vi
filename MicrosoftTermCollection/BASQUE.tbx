ech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1276856">bezeroarentzako arreta-zerbitzuaren ordezkari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31950_1628748_2085186"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mode the phone goes into after a user calls an emergency number (ex: 911) and the call ends. When the phone is in this mode, only the emergency operator can call the person on their phone, so that the emergency operator can call back or determine where the user is at.</descrip></descripGrp><ntig><termGrp><term id="1628748">Emergency Callback Mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2085186">Larrialdi-deiak soilik jasotzeko modua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31952_1628750_2085195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pictures that you can select to appear in the animated Pictures tile on Start, and in the Photos hub.</descrip></descripGrp><ntig><termGrp><term id="1628750">favorites</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2085195">gogokoak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gr