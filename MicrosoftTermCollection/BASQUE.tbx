></ntig></langSet></termEntry><termEntry id="39094_2270444_2330881"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A range of statistical and analytical techniques from modeling, machine learning, and data mining that analyze current and historical data to forecast future trends or events.</descrip></descripGrp><ntig><termGrp><term id="2270444">predictive analytics</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2330881">analisi-igarle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39097_2270759_2276972"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2016 edition of the Microsoft relational database management system.</descrip></descripGrp><ntig><termGrp><term id="2270759">Access 2016</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2276972">Access 2016</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="39098_2270799_2276985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The year 2016 edition of Microsoft Word.</descrip></descripGrp><ntig><termGrp><term id="2270799">Word 2016</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2276985">Word 2016</term><termNote type="geo