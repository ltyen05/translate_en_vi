ig><termGrp><term id="292991">SSL server certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2739454">SSL zerbitzari-ziurtagiri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15350_134128_440029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application for creating and manipulating text-based documents.</descrip></descripGrp><ntig><termGrp><term id="134128">word processor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440029">testu-prozesadore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15359_234913_440451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The visual experience of the premium Windows Vista editions. Windows Aero builds on the Basic and Standard user experiences to offer customers our best-designed, highest-performing desktop environment. A noticeable element of the new Windows Aero experience is the professional-looking, transparent glass design, which creates an open, lightweight environment but more importantly enables users to focus on their content rather than the interface.</descrip></descripGrp><ntig><termGrp><term id="234913">Aero</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp>