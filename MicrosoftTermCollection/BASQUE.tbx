25"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The « character.</descrip></descripGrp><ntig><termGrp><term id="317462">opening chevron</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440825">irekitzeko xebroi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42971_2435051_2436452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having a layout that groups objects two-dimensionally.</descrip></descripGrp><ntig><termGrp><term id="2435051">bending</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2436452">kateatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42972_2435052_2436451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SmartArt graphic that shows a progression of steps in a task, process, or workflow.</descrip></descripGrp><ntig><termGrp><term id="2435052">bending process</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2436451">prozesu kateatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></lan