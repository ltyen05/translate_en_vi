h">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1765590">Datu-baseen konparazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32459_1680741_1765560"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office product that provides non-intrusive auditing of changes made to Excel spreadsheets and Access databases, and supports alerts, notifications and automatic workflows based on user activities such as macro or formula changes.</descrip></descripGrp><ntig><termGrp><term id="1680741">Audit and Control Management Server</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1765560">Auditatze eta kontrolen kudeaketa-zerbitzari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32464_1681335_1765191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Denotes the experience with Lync that can be scheduled, or ad-hoc. A Lync Meeting provides the ability to interact with people through video, audio, instant messaging, and content sharing.</descrip></descripGrp><ntig><termGrp><term id="1681335">Lync Meeting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1765191">Lync bilera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32466_1681337_1765218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Alerts to Lync users about the quality of the network, computer, camera, and lighting conditions.</descrip></descripGrp><ntig><termGrp><term id="1681337">video quality notifications</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1765218">bideo-kalitatearen jakinarazpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32468_1681339_1765312"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets users create and share OneNote meeting notes in a Lync Meeting. Notes appear as docked in a Lync Meeting, with participant lists that can be updated in meeting notes for participants to see.</descrip></descripGrp><ntig><termGrp><term id="1681339">OneNote share</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1765312">OneNote partekatze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32470_1681341_1765215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A video preview for a Lync user that provides options to answer with video from within the notification.</de