/termGrp></ntig></langSet></termEntry><termEntry id="35351_2026819_2392431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of scaling back resource usage by blocking connectivity of clients that are adversely impacting the overall health of the system.</descrip></descripGrp><ntig><termGrp><term id="2026819">engine throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2392431">mugatze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35351_2026820_2392431"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of scaling back resource usage by blocking connectivity of clients that are adversely impacting the overall health of the system.</descrip></descripGrp><ntig><termGrp><term id="2026820">throttling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2392431">mugatze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3537_232842_1228120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A global template that you can use for any type of document. You can modify this template to change the default document formatting or content.</descrip></descripGrp><ntig><termGrp><term id="232842">Normal template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSe