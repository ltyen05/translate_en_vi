p type="definition">The prefix displayed on a badge indicating the search result originates from the Web.</descrip></descripGrp><ntig><termGrp><term id="3083658">Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3084698">Sarea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54072_3083695_3085036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft 365 offer for one person that includes 100 GB of cloud storage with advanced file and photo protection, secure, ad-free Outlook email and calendar, and Web and mobile versions of Word, Excel, and PowerPoint.</descrip></descripGrp><ntig><termGrp><term id="3083695">Microsoft 365 Basic</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3085036">Microsoft 365 Basic</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54073_3083696_3085038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cloud-based security service commercial offer, which provides configuration, protection, and detection capabilities.</descrip></descripGrp><ntig><termGrp><term id="3083696">Microsoft Defender for Office 365 Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3085038">Office 365-erako Microsoft Defender, 1. plana</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54073_3190849_3085038"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft cloud-based security service commercial offer, which provides configuration, protection, and detection capabilities.</descrip></descripGrp><ntig><termGrp><term id="3190849">Microsoft Defender for Office 365 (Plan 1)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3085038">Office 365-erako Microsoft Defender, 1. plana</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54074_3083702_3085053"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category of insights within Microsoft Viva Insights that helps users prioritize wellbeing with actionable recommendations, such as reserving time for focused work, taking regular breaks, and practicing mindfulness.</descrip></descripGrp><ntig><termGrp><term id="3083702">personal insights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3085053">ideia pertsonalak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></ter