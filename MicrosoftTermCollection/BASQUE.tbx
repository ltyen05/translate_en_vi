 fingerprint for the Secure Shell protocol.</descrip></descripGrp><ntig><termGrp><term id="2402832">SSH thumbprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2421451">SSH hatz-marka digitala</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42442_2402833_2421441"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A third-party company that offers organizations and end users the ability to save data to an off-site storage system.</descrip></descripGrp><ntig><termGrp><term id="2402833">cloud storage provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2421441">hodeiko biltegien hornitzailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42443_2402834_2421442"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business that maintains and manages its customers’ data and makes that data accessible over a network, usually the Internet.</descrip></descripGrp><ntig><termGrp><term id="2402834">cloud storage service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2421442">hodeiko biltegien zerbitzua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatical