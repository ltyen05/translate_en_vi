ipt and call JavaScript event handlers from managed types.</descrip></descripGrp><ntig><termGrp><term id="1260271">HTML Bridge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1359289">HTML zubi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26033_1260272_1359248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, a technology that enables users to interactively view high-resolution images. With Deep Zoom, users can zoom in, zoom out, and pan images rapidly.</descrip></descripGrp><ntig><termGrp><term id="1260272">Deep Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1359248">Deep Zoom</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26034_1260273_1359293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Silverlight, an out-of-browser application to which a user grants elevated trust upon installation, providing greater access to the local system.</descrip></descripGrp><ntig><termGrp><term id="1260273">trusted application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1359293">aplikazio fidagarri</term><termNote type="geographicalUsage">ESP</termNote><termNote ty