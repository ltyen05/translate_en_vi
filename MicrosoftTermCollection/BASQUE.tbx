2796099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The responsibility of a company for the impacts of its decisions and activities on society and the environment, through transparent and ethical behaviour that contributes to sustainable development, takes into account the expectations of stakeholders, is in compliance with applicable law and consistent with international norms of behavior, and is integrated throughout the organization and practised in its relationships, as based on ISO 26000:2010.</descrip></descripGrp><ntig><termGrp><term id="2794537">corporate social responsibility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796099">CSR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49320_2794538_2796097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The responsibility of a company for the impacts of its decisions and activities on society and the environment, through transparent and ethical behaviour that contributes to sustainable development, takes into account the expectations of stakeholders, is in compliance with applicable law and consistent with international norms of behavior, and is integrated throughout the organization and practised in its relationships, as based on ISO 26000:2010.</descrip></descripGrp><ntig><termGrp><term id="2794538">CSR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796097">erantzukizun sozial korporatibo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49320_2794538_2796099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The responsibility of a company for the impacts of its decisions and activities on society and the environment, through transparent and ethical behaviour that contributes to sustainable development, takes into account the expectations of stakeholders, is in compliance with applicable law and consistent with international norms of behavior, and is integrated throughout the organization and practised in its relationships, as based on ISO 26000:2010.</descrip></descripGrp><ntig><termGrp><term id="2794538">CSR</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796099">CSR</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49321_2794539_2796098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal report by a business of its decisions and activities as well as their impacts on society and the environment.</descrip></descripGrp><ntig><termGrp><term id="2794539">CSR report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796098">erantzukizun sozial korporatiboaren txosten</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49321_2794539_2796100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal report by a business of its decisions and activities as well as their impacts on society and the environment.</descrip></descripGrp><ntig><termGrp><term id="2794539">CSR report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796100">CSR txosten</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49321_2794542_2796098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal report by a business of its decisions and activities as well as their impacts on society and the environment.</descrip></descripGrp><ntig><termGrp><term id="2794542">Corporate Social Responsibility report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796098">erantzukizun sozial korporatiboaren txosten</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49321_2794542_2796100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A formal report by a business of its decisions and activities as well as their impacts on society and the environment.</descrip></descripGrp><ntig><termGrp><term id="2794542">Corporate Social Responsibility report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796100">CSR txosten</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49322_2794540_2796101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A comprehensive, proactive process to identify the actual and potential negative social, environmental and economic impacts of an organization's decisions and activities over the entire life cycle of a project or organizational activity, with the aim of avoiding and mitigating negative impacts, as defined by ISO 26000:2010.</descrip></descripGrp><ntig><termGrp><term id="2794540">due diligence</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796101">arreta-eskakizun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49323_2794541_2796096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The checklist created by Microsoft based on ISO/IEC 19086-1, the Cloud Computing Service Level Agreement Framework, to guide organizations in their move to the cloud.</descrip></descripGrp><ntig><termGrp><term id="2794541">Cloud Services Due Diligence Checklist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796096">Hodeiko zerbitzuetarako arreta-eskakizunen egiaztapen-zerrenda</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammati