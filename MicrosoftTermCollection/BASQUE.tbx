></descripGrp><ntig><termGrp><term id="3104554">Publish to Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3105828">Argitaratu sarean</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5469_177200_440244"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A message sent to the user or administrator of a system where the recipient may be a human or an automated notification manager.</descrip></descripGrp><ntig><termGrp><term id="177200">notification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440244">jakinarazpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54690_3104555_3105829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The extension required to create and customize fetch-based reports by using SQL Server Data Tools - Business Intelligence, an authoring environment for Visual Studio.</descrip></descripGrp><ntig><termGrp><term id="3104555">Report Authoring Extension</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3105829">Txostenen egiletzaren luzapen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neu