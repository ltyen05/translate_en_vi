ml:lang="en-US"><descripGrp><descrip type="definition">The worldwide team of cybersecurity experts operating in most countries, across all organizations (public and private), with expertise to secure an environment post-security breach and to help users prevent a breach in the first place.</descrip></descripGrp><ntig><termGrp><term id="3093362">Compromise Recovery Security Practice</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3093703">Arriskuak berreskuratzeko segurtasun-taldea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54255_3093362_3093704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The worldwide team of cybersecurity experts operating in most countries, across all organizations (public and private), with expertise to secure an environment post-security breach and to help users prevent a breach in the first place.</descrip></descripGrp><ntig><termGrp><term id="3093362">Compromise Recovery Security Practice</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3093704">CRSP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54255_3093363_3093703"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The worldwide team of cybersecurity experts operating in most countries, across all organizations (public and private), with expertise to secure an environment post-security breach and to help users prevent a breach in the first place.</descrip></descripGrp><ntig><termGrp><term id="3093363">CRSP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3093703">Arriskuak berreskuratzeko segurtasun-taldea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54255_3093363_3093704"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The worldwide team of cybersecurity experts operating in most countries, across all organizations (public and private), with expertise to secure an environment post-security breach and to help users prevent a breach in the first place.</descrip></descripGrp><ntig><termGrp><term id="3093363">CRSP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3093704">CRSP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54265_3094167_3095099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Microsoft's official video series for IT Pros, Solution Architects, Developers, and Tech Enthusiasts.</descrip></descripGrp><ntig><termGrp><term id="3094167">Microsoft Mechanics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3095099">Microsoft Mechanics</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54266_3094170_3095100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The online page under Microsoft Security website where users can learn about a variety of cybersecurity, identity, and compliance topics and best practices at Microsoft.</descrip></descripGrp><ntig><termGrp><term id="3094170">Security 101</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3095100">Segurtasunari buruzko oinarrizko ezagutza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54267_3094172_3095101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows utility that checks which files are in use and by which processes.</descrip></descripGrp><ntig><termGrp><term id="3094172">File Locksmith</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3095101">Fitxategi-sarrailagilea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54268_3094353_3094511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role assigned to experienced Power Apps makers to help others. The advisor will show as someone that can be contacted for help in the Power Apps Virtual Agent chat.</descrip></descripGrp><ntig><termGrp><term id="3094353">advisor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094511">aholkulari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54269_3094354_3094512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A micro-app that uses enterprise data that can be sent as content in Teams.</descrip></descripGrp><ntig><termGrp><term id="3094354">card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094512">txartela</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54270_3094355_3094513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Platform offering that enables you to deploy your small independent apps (mini-apps) into Teams chats, Microsoft Outlook emails, web chat, or third-party apps. Customers deploying new or updated business workflows enjoy increased efficiency and uptake by deploying apps in popular products such as Teams, as opposed to deploying entirely new sites or apps.</descrip></descripGrp><ntig><termGrp><term id="3094355">Cards</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094513">Txartelak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54271_3094356_3094514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows app makers to add collaboration features (meetings, tasks, approvals, etc.) into apps built with Power Apps.</descrip></descripGrp><ntig><termGrp><term id="3094356">Collaboration controls</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094514">Lankidetza-kontrolak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54272_3094357_3094515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Dataverse security configuration setting that allows users to manage the permission of users and teams to read, create, or write in secured columns. For example, the System Administrator column security profile gives full access to all secured columns.</descrip></descripGrp><ntig><termGrp><term id="3094357">column security profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094515">zutabearen segurtasun-profila</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54273_3094358_3094516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An extra layer of security that helps detect and mitigate some types of web attacks such as data theft, site defacement, or the distribution of malware.</descrip></descripGrp><ntig><termGrp><term id="3094358">content security policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094516">edukiaren segurtasun-gidalerroak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54274_3094359_3094517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A special type of URI that encodes the actual resource content, instead of just pointing to it.</descrip></descripGrp><ntig><termGrp><term id="3094359">data URI</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094517">datuen URIa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54275_3094360_3094518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pipeline that eliminates much of today's application lifecycle management (ALM) complexity by bringing ALM automation into the product and making it accessible to all makers, admins, and developers.</descrip></descripGrp><ntig><termGrp><term id="3094360">deployment pipeline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094518">inplementazio-bideratze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54276_3094361_3094519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An environment to build and test with Power Apps, Power Automate, and Microsoft Dataverse. It can be created by users who have the Power Apps Developer Plan.</descrip></descripGrp><ntig><termGrp><term id="3094361">developer environment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094519">garapen-ingurune</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54277_3094362_3094520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power Apps feature that accelerates the getting started process by taking existing content (e.g., a picture of your paper form, a screenshot of a design you like, a PPT, a PDF, or a Figma design file) and converting them into a working Power App with UI and data without requiring the maker to learn how to build an app.</descrip></descripGrp><ntig><termGrp><term id="3094362">express design</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094520">diseinu bizkor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54278_3094363_3094521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of governance capabilities, found in the Power Platform Admin Center that will simplify, automate, and streamline IT administration of the Power Platform.</descrip></descripGrp><ntig><termGrp><term id="3094363">Managed Environments</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094521">Kudeatutako inguruneak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54279_3094364_3094522"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The annual event sponsored by Microsoft dedicated to Microsoft Power Platform products including Power Apps, Power Automate, Power BI, Power Pages, and Power Virtual Agents.</descrip></descripGrp><ntig><termGrp><term id="3094364">Power Platform Conference</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3094522">Power Platform konferentzia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54280_3094365_3094523"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Power Apps connector available to Premium License Plan subscribers.</descrip></descripGrp>