e="definition">The surface of a button where text or an image (typically indicating the button's function) may be displayed.</descrip></descripGrp><ntig><termGrp><term id="25636">button face</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439313">botoi-irudi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13598_26923_439326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that notifies a user that a call is coming in while the user is in a call.</descrip></descripGrp><ntig><termGrp><term id="26923">call waiting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439326">dei-itxarote</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="136_557698_1331296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system job that detects duplicate records for one entity.</descrip></descripGrp><ntig><termGrp><term id="557698">Bulk Duplicate Detection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1331296">Bikoiztuen detekzio masiboa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalN