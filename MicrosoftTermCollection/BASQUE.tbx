xml:lang="eu"><ntig><termGrp><term id="3013092">desidentifikatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53010_3013010_3013093"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A constraint on the algorithms used to publish aggregate information about a statistical database which limits the privacy impact on individuals whose information is in the database.</descrip></descripGrp><ntig><termGrp><term id="3013010">differential privacy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3013093">pribatutasun diferentziala</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53011_3013183_3019955"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that a user can create in Microsoft Cloud for Sustainability to check the volume of greenhouse gases that result from an operational activity. The profile contains the settings needed to run the calculation, and includes the calculation model.</descrip></descripGrp><ntig><termGrp><term id="3013183">calculation profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3019955">kalkulu-profil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53012_3013184_3019956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A legal document evidencing the agreement between the parties.</descrip></descripGrp><ntig><termGrp><term id="3013184">contractual instrument</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3019956">kontratu-tresna</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53013_3013185_3019957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value that relates the amount of pollution generated and the activity associated with the generation of that pollution.</descrip></descripGrp><ntig><termGrp><term id="3013185">emission factor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3019957">isuri-faktore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53014_3013186_3019958"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Power BI app published through AppSource and used to demonstrate the energy and carbon efficiency of Microsoft cloud services through a Power BI dashboard. The app provides individual customers with Carbon footprint and GHG emissions associated with their current Azure and Dynamics 365 subscription(s) in comparison with the estimated footprint of on-premises alternatives.</descrip></descripGrp><ntig><termGrp><term id="3013186">Emissions Impact Dashboard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3019958">Isurien eraginaren panela</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53015_3013187_3019959"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A direct release to the atmosphere of greenhouse gas compounds from various types of equipment and processes.</descrip></descripGrp><ntig><termGrp><term id="3013187">fugitive emission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3019959">isuri iheslari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53016_3013188_3019960"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cloud offering that helps companies measure, understand and take charge of their carbon emissions, set sustainability goals and take measurable action.</descrip></descripGrp><ntig><termGrp><term id="3013188">Microsoft Cloud for Sustainability</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3019960">Microsoft Cloud for Sustainability</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53017_3013189_3019961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emission from the combustion of fossil fuels used in the operation of vehicles or other forms of mobile transportation.</descrip></descripGrp><ntig><termGrp><term id="3013189">mobile combustion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3019961">errekuntza mugikor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53018_3013190_3019962"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An emission from the combustion of fuels used in the operation of power plants, industrial combustion plants, etc.</descrip></descripGrp><ntig><termGrp><term id="3013190">stationary combustion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3019962">errekuntza geldikor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53019_3013191_3019963"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A report that shows the effects that an organization's business operations have on the environment.</descrip></descripGrp><ntig><termGrp><term id="3013191">sustainability report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3019963">jasangarritasun-txosten</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5303_76437_2998732"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, the power to which a base must be raised to equal a given number. For example, for the base 10, the logarithm of 16 is (approximately) 1.2041 because 101.2041 equals (approximately) 16. Both natural logarithms (to the base e, which is approximately 2.71828) and common logarithms (to the base 10) are used in programming. Languages such as C and Basic include functions for calculating natural logarithms.</descrip></descripGrp><ntig><termGrp><term id="76437">logarithm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2998732">logaritmo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53031_3014789_3060061"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure offering that supports Azure Virtual Desktop on Azure Stack HCI.</descrip></descripGrp><ntig><termGrp><term id="3014789">Azure Virtual Desktop on Azure Stack HCI</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3060061">Azure Virtual Desktop Azure Stack HCI-an</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNou