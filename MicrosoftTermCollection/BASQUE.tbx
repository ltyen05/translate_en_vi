owledge.</descrip></descripGrp><ntig><termGrp><term id="85315">non-disclosure agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2689039">isilpekotasun-hitzarmen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12055_235062_440462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that helps the user to adjust their speakers for the best sound by running automatic calibration tests for levels, delay, and frequency response.</descrip></descripGrp><ntig><termGrp><term id="235062">Speaker Calibration wizard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440462">bozgorailuak kalibratzeko morroi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12063_38186_2917887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In hardware, a coupler used to join cables or to join a cable to a device (for example, an RS-232-C connector used to join a modem cable to a computer). Most connector types are available in one of two genders--male or female. A male connector is characterized by one or more exposed pins; a female connector is characterized by one or more receptacles--sockets or jacks-- designed to accept the pins on the male connector.</descrip></descripGrp><ntig><termGrp><term id="38186">connector</term><termNote type="partOfSpeech">Noun</ter