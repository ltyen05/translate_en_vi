 accepted, and that allows the owner of the repository to distribute the contribution with their own license.</descrip></descripGrp><ntig><termGrp><term id="2506807">contribution license agreement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2510133">lankidetzarako lizentzia-kontratu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44554_2506505_2510143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Having the property that it is possible to set the value to null.</descrip></descripGrp><ntig><termGrp><term id="2506505">nullable</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2510143">balio nulua onartzen duen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44555_2506506_2510146"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list which prefixes its items with numbers or letters in ascending order.</descrip></descripGrp><ntig><termGrp><term id="2506506">ordered list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2510146">zerrenda ordenatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote>