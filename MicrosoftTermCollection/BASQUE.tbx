031_2412903"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office application that allows Office 365 admins to access their Office 365 admin center and manage their tenants via their mobile devices.</descrip></descripGrp><ntig><termGrp><term id="2410031">Office 365 Admin</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2412903">Office 365 Admin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42529_2410032_2412905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A failure of a program operation that causes the operation to stop completely.</descrip></descripGrp><ntig><termGrp><term id="2410032">hard fail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2412905">errore berreskuraezin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42530_2410033_2412907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A failure of a program operation where the failure is recorded and the operation continues on.</descrip></descripGrp><ntig><termGrp><term id="2410033">soft fail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2412907">errore berreskuragarri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42531_2410034_2412904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The PowerPoint button that opens a tab with a specialized version of the app store where users can find materials related to education so that those materials can be included in their deck.</descrip></descripGrp><ntig><termGrp><term id="2410034">Apps and Quizzes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2412904">Aplikazioak eta azterketak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4255_87542_2094268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An association between two tables in which the primary key value of each record in the primary table corresponds to the value in the matching field or fields of one, and only one, record in the related table.</descrip></descripGrp><ntig><termGrp><term id="87542">one-to-one relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2094268">batetik baterako erlazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42550_2410359_2411897"><langSet xml:lang="en-US"><descripGrp><descrip type="defini