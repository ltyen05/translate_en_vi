/langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2150407">Office 365 Government</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33843_1908770_2152190"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for businesses that need communication and collaboration tools accessible from PCs, the Web and mobile devices.</descrip></descripGrp><ntig><termGrp><term id="1908770">Office 365 Enterprise E1 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2152190">Office 365 Enterprise E1en probako bertsioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33844_1908771_2152191"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 online subscription for businesses that need communication and collaboration tools and the ability to read and do lightweight editing of documents with the Office Web Apps.</descrip></descripGrp><ntig><termGrp><term id="1908771">Office 365 Enterprise E2</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2152191">Office 365 Enterprise E2</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33846_1908773_2152193"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for businesses that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Web Apps.</descrip></descripGrp><ntig><termGrp><term id="1908773">Office 365 Enterprise E3 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2152193">Office 365 Enterprise E3ren probako bertsioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33847_1908774_2152195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Office 365 subscription for businesses that need productivity, communications and collaboration tools including the familiar desktop Office and compliance features like data loss prevention and archiving. Also includes Skype for Business Plus CAL, enabling customers to get Enterprise Voice on-premises.</descrip></descripGrp><ntig><termGrp><term id="1908774">Office 365 Enterprise E4</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2152195">Office 365 Enterprise E4</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33848_1908775_2152197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limited-day trial for an Office 365 online subscription for businesses that need full productivity, communication and collaboration tools with the familiar Office suite, including Office Web Apps and on-premises server rights to information protection and enterprise voice capabilities.</descrip></descripGrp><ntig><termGrp><term id="1908775">Office 365 Enterprise E4 Trial</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2152197">Office 365 Enterprise E4ren probako bertsioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33868_1933055_1973503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workflow that is synchronous and starts immediately.</descrip></descripGrp><ntig><termGrp><term id="1933055">operational workflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1973503">lan-fluxu aktibo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33869_1933056_1973506"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workflow that is asynchronous or that starts at a later time, but does not have to wait for a previous workflow to finish.</descrip></descripGrp><ntig><termGrp><term id="1933056">post-operational workflow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</ter