></termGrp></ntig></langSet></termEntry><termEntry id="54251_3093357_3093707"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows Microsoft Teams admins to create new, custom meeting types for their organization.</descrip></descripGrp><ntig><termGrp><term id="3093357">meeting templates</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3093707">bileren txantiloiak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54252_3113363_3114081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The modern identity solution for securing access to customer, citizen and partner-facing apps and services.</descrip></descripGrp><ntig><termGrp><term id="3113363">Microsoft Entra External ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3114081">Microsoft Entra-ren kanpoko IDa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54252_3113363_3185465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The modern identity solution for securing access to customer, citizen and partner-facing apps and services.</descrip></descripGrp><ntig><termGrp><term id="3113363">Microsoft Entra External ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></l