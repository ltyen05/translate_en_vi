mation and processes through the use of cloud computing.</descrip></descripGrp><ntig><termGrp><term id="2341357">collaboration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2392393">lankidetza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40270_2342142_2392391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The solution that provides visibility into the cloud applications that are in use in an organization as well as the details to help make an assessment of usage.</descrip></descripGrp><ntig><termGrp><term id="2342142">Cloud Discovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2392391">Cloud Discovery</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40271_2342153_2392423"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service with official permission to be used within an organization.</descrip></descripGrp><ntig><termGrp><term id="2342153">sanctioned service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2392423">zerbitzu baimendu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><term