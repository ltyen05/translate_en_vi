via EA, CASA/EES, MOSA, OSPA, and OSSA.</descrip></descripGrp><ntig><termGrp><term id="2868554">Azure Incentives</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2868892">Azure Incentives</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50684_2868555_2868936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft initiative designed to give solution providers an opportunity to earn supplemental revenue when they assist end customers with software selection and implementation of Microsoft Dynamics CRM.</descrip></descripGrp><ntig><termGrp><term id="2868555">Certified Software Advisor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2868936">Certified Software Advisor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50684_2898928_2868936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft initiative designed to give solution providers an opportunity to earn supplemental revenue when they assist end customers with software selection and implementation of Microsoft Dynamics CRM.</descrip></descripGrp><ntig><termGrp><term id="2898928">CSA</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2868936">Certified Software Advisor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50685_2868556_2868979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program designed to reward Commercial Distributor partners for driving Open License and Office FPP/ESD revenue through resellers.</descrip></descripGrp><ntig><termGrp><term id="2868556">Commercial Distributor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2868979">Commercial Distributor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50686_2868557_2869067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program designed to reward and support CSP direct bill partners for driving the activation and enablement of customers with Microsoft-based Online Services.</descrip></descripGrp><ntig><termGrp><term id="2868557">CSP Direct Bill Partner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2869067">CSP Direct Bill Partner</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50687_2868558_2869155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program for Cloud Solution Provider (CSP) partners that engage with a two-tier provider, commonly a distributor or hoster, who maintains the relationship with Microsoft and provides additional functions and services that the partner does not.</descrip></descripGrp><ntig><termGrp><term id="2868558">CSP Indirect Provider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2869155">CSP Indirect Provider</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50688_2868559_2869241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program for Cloud Solution Provider (CSP) resellers that are engaged by indirect CSP partners, who maintain the relationship with Microsoft, and who provide additional functions and services that the indirect CSP partner does not.</descrip></descripGrp><ntig><termGrp><term id="2868559">CSP Indirect Reseller</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2869241">CSP Indirect Reseller</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50689_2868560_2869391"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft incentive program designed to reward LSPs for securing and maintaining annuity relationships with Enterprise customers.</descrip></descripGrp><ntig><termGrp><term id="2868560">Enterprise Incentives</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2869391">Enterprise Incentives</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_160054_440216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="160054">color-space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440216">kolore-espazioaren bihurketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_210048_440216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="210048">color space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440216">kolore-espazioaren bihurketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partO