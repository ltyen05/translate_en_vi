125_2404304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that can complete work or be used to complete work.</descrip></descripGrp><ntig><termGrp><term id="2400125">resource</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2404304">baliabide</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42424_2400126_2407967"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variation in the layout and size of a caption in a sway that has been chosen by Caption variation.</descrip></descripGrp><ntig><termGrp><term id="2400126">caption style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2407967">epigrafearen estilo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42425_2400154_2400527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The program that lets gamers buy a game once and play it on both their Windows 10 PC and Xbox One console with shared progress, game saves and achievements.</descrip></descripGrp><ntig><termGrp><term id="2400154">Xbox Play Anywhere</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2400527">Xbox Play Anywhere</term><termNote type="geographicalUsage">ESP</termNote><te