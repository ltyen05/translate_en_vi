19">cloud-backed service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2818987">aukerako zerbitzu konektatuak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816520_2818982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816520">optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2818982">hodeiko zerbitzu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49804_2816520_2818987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connected experience that is optional, more precisely, it is not covered by the organization's license with Microsoft, but is instead licensed directly to the user.</descrip></descripGrp><ntig><termGrp><term id="2816520">optional connected experience</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2818987">aukerako zerbitzu konektatuak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote typ