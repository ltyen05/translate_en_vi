Note><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228152">konfidentzialtasun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6387_725767_1228152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The degree of confidentiality of an email message or calendar item, ranging from normal to confidential.</descrip></descripGrp><ntig><termGrp><term id="725767">sensitivity level</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228152">konfidentzialtasun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6388_232427_1228153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number between 1 and 53 that is assigned to each week of the year, where the first week of the year is the first week that contains a Thursday.</descrip></descripGrp><ntig><termGrp><term id="232427">week number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228153">aste-zenbaki</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6393_134066_440027"><langSet xml:lang="en-US"><descripGrp><descri