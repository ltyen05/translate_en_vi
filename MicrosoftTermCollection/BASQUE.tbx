der">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35392_2029156_2037415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of web services built on top of the Office 365 platform that makes available Office 365 components or data, such as documents, spreadsheets, presentations, calendars, mail, contacts, and tasks. These services are available from within apps for Office, apps for SharePoint, and also from third-party sites or applications who want to use Office 365 components, but are hosted on another platform, such as Microsoft Azure.</descrip></descripGrp><ntig><termGrp><term id="2029156">Office 365 APIs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2037415">Office 365 APIak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35393_2029157_2037445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that creates a template for a sensitive information type from a form, which can then be used to define transport rules, prevent oversharing of information, and create Data Loss Protection policies.</descrip></descripGrp><ntig><termGrp><term id="2029157">Document Fingerprinting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2037445">Dokumentuen markatze digital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammatica