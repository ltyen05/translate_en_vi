ture that monitors downloaded apps for malware or unknown reputation.</descrip></descripGrp><ntig><termGrp><term id="1627809">Windows SmartScreen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1635581">Windows SmartScreen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31295_1598405_1610090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of Windows that includes a set of maintenance tasks that run automatically when the user's PC is idle.</descrip></descripGrp><ntig><termGrp><term id="1598405">Automatic Maintenance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1610090">Mantentze automatikoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31296_1598406_1610091"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature of BitLocker that enables IT pros to encrypt a disk before a user begins to use it.</descrip></descripGrp><ntig><termGrp><term id="1598406">BitLocker encrypted installation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1610091">BitLocker-eko instalazio enkriptatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</te