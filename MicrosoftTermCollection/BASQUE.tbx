en-US"><descripGrp><descrip type="definition">A feature in Internet Explorer that enables users to go to the next page on a site quickly by swiping across the page or clicking the Forward button.</descrip></descripGrp><ntig><termGrp><term id="1690725">flip ahead</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1694784">aurrera egiteko pasatze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32688_1690726_1694864"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that shuts down or restarts the PC.</descrip></descripGrp><ntig><termGrp><term id="1690726">Power</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1694864">Piztu/Itzali</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32720_1694143_1718210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The option that lets users choose, be default, what mode they will view records in forms in.</descrip></descripGrp><ntig><termGrp><term id="1694143">Form Mode</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718210">Inprimaki modua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type=