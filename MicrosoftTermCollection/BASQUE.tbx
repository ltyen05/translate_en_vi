partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2224624">saldo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_314116_2791814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="314116">account balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2791814">balantze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_314116_440797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="314116">account balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440797">kontuaren balantze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_616949_2224624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="616949">balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2224624">saldo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_616949_2791814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="616949">balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2791814">balantze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2301_616949_440797"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount that is the difference between the sum of debit entries and the sum of credit entries entered into an account during a financial period.</descrip></descripGrp><ntig><termGrp><term id="616949">balance</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440797">kontuaren balantze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23043_1057319_1176622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to write CD-ROMs. Because a disc can be written only once on these machines, they are used most commonly to create CD-ROMs for data archives or to produce CD-ROM masters that can be duplicated for mass distribution.</descrip></descripGrp><ntig><termGrp><term id="1057319">CD recorder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1176622">CD grabagailu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23043_1057320_1176622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to write CD-ROMs. Because a disc can be written only once on these machines, they are used most commonly to create CD-ROMs for data archives or to produce CD-ROM masters that can be duplicated for mass distribution.</descrip></descripGrp><ntig><termGrp><term id="1057320">CD burner</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1176622">CD grabagailu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23055_1057442_2522156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of transistor in which the flow of current between the source and the drain is modulated by the electric field around the gate electrode. FETs are used as amplifiers, oscillators, and switches and are characterized by an extremely high input impedance (resistance) that makes them particularly suitable for amplification of very small signals. Types of FETs include the junction FET and the metal-oxide semiconductor FET (MOSFET).</descrip></descripGrp><ntig><termGrp><term id="1057442">FET</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2522156">FET transistore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23055_1057442_2522157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of transistor in which the flow of current between the source and the drain is modulated by the electric field around the gate electrode. FETs are used as amplifiers, oscillators, and switches and are characterized by an extremely high input impedance (resistance) that makes them particularly suitable for amplification of very small signals. Types of FETs include the junction FET and the metal-oxide semiconductor FET (MOSFET).</descrip></descripGrp><ntig><termGrp><term id="1057442">FET</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2522157">eremu-efektuko transistore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23055_1057443_2522156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of transistor in which the flow of current between the source and the drain is modulated by the electric field around the gate electrode. FETs are used as amplifiers, oscillators, and switches and are characterized by an extremely high input impedance (resistance) that makes them particularly suitable for amplification of very small signals. Types of FETs include the junction FET and the metal-oxide semiconductor FET (MOSFET).</descrip></descripGrp><ntig><termGrp><term id="1057443">field-effect transistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2522156">FET transistore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23055_1057443_2522157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of transistor in which the flow of current between the source and the drain is modulated by the electric field around the gate electrode. FETs are used as amplifiers, oscillators, and switches and are characterized by an extremely high input impedance (resistance) that makes them particularly suitable for amplification of very small signals. Types of FETs include the junction FET and the metal-oxide semiconductor FET (MOSFET).</descrip></descripGrp><ntig><termGrp><term id="1057443">field-effect transistor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2522157">eremu-efektuko transistore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23068_1057655_1140438"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web analytics report that identifies terms that should become Best Bets.</descrip></descripGrp><ntig><termGrp><term id="1057655">Best Bet Suggestions report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140438">Aukerarik onenen proposamenen txosten</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23069_1057656_1140439"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web analytics report that identifies the Best Bet terms and how they are utilized by the system.</descrip></descripGrp><ntig><termGrp><term id="1057656">Best Bet Usage report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140439">Aukerarik onenen erabileraren txosten</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23092_1058116_1140440"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that ensures that all components of a file are preserved, even if they are supported only by the rich client and not viewable in Web Companions.</descrip></descripGrp><ntig><termGrp><term id="1058116">Document Integrity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1140440">Dokumentuaren osotasun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2314_117926_1228108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To change between states or modes.</descrip></descripGrp><ntig><termGrp><term id="117926">switch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228108">aldatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23154_1060415_2522166"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common type of field-effect transistor in which a layer of silicon dioxide insulates the metal gate from the semiconductor current channel. MOSFETs have extremely high input impedance and therefore require almost no driving power. They are used in many audio applications, including high-gain amplifier circuits. Like all metal-oxide semiconductor (MOS) devices, MOSFETs are easily damaged by static electricity.</descrip></descripGrp><ntig><termGrp><term id="1060415">MOSFET</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2522166">MOSFET transistore</t