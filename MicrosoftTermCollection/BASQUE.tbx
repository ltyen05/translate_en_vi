latform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2766734">Microsoft Power Platform</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43798_2758212_2766735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The integrated set of BI services which include Power BI, PowerApps, and Microsoft Flow.</descrip></descripGrp><ntig><termGrp><term id="2758212">Power Platform</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2766735">Power Platform</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43799_2470927_2471549"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The lightweight markup language with plain text formatting syntax designed to be converted to HTML and other formats and that is used to format readme files, write messages in online discussion forums, and create rich text using a plain text editor.</descrip></descripGrp><ntig><termGrp><term id="2470927">Markdown</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2471549">Markdown</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43800_2470929_2471550"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Word add-in that converts Markdown documents to Word format for editing and then converts the Word document back to Markdown format, using the Paragraph, Table, List, and Range objects.</descrip></descripGrp><ntig><termGrp><term id="2470929">Markdown editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2471550">Markdown editor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43809_2471187_2497897"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component type of the app designer that includes entities, dashboards, and business process flows.</descrip></descripGrp><ntig><termGrp><term id="2471187">artifact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2497897">artefaktu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43810_2471606_2497899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customizable area of an app, site map, or view designer where users can add or edit different components of a business app.</descrip></descripGrp><ntig><termGrp><term id="2471606">canvas</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2497899">mihise</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43811_2471609_2497895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stage in a business process flow that uses an automated process for gathering data.</descrip></descripGrp><ntig><termGrp><term id="2471609">action step</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2497895">ekintza-urratsa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43812_2471610_2497898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A customized rule that applies form logic without users having to write code or create plug-ins. Users can create business rules to set or clear form field values, validate data and errors, and create business recommendations based on business intelligence.</descrip></descripGrp><ntig><termGrp><term id="2471610">business rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2497898">negozioaren araua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43813_2471611_2479362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numerical summary of an organization's security posture based on system configurations, user behavior and other security related measurements that represents the extent to which an organization has adopted security controls in their Microsoft environment which can help offset the risk of being breached.</descrip></descripGrp><ntig><termGrp><term id="2471611">secure score</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2479362">segurtasun-kalifikazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43814_2471613_2497900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format used to create an action card in the Relationship Assistant in Dynamics 365.</descrip></descripGrp><ntig><termGrp><term id="2471613">card form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2497900">txartel-inprimakia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43815_2471614_2497906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The display window that shows users a variety of relevant data-driven insights and news from their contacts, watch list, leads, opportunities, accounts, and social media.</descrip></descripGrp><ntig><termGrp><term id="2471614">Insights pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2497906">Insights panela</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43816_2471615_2497896"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive designer that simplifies the app building experience so users can create and customize their own business apps with charts, entities, dashboards, forms, views, and business processes.</descrip></descripGrp><ntig><termGrp><term id="2471615">app designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2497896">aplikazio-diseinatzailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43817_2471616_2497908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive feature within the app designer that offers users a simplified way to design, edit, or customize how they view and access customer and business data.</descrip></descripGrp><ntig><termGrp><term id="2471616">view designer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2497908">ikuspegi-diseinatzailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelec