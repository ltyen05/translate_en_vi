<descrip type="definition">The Microsoft product line of enterprise resource planning (ERP) and customer relationship management (CRM) intelligent business applications.</descrip></descripGrp><ntig><termGrp><term id="3092263">Dynamics 365</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3092288">Dynamics 365</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54249_3092518_3092534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service hosted in Microsoft Dynamics 365 Lifecycle Services, designed to enhance the experience of partners and ISVs when they translate their solutions or add a new language to supported Dynamics 365 products. DTS supports the translation of user interface (UI) files, translation of documentation files, and creation of XLIFF translation memory files to be used for string recycling for future translation requests.</descrip></descripGrp><ntig><termGrp><term id="3092518">Dynamics 365 Translation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3092534">Dynamics 365 Translation Service</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54249_3092518_3092577"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service hosted in Microsoft Dynamics 365 Lifecycle Services, designed to enhance the experience of partners and ISVs when they translate their solutions or add a new language to supported Dynamics 365 products. DTS supports the translation of user interface (UI) files, translation of documentation files, and creation of XLIFF translation memory files to be used for string recycling for future translation requests.</descrip></descripGrp><ntig><termGrp><term id="3092518">Dynamics 365 Translation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3092577">Translation Service</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54249_3092520_3092534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service hosted in Microsoft Dynamics 365 Lifecycle Services, designed to enhance the experience of partners and ISVs when they translate their solutions or add a new language to supported Dynamics 365 products. DTS supports the translation of user interface (UI) files, translation of documentation files, and creation of XLIFF translation memory files to be used for string recycling for future translation requests.</descrip></descripGrp><ntig><termGrp><term id="3092520">Translation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3092534">Dynamics 365 Translation Service</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54249_30