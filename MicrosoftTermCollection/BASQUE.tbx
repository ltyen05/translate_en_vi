-US"><descripGrp><descrip type="definition">A feature where you can track all emails in a specified folder in CRM.</descrip></descripGrp><ntig><termGrp><term id="2172240">folder-level tracking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2339861">karpeta-mailen jarraipena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37963_2172241_2343234"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section that features recent conversations, the ability to reply inline and "like" comments, and the ability to open a conversation in the Outlook web app in a new tab.</descrip></descripGrp><ntig><termGrp><term id="2172241">Conversations</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2343234">Elkarrizketak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37964_2172249_2343235"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows an administrator to configure and control users' ability to access notes related to specific CRM records from within CRM. Users can also search business-related notes in OneNote across devices.</descrip></descripGrp><ntig><termGrp><term id="2172249">OneNote Integration</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></