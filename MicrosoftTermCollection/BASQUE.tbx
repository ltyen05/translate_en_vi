 xml:lang="eu"><ntig><termGrp><term id="3084255">Microsoft Surface Studio 2+</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5409_527644_2180691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object whose surface contains faces, each of which is described by a simple polygon.</descrip></descripGrp><ntig><termGrp><term id="527644">mesh</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2180691">sare</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54097_3090777_3090816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data model that empowers organizations to unify, store and prepare water measurement data from their facilities into a single data model to help meet water sustainability goals.</descrip></descripGrp><ntig><termGrp><term id="3090777">water data model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3090816">uraren datu-eredu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54102_3090778_3090780"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Emission of gases, mainly carbon dioxide from the combustion of fossil fuels: coal, oil and natural gas, that contribute to the greenhouse effect and, consequently, to the climate change of our planet.</descrip></descripGrp><ntig><termGrp><term id="3090778">GHG emission</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3090780">BEG isuri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54104_3085781_3086200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales feature powered by an AI model that scans your emails and meetings in Outlook and finds items that might be related to your work in Dynamics 365. Activity suggestions can be synced and connected to contacts, accounts, leads, or opportunities.</descrip></descripGrp><ntig><termGrp><term id="3085781">activity suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3086200">jarduera-iradokizun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54105_3085782_3086201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An AI-generated summary of a customer conversation.</descrip></descripGrp><ntig><termGrp><term id="3085782">AI summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3086201">AA laburpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54106_3085783_3086202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rule created and activated for leads and opportunities by defining conditions to automatically assign records to sellers when the defined conditions are met in Dynamics 365 Sales.</descrip></descripGrp><ntig><termGrp><term id="3085783">assignment rule</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3086202">esleipen-arau</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54107_3085784_3086203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Conversation Intelligence insight that shows the keywords that the top sellers use more frequently in conversations with customers. By analyzing this insight, you can understand what words the top sellers use that help them to close deals and generate revenue.</descrip></descripGrp><ntig><termGrp><term id="3085784">Best practice keywords</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3086203">Jardunbide egokien gako-hitzak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54108_3085785_3086204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales page that provides a high-level view of how the conversation with a customer went, and includes action items and relevant keywords, a timeline, a transcript of the call, and more.</descrip></descripGrp><ntig><termGrp><term id="3085785">call summary</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3086204">deien laburpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54109_3085786_3086205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Dynamics 365 Sales capability that enables the suggested contacts to be displayed in Teams when a seller starts a new connected chat. It helps the sellers to quickly find the right coworkers to collaborate with.</descrip></descripGrp><ntig><termGrp><term id="3085786">contact suggestion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3086205">kontaktu-iradokizun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54110_3085787_3086206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Sales Accelerator that uses the AI-based model that flags duplicate leads based on standard rules. Sellers can choose to merge duplicate leads to the primary record or delete the duplicate leads ensuring the sellers always have the right leads with the right information.</descrip></descripGrp><ntig><termGrp><term id="3085787">Data Hygiene</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3086206">Datu-garbiketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54111_3085788_3086207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The dedicated workspace in Dynamics 365 Sales for sellers to efficiently manage their sales pipeline. As a seller, you can personalize the workspace for your needs.</descrip></descripGrp><ntig><termGrp><term id="3085788">deal manager</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3086207">tratu-kudeatzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54112_3085789_3086208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ratio of the number of emails sent and received in a given opportunity, to the average sent and received ratio in all similar won deals.</descrip></descripGrp><ntig><termGrp><term id="3085789">email send/receive ratio</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3086208">bidalitako/jasotako mezuen erlazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54113_3085790_3086209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A model that analyzes patterns in historical data that users provide and learns to associate those patterns with outcomes. Then, it uses the power of AI to detect learned patterns in new data, and use them to predict future outcomes.</descrip></descripGrp><ntig><termGrp><term id="3085790">prediction model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3086209">iragarpen-eredu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54114_3085791_3086210"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows sellers to record calls by using the Teams dialer and get the most out of every call with advanced conversation intelligence capabilities such as AI-powered insights, rich call summaries, and more.</descrip></descripGrp><ntig><termGrp><term id="3085791">real-time transcription and insights</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3086210">denbora errealeko transkripzioa eta xehetasunak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54115_3085792_3086211">