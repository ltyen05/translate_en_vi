Speech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718223">kanal sozial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32761_1703328_1718204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business entity, typically a company, that provides up to date data to a Microsoft Dynamics CRM user.</descrip></descripGrp><ntig><termGrp><term id="1703328">external data provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718204">datu-hornitzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32761_1703328_1718209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business entity, typically a company, that provides up to date data to a Microsoft Dynamics CRM user.</descrip></descripGrp><ntig><termGrp><term id="1703328">external data provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718209">kanpoko datuen hornitzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32761_1703343_1718204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business entity, typically a company, that provides up to date data to a Microsoft Dynamics CRM user.</descrip></descripGrp><ntig><termGrp><term id="1703343">data service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718204">datu-hornitzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32761_1703343_1718209"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A business entity, typically a company, that provides up to date data to a Microsoft Dynamics CRM user.</descrip></descripGrp><ntig><termGrp><term id="1703343">data service provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718209">kanpoko datuen hornitzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32762_1703329_1718215"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The record that contains person-specific information (age, height, etc) in CRM.</descrip></descripGrp><ntig><termGrp><term id="1703329">person record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718215">erregistro pertsonal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32763_1703330_1718216"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Business Network feature in CRM, the connection that a person has to another person, whether explicit, where the relationship is defined, or implicit, where the people may have had contact, but the relationship is not defined.</descrip></descripGrp><ntig><termGrp><term id="1703330">person relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718216">erlazio pertsonal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32764_1703331_1718217"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that represents a person, declared as such in metadata.</descrip></descripGrp><ntig><termGrp><term id="1703331">person-type entity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718217">entitate itxurako pertsona</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32765_1703332_1718196"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entity that represents a person in the Business Network, to which person-type entities in CRM can be linked.</descrip></descripGrp><ntig><termGrp><term id="1703332">Business Network profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718196">Business Network-eko profil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32766_1703333_1718197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An explicit (for example, “colleague”) or implicit (for example,  “sent 100 emails in the last 30 days”) relationship, with inherent strength, between people in the Business Network.</descrip></descripGrp><ntig><termGrp><term id="1703333">Business Network relationship</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718197">Business Network-eko erlazioak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32767_1703334_1718200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A role that is similar to the customer service role, with the addition of being able to manage public conversations enabled and with the following permissions: organization read, BU append, BU append to, and user delete.</descrip></descripGrp><ntig><termGrp><term id="1703334">community representative</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718200">komunitatearen ordezkari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32768_1703340_1718224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In a pie chart that represents records, for example, cases broken out by source, the part of the "pie" (the slice) that represents social sources such as Facebook, Twitter, and other social channels.</descrip></descripGrp><ntig><termGrp><term id="1703340">social slice</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718224">kanal sozialen zatia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32769_1703344_1744148"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action by which a subscription (the source subscription) is replaced by a new subscription, both owned by the same billing account, along a preconfigured conversion path. The source subscription is canceled and the destination subscription is the new subscription.</descrip></descripGrp><ntig><termGrp><term id="1703344">conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1744148">bihurketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32770_1703345_1744159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A new subscription that is created as a result of a conversion or a merge.</descrip></descripGrp><ntig><termGrp><term id="1703345">destination subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1744159">helburuko harpidetza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32772_1703346_1718208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add to or augment data that is in the system, usually from an outside data service provider.</descrip></descripGrp><ntig><termGrp><term id="1703346">enrich</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1718208">aberastu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32773_1703347_1744177"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A subscription that is canceled to create a new subscription as a result of a conversion or merge.</descrip></descripGrp><ntig><termGrp><term id="1703347">source subscription</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1744177">iturburuko harpidetza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber"