e="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53417_3043785_3044187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The browser extension that allows organizations to audit and manage activities users take on sensitive items on devices running Windows 10.</descrip></descripGrp><ntig><termGrp><term id="3043785">Microsoft Purview Extension</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3044187">Microsoft Purview-ren luzapena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53433_3044721_3113499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository of data in its original, untransformed state that also provides management tools used to clean, transform, and govern the data.</descrip></descripGrp><ntig><termGrp><term id="3044721">data lakehouse</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3113499">datuen biltegia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="53433_3044721_3178872"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository of data in its original, untransformed state that also provides management tools used to clean, transform, and govern the data.</descrip></descripGrp><ntig><termGrp><term id="3044721">data lakehouse</term><termNote type="part