rip type="definition">The Windows Camera mode in which the Camera app automatically adjusts image capture settings such as exposure, ISO, sensitivity, white balance and more.</descrip></descripGrp><ntig><termGrp><term id="2389354">Auto</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2390694">Automatikoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42212_2389893_2417359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A series of points with color and varying thickness that resembles physical ink on a digital screen.</descrip></descripGrp><ntig><termGrp><term id="2389893">ink</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2417359">trazu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42213_2390287_2392831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standalone application that requires the user to have an Office 365 subscription.</descrip></descripGrp><ntig><termGrp><term id="2390287">companion app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2392831">aplikazio laguntzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote ty