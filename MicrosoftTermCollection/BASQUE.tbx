ces. Data coming from various sources often uses different fields to uniquely identify records and contains different values.</descrip></descripGrp><ntig><termGrp><term id="2579494">predictive match</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2814255">emaitza-igarle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45804_2579495_2814256"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of rules defined by the user to obtain a list of potentially matching entities, of either profiles or interactions.</descrip></descripGrp><ntig><termGrp><term id="2579495">predictive match policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2814256">emaitza-igarleen gidalerroak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45805_2579496_2814257"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scoring model based on machine learning analysis to enable business users of all skill levels to apply artificial intelligence to predict a range of business outcomes with regards to lead qualification.</descrip></descripGrp><ntig><termGrp><term id="2579496">predictive scoring model</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2814