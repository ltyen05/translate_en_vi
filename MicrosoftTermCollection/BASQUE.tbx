</termEntry><termEntry id="34756_2013318_2017971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app for the Windows Store designed for small groups of SharePoint users to enable them to perform basic tasks, such as provide access to team document libraries, site feeds, and project tasks.</descrip></descripGrp><ntig><termGrp><term id="2013318">Sites app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2017971">Guneak aplikazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34758_2013323_2775136"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A transfer of customer data from one system to another.</descrip></descripGrp><ntig><termGrp><term id="2013323">migration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2775136">migrazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="34759_2013324_2590205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A product that provides additional functionality when used with a prerequisite underlying base product.</descrip></descripGrp><ntig><termGrp><term id="2013324">add-on</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2590205">gehigarri</term><termNote typ