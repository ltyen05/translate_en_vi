over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397194">OAB distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427672">OAB banaketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14931_397194_427673"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The method by which the offline address book (OAB) can be accessed by users when they are working remotely or over a dial-up connection. To distribute the OAB, administrators can use Web-based distribution, public folder distribution, or both. Public folder distribution is required for Outlook 2003 or earlier clients.</descrip></descripGrp><ntig><termGrp><term id="397194">OAB distribution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427673">lineaz kanpoko helbide-liburuen banaketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14937_397209_427627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of well-connected Exchange servers between which no connector is required for message transfer.</descrip></descripGrp><ntig><termGrp><term id="397209">routing group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427627">banabideko talde</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14944_262698_440576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer graphics, a display method in which a viewing window on the screen scans horizontally or vertically, like a camera, to bring offscreen extensions of the current image smoothly into view.</descrip></descripGrp><ntig><termGrp><term id="262698">pan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440576">panoramiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14944_779138_440576"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer graphics, a display method in which a viewing window on the screen scans horizontally or vertically, like a camera, to bring offscreen extensions of the current image smoothly into view.</descrip></descripGrp><ntig><termGrp><term id="779138">panning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440576">panoramiko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14948_245218_440507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A common point of entry for spyware guarded by an agent. Examples of checkpoints include Startup Folder, dial up connections, Wi-Fi connections, Internet Safe Sites, Winsock Layered Service Providers, Windows Messenger Service, and SPAM Zombie prevention.</descrip></descripGrp><ntig><termGrp><term id="245218">checkpoint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440507">kontrol-puntu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14949_397216_427735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of mailbox stores and public folder stores that share a set of transaction log files. Exchange manages each storage group with a separate server process.</descrip></descripGrp><ntig><termGrp><term id="397216">storage group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427735">bilketa-talde</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14953_38284_439421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric or string value that is not calculated and, therefore, does not change.</descrip></descripGrp><ntig><termGrp><term id="38284">constant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439421">konstante</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14954_78795_439721"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To enlarge a window to its largest size by double-clicking the title bar, clicking the Maximize button (at the right of the title bar), or by pressing ALT+SPACEBAR and then pressing X.</descrip></descripGrp><ntig><termGrp><term id="78795">maximize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439721">maximizatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14962_397223_427726"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined security group that provides specific permissions to allow role members to manage Exchange configuration data. Exchange 2007 provides the following four administrator roles: Exchange Recipient Administrators, Exchange Organization Administrators, Exchange Server Administrators, and Exchange View-Only Administrators.</descrip></descripGrp><ntig><termGrp><term id="397223">administrator role</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427726">administratzaile-funtzio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14963_3046991_3048145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to control a video game. For example, a joystick, mouse, or gamepad.</descrip></descripGrp><ntig><termGrp><term id="3046991">controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3048145">kontrolatzailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14963_57667_3048145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A device used to control a video game. For example, a joystick, mouse, or gamepad.</descrip></descripGrp><ntig><termGrp><term id="57667">game controller</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3048145">kontrolatzailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14964_265316_1228239"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an operator that can hold an arbitrary number of arguments, or to a function that can hold an arbitrary number of operators.</descrip></descripGrp><ntig><termGrp><term id="265316">n-ary</term><termNote type="partOfSpeech">Adjective