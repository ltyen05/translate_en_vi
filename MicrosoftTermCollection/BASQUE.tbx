="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3100654">enpresaren batera moduaren eszena</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54580_3100695_3101290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The retail media advertising platform that connects brands with the world's largest retailers and their active shoppers.</descrip></descripGrp><ntig><termGrp><term id="3100695">PromoteIQ</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101290">PromoteIQ</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54581_3100752_3101284"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that integrates the most common PC/desktop management functions: virus inspection, trash cleaning, system repair/upgrade, system optimization, application management, pop-up blocking.</descrip></descripGrp><ntig><termGrp><term id="3100752">PC Manager</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101284">PC kudeatzailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54582_3100753_3101286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within the PC Manager app that boosts PC performance by freeing memory.</descrip></descripGrp><ntig><termGrp><term id="3100753">PC Boost</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101286">PC-aren errendimendu-hobekuntza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54583_3100754_3101287"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature within the PC Manager app that protects the operational system default browser settings from unexpected changes.</descrip></descripGrp><ntig><termGrp><term id="3100754">Browser Protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3101287">Arakatzailearen babesa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="54587_3113361_3114075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft Entra product that enables securing and managing workloads, such as applications, service principals, managed identities and other software components that need to access cloud resources.</descrip></descripGrp><ntig><termGrp><term id="3113361">Microsoft Entra Workload ID</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammati