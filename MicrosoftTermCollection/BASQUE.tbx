">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6304_2801927_440156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A way to arrange data based on value or data type.</descrip></descripGrp><ntig><termGrp><term id="2801927">order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440156">ordenatzeko irizpide</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6306_146058_440138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A database that contains only a subset of the records in a full replica.</descrip></descripGrp><ntig><termGrp><term id="146058">partial replica</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440138">erreplika partzial</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6308_64546_439615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of files and folders (sometimes compressed into one file) that duplicates the original file and folder structure of an operating system. It often contains other files added by the OEM or corporation.</descrip></descripGrp><ntig><termGrp><term id="64546">image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439615">irudi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6309_178700_2072364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To connect or associate items or data such as contacts, accounts, or worksheets.</descrip></descripGrp><ntig><termGrp><term id="178700">link</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2072364">estekatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6309_178700_2349385"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To connect or associate items or data such as contacts, accounts, or worksheets.</descrip></descripGrp><ntig><termGrp><term id="178700">link</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2349385">lotu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6316_155655_440195"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For files, information that indicates whether a file is read-only, hidden, ready for archiving (backing up), compressed, or encrypted, and whether the file contents should be indexed for fast file searching.</descrip></descripGrp><ntig><termGrp><term id="155655">attribute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440195">atributu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6317_262429_440533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security method used by wireless networks. WPA encrypts the information that is sent between computers on a wireless network and authenticates users to help ensure that only authorized people can access the network.</descrip></descripGrp><ntig><termGrp><term id="262429">Wi-Fi Protected Access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440533">WiFi sarbide babestu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6317_262429_440534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security method used by wireless networks. WPA encrypts the information that is sent between computers on a wireless network and authenticates users to help ensure that only authorized people can access the network.</descrip></descripGrp><ntig><termGrp><term id="262429">Wi-Fi Protected Access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440534">WPA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6317_262430_440533"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security method used by wireless networks. WPA encrypts the information that is sent between computers on a wireless network and authenticates users to help ensure that only authorized people can access the network.</descrip></descripGrp><ntig><termGrp><term id="262430">WPA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440533">WiFi sarbide babestu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6317_262430_440534"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security method used by wireless networks. WPA encrypts the information that is sent between computers on a wireless network and authenticates users to help ensure that only authorized people can access the network.</descrip></descripGrp><ntig><termGrp><term id="262430">WPA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440534">WPA</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6319_343640_441015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of managing business and/or social contacts in order to follow up, track conversations, etc.</descrip></descripGrp><ntig><termGrp><term id="343640">contact management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="441015">kontaktuen kudeaketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6331_146525_2094277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form that stays on top of other windows. A pop-up form can be modal or modeless.</descrip></descripGrp><ntig><termGrp><term id="146525">pop-up form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2094277">inprimaki gainerakor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6333_184278_2486405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A BIOS developed to enable system-related information, such as information about hardware, to be gathered from computers on a network.</descrip></descripGrp><ntig><termGrp><term id="184278">SMBIOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2486405">SMBIOS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6333_184279_2486405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A BIOS developed to enable system-related information, such as information about hardware, to be gathered from computers on a network.</descrip></descripGrp><ntig><termGrp><term id="184279">system management BIOS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2486405">SMBIOS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6349_345311_441018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of arranging data based on the order of specified information. For example, records sorted by class would list all records within a class before moving to records in the next class.</descrip></descripGrp><ntig><termGrp><term id="345311">sorting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="441018">sailkapen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6350_276560_1788286"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The utility in Windows Vista that presents a view of all PCs, devices, and printers on the network, and is significantly faster and more reliable than My Network Places in Windows XP.</descrip></descripGrp><ntig><termGrp><term id="276560">Network Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1788286">sare-esploratzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6352_152788_2594594"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method by which a client receives a stream, during which he/she cannot control the stream.</descrip></descripGrp><ntig><termGrp><term id="152788">broadcast</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2594594">igorpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6360_544306_1355349"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The configuration of a particular build.</descrip></descripGrp><ntig><termGrp><term id="544306">build configuration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355349">konpilazio-konfigurazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6362_99210_2998740"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that can be represented in a number system with a given base, such as the decimal system, by a finite or infinite sequence of digits and a radix point. For example, 1.1 is a real number, as is 0.33333....</descrip></descripGrp><ntig><termGrp><term id="99210">real number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2998740">zenbaki erreal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6366_182360_1276822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To specify the owner of a record, such as an account or case, or an activity, such as an email message or phone call. Users can assign cases and activities to either a user or a queue.</descrip></descripGrp><ntig><termGrp><term id="182360">assign</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1276822">esleitu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6374_58539_1228150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A domain controller that holds a copy of the global catalog for the forest.</descrip></descripGrp><ntig><termGrp><term id="58539">global catalog server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228150">katalogo orokorraren zerbitzari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6378_7117_1789476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entry in either a securable object's discretionary access control list (DACL) or an object's system access control list (SACL). In a DACL, the entry grants or denies permissions to a user or group. In a SACL, the entry specifies which security events to audit for a particular user or group or controls the Windows Integrity Level for the object.</descrip></descripGrp><ntig><termGrp><term id="7117">access control entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1789476">ACE</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6378_7117_362856"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An entry in either a securable object's discretionary access control list (DACL) or an object's system access control list (SACL). In a DACL, the entry grants or denies permissions to a user or group. In a SACL, the entry specifies which security events to audit for a particular user or group or controls the Windows Integrity Level for the object.</descrip></descripGrp><ntig><termGrp><term id="7117">access control entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="362856">sarbide-kontroleko sarrera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNo