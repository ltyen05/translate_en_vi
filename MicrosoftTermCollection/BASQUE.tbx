"definition">To work in one location (often at home) and communicate with a main office at a different location through a personal computer equipped with a modem and communications software.</descrip></descripGrp><ntig><termGrp><term id="1266979">telework</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2587387">urrunetik lan egin</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21342_1266979_2587390"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To work in one location (often at home) and communicate with a main office at a different location through a personal computer equipped with a modem and communications software.</descrip></descripGrp><ntig><termGrp><term id="1266979">telework</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2587390">urruneko lan</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21342_771158_2587387"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To work in one location (often at home) and communicate with a main office at a different location through a personal computer equipped with a modem and communications software.</descrip></descripGrp><ntig><termGrp><term id="771158">telecommute</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></la