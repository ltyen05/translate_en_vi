 the commands that pertain to them.</descrip></descripGrp><ntig><termGrp><term id="719746">Solution Explorer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1979238">Irtenbide-esploratzailea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2023_136809_440051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A link that specifies a full path to a resource, such that the destination of the link doesn’t change based on where it is linking from.</descrip></descripGrp><ntig><termGrp><term id="136809">absolute link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440051">esteka absolutu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2025_93650_1794961"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The POP protocol that is used to retrieve email and that supports download-and-delete from a remote mailbox.</descrip></descripGrp><ntig><termGrp><term id="93650">POP3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1794961">POP3</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gr