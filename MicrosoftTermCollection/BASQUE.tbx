nition">The number of bits transmitted every second, used as a measure of the speed at which a device, such as a modem, can transfer data.</descrip></descripGrp><ntig><termGrp><term id="153112">bps</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440186">bps</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26690_1347061_1355384"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the Hotmail quick view that displays only the email messages that originate from a social networking service such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347061">Social updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355384">Eguneratze sozialak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26691_1347063_1355386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spam-fighting program that Hotmail runs where actual customers classify email messages as "junk" or "not junk." Because the program is by invitation only, customers who participate are highly engaged. The Hotmail team reported in 2010 that more than half of the spam fighters participate daily. Invitations to the program are extended to a cross-section of customers who reflect the broad population of Hotmail customers in several dimensions, including age of account and country or region. Under the program, Hotmail resends an actual message that was addressed to the spam fighter. One message per day at the most is sent.</descrip></descripGrp><ntig><termGrp><term id="1347063">Spam Fighters program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355386">Spam Fighters programa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26691_1354361_1355386"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The spam-fighting program that Hotmail runs where actual customers classify email messages as "junk" or "not junk." Because the program is by invitation only, customers who participate are highly engaged. The Hotmail team reported in 2010 that more than half of the spam fighters participate daily. Invitations to the program are extended to a cross-section of customers who reflect the broad population of Hotmail customers in several dimensions, including age of account and country or region. Under the program, Hotmail resends an actual message that was addressed to the spam fighter. One message per day at the most is sent.</descrip></descripGrp><ntig><termGrp><term id="1354361">Feedback Loop program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355386">Spam Fighters programa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26692_1347064_1355756"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A rating system for online games.</descrip></descripGrp><ntig><termGrp><term id="1347064">game rating system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355756">jokoen balorazio-sistema</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26696_1347068_1355389"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conversation that is displayed with other conversations in one window. The conversations are loaded into sections or tabs of the window, rather than in multiple windows.</descrip></descripGrp><ntig><termGrp><term id="1347068">tabbed conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355389">fitxa bidezko solasaldi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26697_1347069_1355382"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the view in Messenger that displays the social activity of friends.</descrip></descripGrp><ntig><termGrp><term id="1347069">social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355382">soziala</term><termNote type="geographica