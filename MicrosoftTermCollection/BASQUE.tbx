725949_1797800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of visual elements and sounds for your computer desktop or device User Interface. A theme determines the look of the various visual elements of your User Interface, such as windows, icons, fonts, and colors, and it can include sounds.</descrip></descripGrp><ntig><termGrp><term id="725949">theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1797800">gai</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20542_725950_1797800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of visual elements and sounds for your computer desktop or device User Interface. A theme determines the look of the various visual elements of your User Interface, such as windows, icons, fonts, and colors, and it can include sounds.</descrip></descripGrp><ntig><termGrp><term id="725950">desktop theme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1797800">gai</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20543_760171_2279991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Internet Explorer feature that allows users to surf the Web without leaving a browsing history, cookies or other information on the PC so they can do online banking on a shared computer, for example.</descrip></descripGrp><ntig><termGrp><term id="760171">InPrivate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2279991">InPrivate</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20560_725996_1768204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service for wireless products that allows users to send and receive brief messages consisting of text and numbers to and from mobile phones and devices.</descrip></descripGrp><ntig><termGrp><term id="725996">SMS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1768204">SMS</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20569_726147_1097069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that is part of a OneCare circle but is not a hub PC or a monitor PC. A device PC has no privileges to monitor or make changes to any other computer in the OneCare circle.</descrip></descripGrp><ntig><termGrp><term id="726147">device PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097069">gailu PC</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20584_726168_1097129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that is not the hub PC but that monitors the activity of other computers in the OneCare circle. The OneCare subscription administrator designates which, if any, computers in the circle have monitoring privileges. A monitor PC cannot make changes to any other computer in the OneCare circle.</descrip></descripGrp><ntig><termGrp><term id="726168">monitor PC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1097129">PC monitore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20595_726386_2002415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A virtual community that provides people with opportunities to interact (via blogs, chats, newsgroups, webcasts, user groups, and forums) with Microsoft employees, experts, and peers in order to share knowledge and news about Microsoft technology.</descrip></descripGrp><ntig><termGrp><term id="726386">Microsoft community</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2002415">Microsoft komunitate</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20600_726850_1228301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sound made by a mobile device or other phone to indicate an incoming call or message, for example, a series of beeps or an audio recording.</descrip></descripGrp><ntig><termGrp><term id="726850">ringtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228301">txirrin-tonu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20600_726850_2085420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The sound made by a mobile device or other phone to indicate an incoming call or message, for example, a series of beeps or an audio recording.</descrip></descripGrp><ntig><termGrp><term id="726850">ringtone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2085420">dei-tonu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20602_727015_2322283"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A calendar view that displays all scheduled items.</descrip></descripGrp><ntig><termGrp><term id="727015">Agenda view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2322283">agenda-ikuspegi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20606_727019_1954144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An alert that is set by the user to be activated at a particular time.</descrip></descripGrp><ntig><termGrp><term id="727019">alarm</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1954144">alarma</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20612_727401_1228302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An authentication device that digitally scans an individual's fingerprint, records the unique pattern of the individual's ridges and valleys, and determines if the pattern matches the pattern of the person who has access permission to a particular device, such as a computer or a phone, or to a Web site.</descrip></descripGrp><ntig><termGrp><term id="727401">fingerprint reader</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228302">hatz-marken irakurle</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20613_727416_1228303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A renamed .cab file which contains a .theme file, and optionally one or more desktop backgrounds, icons, mouse pointer files, and sound files. It does not conta