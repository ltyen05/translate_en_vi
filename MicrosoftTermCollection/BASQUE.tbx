ig><termGrp><term id="2821624">team flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2824642">talde-fluxu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49906_2822727_2827249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The baseline subscription-based offering of Microsoft Project.</descrip></descripGrp><ntig><termGrp><term id="2822727">Project Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2827249">Project-en 1. plana</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49907_2822739_2827250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The subscription-based offering of Microsoft Project that includes the baseline functions (Project Plan 1), plus a desktop client for up to 5 machines and some additional functions such as for reporting and resource management.</descrip></descripGrp><ntig><termGrp><term id="2822739">Project Plan 3</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2827250">Project-en 3. plana</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="g