rip type="definition">To assign or reserve a portion of an element, such as a resource or a session, for a particular use or purpose.</descrip></descripGrp><ntig><termGrp><term id="11020">allocate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439227">esleitu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1477_149955_2734830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The API that developers can use for creating applications that run on Windows 95 or later.</descrip></descripGrp><ntig><termGrp><term id="149955">Windows API</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2734830">Windows API</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14774_397165_427624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process by which an administrator can manually move a clustered mailbox server between nodes in a cluster. A handoff should only be performed by using the Move-ClusteredMailboxServer cmdlet in the Exchange Management Shell.</descrip></descripGrp><ntig><termGrp><term id="397165">handoff</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427624">pasatze</term><termNote type="geographicalUsa