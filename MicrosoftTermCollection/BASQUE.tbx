ig><termGrp><term id="1355374">urruneko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37900_2169170_2798410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The attack method where the attacker steals a user’s Kerberos authentication ticket to impersonate that user and access various enterprise resources.</descrip></descripGrp><ntig><termGrp><term id="2169170">Pass-the-Ticket</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2798410">Pass-the-Ticket</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37900_2169171_2798410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The attack method where the attacker steals a user’s Kerberos authentication ticket to impersonate that user and access various enterprise resources.</descrip></descripGrp><ntig><termGrp><term id="2169171">PtT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2798410">Pass-the-Ticket</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37907_2169233_2692169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pay-as-you-go sec