ard module</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2094334">modulu estandar</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26804_1356707_1375350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user interface control in Microsoft Dynamics CRM where you can create and edit forms for an entity.</descrip></descripGrp><ntig><termGrp><term id="1356707">form editor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1375350">inprimaki-editore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26842_1357076_1790034"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that allows users to meet in virtual rooms on a server running Exchange.</descrip></descripGrp><ntig><termGrp><term id="1357076">Exchange Conferencing Services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1790034">Exchange konferentzia-zerbitzu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26843_1357077_1787542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of search which is restricted to a specific domain, such as news search, image search, local search.</descrip></descripGrp><ntig><termGrp><term id="1357077">vertical search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1787542">bilaketa bertikala</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2687_62883_2094206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ready-made or pre-designed web page that can be modified for a custom design.</descrip></descripGrp><ntig><termGrp><term id="62883">HTML template</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2094206">HTML txantiloi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26891_1358013_2392417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who connects to the home network or business network using a computer connected to the Internet.</descrip></descripGrp><ntig><termGrp><term id="1358013">remote user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2392417">urruneko erabiltzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26894_1358510_2796085"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technology used by Exchange to store user mailboxes and folders. A store consists of a rich-text database (.edb), plus a streaming native Internet content database (.stm).</descrip></descripGrp><ntig><termGrp><term id="1358510">store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796085">biltegi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2690_19121_439270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key that moves the cursor to the left, one character at a time, usually erasing each character as it moves.</descrip></descripGrp><ntig><termGrp><term id="19121">BACKSPACE key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439270">ATZERA tekla</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26902_1358990_1375365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form that is displayed when another form option isn’t explicitly set. An example would be if an administrator fails to define a form for a particular security group that has access to the application.</descrip></descripGrp><ntig><termGrp><term