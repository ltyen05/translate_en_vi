fSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2369113">prezio finkoko proiektu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2670_627844_2369113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of project in which the customer pays a predetermined amount for the entire project.</descrip></descripGrp><ntig><termGrp><term id="627844">fixed fee job</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2369113">prezio finkoko proiektu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26700_1347072_1355346"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom-created layout of photos in an album.</descrip></descripGrp><ntig><termGrp><term id="1347072">arrangement</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355346">antolaera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26702_1347074_1355375"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that lets you work on your computer from a different computer.</descrip></descripGrp><ntig><termGrp><term id="1347074">remote connection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355375">urruneko konexio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26703_1347075_1355365"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tooltip that is displayed when hovering over a personal folder on the Manage Folders webpage.</descrip></descripGrp><ntig><termGrp><term id="1347075">Personal Folder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355365">Karpeta pertsonala</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26704_1347076_1355388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the list of synced folders.</descrip></descripGrp><ntig><termGrp><term id="1347076">Synced folders</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355388">Karpeta sinkronizatuak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26705_1347077_1355359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI element that allows users to set permissions for an item or content so that is not made available to anyone else, thus making it private.</descrip></descripGrp><ntig><termGrp><term id="1347077">Just me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355359">Ni bakarrik</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26706_1347078_1355361"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for the social activity stream that Windows Live programmatically displays in a collection. Items listed may originate within a Windows Live program, service, or landing page (Messenger, OneDrive, Windows Live Photos), or in third-party activities people connect to their profiles, such as Facebook.</descrip></descripGrp><ntig><termGrp><term id="1347078">Messenger social</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355361">Messenger soziala</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26707_1347079_1355354"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To manually edit and make adjustments to your photos.</descrip></descripGrp><ntig><termGrp><term id="1347079">fine tune</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355354">doitu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26708_1347080_1355356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A metadata tag that includes GPS latitude and longitude coordinates to specify a location. Geotags are typically used to find and organise photos and videos.</descrip></descripGrp><ntig><termGrp><term id="1347080">geotag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355356">geoetiketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26709_1347081_1355381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To present items within a set in no established order, as opposed to ordering items by name, by date taken, by size, etc., and typically used with audio and visual media, such as album song order or photo slide shows.</descrip></descripGrp><ntig><termGrp><term id="1347081">shuffle</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355381">ausaz</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adverb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26710_1347082_1355635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to share stories with others using their digital photos and photo management software.</descrip></descripGrp><ntig><termGrp><term id="1347082">storytelling</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355635">istorio-kontaketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26714_1347086_1355366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To add a personal touch to something.</descrip></descripGrp><ntig><termGrp><term id="1347086">personalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355366">pertsonalizatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26719_1347108_1355371"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that provides one-click access to a subset of email messages based on specific criteria, which include: flagged (messages that the customer has designated as requiring follow-up), photos (messages that contain photos), and social updates (messages that originate from a social networking service such as Facebook).</descrip></descripGrp><ntig><termGrp><term id="1347108">quick view</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355371">ikuspegi bizkor</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26720_1347110_1355355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The webpage subheading for the view in Messenger that displays someone's friends and contacts that aren't friends but that can be interacted with in Messenger (those are often legacy entries).</descrip></descripGrp><ntig><termGrp><term id="1347110">friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355355">lagunak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26727_1354360_1375355"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A territory, and its information, that is included within another territory.</descrip></descripGrp><ntig><termGrp><term id="1354360">sub-territory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1375355">azpilurralde</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26728_1354362_1385639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Hotmail that's designed to help people get more done on the web without having to leave their inbox. Active View displays directly in the body of the email message, showing either previews to other web content or interactive elements created by the sender that let the recipient complete core tasks. A preview message example might include a reference to a file on a photo-sharing or video-sharing website that the recipient can view in the message, or package-tracking information that's extracted from a shipping website. Interactive scenarios might include rating movies and updating wish lists on movie-rental websites or responding to invitations or comments on social networking websites.</descrip></descripGrp><ntig><termGrp><term id="1354362">Active View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1385639">Ikuspegi aktiboa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1354369_1990029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1354369">desktop application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1990029">mahaigaineko programa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1505030_1990029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1505030">desktop app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1990029">mahaigaineko programa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26735_1986256_1990029"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is meant to run on a desktop or laptop computer.</descrip></descripGrp><ntig><termGrp><term id="1986256">desktop program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1990029">mahaigaineko programa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1354381_1355393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1354381">Video Messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355393">Bideo-mezuak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1354381_2057572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1354381">Video Messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2057572">bideo-mezuak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1815478_1355393"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1815478">video messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355393">Bideo-mezuak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26737_1815478_2057572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users a rich way to send video messages asynchronously to another user.</descrip></descripGrp><ntig><termGrp><term id="1815478">video messages</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2057572">bideo-mezuak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26738_1354382_1355370"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to access their other POP3 enabled email accounts from within their central email account.</descrip></descripGrp><ntig><termGrp><term id="1354382">POP aggregation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355370">POP agregazioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26740_1354385_1385640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A small image that provides a visual indication of roles, contribution levels, achievements, affiliations, etc.</descrip></descripGrp><ntig><termGrp><term id="1354385">badge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1385640">bereizgarri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26742_1354388_1355350"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contact list designed for use within a form for selecting contacts. Users can click a contact to select it and may make multiple selections by using CTRL+click.</descrip></descripGrp><ntig><termGrp><term id="1354388">contact picker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1355350">kontaktu-hautatzaile</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26773_1355136_3134324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trusted industry standard in online pharmacy verification. Established in 2003, the PharmacyChecker Verification Program helps protect consumers by ensuring that the prescription drugs they order come from qualified online pharmacies.</descrip></descripGrp><ntig><termGrp><term id="1355136">PharmacyChecker</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3134324">PharmacyChecker</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26782_1355242_2780948"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary SharePoint Server management plan that identifies what is considered a record, what category the record belong to, where the records are stored, record retention period, and who manages the record.</descrip></descripGrp><ntig><termGrp><term id="1355242">file plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:l