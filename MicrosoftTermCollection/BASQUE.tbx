 button that allows users to purchase Skype Credit for their Skype account.</descrip></descripGrp><ntig><termGrp><term id="1805602">Buy Skype Credit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2737583">Skype saldoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33611_2713985_2057485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that allows users to purchase Skype Credit for their Skype account.</descrip></descripGrp><ntig><termGrp><term id="2713985">Skype Credit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2057485">Erosi Skype saldoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33611_2713985_2737583"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The button that allows users to purchase Skype Credit for their Skype account.</descrip></descripGrp><ntig><termGrp><term id="2713985">Skype Credit</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2737583">Skype saldoa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNu