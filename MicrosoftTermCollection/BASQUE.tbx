nk.</descrip></descripGrp><ntig><termGrp><term id="1766393">Instant Answers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1787531">Berehalako erantzunak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33314_1766409_1787538"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Bing that shows the words you searched for and the sites you've visited, along with the date and time of your search.</descrip></descripGrp><ntig><termGrp><term id="1766409">Search History</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1787538">Bilaketa-historia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33318_1767736_1815578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app that uses the server-to-server (S2S) protocol, where the app is responsible for creating the user portion of the access token, and therefore is trusted to assert any user identity.</descrip></descripGrp><ntig><termGrp><term id="1767736">high-trust app</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1815578">fidagarritasun handiko aplikazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><