ber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2437268">zerbitzuaren izen nagusia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40430_2347754_2349143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering domestic calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347754">Skype for Business PSTN Domestic Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2349143">Skype for Business dei analogiko nazionalak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40431_2347755_2349144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering international calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347755">Skype for Business PSTN International Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2349144">Nazioarteko Skype for Business dei analogikoak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40432_2347756_2349142"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service plan offer covering domestic and international calls as part of the PSTN Calling service in Office 365.</descrip></descripGrp><ntig><termGrp><term id="2347756">Skype for Business PSTN Domestic and International Calling</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2349142">Skype for Business dei analogiko nazionalak eta nazioartekoak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40433_2348753_2348932"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The agent for personal or enterprise use to keep data fresh by connecting to on-premises data sources.</descrip></descripGrp><ntig><termGrp><term id="2348753">Power BI Gateway</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2348932">Power BI Gateway</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40434_2348755_2348933"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The enterprise version of Power BI Gateway that enables IT departments to deploy, configure, manage and maintain a group of central gateways to serve a large group of users instead of having each employee install and configure a Power BI Gateway - Personal and transparently refresh data uploaded to Power BI for users requiring up-to-date data, with direct query support to SQL Server.</descrip></descripGrp><ntig><termGrp><term id="2348755">Power BI Gateway - Enterprise</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2348933">Power BI Gateway - Enterprise</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40435_2348758_2348931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The client agent that enables Power BI to connect to on-premises SQL Server Analysis Services instances and author interactive reports and dashboards based on role membership on that instance.</descrip></descripGrp><ntig><termGrp><term id="2348758">Power BI Analysis Services Connector</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2348931">Power BI Analysis Services Connector</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40436_2349281_2352399"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item showing hearts (number of likes) for a given chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349281">Show likes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2352399">Erakutsi bihotzak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40438_2349283_2352397"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item connected the heart-feature, whereby a participant can remove a "heart" from a chat message, indicating that the participant does not like a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349283">Unlike</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2352397">Kendu bihotza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40439_2349284_2352388"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An amount of money added to an account.</descrip></descripGrp><ntig><termGrp><term id="2349284">credit</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2352388">saldo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40440_2349285_2352396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item connected the heart-feature, whereby a participant can give a "heart" to a chat message, indicating that the participant likes a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349285">Like</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2352396">Eman bihotza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40441_2349286_2352398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of hearts showing how many particpant have liked a chat message. The heart-feature refers to giving and removing hearts and is distinct from the Like-feature known from e.g. Facebook.</descrip></descripGrp><ntig><termGrp><term id="2349286">Likes</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2352398">Bihotzak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40449_2350535_2424178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure service for virtual machines (VMs) that helps address organizational security and compliance requirements by encrypting the VM boot and data disks with keys and policies that are controlled in Azure Key Vault.</descrip></descripGrp><ntig><termGrp><term id="2350535">Azure Disk Encryption</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2424178">Azure Disk Encryption</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40449_2901999_2424178"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Azure service for virtual machines (VMs) that helps address organizational security and compliance requirements by encrypting the VM boot and data disks with keys and policies that are controlled in Azure Key Vault.</descrip></descripGrp><ntig><termGrp><term id="2901999">ADE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2424178">Azure Disk Encryption</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4045_475243_1335581"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security access level that allows a user access to record types in the user's business unit and all business units subordinate to the user's business unit.</descrip></descripGrp><ntig><termGrp><term id="475243">Parent: Child Business Units</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1335581">Nagusia: bigarren mailako negozio-unitateak</term><termNote type="geographicalUsage">ESP</termNote><termNote typ