65561_2369118"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of the financial consequence an accounting event.</descrip></descripGrp><ntig><termGrp><term id="1465561">journal entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2369118">egunkari-idazpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27834_1465563_2369120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To record the financial consequences of accounting events in the subledger journal.</descrip></descripGrp><ntig><termGrp><term id="1465563">journalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2369120">erregistratu kutxako liburuan</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="27850_1465579_2322285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A class of notification that is generated by user-defined rules meant to inform him/her of events, conditions, and status changes.</descrip></descripGrp><ntig><termGrp><term id="1465579">alert</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2322285">alerta-mezu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote>