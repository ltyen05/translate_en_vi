ry id="46028_2594504_2596507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of out-of-box content allowing users to immediately gain insights from a source.</descrip></descripGrp><ntig><termGrp><term id="2594504">content pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2596507">eduki-pakete</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46031_2594560_2796081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository to store secrets in an encrypted way.</descrip></descripGrp><ntig><termGrp><term id="2594560">secured secret store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796081">sekretu-biltegi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46031_2793216_2796081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A repository to store secrets in an encrypted way.</descrip></descripGrp><ntig><termGrp><term id="2793216">secret store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2796081">sekretu-biltegi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46037_2594855_2645476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data platform designed for data warehousing and Big Data analytics which offers deep data integration, high-speed query processing, scalable storage, and simple maintenance for your end-to-end business intelligence solutions.</descrip></descripGrp><ntig><termGrp><term id="2594855">Microsoft Analytics Platform System</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2645476">Microsoft Analytics Platform System</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46037_2594856_2645476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The data platform designed for data warehousing and Big Data analytics which offers deep data integration, high-speed query processing, scalable storage, and simple maintenance for your end-to-end business intelligence solutions.</descrip></descripGrp><ntig><termGrp><term id="2594856">APS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2645476">Microsoft Analytics Platform System</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46046_2594916_2597096"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center where people can see, access, and troubleshoot features related to their accounts, including device login, Windows Hello, Dynamic Lock, and other convenience and security features related to accounts and login.</descrip></descripGrp><ntig><termGrp><term id="2594916">account protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2597096">kontuaren babesa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46047_2594920_2597097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center, within Ransomware protection, where customers can set up or initiate file restores with cloud providers, to help recover from a ransomware attack (which often encrypts files).</descrip></descripGrp><ntig><termGrp><term id="2594920">Ransomware data recovery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2597097">Erreskatea eskatzen duen malwarearen datuak berreskuratzea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46048_2594927_2597098"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Windows Defender Security Center, the area within the Virus &amp; threat protection section (pillar), where customers can find and use features to help prevent or recover from ransomware attacks.​</descrip></descripGrp><ntig><termGrp><term id="2594927">Ransomware protection</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2597098">Erreskatea eskatzen duen malwarearen babesa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46049_2594936_2597099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Defender Security Center, the area within the Virus &amp; threat protection section (pillar) where customers can see the history of the threats found on their devices.</descrip></descripGrp><ntig><termGrp><term id="2594936">Threat history</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2597099">Mehatxuen historia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46050_2594944_2597100"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Defender Security Center app on Windows 10, the area within the Virus &amp; threat protection section (pillar) where customers can see information about ​the definitions being used to recognize the latest threats on their device, and check for updates to those definitions.</descrip></descripGrp><ntig><termGrp><term id="2594944">Virus &amp; threat protection updates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2597100">Birusen eta mehatxuen aurkako babesaren eguneratzeak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46052_3029685_3030462"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to make and receive calls and texts, check notifications, and instantly access their Android device's photos and apps from their Windows PC.</descrip></descripGrp><ntig><termGrp><term id="3029685">Phone Link</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3030462">Mugikor-konexioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46053_2594977_2920149"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A partnership program for game streamers to represent the Mixer community in the online world. Participants in the Mixer Partnership Program can benefit from more transcoding options, custom emoticons, testing of new features, priority support, promotional opportunities and more.</descrip></descripGrp><ntig><termGrp><term id="2594977">Mixer Partnership Program</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2920149">Mixer lankidetza-programa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46054_2594978_2920150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Legally binding document that defines the terms of the relationship between participants in the Mixer Partnership Program and Microsoft Corporation.</descrip></descripGrp><ntig><termGrp><term id="2594978">Mixer Program Agreement</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2920150">Mixer programaren kontratu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46057_2594988_2597105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The partner (authorized by the Microsoft Partner Network) that is associated as the customer’s transacting partner on a cloud subscription.</descrip></descripGrp><ntig><termGrp><term id="2594988">transacting partner of record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2597105">erregistroaren transakzio-bazkide</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46058_2594992_2597104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The partner (authorized by the Microsoft Partner Network) who is helping the customer design, build, deploy or manage a solution that they have built on the service. It is not the partner who sold the subscription.</descrip></descripGrp><ntig><termGrp><term id="2594992">digital partner of record</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2597104">erregistroaren bazkide digital</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46061_2595007_2601613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The participant in the Xbox Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2595007">Xbox Insider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2601613">Xbox Insider</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46061_2595007_3114541"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The participant in the Xbox Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2595007">Xbox Insider</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3114541">Insider</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46061_3114521_2601613"><langSet xml:l