try><termEntry id="51029_2882000_2882499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Sales Hub tab available under activities for leads and opportunities. When a customer call regarding a lead or opportunity is processed in Conversation Intelligence, the Call Insights tab displays the information on the summary of the call.</descrip></descripGrp><ntig><termGrp><term id="2882000">Call Insights</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2882499">Deiaren xehetasunak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5103_312764_1227621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Internet Explorer, a set of tabs you can store in your Favorites or as Home Page to reopen all tabs in the set in one go.</descrip></descripGrp><ntig><termGrp><term id="312764">tab set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1227621">fitxa multzo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51030_2882001_2882500"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Dynamics 365 Sales Insights, optimization of insight cards that are important and their promotion to display at the top.</descrip></descripGrp><ntig><termGrp><term id="2882001">card ranking</term><termNote type="partOfSpeech">Noun</termNote><termNote type="gram