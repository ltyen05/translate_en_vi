2009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The AI-enhanced web search experience that supports users by summarizing web search results and providing a chat experience. Users can also generate creative content, such as poems, jokes, stories, and more.</descrip></descripGrp><ntig><termGrp><term id="3193308">Microsoft 365 Copilot in Bing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192009">Copilot Bing-en</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56679_3191194_3192004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft technology that provides built-in generative AI for Microsoft Viva services.</descrip></descripGrp><ntig><termGrp><term id="3191194">Copilot in Viva</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192004">Copilot Viva-n</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56679_3193313_3192004"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft technology that provides built-in generative AI for Microsoft Viva services.</descrip></descripGrp><ntig><termGrp><term id="3193313">Microsoft 365 Copilot in Viva</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192004">Copilot Viva-n</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56680_3191195_3192006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unified Copilot experience in Microsoft Loop that enables users to brainstorm, outline a plan, and draft content.</descrip></descripGrp><ntig><termGrp><term id="3191195">Copilot in Loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192006">Copilot Loop-en</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56680_3193311_3192006"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The unified Copilot experience in Microsoft Loop that enables users to brainstorm, outline a plan, and draft content.</descrip></descripGrp><ntig><termGrp><term id="3193311">Microsoft 365 Copilot in Loop</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192006">Copilot Loop-en</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56681_3191991_3192199"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The most appropriate action dynamically selected and executed by AI, based on available resources and desired outcomes, within an automation plan. This process leverages large language models (LLMs) to reason over unstructured content and determine the necessary steps and sequence to achieve a specified objective, making it flexible and efficient in handling complex process flows.</descrip></descripGrp><ntig><termGrp><term id="3191991">adaptive action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192199">ekintza moldagarri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56682_3191992_3192200"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of flow that is created using the AI flows feature.</descrip></descripGrp><ntig><termGrp><term id="3191992">AI flow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192200">AA fluxu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56683_3191993_3192201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An LLM-enabled process automation feature in Power Automate that allows users to execute to an end result by describing in natural language what they want to achieve with parameters for the flow to work within.</descrip></descripGrp><ntig><termGrp><term id="3191993">AI flows</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192201">AA fluxuak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56684_3191994_3192202"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A connector that allows desktop flows to interact with various cloud services and applications. It enables the automation of tasks that involve cloud-based resources, by providing specific actions that can create, retrieve, update, or manage data in these services.</descrip></descripGrp><ntig><termGrp><term id="3191994">cloud connector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192202">hodeiko konektore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56685_3191995_3192203"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software robot that automates repetitive tasks within business processes, such as data entry, order processing, or customer service responses.</descrip></descripGrp><ntig><termGrp><term id="3191995">flowbot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192203">fluxu-bot</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56686_3191996_3192204"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capacity within Power Automate that allows users to run desktop flows with zero infrastructure. It's allocated to hosted machines or committed to hosted machine groups.</descrip></descripGrp><ntig><termGrp><term id="3191996">hosted process capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192204">ostatatutako prozesatze-ahalmen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56687_3191997_3192205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A non-secret, random value used to ensure that identical plaintexts encrypt to different ciphertexts, thus enhancing the security of the encryption process.</descrip></descripGrp><ntig><termGrp><term id="3191997">initialization vector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192205">hasieratze-bektore</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56688_3191998_3192206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The setting in a hosted machine group that determines the maximum number of hosted bots it can auto-allocate itself to turn on hosted machines.</descrip></descripGrp><ntig><termGrp><term id="3191998">Max bots</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192206">Gehieneko botak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56689_3191999_3192207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capacity allocated to a cloud flow that enables it, along with all its associated cloud flows, to use premium connectors and execute actions up to a specified daily limit.</descrip></descripGrp><ntig><termGrp><term id="3191999">process capacity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3192207">prozesatze-ahalmen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Neuter</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5675_136869_440054"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A utility that makes a computer easier to use for people with disabilities.</descrip></descripGrp><ntig><termGrp><term id="136869">accessibility aid</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440054">erabilerraztasuna hobetzeko utilitate</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5677_143969_1228141"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Symbols in legends that show the patterns and colors assigned to the data series (or categories) in a chart. Legend keys appear to the left of legend entries. Formatting a legend key also formats the data marker that's associated with it.</descrip></descripGrp><ntig><termGrp><term id="143969">legend keys</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228141">legenda-gakoak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="568_297005_440685"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program designed to amuse or scare a user, for example by imitating the actions of a virus, without actually harming the computer.</descrip></descripGrp><ntig><termGrp><term id="297005">joke program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440685">txantxa-programa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="56829_3195149_3195167"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The container service for microservices built by Power Platform Policy team.</descrip></descripGrp><ntig><termGrp><term id="3195149">Quartz</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3195167">Quartz</term><