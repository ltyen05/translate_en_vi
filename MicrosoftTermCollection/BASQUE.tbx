definition">A card-like layout on an Outlook Contact that provides the user with the look of a real world business card.</descrip></descripGrp><ntig><termGrp><term id="183955">Electronic Business Card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1227697">bisita-txartel elektroniko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12039_183955_1227698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card-like layout on an Outlook Contact that provides the user with the look of a real world business card.</descrip></descripGrp><ntig><termGrp><term id="183955">Electronic Business Card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1227698">bisita-txartel</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12039_274668_1227697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card-like layout on an Outlook Contact that provides the user with the look of a real world business card.</descrip></descripGrp><ntig><termGrp><term id="274668">Business Card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1227697">bisita-txartel elektroniko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">N