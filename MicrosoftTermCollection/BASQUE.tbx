oun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2237121">Data soilik</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37774_2157394_2237132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The behavior property of a Date and Time attribute where field values are displayed with no time zone conversion.</descrip></descripGrp><ntig><termGrp><term id="2157394">Time-Zone Independent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2237132">Ordu-zonarekiko independente</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37779_2157426_2346337"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An image file type in which a very short video is followed by a transition to a still image. The combination of video and still image captures the essence of the moment.</descrip></descripGrp><ntig><termGrp><term id="2157426">living image</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2346337">argazki-klip</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37780_2157427_2180775"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A photo that illustrates motion by blurring together multiple frames of a short video to create the effect of motion in the still image.</descrip></descripGrp><ntig><termGrp><term id="2157427">motion focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2180775">mugimenduaren fokatze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37781_2157428_2180145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The top level view in File Explorer that shows the user's most frequently used and most recently used files and folders or folders pinned by the user for quick access.</descrip></descripGrp><ntig><termGrp><term id="2157428">Quick access</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2180145">Sarbide bizkorra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37782_2157429_2180282"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that provides unending stream of music based not on the user's library, but on an artist or song selected by the user.</descrip></descripGrp><ntig><termGrp><term id="2157429">Radio</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></nti