rip></descripGrp><ntig><termGrp><term id="2438783">Microsoft Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2440033">Paint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438784_2440032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438784">Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2440032">Microsoft Paint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43044_2438784_2440033"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The drawing app you can use to create simple or elaborate drawings. These drawings can be either black-and-white or color. You can also use Paint to work with pictures, such as .jpg, .gif, or .bmp files.</descrip></descripGrp><ntig><termGrp><term id="2438784">Paint</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2440033">Paint</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43053_2439180_2440030"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar, appearing at the top, that displays a small preview image (thumbnail) of the content in each open tab.</descrip></descripGrp><ntig><termGrp><term id="2439180">preview bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2440030">aurrebista-barra</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43054_2439181_2440023"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to see a small preview of the content in each open tab, shown in a persistent bar (not just on mouseover)​.</descrip></descripGrp><ntig><termGrp><term id="2439181">tab preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2440023">fitxen aurrebista</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43055_2439182_2440031"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To clear or remove all tabs that are currently displayed, and save them as a set of tabs that you can restore later.</descrip></descripGrp><ntig><termGrp><term id="2439182">set aside</term><termNote type="partOfS