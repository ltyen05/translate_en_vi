</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16276_263115_1228249"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a file format that allows for VBA code. Examples of file extensions for macro-enabled formats are .docm, .pptm, .xlsm.</descrip></descripGrp><ntig><termGrp><term id="263115">macro-enabled</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228249">makro gaitudun</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16290_237379_440499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Office Server that provides a workflow for document review.</descrip></descripGrp><ntig><termGrp><term id="237379">Document Review</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440499">dokumentu-azterketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="163_311257_440785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The user preferences for the formatting of dates, currencies, numbers, and so on. The user locale is a per-user setting, and does not require the user to restart or to log on or log off the computer.</descrip></descripGrp><ntig><termGrp><term id="311257">user locale</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440785">erabiltzailearen eskualdeko ezarpenak</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16308_307420_320661"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of calendar enhancements that enable users to schedule people and resources quickly, efficiently, and reliably. The enhancements include the Calendar Attendant, the Resource Booking Attendant, and the Scheduling Assistant.</descrip></descripGrp><ntig><termGrp><term id="307420">Calendar Concierge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="320661">Egutegizain</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16315_140027_1227744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dialog box that displays one complete record at a time. You can use data forms to add, change, locate, and delete records.</descrip></descripGrp><ntig><termGrp><term id="140027">data form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1227744">Datu-inprimaki</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16317_209984_440304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In Windows Media Player, a database that contains information about digital media files on a computer, a network drive, or the Internet.</descrip></descripGrp><ntig><termGrp><term id="209984">library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440304">liburutegi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1632_213814_2369101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An account that describes the changes in value reported on a balance sheet.</descrip></descripGrp><ntig><termGrp><term id="213814">balance sheet account</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2369101">balantze-egoeraren kontua</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16322_143641_1228250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The cell in which each input value from a data table is substituted. Any cell on a worksheet can be the input cell. Although the input cell does not need to be part of the data table, the formulas in data tables must refer to the input cell.</descrip></descripGrp><ntig><termGrp><term id="143641">input cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228250">sarrera-gelaxka</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16327_163539_440224"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The adjustment of the spacing between two characters to create the appearance of even spacing, fit text to a given space, and adjust line breaks.</descrip></descripGrp><ntig><termGrp><term id="163539">kerning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440224">karaktere-tartea doitze</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262439_440542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262439">XrML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440542">XrML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262439_440543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262439">XrML</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440543">eskubideak kudeatzeko marka-lengoaia hedagarri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262440_440542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262440">extensible rights markup language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440542">XrML</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1633_262440_440543"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A proposed standard digital rights management (DRM) markup language which enables users to specify rights and conditions associated with resources, such as digital content or Web services.</descrip></descripGrp><ntig><termGrp><term id="262440">extensible rights markup language</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440543">eskubideak kudeatzeko marka-lengoaia hedagarri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16331_460688_1335508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that allows the user to manually enter a price per unit to a product that is added to a quote, order, or invoice from the product catalog.</descrip></descripGrp><ntig><termGrp><term id="460688">Override Price</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1335508">Gainidatzi prezioa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16336_475235_1335587"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pricing method that determines the unit price of the product, which is calculated as a percent of the profit that you want to receive.</descrip></descripGrp><ntig><termGrp><term id="475235">percent margin</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1335587">marjinaren ehuneko</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16337_117385_1228251"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One character (or more) printed slightly below the baseline of surrounding text.</descrip></descripGrp><ntig><termGrp><term id="117385">subscript</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228251">azpiindize</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16344_18758_439267"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the context of processes or tasks that are part of an operating system or program, operating without interaction with the user while the user is working on another task.</descrip></descripGrp><ntig><termGrp><term id="18758">background</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439267">atzeko plano</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16348_318717_440880"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To advance audio or video playback at a speed that is faster than normal.</descrip></descripGrp><ntig><termGrp><term id="318717">fast forward</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440880">bizkor aurreratu</term><termNote type="geographicalU