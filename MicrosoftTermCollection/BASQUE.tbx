,576, [230] bytes).</descrip></descripGrp><ntig><termGrp><term id="1553">gigabyte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439131">GB</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="247_1553_439132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of computer or device memory equal to 1,024 megabytes (1,024 1,048,576, [230] bytes).</descrip></descripGrp><ntig><termGrp><term id="1553">gigabyte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439132">gigabyte</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2470_52378_2738519"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To cease functioning in whole or in part, particularly due to exceeding a pre-designed time limit.</descrip></descripGrp><ntig><termGrp><term id="52378">expire</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2738519">iraungi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2472_83022_1228111"><langSet xml:lang="en-US