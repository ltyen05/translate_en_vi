p><term id="2635486">Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2641502">Gailuen ataria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2635486_2641508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2635486">Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2641508">Windows gailuen ataria</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40031_2338749_2341106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The standalone 3D scanning app available in the Windows Store.​​</descrip></descripGrp><ntig><termGrp><term id="2338749">3D Scan</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2341106">3D Scan</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40032_2328169_2328696"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature of the 3D Scanner app that allows users to take 3D selfies.​</descrip></descripGrp><ntig><termGrp><term id="2328169">3D Selfie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2328696">3D selfiea</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40033_2328170_2328698"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A 3D printing format that allows design applications to send 3D models to other applications, platforms, services, and printers.​</descrip></descripGrp><ntig><termGrp><term id="2328170">3MF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2328698">3MF</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40034_2328171_2328701"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The rectangular boundaries of the object to be scanned.​​</descrip></descripGrp><ntig><termGrp><term id="2328171">boundary cube</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2328701">muga-koadroa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</t