scripGrp><ntig><termGrp><term id="1217967">home screen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1790138">hasierako pantaila</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1377_338601_1790138"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The main or default (start-up) screen.</descrip></descripGrp><ntig><termGrp><term id="338601">Home Screen</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1790138">hasierako pantaila</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13772_52156_439542"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a type of access to data in a database that is shared over a network. When you open a database in exclusive mode, you prevent others from opening the database.</descrip></descripGrp><ntig><termGrp><term id="52156">exclusive</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439542">esklusibo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13773_144171_2094225"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A replica that exchanges data with its hub or a global replica, but not with other replicas in the replica set.</descrip></descripGrp><ntig><termGrp><term id="144171">local replica</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2094225">erreplika lokal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13776_5615_439184"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A supplemental program that can extend the capabilities of an application program.</descrip></descripGrp><ntig><termGrp><term id="5615">add-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439184">osagarri</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13787_397179_427682"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of recipients that are created to expedite the mass emailing of messages and other information. Unlike a mail-enabled universal distribution group, a mail-enabled USG can also be used to assign permissions. When email is sent to a mail-enabled USG, all members of that group receive a copy of the message.</descrip></descripGrp><ntig><termGrp><term id="397179">mail-enabled universal security group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="427682">postarako gaitutako segurtasun-talde unibertsal</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13788_213533_1962736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To tap twice quickly on a screen or touchpad.</descrip></descripGrp><ntig><termGrp><term id="213533">double-tap</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1962736">birritan sakatu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13789_557730_1336807"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A workflow condition that enables a workflow to block its own execution.</descrip></descripGrp><ntig><termGrp><term id="557730">wait condition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1336807">itxarote-baldintza</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120227_439951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120227">TCP/IP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439951">TCP/IP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120227_439952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120227">TCP/IP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439952">Transmisioa kontrolatzeko protokolo/Internet protokolo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120228_439951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120228">Transmission Control Protocol/Internet Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439951">TCP/IP</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1379_120228_439952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The suite of networking protocols arranged in four layers, which are called the link layer, internet layer, transport layer, and application layer, and that includes IP in the internet layer and TCP in the transport layer.</descrip></descripGrp><ntig><termGrp><term id="120228">Transmission Control Protocol/Internet Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439952">Transmisioa kontrolatzeko protokolo/Internet protokolo</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13799_211832_1336717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option in the product catalog that determines whether a product is sold whole, in fractions, or in whole and fractions, or if a user has no control over the quantity.</descrip></descripGrp><ntig><termGrp><term id="211832">quantity selling option</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1336717">salmenta-unitatearen aukera</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGend