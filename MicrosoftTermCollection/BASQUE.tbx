olatile storage with benefits of performance, reliability and power saving.</descrip></descripGrp><ntig><termGrp><term id="1042105">solid-state drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228410">SSD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22319_1054003_1228410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary storage device based on solid-state memory, such as flash memory, that provides nonvolatile storage with benefits of performance, reliability and power saving.</descrip></descripGrp><ntig><termGrp><term id="1054003">SSD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228410">SSD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22319_2611333_1228410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary storage device based on solid-state memory, such as flash memory, that provides nonvolatile storage with benefits of performance, reliability and power saving.</descrip></descripGrp><ntig><termGrp><term id="2611333">SSD disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228410">SSD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Nou