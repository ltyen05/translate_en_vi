>Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2818979">Teams-en bot aholkularia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49799_2816514_2817558"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot in Office 365 Advisor for Teams that assists in the deployment of Microsoft Teams by providing guidance and resources to team members during roll out.</descrip></descripGrp><ntig><termGrp><term id="2816514">Advisor for Teams bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2817558">bot aholkulari</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49799_2816514_2818979"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bot in Office 365 Advisor for Teams that assists in the deployment of Microsoft Teams by providing guidance and resources to team members during roll out.</descrip></descripGrp><ntig><termGrp><term id="2816514">Advisor for Teams bot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2818979">Teams-en bot aholkularia</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termG