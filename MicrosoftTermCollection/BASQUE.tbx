909_1359034_1375490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of deploying on-premises CRM so that remote users can connect to the application from the Internet.</descrip></descripGrp><ntig><termGrp><term id="1359034">Internet-facing deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1375490">IFD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26909_1359034_1375892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of deploying on-premises CRM so that remote users can connect to the application from the Internet.</descrip></descripGrp><ntig><termGrp><term id="1359034">Internet-facing deployment</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1375892">Internetetiko sarbidea duen inplementazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26909_1370486_1375490"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of deploying on-premises CRM so that remote users can connect to the application from the Internet.</descrip></descripGrp><ntig><termGrp><term id="1370486">IFD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1375490">IFD</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26909_1370486_1375892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of deploying on-premises CRM so that remote users can connect to the application from the Internet.</descrip></descripGrp><ntig><termGrp><term id="1370486">IFD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1375892">Internetetiko sarbidea duen inplementazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26910_1359035_1376081"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of authenticating a user based on a set of claims about the user's identity contained in a trusted token. This token is often issued and signed by an entity that is able to authenticate the user by other means, and that is trusted by the entity doing the claims-based authentication.</descrip></descripGrp><ntig><termGrp><term id="1359035">claims-based authentication</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1376081">erreklamazioetan oinarritutako autentifikazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26911_1359038_1375347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability to view and manage SharePoint documents from Microsoft Dynamics CRM.</descrip></descripGrp><ntig><termGrp><term id="1359038">document management</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1375347">dokumentu-kudeaketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26913_1359040_1375364"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of field-level access permissions that have been granted to a user or users.</descrip></descripGrp><ntig><termGrp><term id="1359040">field access profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1375364">eremuetarako sarbide-profil</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2692_233482_616140"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A notification that an email message was not delivered to the recipient.</descrip></descripGrp><ntig><termGrp><term id="233482">non-delivery report</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="616140">entregatu ez izanaren jakinarazpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</term