ected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_2930015_2931319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2930015">Microsoft Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2931319">Microsoft Teams Connect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_2930015_3060483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2930015">Microsoft Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="3060483">Teams Connect</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52046_3059193_2931319"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category name for a group of features that enable collaboration with external users in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="3059193">Teams Connect</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalN