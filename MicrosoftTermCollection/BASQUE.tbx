peech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2840808">Power Platform administrazio-zentro</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819348_2822314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819348">metadata navigation filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2822314">metadatuetan oinarritutako nabigazio eta iragazketa</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49850_2819349_2822314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint feature that allows users to configure a filter list to use metadata tree view hierarchies and set filter controls to improve navigation and filtering of the list items.</descrip></descripGrp><ntig><termGrp><term id="2819349">metadata navigation and filtering</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="2822314">metadatuetan oinarritutako nabigazio eta iragazketa</term><termNote type="geographicalUsage">ESP</termNote><ter