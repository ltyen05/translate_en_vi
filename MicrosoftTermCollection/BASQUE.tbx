gSet xml:lang="en-US"><descripGrp><descrip type="definition">Of, pertaining to, or characterized by capital letters.</descrip></descripGrp><ntig><termGrp><term id="126360">uppercase</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="439984">maiuskula</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21948_781514_1228379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of hardware that supports multiple discrete capabilities, such as audio, mixer, and music, on a single card. This device is sometimes treated as a bus that can be enumerated to locate the devices on that bus.</descrip></descripGrp><ntig><termGrp><term id="781514">multifunction device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228379">funtzio anitzeko gailu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21948_781515_1228379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of hardware that supports multiple discrete capabilities, such as audio, mixer, and music, on a single card. This device is sometimes treated as a bus that can be enumerated to locate the devices on that bus.</descrip></descripGrp><ntig><termGrp><term id="781515">MFD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228379">funtzio anitzeko gailu</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21951_1080693_1228380"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To expose a virtual disk to the user, backed by a file.</descrip></descripGrp><ntig><termGrp><term id="1080693">attach</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228380">erantsi</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21957_781802_1228381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The administrative task of making remote resources available to its users, setting policies that control how users will connect, how they will find the remote resources, and what settings users will connect with.</descrip></descripGrp><ntig><termGrp><term id="781802">publishing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="1228381">argitalpen</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2196_1261176_440755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of modifying the pages of a Web site so that its content is more easily discoverable by Internet search engines.</descrip></descripGrp><ntig><termGrp><term id="1261176">SEO</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440755">bilatzailearen optimizazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2196_308342_440755"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The act of modifying the pages of a Web site so that its content is more easily discoverable by Internet search engines.</descrip></descripGrp><ntig><termGrp><term id="308342">search engine optimization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"><ntig><termGrp><term id="440755">bilatzailearen optimizazio</term><termNote type="geographicalUsage">ESP</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21965_782196_1359760"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that works with data in groups of 32 bits at a time. The Apple Macintosh II and higher models are 32-bit machines, in terms of both the word size of their microprocessors and the size of the data buses, as are computers based on the Intel 80386 and higher-level microprocessors.</descrip></descripGrp><ntig><termGrp><term id="782196">32-bit machine</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="eu"