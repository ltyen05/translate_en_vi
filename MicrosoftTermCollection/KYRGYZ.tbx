"grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20655_747784_1950753"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button that replaces the File menu beginning with some 2007 Microsoft Office system programs.</descrip></descripGrp><ntig><termGrp><term id="747784">Office Button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1950753">Microsoft Office Баскычы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20675_743746_2290745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To monitor an email conversation or newsgroup thread. The headers for messages in a watched conversation appear in a different color, which makes them easier to find in a message list.</descrip></descripGrp><ntig><termGrp><term id="743746">watch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2290745">көрүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20683_745706_1495742"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option on the Views menu in File Explorer that shows the most appropriate details for the file type in a flexible layout rather than only showing the details associated with the column headers in the view.</descrip></descripGrp><ntig><termGrp><term id="745706">Content</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495742">Мазмун</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20689_2356132_2359394"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Control Panel that provides the user with a single point of entry for tasks and notifications related to security and general PC software maintenance.</descrip></descripGrp><ntig><termGrp><term id="2356132">Security and Maintenance</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2359394">Коопсуздук жана тейлөө</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20695_746372_1495744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A gallery that allows users to create a quick rule to move mail to a selected folder based on the sender, recipients, or conversation of the currently selected email message without opening the full Create Rule dialog.</descrip></descripGrp><ntig><termGrp><term id="746372">Always Move gallery</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495744">Дайыма көчмө галерея</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20697_777440_1495745"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of computers on a home network that can share pictures, music, videos, documents, and printers. A homegroup is created by using the HomeGroup feature; it is protected with a password.</descrip></descripGrp><ntig><termGrp><term id="777440">homegroup</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495745">Үй тобу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20698_782774_1495746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password that helps prevent unauthorized access to homegroup files and printers.</descrip></descripGrp><ntig><termGrp><term id="782774">homegroup password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495746">Үй тобунун жашыруун сөзү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20702_746417_1495747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital or paper format pack that usually consists of a proof of purchase, the description of the licensing terms and policies, and number of client access licenses (CALs) purchased in this pack.</descrip></descripGrp><ntig><termGrp><term id="746417">CAL pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495747">CAL пакети</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20703_746420_1495748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action that removes redundant messages from an email conversation to reduce information overload and improve readability.</descrip></descripGrp><ntig><termGrp><term id="746420">Clean Up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495748">Тазалоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20704_746421_1495749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A fork within a conversation, where more than one reply was made to a single email and caused a split in the conversation.</descrip></descripGrp><ntig><termGrp><term id="746421">branch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495749">бутак</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20707_1805810_2075277"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message session with multiple parties, exchanged via IM (not through your mobile operator).</descrip></descripGrp><ntig><termGrp><term id="1805810">group conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2075277">топтук баарлашуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20707_1805810_2075278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message session with multiple parties, exchanged via IM (not through your mobile operator).</descrip></descripGrp><ntig><termGrp><term id="1805810">group conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2075278">топтук сүйлөшүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20707_1805810_2075279"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instant message session with multiple parties, exchanged via IM (not through your mobile operator).</descrip></descripGrp><ntig><termGrp><term id="1805810">group conversation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"