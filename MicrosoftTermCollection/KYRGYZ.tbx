"partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463379">түс бөлүштүрүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37852_2164317_2182218"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To return to Windows 7 after upgrading to Windows 10.</descrip></descripGrp><ntig><termGrp><term id="2164317">go back</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2182218">артка</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37853_2268352_2269829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A request to try a feature on Insider Preview builds. The requests can be found within the Insider Hub app for those in the Insider Program.</descrip></descripGrp><ntig><termGrp><term id="2268352">quest</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2269829">издөө оюну</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="37854_2164319_2193448"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that lets you make regular cel