termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2826891">Жарык режим</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49919_2823678_2826893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital file that resembles, or is an image of, a printout.</descrip></descripGrp><ntig><termGrp><term id="2823678">virtual printout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2826893">виртуалдык басып чыгаруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49920_2823680_2826889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneNote UI label that inserts a document as a virtual printout.</descrip></descripGrp><ntig><termGrp><term id="2823680">Insert as printout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2826889">Басып чыгаруу катары кыстаруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49921_2823682_2826892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A button, displayed as a clock icon, that displays a chronological list of pages that you’ve recently viewed or edited, as well as the sections and notebooks they’re found in.</descrip></descripGrp><ntig><termGrp><term id="2823682">Recent Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2826892">Жакынкы белгилер</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49922_2823695_2826890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of group calendars that the user has joined.</descrip></descripGrp><ntig><termGrp><term id="2823695">joined groups</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2826890">кошулган топтор</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49927_2824967_2829272"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The order in which screen readers read the slide contents.</descrip></descripGrp><ntig><termGrp><term id="2824967">reading order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829272">окуу ирет</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49928_2825758_2829265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Translation option in Outlook that automatically translates messages that are received in languages other than the default language.</descrip></descripGrp><ntig><termGrp><term id="2825758">Always translate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829265">Дайыма которуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49929_2825759_2829266"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The translation option in Outlook that asks the user before automatically translating messages that are received in languages other than the default language.</descrip></descripGrp><ntig><termGrp><term id="2825759">Ask me before translating</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829266">Которуу керектигин менден суроо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49930_2825763_2829268"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The translation option in Outlook that never translates messages that are received in languages other than the default language.</descrip></descripGrp><ntig><termGrp><term id="2825763">Never translate</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829268">Которуунун кереги жок</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49931_2825767_2829273"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook Calendar that allows users to search for nearby schools and add the school calendar to their list of calendars.</descrip></descripGrp><ntig><termGrp><term id="2825767">Schools</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829273">Мектептер</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49932_2825770_2829274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Header in the Outlook Settings UI for the three options: Always translate, Ask me before translating, and Never translate.</descrip></descripGrp><ntig><termGrp><term id="2825770">Translation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829274">Которуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49934_2825778_2829269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Outlook that allows the user to stop messages from being delivered to the inbox for a specified amount of time.</descrip></descripGrp><ntig><termGrp><term id="2825778">Pause inbox</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829269">Кирүүчү ящикти тынытуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49935_2825779_2829275"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Outlook that allows the user to turn off the Pause inbox feature.</descrip></descripGrp><ntig><termGrp><term id="2825779">Unpause</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829275">Тынытууну токтотуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49936_2825788_2829271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected hours.</descrip></descripGrp><ntig><termGrp><term id="2825788">Quiet hours</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829271">Тынч сааттар</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49936_3020525_2829271"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected hours.</descrip></descripGrp><ntig><termGrp><term id="3020525">Quiet time</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829271">Тынч сааттар</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49937_2825791_2829270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Microsoft Teams that turns off notifications to the user's mobile phone for selected days.</descrip></descripGrp><ntig><termGrp><term id="2825791">Quiet days</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829270">Тынч күндөр</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49938_2825798_2829264"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To accept an invitation (such as to a meeting) or a request.</descrip></descripGrp><ntig><termGrp><term id="2825798">accept</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2829264">кабыл алуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49950_2827269_2831503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mathematical process used for removing subexpressions from a mathematical expression, when this removal does not change the meaning or the value of the expression because the subexpressions have equal and opposing effects. For example, a fraction is put in lowest terms by cancelling out the common factors of the numerator and the denominator.</descrip></descripGrp><ntig><termGrp><term id="2827269">cancel out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831503">кыскартуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49951_2827271_2831507"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To calculate the value of.</descrip></descripGrp><ntig><termGrp><term id="2827271">evaluate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831507">эсептөө</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49953_2827274_2831515"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To convert a radical in the denominator of an algebraic fraction to a rational number.</descrip></descripGrp><ntig><termGrp><term id="2827274">rationalize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831515">бөлүүчүнү рационалдаштыруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49955_2827280_2831508"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of removing (through division) the common factor of the terms of an algebraic expression in order to simplify the algebraic expression. For example, the expression 2y + 6 can be simplified by "factoring out" the factor 2 to produce 2(y + 3).</descrip></descripGrp><ntig><termGrp><term id="2827280">factor out</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831508">жалпы көбөйтүүчүнү бөлүп чыгаруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49957_2827282_2831510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The number written in front of the variable with the largest exponent. For example, in the equation -7x^4 + 2x^3 - 11, the highest exponent is 4. The coefficient for that term is -7, which means that -7 is the leading coefficient.</descrip></descripGrp><ntig><termGrp><term id="2827282">leading coefficient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831510">улуу коэффициент</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49958_2827286_2831511"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An algebraic expression that contains one term, such as: 3xy.</descrip></descripGrp><ntig><termGrp><term id="2827286">monomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831511">бир мүчө</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49959_2827288_2831518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Either a single number or variable, or numbers and variables multiplied together. For example, the expression 4x - 7 + y = 5 contains four terms: 4x, 7, y, and 5.</descrip></descripGrp><ntig><termGrp><term id="2827288">term</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831518">элемент</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49960_2827297_2831502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An algebraic expression of the sum or the difference of two terms.</descrip></descripGrp><ntig><termGrp><term id="2827297">binomial</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831502">бином</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49961_2827299_2831504"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The property of multiplication whereby when a number is multiplied by the sum of two numbers, the first number can be distributed to both of those numbers and multiplied by each of them separately, and the two products can then be added together for the same result as multiplying the first number by the sum. For example: 2 x (3 + 5) = 2 x 3 + 2 x 5</descrip></descripGrp><ntig><termGrp><term id="2827299">distributive property</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831504">таратылуучу касиет</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49962_2827300_2831512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that is the square of an integer; it is the product of some integer with itself. For example, 9 is a perfect square, since it can be written as 3 × 3. Any number multiplied by itself creates a perfect square.</descrip></descripGrp><ntig><termGrp><term id="2827300">perfect square</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831512">туура чарчы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49962_2827300_2831517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that is the square of an integer; it is the product of some integer with itself. For example, 9 is a perfect square, since it can be written as 3 × 3. Any number multiplied by itself creates a perfect square.</descrip></descripGrp><ntig><termGrp><term id="2827300">perfect square</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831517">бүтүн сандын квадраты</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49962_2827301_2831512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that is the square of an integer; it is the product of some integer with itself. For example, 9 is a perfect square, since it can be written as 3 × 3. Any number multiplied by itself creates a perfect square.</descrip></descripGrp><ntig><termGrp><term id="2827301">square number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831512">туура чарчы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49962_2827301_2831517"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An integer that is the square of an integer; it is the product of some integer with itself. For example, 9 is a perfect square, since it can be written as 3 × 3. Any number multiplied by itself creates a perfect square.</descrip></descripGrp><ntig><termGrp><term id="2827301">square number</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831517">бүтүн сандын квадраты</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49963_2827302_2831513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The result of multiplying, or an expression that identifies factors to be multiplied. For example, 15 is the product of 3 and 5, and x(2+x) is the product of x and 2+x.</descrip></descripGrp><ntig><termGrp><term id="2827302">product</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831513">көбөйтүндү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49964_2827303_2831505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In mathematics, the operation which is the opposite of multiplication.</descrip></descripGrp><ntig><termGrp><term id="2827303">division</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831505">бөлүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49965_2827304_2831509"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A theorem linking factors and zeros of a polynomial.</descrip></descripGrp><ntig><termGrp><term id="2827304">Factor Theorem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831509">Көбөйтүүчү теоремасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49966_2827305_2831514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Theorem that for a polynomial equation in one variable with integer coefficients to have a solution (root) that is a rational number, the leading coefficient (the coefficient of the highest power) must be divisible by the denominator of the fraction and the constant term (the one without a variable) must be divisible by the numerator.</descrip></descripGrp><ntig><termGrp><term id="2827305">Rational Root Theorem</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831514">Рационалдуу тамырлар теоремасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49967_2827314_2831516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A value or values which, when substituted for a variable in an equation, make the equation true.</descrip></descripGrp><ntig><termGrp><term id="2827314">solution</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2831516">чечим</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49976_2827830_2833132"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Title of the pane that includes emojis and gifs that the user can select to include in an email.</descrip></descripGrp><ntig><termGrp><term id="2827830">Expressions</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2833132">Сезим чыгаруулар</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="49983_2827856_2833137"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The title of a scheduled call in Skype.</descrip></descripGrp><ntig><termGrp><term id="2827856">Title</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2833137">Наам</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_234319_1493595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="234319">transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493595">берилмелерди өткөрүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_234319_1493596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="234319">transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493596">ташүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_234319_2530875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="234319">transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2530875">өткөрүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_665_1493595"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="665">data transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493595">берилмелерди өткөрүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_665_1493596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="665">data transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493596">ташүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50_665_2530875"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The movement of information from one location to another, either within a computer (as from a disk drive to memory), between a computer and an external device (as between a file server and a computer on a network), or between separate computers.</descrip></descripGrp><ntig><termGrp><term id="665">data transfer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2530875">өткөрүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="500_1538479_462652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to a single microcomputer, the sum of a system's internal and external components, including memory, disk drives, keyboard, video, and generally less critical add-on hardware, such as a mouse, modem, or printer. Software (the operating system and various device drivers), the user's choices established through configuration files such as the AUTOEXEC.BAT and CONFIG.SYS files on IBM PCs and compatibles, and sometimes hardware (switches and jumpers) are needed to "configure the configuration" to work correctly. Although system configuration can be changed, as by adding more memory or disk capacity, the basic structure of the system--its architecture--remains the same.</descrip></descripGrp><ntig><termGrp><term id="1538479">system configuration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462652">конфигурация</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="500_37690_462652"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In reference to a single microcomputer, the sum of a system's internal and external components, including memory, disk drives, keyboard, video, and generally less critical add-on hardware, such as a mouse, modem, or printer. Software (the operating system and various device drivers), the user's choices established through configuration files such as the AUTOEXEC.BAT and CONFIG.SYS files on IBM PCs and compatibles, and sometimes hardware (switches and jumpers) are needed to "configure the configuration" to work correctly. Although system configuration can be changed, as by adding more memory or disk capacity, the basic structure of the system--its architecture--remains the same.</descrip></descripGrp><ntig><termGrp><term id="37690">configuration</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462652">конфигурация</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50000_2829752_2833131"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An input device which captures the handwriting or brush strokes of a user and converts handwritten analog information created using "pen and paper" into digital data, enabling the data to be utilized in various applications.</descrip></descripGrp><ntig><termGrp><term id="2829752">digital pen</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2833131">санарип калем</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50001_2829757_2833133"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animated GIF that repeats its motion in a continuous loop. A looping GIF ends up exactly where it started so that the continuous action is smooth, as if it genuinely was repeating itself. A looping GIF is made by adding still images to an animated GIF in reverse order.</descrip></descripGrp><ntig><termGrp><term id="2829757">looping GIF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2833133">илмектүү GIF</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5002_1276279_1493846"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is related to the active window or item, accessible by right-clicking the mouse.</descrip></descripGrp><ntig><termGrp><term id="1276279">right-click menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493846">калкыма меню</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5002_1276279_2700513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is related to the active window or item, accessible by right-clicking the mouse.</descrip></descripGrp><ntig><termGrp><term id="1276279">right-click menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2700513">урунма менюсу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5002_1276279_462662"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu that is related to the active window or item, accessible by right-clicking the mouse.</descrip></descripGrp><ntig><termGrp><term id="1276279">right-click menu</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462662">контексттик меню</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5002_1276279_4626