58_462645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To create an object, such as an email message.</descrip></descripGrp><ntig><termGrp><term id="36858">compose</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462645">жаратуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15047_318786_1494269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ≤ character.</descrip></descripGrp><ntig><termGrp><term id="318786">LESS-THAN OR EQUAL TO</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494269">төмөн же барабар белгиси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15047_318787_1494269"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ≤ character.</descrip></descripGrp><ntig><termGrp><term id="318787">less than or equal to sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494269">төмөн же барабар белгиси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15049_263066_1495658"><