ion">The temporary storage area the computer uses to run programs and store data. Information stored in RAM is temporary and is designed to be erased when the computer is turned off.</descrip></descripGrp><ntig><termGrp><term id="97668">random access memory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493905">RAM</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6120_97668_1495520"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The temporary storage area the computer uses to run programs and store data. Information stored in RAM is temporary and is designed to be erased when the computer is turned off.</descrip></descripGrp><ntig><termGrp><term id="97668">random access memory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495520">оперативдүү эс-тутум</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6121_179135_1998285"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The wireless communication technology that conforms to the Bluetooth computing and telecommunications industry specification. This specification describes how mobile phone, landline phones, computers, and mobile devices can easily exchange information by using a short-range wireless connection.</descrip></descripGrp><ntig><termGrp><term id="179135">Bluetooth</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1998285">Bluetooth</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6136_149866_1890986"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation saved in MHTML format that integrates all supporting information, including graphics and other files, into a single file.</descrip></descripGrp><ntig><termGrp><term id="149866">Web archive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890986">Веб архиви</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6140_359642_1782971"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object, such as a picture, whose value isn't derived from data stored in a table.</descrip></descripGrp><ntig><termGrp><term id="359642">unbound object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1782971">чектелбеген объект</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6143_49737_1495521"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The small, upward-pointing symbol (^) typically found over the 6 key on the top row of a microcomputer keyboard.</descrip></descripGrp><ntig><termGrp><term id="49737">caret</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495521">"^" белгиси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6146_142043_463421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for filtering data that uses a version of the current form or datasheet with empty fields in which you can type the values you want the filtered records to contain.</descrip></descripGrp><ntig><termGrp><term id="142043">Filter By Form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463421">Форм боюнча чыпка</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6147_140616_463405"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An item (such as a page, frameset, item type, form, view, script file, text file, cascading style sheet, or image) that contributes to an overall pattern, scheme, or layout.</descrip></descripGrp><ntig><termGrp><term id="140616">design element</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463405">долбоорлоо элементи</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6151_1052638_447032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A printed circuit board that enables a personal computer to use a peripheral device, such as a CD-ROM drive, modem, or joystick, for which it does not already have the necessary connections, ports, or circuit boards. Commonly, a single adapter card can have more than one adapter on it.</descrip></descripGrp><ntig><termGrp><term id="1052638">interface card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="447032">адаптер</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6151_1136585_447032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A printed circuit board that enables a personal computer to use a peripheral device, such as a CD-ROM drive, modem, or joystick, for which it does not already have the necessary connections, ports, or circuit boards. Commonly, a single adapter card can have more than one adapter on it.</descrip></descripGrp><ntig><termGrp><term id="1136585">adapter card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="447032">адаптер</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6151_126_447032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A printed circuit board that enables a personal computer to use a peripheral device, such as a CD-ROM drive, modem, or joystick, for which it does not already have the necessary connections, ports, or circuit boards. Commonly, a single adapter card can have more than one adapter on it.</descrip></descripGrp><ntig><termGrp><term id="126">adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="447032">адаптер</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6158_69289_1493906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An address for a resource on the Internet that is used by Web browsers to locate Internet resources. An Internet address typically starts with a protocol name, followed by the name of the organization that maintains the site; the suffix identifies the kind of organization it is.</descrip></descripGrp><ntig><termGrp><term id="69289">Internet address</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493906">Интернет-дарек</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="617_1519064_462744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any self-contained piece of work created with an application program and, if saved on disk, given a unique filename by which it can be retrieved.</descrip></descripGrp><ntig><termGrp><term id="1519064">doc</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462744">документ</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="617_47427_462744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any self-contained piece of work created with an application program and, if saved on disk, given a unique filename by which it can be retrieved.</descrip></descripGrp><ntig><termGrp><term id="47427">document</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462744">документ</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6172_1276170_1493907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email message that a user sends to others to invite them to a meeting.</descrip></descripGrp><ntig><termGrp><term id="1276170">invitation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493907">жолугууга чакырык</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumbe