ries, such as a line sloping upward to represent increased sales over a period of months.</descrip></descripGrp><ntig><termGrp><term id="123594">trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2097555">тренд сызыгы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45820_2579516_2583466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To bring a system or piece of software into compliance with a policy or configuration intent.</descrip></descripGrp><ntig><termGrp><term id="2579516">remediate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2583466">оңдоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="45829_2580598_2583853"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A review of material that has reached the end of its retention period in order to decide whether it should be disposed of.</descrip></descripGrp><ntig><termGrp><term id="2580598">disposition review</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2583853">жоюудан мурун карап чыгуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><te