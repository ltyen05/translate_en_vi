Set xml:lang="ky"><ntig><termGrp><term id="1890853">төрт баштуу жебе</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12144_237193_1496150"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To place a file or project back in a source repository. This releases the lock for editing and enables other users to view the updated file or check out the file.</descrip></descripGrp><ntig><termGrp><term id="237193">check in</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496150">каттоого киргизүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12146_227660_1494162"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The practice of recording, classifying, summarizing, and reporting the financial consequences of accounting events.</descrip></descripGrp><ntig><termGrp><term id="227660">accounting</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494162">каттоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12159_98936_1793313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processor in an imagesetter or desktop printer that interprets the commands sent by a printer driver and converts them to a raster or bitmap grid to mark the paper or film.</descrip></descripGrp><ntig><termGrp><term id="98936">Raster Image Processor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1793313">RIP</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12159_98937_1793313"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The processor in an imagesetter or desktop printer that interprets the commands sent by a printer driver and converts them to a raster or bitmap grid to mark the paper or film.</descrip></descripGrp><ntig><termGrp><term id="98937">RIP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1793313">RIP</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1217_3131_1493658"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An overlapped window used for dialog boxes, message boxes, and other temporary windows that appear outside an application's primary window.</descrip></descripGrp><ntig><termGrp><term id="3131">pop-up window</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493658">калкыма терезе</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partO