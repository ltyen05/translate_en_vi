termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463361">атайын мүмкүнчүлүк</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5677_143969_1944424"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Symbols in legends that show the patterns and colors assigned to the data series (or categories) in a chart. Legend keys appear to the left of legend entries. Formatting a legend key also formats the data marker that's associated with it.</descrip></descripGrp><ntig><termGrp><term id="143969">legend keys</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1944424">шарттуу белгилер</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="568_297005_1493626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A program designed to amuse or scare a user, for example by imitating the actions of a virus, without actually harming the computer.</descrip></descripGrp><ntig><termGrp><term id="297005">joke program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493626">тамаша программасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="gram