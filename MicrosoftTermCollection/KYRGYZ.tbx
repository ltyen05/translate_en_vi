rmEntry><termEntry id="5293_23313_1496123"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control used on a form, report, or data access page to display or modify data from a table, query, or SQL statement.</descrip></descripGrp><ntig><termGrp><term id="23313">bound control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496123">байланышкан башкаруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5297_107243_463168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To write data (typically a file) to a storage medium.</descrip></descripGrp><ntig><termGrp><term id="107243">save</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463168">сактоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5298_9459_1493863"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of contact information for particular individuals, groups or organizations.</descrip></descripGrp><ntig><termGrp><term id="9459">address book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493863">дарек китеби</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gramm