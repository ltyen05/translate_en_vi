ammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1944399">санариптик кол коюу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14195_67346_1494232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A peripheral device whose purpose is to allow the user to provide input to a computer system. Examples of input devices are keyboards, mice, joysticks, and styluses.</descrip></descripGrp><ntig><termGrp><term id="67346">input device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494232">киргизүүчү түзмөк</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14200_117651_1495639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One character (or more) that is slightly higher than other text on a line, such as a footnote reference mark.</descrip></descripGrp><ntig><termGrp><term id="117651">superscript</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495639">жогорку индекс</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1421_145137_2786187"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network type that a computer is connected to that automatically sets the appropriate firewall settings for the location.</descrip></descripGrp><ntig><termGrp><term id="145137">network location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2786187">тармак жердиги</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14211_213519_2642338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An order for a SKU that is currently not available for delivery.</descrip></descripGrp><ntig><termGrp><term id="213519">pre-order</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2642338">алдын ала буйрутмалоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14219_310257_464120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows technology that protects OS resources (files, folders registry keys) and prevents applications and administrators from making changes to a computer's resources in an arbitrary way.</descrip></descripGrp><ntig><termGrp><term id="310257">System Protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464120">системди коргоо</term><termNote type="geographicalUsage">KGZ</termNote><