1568"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack where a malicious website makes an HTTP request to a target website in such a way that the website thinks that the request is part of a legitimate user’s session.</descrip></descripGrp><ntig><termGrp><term id="1647732">CSRF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891568">сайт ара жасалма суроо-талап</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32287_1647732_1891569"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack where a malicious website makes an HTTP request to a target website in such a way that the website thinks that the request is part of a legitimate user’s session.</descrip></descripGrp><ntig><termGrp><term id="1647732">CSRF</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891569">CSRF</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32288_1647733_1891570"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predetermined value that must be present in a client-server request for the request to be considered valid.</descrip></descripGrp><ntig><termGrp><term id="1647733">canary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp>