r">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2079155">токтотуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2690_19121_462494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key that moves the cursor to the left, one character at a time, usually erasing each character as it moves.</descrip></descripGrp><ntig><termGrp><term id="19121">BACKSPACE key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462494">BACKSPACE баскычы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26949_1359312_1522035"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person someone has established a mutual connection with, particularly via social networks or digital communication channels.</descrip></descripGrp><ntig><termGrp><term id="1359312">friend</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1522035">дос</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26965_1359720_1891584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content processing feature that extracts information from unstructured text in an item and stores that information as additional managed properties for the item. The additional managed properties can be used to refine results.</descrip></descripGrp><ntig><termGrp><term id="1359720">property extractor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891584">жак жандыруучусу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26965_1653098_1891584"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A content processing feature that extracts information from unstructured text in an item and stores that information as additional managed properties for the item. The additional managed properties can be used to refine results.</descrip></descripGrp><ntig><termGrp><term id="1653098">entity extractor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891584">жак жандыруучусу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26977_1361740_1522027"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label in Messenger for the results list of a contacts search.</descrip></descripGrp><ntig><termGrp><term id="1361740">Contacts</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1522027">Байланыштар</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26979_1361742_1522037"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The UI label for a permissions setting that indicates an item is being shared with (made available to) all of someone's friends.</descrip></descripGrp><ntig><termGrp><term id="1361742">Friends</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1522037">Достор</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26982_1361745_1782987"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation method in Messenger that allows someone to maintain multiple conversations in a tabbed view.</descrip></descripGrp><ntig><termGrp><term id="1361745">tabbed conversations</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1782987">баарлашуу кыстырмасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26983_1361746_1522044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A module someone can add to their Windows Live Space to contain personal interest items such as music, books, and movi