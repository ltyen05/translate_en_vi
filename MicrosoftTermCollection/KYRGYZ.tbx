Number">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463522">зыяндуу програм</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13356_34914_1494201"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard Windows control that can be used to provide interactive column titles for a list.</descrip></descripGrp><ntig><termGrp><term id="34914">column heading</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494201">тилкенин башы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13363_184068_1944356"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu option on the Property Panel that enables the user to specify document properties.</descrip></descripGrp><ntig><termGrp><term id="184068">Property Editor</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1944356">Касиеттерди түзөтүүчү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1337_297179_464036"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of trojan that causes systems equipped with modems to dial phone numbers without the consent of the user. In most cases, the phone numbers dialed are premium rate numbers which result in unexpected charges on the affected user's phone bill.</descrip></descripGrp><ntig><termGrp><term id="297179">dialer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464036">номур терүүчү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13370_33049_462613"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To end an application's relationship with an open file so that the application will no longer be able to access the file without opening it again.</descrip></descripGrp><ntig><termGrp><term id="33049">close</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462613">жабуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13372_413712_1944427"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbol that is displayed beside a paragraph in outline view. You can use the symbol to display or hide subordinate levels of text and to reorganize text quickly.</descrip></descripGrp><ntig><termGrp><term id="413712">outline symbol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1944427">документтин түзүлүшүнүн символу</te