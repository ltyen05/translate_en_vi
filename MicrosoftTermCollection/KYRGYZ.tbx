gSet xml:lang="ky"><ntig><termGrp><term id="1496142">тышкы маанинин тиби</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10052_58226_462834"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quick movement of a finger or pen on a screen that the computer interprets as a command, rather than as a mouse movement, writing, or drawing.</descrip></descripGrp><ntig><termGrp><term id="58226">gesture</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462834">жандоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1006_318140_464198"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of four fields of an SCODE. It is a unique number that is assigned to represent the error or warning.</descrip></descripGrp><ntig><termGrp><term id="318140">error code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464198">ката коду</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10069_338533_464359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In printing, the process of eliminating white lines between colors by printing small areas of overlapping color where colors touch.</descrip></descripGrp><ntig><termGrp><term id="338533">trapping</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464359">трэппинг</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10077_33192_1494068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ) character.</descrip></descripGrp><ntig><termGrp><term id="33192">closing parenthesis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494068">жабуучу кашаа</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10086_263114_1793294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a file format that does not allow for VBA code. Office 12 default file formats are macro-free. Examples of file extensions for macro-free formats are .docx, .pptx, .xlsx.</descrip></descripGrp><ntig><termGrp><term id="263114">macro-free</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1793294">макро бош</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10089_227651_1496143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">As one aspect of a KPI, the desired level of performance with respect to a specific business goal or strategy. Actual values are evaluated against the target to determine KPI score and status.</descrip></descripGrp><ntig><termGrp><term id="227651">target</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496143">максат</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10089_227652_1496143"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">As one aspect of a KPI, the desired level of performance with respect to a specific business goal or strategy. Actual values are evaluated against the target to determine KPI score and status.</descrip></descripGrp><ntig><termGrp><term id="227652">target value</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496143">максат</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10094_157455_1494069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive tool that makes it easier to set up commonly used accessibility features by specifying options by type of disability, rather than by numeric value changes.</descrip></descripGrp><ntig><termGrp><term id="157455">Accessibility Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494069">Мүмкүндүк алуу устаты</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10100_149094_1890982"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color that is defined by the operating system for a specific type of monitor and video adapter and that is associated with a specific part of the user interface, such as a window title or a menu.</descrip></descripGrp><ntig><termGrp><term id="149094">system color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890982">түзүм системасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10109_123691_1478670"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To hide parts of a file or clip without deleting them from the original source. Files and clips can be trimmed by adjusting the start or end trim point.</descrip></descripGrp><ntig><termGrp><term id="123691">trim</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1478670">кыркуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10110_135005_1496144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The horizontal reference line on a grid, chart, or graph that has horizontal and vertical dimensions.</descrip></descripGrp><ntig><termGrp><term id="135005">x-axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496144">х-огу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10110_135005_1496145"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The horizontal reference line on a grid, chart, or graph that has horizontal and vertical dimensions.</descrip></descripGrp><ntig><termGrp><term id="135005">x-axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496145">горизонталдуу ок</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10110_1508525_1496144"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The horizontal reference line on a grid, chart, or graph that has horizontal and vertical dimensions.</descrip></descripGrp><ntig><termGrp><term id="1508525">x axis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496144">х-огу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type