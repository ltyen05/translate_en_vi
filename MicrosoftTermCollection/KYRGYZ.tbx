Set xml:lang="en-US"><descripGrp><descrip type="definition">The tool which enables users to automatically perform routine tasks on a chosen computer by monitoring whatever criteria the users choose to initiate the tasks (referred to as triggers) and then executing the tasks when the criteria is met.</descrip></descripGrp><ntig><termGrp><term id="307402">Task Scheduler</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464086">тапшырма пландоочу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14695_374338_1793324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field data type that can contain up to 255 characters or the number of characters specified by the Fieldsize property, whichever is less.</descrip></descripGrp><ntig><termGrp><term id="374338">Text</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1793324">Текст</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14700_1176605_463112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure referring to the height of a printed character. A point equals 1/72 of an inch, or approximately 1/28 of a centimeter.</descrip></descripGrp><ntig><termGrp><term id="1176605">pt</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig>