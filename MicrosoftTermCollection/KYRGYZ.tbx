cripGrp><ntig><termGrp><term id="1709112">rotation lock button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1762123">айландырууну бекитүүчү баскыч</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32879_1709128_1891631"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Exchange mailbox that is associated with a SharePoint site, enabling users to access documents and email related to group projects through either Outlook or SharePoint.</descrip></descripGrp><ntig><termGrp><term id="1709128">site mailbox</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891631">сайт почта ящиги</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32884_1710098_1729663"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An edition of Windows 8 Pro that contains Windows Media Center.</descrip></descripGrp><ntig><termGrp><term id="1710098">Windows 8 Pro with Media Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1729663">Media Center'и бар Windows 8 Pro</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32886_1713361_1891632"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Authenticated access that can be granted to external partners and clients to enable sharing of selected SharePoint Online content.</descrip></descripGrp><ntig><termGrp><term id="1713361">external access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891632">тышкы кирүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32887_1713362_1891633"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique link that provides external users anonymous access to selected documents stored in SharePoint Online, with no sign in required.</descrip></descripGrp><ntig><termGrp><term id="1713362">guest link</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891633">конок шилтемеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32888_1713387_1950768"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables rich visualizations for interactive data exploration, presentation and reporting in SharePoint and Excel.</descrip></descripGrp><ntig><termGrp><term id="1713387">Power View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1950768">Power View</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32893_1713523_1729664"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The release candidate release of the Windows 8 operating system.</descrip></descripGrp><ntig><termGrp><term id="1713523">Windows 8 Release Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1729664">Windows 8 Release Preview</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32895_1713527_1755649"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automated proactive scan that triggers when NTFS detects a corruption. The scan is equivalent to the scan phase of chkdsk and finds and logs all corruptions to an internal file. This scan runs during maintenance hours, can be triggered from the Explorer, or manually run from a command line. When this scan is running in the background, some NTFS operations may be blocked.</descrip></descripGrp><ntig><termGrp><term id="1713527">Proactive Scanner</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1755649">Иштеген сканер</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32896_1713528_1755643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A registry setting that allows the DHCP client to transmit more messages to the server to obtain an IP address when the PC is in connected standby mode. This setting can increase power consumption but can also help resolve IP address (IPv4 or IPv6) problems more quickly.</descrip></descripGrp><ntig><termGrp><term id="1713528">aggressive address acquisition retry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1755643">кайра-кайра даректи алуу аракети</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32897_1713529_1755644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service within Remote Desktop Services responsible for aggregating RemoteApp programs and desktops that are published to end users from across the entire deployment. It ensure only users with appropriate rights can access published resources. The resources are used to display error messages that, for example, might say that the publishing service is unavailable. This can help the admin debug their deployment.</descrip></descripGrp><ntig><termGrp><term id="1713529">Central Publishing service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1755644">Борбордук басып чыгаруу кызматы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32899_1713532_1755647"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability to sign in to a PC by using a four-digit code.</descrip></descripGrp><ntig><termGrp><term id="1713532">PIN sign-in</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1755647">катталып кирүү үчүн ПИН</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3290_142330_1495455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A color that that is currently selected for drawing or displaying text on the screen.</descrip></descripGrp><ntig><termGrp><term id="142330">foreground color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495455">чагылдыруу түсү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32900_1713533_1755651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software setting that disables display rotation.</descrip></descripGrp><ntig><termGrp><term id="1713533">rotation lock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1755651">айландыруу бекитүүсү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1718119_1891635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1718119">ULS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891635">ULS</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1718119_1891641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1718119">ULS</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891641">Бирдейлешкен Журнал жазуу Кызматы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1722438_1891635"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1722438">Unified Logging Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891635">ULS</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32908_1722438_1891641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An instrumentation and logging platform that provides monitoring, reporting and log viewing capabilities for Office servers and services.</descrip></descripGrp><ntig><termGrp><term id="1722438">Unified Logging Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891641">Бирдейлешкен Журнал жазуу Кызматы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32909_1718122_1891636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application-hosting architecture that relies on cloud-based services. Application logic and data are typically hosted on a distributed set of services on the Internet, connected through web APIs, and authenticated with server-to-server authentication technologies such as OAuth.</descrip></descripGrp><ntig><termGrp><term id="1718122">Cloud App Model</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891636">Булут Тиркеме Модели</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32925_1718267_1891638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item that lets the user open a document using a different application than the one associated with the document type.</descrip></descripGrp><ntig><termGrp><term id="1718267">Open with</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891638">Менен ачылганы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3293_83637_1493750"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">On a Web page, a grouping of hyperlinks for getting around in that particular Web site.</descrip></descripGrp><ntig><termGrp><term id="83637">navigation bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493750">навигация тилкеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_1719344_2801449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="1719344">telemetry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2801449">дарт аныктоо колдомолор</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_1998703_2801449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="1998703">telemetry data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2801449">дарт аныктоо колдомолор</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32930_2790091_2801449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Data that shows how products are used including where, how often, with which other software and hardware. This data is used to identify user needs and experiences as well as potential marketing and product improvement opportunities over time. Partners and Microsoft can better understand what happens between planning, lab testing, sales data, and real world scenarios over time.</descrip></descripGrp><ntig><termGrp><term id="2790091">diagnostic data</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2801449">дарт аныктоо колдомолор</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32934_1722196_1891640"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that returns the first non-null expression from a list of arguments.</descrip></descripGrp><ntig><termGrp><term id="1722196">COALESCE</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891640">COALESCE</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32994_2027122_2032489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An app for Mac computers that creates a folder on the user's computer, downloads the contents of their OneDrive, and keeps the folder in sync with any file changes online and among additional computers.</descrip></descripGrp><ntig><termGrp><term id="2027122">OneDrive for Mac</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2032489">Mac үчүн OneDrive</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32995_1736382_1891642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that facilitates the use of Presenter View by automatically applying the Extend setting for Windows projection and identifying the correct display for Slide Show versus Presenter view.</descrip></descripGrp><ntig><termGrp><term id="1736382">Auto-Extend</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891642">Авто Кеңейтүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32996_1736384_1891643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Presenter View that enables the user to switch which monitor is showing Presenter View and which monitor is showing Slide Show.</descrip></descripGrp><ntig><termGrp><term id="1736384">Swap Displays</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891643">Дисплейлер которуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3300_294443_464009"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The entity designated to receive something.</descrip></descripGrp><ntig><termGrp><term id="294443">recipient</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464009">кабыл алуучу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33002_1737007_1891644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of an app for SharePoint that can be embedded on a site page to expose the functionality of the app.</descrip></descripGrp><ntig><termGrp><term id="1737007">app part</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891644">тиркеме бөлүгү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33028_1738547_1891645"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A dropdown menu item or ribbon component that is added to a site page.</descrip></descripGrp><ntig><termGrp><term id="1738547">custom action</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891645">кардар иш-аракети</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNot