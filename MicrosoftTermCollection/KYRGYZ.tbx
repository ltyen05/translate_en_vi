444"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person who is responsible for teaching a class.</descrip></descripGrp><ntig><termGrp><term id="1618171">educator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891444">билим берүүчү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31732_1618173_1891445"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric or non-numeric score that represents a student's performance on an assignment.</descrip></descripGrp><ntig><termGrp><term id="1618173">grade</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891445">баа</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31733_1618200_1891446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A worksheet that contains the collection of grades for all students enrolled in a particular class.</descrip></descripGrp><ntig><termGrp><term id="1618200">Gradebook</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891446">Баа Китепчеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammati