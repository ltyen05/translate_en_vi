ular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2499186">Аралаш чындык порталы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44259_2486144_2499189"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The mixed reality experience built into Windows that powers a compatible virtual reality headset or head-mounted display.</descrip></descripGrp><ntig><termGrp><term id="2486144">Windows Mixed Reality</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2499189">Windows Mixed Reality</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44260_2486898_2498572"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A conclusion of a business interaction.</descrip></descripGrp><ntig><termGrp><term id="2486898">close</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2498572">жабылуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44261_2486899_2498578"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of a meeting.</descrip></descripGrp><ntig><termGrp><term id="2486899">meeting