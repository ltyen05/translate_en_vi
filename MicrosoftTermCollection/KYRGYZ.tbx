fSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2375229">TEXTBETWEEN</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41830_2368197_2375226"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function that looks for a value in one range and returns a reference to the cell in the corresponding position of another range.</descrip></descripGrp><ntig><termGrp><term id="2368197">CLOOKUP</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2375226">CLOOKUP</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41836_2368390_2613074"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The tool that aids in reading comprehension by displaying a reading-focused view with optimized font spacing, and by reading text aloud while highlighting it, breaking words down into syllables, and translating text.</descrip></descripGrp><ntig><termGrp><term id="2368390">Immersive Reader</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2613074">Курчаган Окугуч</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4185_418556_1793310"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make data ready and available for subsequent distribution and deployment in a server environment.</descrip></descripGrp><ntig><termGrp><term id="418556">publish</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1793310">жарыялоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41855_2374281_2378499"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A privacy setting that allows the operating system, apps, and services to detect a user's approximate location (within several miles/km), without sharing their exact location.</descrip></descripGrp><ntig><termGrp><term id="2374281">general location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2378499">жалпы жайгашуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41856_2374312_2378498"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A location that you can set for your device that can be used by Windows, apps, and services when an exact location isn't available, such as on a desktop PC without GPS.​ ​</descrip></descripGrp><ntig><termGrp><term id="2374312">default location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2378498">баштапкы жайгашуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4188_136987_1493800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a chart sheet or worksheet the active, or selected, sheet. The sheet that you activate determines which menu bar and toolbars are displayed.</descrip></descripGrp><ntig><termGrp><term id="136987">activate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493800">активдештирүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41880_2370579_2372153"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A biometric authentication feature that that enables signing in to your device, apps, online services, and networks by face recognition.</descrip></descripGrp><ntig><termGrp><term id="2370579">Windows Hello face</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2372153">Windows Hello бети</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41881_2370580_2372154"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A biometric authentication feature that that enables signing in to your device, apps, online services, and networks by fingerprint recognition.</descrip></descripGrp><ntig><termGrp><term id="2370580">Windows Hello fingerprint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2372154">Windows Hello манжа изи</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41882_2370581_2372155"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A biometric authentication feature that that enables signing in to your device, apps, online services, and networks by iris recognition.</descrip></descripGrp><ntig><termGrp><term id="2370581">Windows Hello iris</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2372155">Windows Hello кареги</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="419_39765_1493621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Each of a set of references that together describe the exact position of something with respect to a set of axes (or a row and column).</descrip></descripGrp><ntig><termGrp><term id="39765">coordinate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493621">координат</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4190_125903_1816980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external bus that supports Plug and Play installation, which enables you to connect and disconnect devices without shutting down or restarting your computer.</descrip></descripGrp><ntig><termGrp><term id="125903">universal serial bus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1816980">USB</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4190_125904_1816980"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An external bus that supports Plug and Play installation, which enables you to connect and disconnect devices without shutting down or restarting your computer.</descrip></descripGrp><ntig><termGrp><term id="125904">USB</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1816980">USB</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4191_1358544_1493801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows wizard that helps the user import digital video to the computer from digital video cameras and other sources.</descrip></descripGrp><ntig><termGrp><term id="1358544">Import Video wizard</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493801">Видеону импорттоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4191_262696_1493801"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Windows wizard that helps the user import digital video to the computer from digital video cameras and other sources.</descrip></descripGrp><ntig><termGrp><term id="262696">Import Video</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493801">Видеону импорттоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41917_2372848_2379012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Excel function which takes an expression and performs an implicit intersection when the expression is a range, returns the top left value when expression is an array, and otherwise just returns the expression.</descrip></descripGrp><ntig><termGrp><term id="2372848">SINGLE()</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2379012">SINGLE()</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41919_2373340_2374111"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A timeframe that a customer sets to describe when they usually use their device, during which automatic restarts will not happen.</descrip></descripGrp><ntig><termGrp><term id="2373340">active hours</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2374111">активдүү саттар</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41920_2373341_2374113"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The command that pastes a URL that you copied to your clipboard into the address bar and takes you to the site.</descrip></descripGrp><ntig><termGrp><term id="2373341">Paste and go</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2374113">Кой да, бар</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41921_2373342_2374114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app included in Windows that allows a trusted friend or support professional to help solve a problem with your PC by accessing and taking control of it over a remote connection.</descrip></descripGrp><ntig><termGrp><term id="2373342">Quick Assist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2374114">Тез жардам</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41921_3160521_2374114"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app included in Windows that allows a trusted friend or support professional to help solve a problem with your PC by accessing and taking control of it over a remote connection.</descrip></descripGrp><ntig><termGrp><term id="3160521">Microsoft Quick Assist</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2374114">Тез жардам</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41931_2374260_2377936"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Zoom feature that allows users to create a pictorial table of contents containing a collection of their Section Zooms and that can update if the presentation is edited.</descrip></descripGrp><ntig><termGrp><term id="2374260">Summary Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2377936">Мазмун арымдоосу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41932_2374261_2377935"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Zoom feature that presents a preview of a slide in a presentation which auto-updates when the slide is updated and navigates users to that slide when they click on the preview</descrip></descripGrp><ntig><termGrp><term id="2374261">Slide Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2377935">Слайд арымдоосу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41933_2374264_2377934"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Zoom feature that presents a preview of a section in a presentation which auto-updates when the section’s first slide is updated, navigates users to that section when they click on the preview, and returns them back to the Summary Zoom when they are done.</descrip></descripGrp><ntig><termGrp><term id="2374264">Section Zoom</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2377934">Бөлүм арымдоосу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41938_2374322_2511357"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that teachers can use to provision student PCs for classroom use.​</descrip></descripGrp><ntig><termGrp><term id="2374322">Set up School PCs</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2511357">Окуучу ПКларын орнотуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41939_2374323_2511359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The education app used for secure, online assessments, such as exams. It doesn't allow test takers to access resources stored on their device or the internet; it prevents OS-level distractions; and it doesn't allow test-takers to share test content with other students.​</descrip></descripGrp><ntig><termGrp><term id="2374323">Take a Test</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2511359">Сыноодон өтүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41946_2375030_2378494"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for games that are rented most over time.</descrip></descripGrp><ntig><termGrp><term id="2375030">Most rented games</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2378494">Эң көп ижарага алынган оюндар</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41947_2375031_2378493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for apps that are rented most over time.</descrip></descripGrp><ntig><termGrp><term id="2375031">Most rented apps</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2378493">Эң көп ижарага алынган колдонмолор</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41948_2375032_2378492"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for apps or games that are rented most over time.</descrip></descripGrp><ntig><termGrp><term id="2375032">Most rented</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2378492">Эң көп ижарага алынган</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="41949_2375033_2378487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The collection title for games that are in the top 1000 items based on sales.</descrip></descripGrp><ntig><termGrp><term id="2375033">Best selling games</term><termNote type="partOfSpeech">ProperNoun</termNote><t