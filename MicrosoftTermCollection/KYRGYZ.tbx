:lang="ky"><ntig><termGrp><term id="464196">компьютер администратору</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="866_312761_1493642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A System Audio Effects (SYSFX) component used to provide a more immersive audio experience in the Windows Media Player and thus an improved listening experience by utilizing the available speakers that a user has attached to his/her PC by sending audio to all of the speakers, regardless of the number of channels the content contains. This will provide a better sounding experience for stereo and quadraphonic content being rendered on multi-channel playback systems.</descrip></descripGrp><ntig><termGrp><term id="312761">speaker fill</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493642">үн чыгаргычты толтуруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8664_55395_462815"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The stylistic attributes of a font — such as bold, italic, and underline.</descrip></descripGrp><ntig><termGrp><term id="55395">font style</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462815">арип стили</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_228749_1494014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="228749">Allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494014">макулдук тизмеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8688_276556_1494014"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of users, accounts, Web sites, etc. that are permitted to perform certain actions on a network.</descrip></descripGrp><ntig><termGrp><term id="276556">allow list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494014">макулдук тизмеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="869_557910_1891120"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An optional Microsoft Exchange 2000 Server component that is installed on a designated server in an administrative group. It provides centralized administration and archival of private keys, and maintains every user s private encryption key in an encrypted database. The keys are used for encrypting email messages and signing messages with digital signatures.</descrip></descripGrp><ntig><termGrp><term id="557910">Key Management Service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891120">Ачкыч Башкаруу Кызматы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8696_183901_1890998"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A slide template that defines default formatting or the position of placeholders for one or more slides in a presentation.</descrip></descripGrp><ntig><termGrp><term id="183901">content master</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890998">мазмун устасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8706_186134_1494015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of rules on a computer and a portable device that allow digital media files and other information to be synchronized.</descrip></descripGrp><ntig><termGrp><term id="186134">partnership</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494015">байланыш топ</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8714_186176_1950748"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A context menu that enables the user to preview the contents of a file with the Office Preview Handler (OPH) in Outlook (either documents attached to email or SharePoint documents in Outlook).</descrip></descripGrp><ntig><termGrp><term id="186176">PowerPoint Previewer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1950748">PowerPoint Алдын ала көрүүчүсү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73755_1495565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73755">LDAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495565">Жеңилдетилген түз мүмкүндүк алуу протоколу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73755_462951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73755">LDAP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462951">LDAP протоколу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73756_1495565"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73756">Lightweight Directory Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495565">Жеңилдетилген түз мүмкүндүк алуу протоколу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8718_73756_462951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary access protocol for Active Directory. LDAP is an industry-standard protocol, established by the Internet Engineering Task Force (IETF), that allows users to query and update information in a directory service. Active Directory supports both LDAP version 2 and LDAP version 3.</descrip></descripGrp><ntig><termGrp><term id="73756">Lightweight Directory Access Protocol</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462951">LDAP протоколу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8727_306408_464073"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A filter effect in Windows Movie Maker.</descrip></descripGrp><ntig><termGrp><term id="306408">Threshold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464073">Босого</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8732_137331_2096433"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Adds preset visual effects to text on slides. Ranging from subtle to exciting, each scheme usually includes an effect for the slide title and an effect that is applied to bullets or paragraphs on a slide.</descrip></descripGrp><ntig><termGrp><term id="137331">animation scheme</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2096433">жандандыруу схемасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8740_117601_1543813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A brief content of a larger document.</descrip></descripGrp><ntig><termGrp><term id="117601">summary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1543813">жыйынтык</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35474_462636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35474">command button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462636">буйрук баскычы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35474_462637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35474">command button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462637">баскыч</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35475_462636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35475">push button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462636">буйрук баскычы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8744_35475_462637"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A standard system control that initiates a command.</descrip></descripGrp><ntig><termGrp><term id="35475">push button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462637">баскыч</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8747_351591_1494016"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature in Windows that allows users to access and manage printers, multi-function printers, digital cameras and scanners.</descrip></descripGrp><ntig><termGrp><term id="351591">Printing and Imaging Devices</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494016">Басып чыгаруу жана сүрөт иштетүүчү түзмөктөр</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8751_418607_1522022"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To prevent another user from initiating a conversation and from viewing your presence or other information, such as your personal information.</descrip></descripGrp><ntig><termGrp><term id="418607">block</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1522022">тосмолоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8777_24948_1494017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list in which each item or block of text is preceded by a bullet.</descrip></descripGrp><ntig><termGrp><term id="24948">bulleted list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494017">белги коюлган тизме</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8780_100131_1494018"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The temporary storage place on Windows where deleted files are transferred and remain until manually emptied and files are permanently deleted, which allows users to retrieve files until that point.</descrip></descripGrp><ntig><termGrp><term id="100131">Recycle Bin</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494018">Таштанды кутусу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8790_232417_463723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list of domain names and email addresses that you want to receive messages from. E-mail addresses in Contacts and in the Global Address Book are included in this list by default. People you sent messages to will be added to the list.</descrip></descripGrp><ntig><termGrp><term id="232417">Safe Senders List</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463723">Ишенимдүү жиберүүчүлөр тизмеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8792_359700_1793265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A field size or data type that can hold positive integer numbers ranging from 0 to 255.</descrip></descripGrp><ntig><termGrp><term id="359700">byte</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1793265">байт</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</ter