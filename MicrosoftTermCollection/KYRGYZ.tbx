icalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891097">офлайн дарек китепчеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14924_149902_1495655"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that retrieves data stored on your intranet or the Internet.</descrip></descripGrp><ntig><termGrp><term id="149902">Web query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495655">Веб-сурам</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14938_18094_1496159"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A predefined or free-form figure — such as a line, oval, cube, flowchart symbol, banner, or free-form scribble — that the user can insert into a document and then customize.</descrip></descripGrp><ntig><termGrp><term id="18094">AutoShape</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496159">АвтоФорма</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14943_134986_2290746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The position of a p