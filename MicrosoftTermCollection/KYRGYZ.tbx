2609377"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The capability of Windows Defender System Guard that protects a device from compromised firmware.​</descrip></descripGrp><ntig><termGrp><term id="2607097">firmware protection</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2609377">программалык камсыздоо коргоосу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46294_2607107_2609379"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consumer-friendly name for trusted platform module (TPM)​.</descrip></descripGrp><ntig><termGrp><term id="2607107">security processor</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2609379">коопсуздук процессору</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46299_2607706_2609378"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows 10 app that helps users get online easily and in more places on their Windows 10 PC. Users sign up for a data plan and connect with mobile operators in their area using a supported SIM card.</descrip></descripGrp><ntig><termGrp><term id="2607706">Mobile Plans</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2609378">Мобилдик пландар</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="463_75391_1493624"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An object that is inserted into a document from a source file and that is updated when the original source file is updated.</descrip></descripGrp><ntig><termGrp><term id="75391">linked object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493624">байланган объект</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4631_158674_1495489"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The menu for a group of ready-made shapes that includes basic shapes, such as rectangles and circles, plus a variety of lines and connectors, block arrows, flowchart symbols, stars and banners, and callouts.</descrip></descripGrp><ntig><termGrp><term id="158674">AutoShapes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495489">АвтоФормалар</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46310_2608183_2610169"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A web part that is offered as default for the design of a SharePoint communication site.</descrip></descripGrp><ntig><termGrp><term id="2608183">default hero</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2610169">айласыз каарман</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46325_2608792_2610168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A SharePoint site created or managed by few people to broadcast information out to a broad audience.</descrip></descripGrp><ntig><termGrp><term id="2608792">communication site</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2610168">кабарлашуу сайты</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46330_2609539_2663800"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that enables Cortana to take over your mouse pointer and literally show you how to change a setting when you ask her to "show me (how to do something)." She performs each step for you in a sequence of clicks needed to make a particular change in Windows Settings.</descrip></descripGrp><ntig><termGrp><term id="2609539">Cortana Show Me</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2663800">Cortana Show Me</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46337_2609835_2787233"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To plan an event for a specific time slot.</descrip></descripGrp><ntig><termGrp><term id="2609835">schedule</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2787233">ырааттамага коюу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46341_2610077_2611398"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The consumer-facing name for Hypervisor Code Integrity (HVCI). The HVCI service in Windows 10 determines whether code executing in kernel mode is securely designed and trustworthy, and helps ensure that all software running in kernel mode, including drivers, securely allocate memory and operate as they are intended.</descrip></descripGrp><ntig><termGrp><term id="2610077">memory integrity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2611398">эстутум бүтүндүгү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834959_2837207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834959">Microsoft OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2837207">Microsoft OneDrive Sync</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834959_2837208"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834959">Microsoft OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2837208">OneDrive Sync</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46344_2834960_2837207"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The desktop-only sync app for OneDrive that enables on-demand file sharing and navigation in File Explorer and that comes pre-installed on PCs.</descrip></descripGrp><ntig><termGrp><term id="2834960">OneDrive sync</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2837207">Microsoft OneDrive Sync</term><termNote ty