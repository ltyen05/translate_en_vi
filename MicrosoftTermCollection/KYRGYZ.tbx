"6309_178700_2079157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To connect or associate items or data such as contacts, accounts, or worksheets.</descrip></descripGrp><ntig><termGrp><term id="178700">link</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2079157">байланыштыруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6314_138412_1984122"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An animation enhancement that lets you apply effects to a chart by series, category, or element in a series or category.</descrip></descripGrp><ntig><termGrp><term id="138412">chart effect option</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1984122">диаграммага натыйжа кошуу тандоосу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="6316_155655_463514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For files, information that indicates whether a file is read-only, hidden, ready for archiving (backing up), compressed, or encrypted, and whether the file contents should be indexed for fast file searching.</descrip></descripGrp><ntig><termGrp><term id="155655">attribute</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp