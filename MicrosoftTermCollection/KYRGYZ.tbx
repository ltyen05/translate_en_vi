crip></descripGrp><ntig><termGrp><term id="2635486">Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2642337">Түзмөк порталы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40030_2635486_2642352"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based interface that is included as part of specialized Windows devices and used by developers to manage device services remotely.</descrip></descripGrp><ntig><termGrp><term id="2635486">Device Portal</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2642352">Windows Түзмөк порталы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4005_44392_462706"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One or more special characters used to separate peers in a delimited structure, at any level (fields, records, and so on).</descrip></descripGrp><ntig><termGrp><term id="44392">delimiter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462706">бөлгүч</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40080_2329245_2344348"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that lets a user hide an email message from their inbox, setting it to return to the top of their inbox at a specified date and time. It lets the user clear their inbox by postponing items that aren't urgent.</descrip></descripGrp><ntig><termGrp><term id="2329245">Schedule</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2344348">Иш ыраат</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40081_2329246_2344347"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To mark an email message or conversation such that it moves to the top of your inbox and is flagged at a specified date and time.</descrip></descripGrp><ntig><termGrp><term id="2329246">schedule</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2344347">иш ыраат</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40082_2329247_2341985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of enterprise-related hardware and software security features that, when configured together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2329247">Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2341985">Device Guard</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40082_2795844_2341985"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The combination of enterprise-related hardware and software security features that, when configured together, will lock a device down so that it can only run trusted applications.​​​</descrip></descripGrp><ntig><termGrp><term id="2795844">Microsoft Defender Device Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2341985">Device Guard</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40083_2329248_2334097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The section of Windows Store for Business where admins can sign policies and catalogs of approved software, including LOB apps, using enterprise-specific signing certificates.​</descrip></descripGrp><ntig><termGrp><term id="2329248">Device Guard signing</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2334097">Device Guard кол коюу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40084_2329249_2334099"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The category of fonts that make it easier for people with dyslexia to read.​</descrip></descripGrp><ntig><termGrp><term id="2329249">Fluent</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2334099">Fluent</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40085_2329250_2340822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One to whom something is delegated.</descrip></descripGrp><ntig><termGrp><term id="2329250">assignee</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2340822">укук мураскор</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40086_2329251_2340832"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to items marked with a star.</descrip></descripGrp><ntig><termGrp><term id="2329251">starred</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2340832">жылдызы бар</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40087_2329252_2340831"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An indication for a priority in a list or other organizational structure.</descrip></descripGrp><ntig><termGrp><term id="2329252">star</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2340831">жылдыз</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40111_2330390_2334108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A generic reference to an organization's Windows Store for Business to offer specific content to their users, and for users to download approved content.</descrip></descripGrp><ntig><termGrp><term id="2330390">private store</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2334108">жеке интернет дүкөнү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40112_2330405_2334106"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A map downloaded to your PC, phone or tablet that can be used to get directions and search for places even when you are not connected to the Internet.</descrip></descripGrp><ntig><termGrp><term id="2330405">offline map</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2334106">оф-лайн карта</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40116_2331304_2334103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or business that makes line-of-business apps available to customers through an online market.</descrip></descripGrp><ntig><termGrp><term id="2331304">line-of-business publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2334103">ишкердик түрү үчүн басып чыгаруучу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40116_2331304_2334105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or business that makes line-of-business apps available to customers through an online market.</descrip></descripGrp><ntig><termGrp><term id="2331304">line-of-business publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2334105">ИТ басып чыгаруучу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40116_2331305_2334103"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or business that makes line-of-business apps available to customers through an online market.</descrip></descripGrp><ntig><termGrp><term id="2331305">LOB publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2334103">ишкердик түрү үчүн басып чыгаруучу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40116_2331305_2334105"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A person or business that makes line-of-business apps available to customers through an online market.</descrip></descripGrp><ntig><termGrp><term id="2331305">LOB publisher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2334105">ИТ басып чыгаруучу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40118_2331575_2334112"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that is licensed by a company in bulk for use by end users.</descrip></descripGrp><ntig><termGrp><term id="2331575">volume application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2334112">корпоративдүү колдонмо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40121_2331937_2340830"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An automatically generated filter list in Wunderlist (e.g. Today, Week, Assigned to me, Starred, All, and Completed Smart List) that shows all tasks from across all your task lists that meet the specific criteria.</descrip></descripGrp><ntig><termGrp><term id="2331937">smart list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2340830">смарт тизме</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40122_2331938_2340833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Mac OS X specific part of the app that allows Wunderlist to receive push notifications on the Mac.</descrip></descripGrp><ntig><termGrp><term id="2331938">Wunderlist Helper</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2340833">Wunderlist Жардамчысы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40123_2331939_2340829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Wunderlist feature that allows users to enter due dates for a task as text (e.g. next Sunday), automatically recognize the date, and set a due date and reminder for the task.</descrip></descripGrp><ntig><termGrp><term id="2331939">Smart Due Dates</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2340829">Смарт тиешелүү күнү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40124_2332081_2340828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that gives users information regarding the safety of a message via a colored bar inserted into the message.</descrip></descripGrp><ntig><termGrp><term id="2332081">Safety Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2340828">Коопсуздук боюнча кулак кагыш</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="40126_2332083_2340827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows administrators to inform email senders that they may be about to violate one of the data loss prevention policies.</descrip></descripGrp><ntig><termGrp><term id="2332083">Policy Tips</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2340827">Саясат боюнча кулак кагыш</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSel