>SD</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33075_1749609_2737749"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer that enables internal users to share audio and video data with external users.</descrip></descripGrp><ntig><termGrp><term id="1749609">A/V Edge server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2737749">Аудио- жана видео колдомолордун Кыр сервери</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33083_1754526_1759305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The automatic display of photos in Windows Photos in a grid-like pattern based on metadata from the photos that are connected to the user's account.</descrip></descripGrp><ntig><termGrp><term id="1754526">photo mix</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1759305">фото коллаж</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33084_1755584_1759301"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function relevant to an app in use that is displayed on the app bar.</descrip></descripGrp><ntig><termGrp><term id="1755584">app command</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1759301">колдонмо буйругу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33085_1755674_1759306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The charm that takes users to the Start screen.</descrip></descripGrp><ntig><termGrp><term id="1755674">Start charm</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1759306">Баштоо баскыч-чебери</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33087_1755689_1759302"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The functionality that allows users to switch back to recently used apps.</descrip></descripGrp><ntig><termGrp><term id="1755689">app switching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1759302">колдонмону которуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33088_1755690_1759303"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state that enables a PC to turn on instantly and have tiles and other services update even when the screen is off.</descrip></descripGrp><ntig><termGrp><term id="1755690">connected standby</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1759303">туташуусу менен гибернация режими</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33089_1755691_1759304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of Windows and device settings that users can change grouped into one location.</descrip></descripGrp><ntig><termGrp><term id="1755691">PC settings</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1759304">компьютер параметрлери</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33091_1755693_1759307"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tablet hardware button with the Windows logo on it that's similar to the Windows key on a keyboard. Pressing the Power and Windows buttons simultaneously is the equivalent of pressing Ctrl+Alt+Del.</descrip></descripGrp><ntig><termGrp><term id="1755693">Windows button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1759307">Windows баскычы</term><termNote type="geographicalUsa