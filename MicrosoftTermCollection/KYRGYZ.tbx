_67709_462894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To load the program and installation files onto your computer or device so that the program runs correctly.</descrip></descripGrp><ntig><termGrp><term id="67709">install</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462894">орнотуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1901_92735_463104"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A symbolic value used in place of a real value that is unknown or unavailable at the current time, or that is not displayed for security reasons.</descrip></descripGrp><ntig><termGrp><term id="92735">placeholder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463104">прототип</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1902_57264_1493688"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Capable of using or being displayed on the full area of a display screen. Applications running in windowing environments, although they might use the entire area of the screen, commonly allocate different areas to different windows, any of which can be enlarged to fill the entire screen.</descrip></descripGrp><ntig><termGrp><term id="57264">full screen</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammatica