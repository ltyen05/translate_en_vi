l Identification</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464436">репликтөө идентификатору</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="577_361199_464476"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tutorial outlining basic Windows features, workflow and information.</descrip></descripGrp><ntig><termGrp><term id="361199">Windows Basics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464476">Windows негиздери</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5770_133968_1493887"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A local area network (LAN) that sends and receives data via radio, infrared optical signaling, or some other technology that does not require a physical connection between individual nodes and the hub. Wireless LANs are often used in office or factory settings where a user must carry a portable computer from place to place.</descrip></descripGrp><ntig><termGrp><term id="133968">wireless LAN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493887">зымсыз чакан желе</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5775_148897_463475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Editing that occurs within a structured document such as a well-formed XML document.</descrip></descripGrp><ntig><termGrp><term id="148897">structural editing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463475">түзүлүштүү ондоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="578_148201_1890977"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of the colors defined in a set of chosen colors. If you fill an object with a scheme color, the object's color changes whenever you choose another color scheme for that publication.</descrip></descripGrp><ntig><termGrp><term id="148201">scheme color</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890977">схеманын түсү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5790_211562_1493888"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any feature in the computer system based on older technology for which compatibility continues to be maintained in other system components.</descrip></descripGrp><ntig><termGrp><term id="211562">legacy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493888">мурасталган</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5809_351298_1493889"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A limitation or a restriction.</descrip></descripGrp><ntig><termGrp><term id="351298">constraint</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493889">чектеме</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5810_119238_1493890"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A keyboard key, often labeled with both a left-pointing and a right-pointing arrow, that traditionally (as in word processing) is used to insert tab characters into a document. In other applications, such as menu-driven programs, the TAB key is often used to move the on-screen highlight from place to place.</descrip></descripGrp><ntig><termGrp><term id="119238">TAB key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493890">TAB баскычы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5814_17688_1495512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A built-in format that can be applied to a range of data, or to controls and sections in a form or report to change their appearance.</descrip></descripGrp><ntig><termGrp><term id="17688">autoformat</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495512">авто-формат</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5819_126909_2643623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that uniquely identifies a user in a computer system for the purpose of logging into said system and identifying oneself to other users.</descrip></descripGrp><ntig><termGrp><term id="126909">username</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2643623">кирүүчү аты</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5819_2638662_2643623"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A string that uniquely identifies a user in a computer system for the purpose of logging into said system and identifying oneself to other users.</descrip></descripGrp><ntig><termGrp><term id="2638662">user name</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2643623">кирүүчү аты</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5821_1275979_463342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary document used in Excel to store and work with data. A worksheet consists of cells that are organized into columns and rows; a worksheet is always stored in a workbook.</descrip></descripGrp><ntig><termGrp><term id="1275979">sheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463342">иш барагы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5821_134416_463342"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A primary document used in Excel to store and work with data. A worksheet consists of cells that are organized into columns and rows; a worksheet is always stored in a workbook.</descrip></descripGrp><ntig><termGrp><term id="134416">worksheet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463342">иш барагы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5834_87984_1493892"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A specific action carried out by a computer in the process of executing a program.</descrip></descripGrp><ntig><termGrp><term id="87984">operation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493892">иш аракет</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5835_138731_1890911"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism provided by the common language runtime whereby managed code is granted permissions by security policy and these permissions are enforced, helping to limit the operations that the code will be allowed to perform.</descrip></descripGrp><ntig><termGrp><term id="138731">code access security</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890911">кодго кирүү коопсуздугу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5849_122378_1495513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variety of graphics tablet that uses pressure sensors, rather than the electromagnetics used in more expensive high-resolution tablets, to track the position of a device on its surface.</descrip></descripGrp><ntig><termGrp><term id="122378">touch pad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495513">сенсордук такта</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5849_783226_1495513"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A variety of graphics tablet that uses pressure sensors, rather than the electromagnetics used in more expensive high-resolution tablets, to track the position of a device on its surface.</descrip></descripGrp><ntig><termGrp><term id="783226">touchpad</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495513">сенсордук такта</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5853_309073_1493893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of files that modify Windows features. Package types include service packs, security updates, language packs, and hotfixes. Examples of packages include LanguagePack, Windows Foundation, and FeaturePack.</descrip></descripGrp><ntig><termGrp><term id="309073">package</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493893">таңгак</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5858_184170_1495514"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Outlook pane that can be enabled to show an overview of the user's schedule, tasks and frequent contacts.</descrip></descripGrp><ntig><termGrp><term id="184170">To-Do Bar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495514">Аткарылчу иштер тилкеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5859_293097_2007315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique number governments issue to companies and citizens in order to track taxes paid on goods and services. VAT IDs in the European Union contain a country prefix followed by up to 12 digits or characters.</descrip></descripGrp><ntig><termGrp><term id="293097">VAT ID</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2007315">КНС коду</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5864_15940_1493894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed, connection-oriented, virtual circuit-based packet switching protocol used to transport many different types of network traffic. ATM packages data in 53-byte, fixed-length cells that can be switched quickly between logical connections on a network.</descrip></descripGrp><ntig><termGrp><term id="15940">ATM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493894">асинхрондук алмашуу режими</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5864_15940_462472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed, connection-oriented, virtual circuit-based packet switching protocol used to transport many different types of network traffic. ATM packages data in 53-byte, fixed-length cells that can be switched quickly between logical connections on a network.</descrip></descripGrp><ntig><termGrp><term id="15940">ATM</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462472">ATM</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5864_15941_1493894"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed, connection-oriented, virtual circuit-based packet switching protocol used to transport many different types of network traffic. ATM packages data in 53-byte, fixed-length cells that can be switched quickly between logical connections on a network.</descrip></descripGrp><ntig><termGrp><term id="15941">asynchronous transfer mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493894">асинхрондук алмашуу режими</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5864_15941_462472"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A high-speed, connection-oriented, virtual circuit-based packet switching protocol used to transport many different types of network traffic. ATM packages data in 53-byte, fixed-length cells that can be switched quickly between logical connections on a network.</descrip></descripGrp><ntig><termGrp><term id="15941">asynchronous transfer mode</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462472">ATM</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5870_725947_1493895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows x86-based computers to support more than 4 gigabytes (GB) of physical memory. Up to 64 GB of physical memory can be used as regular 4-kilobyte (KB) pages, and the number of bits that can be used by the kernel to address physical memory can be expanded from 32 to 36.</descrip></descripGrp><ntig><termGrp><term id="725947">physical address expansion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493895">физикалык даректи кеңейтүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5870_92106_1493895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows x86-based computers to support more than 4 gigabytes (GB) of physical memory. Up to 64 GB of physical memory can be used as regular 4-kilobyte (KB) pages, and the number of bits that can be used by the kernel to address physical memory can be expanded from 32 to 36.</descrip></descripGrp><ntig><termGrp><term id="92106">physical address extension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493895">физикалык даректи кеңейтүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5870_92107_1493895"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows x86-based computers to support more than 4 gigabytes (GB) of physical memory. Up to 64 GB of physical memory can be used as regular 4-kilobyte (KB) pages, and the number of bits that can be used by the kernel to address physical memory can be expanded from 32 to 36.</descrip></descripGrp><ntig><termGrp><term id="92107">PAE</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493895">физикалык даректи кеңейтүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5874_101275_1890873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A form of statistical analysis used for forecasting. Regression analysis estimates the relationship between variables so that a given variable can be predicted from one or more other variables.</descrip></descripGrp><ntig><termGrp><term id="101275">regression analysis</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890873">регрессия талдоосу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5876_86775_1793304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft WOSA (Windows Open System Architecture) structure, an interface providing a common language for Windows applications to gain access to a database on a network.</descrip></descripGrp><ntig><termGrp><term id="86775">ODBC</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1793304">ODBC</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5876_86776_1793304"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In the Microsoft WOSA (Windows Open System Architecture) structure, an interface providing a common language for Windows applications to gain access to a database on a network.</descrip></descripGrp><ntig><termGrp><term id="86776">Open Database Connectivity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1793304">ODBC</term><termNote type="geographicalUsage">KGZ</termNote><termNote ty