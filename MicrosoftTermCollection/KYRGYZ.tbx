1359"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A pane in Outlook that displays a selected contact along with relevant information (photos, status messages or feeds, calendar items, etc.) from Outlook and other networks.</descrip></descripGrp><ntig><termGrp><term id="1262379">People Pane</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891359">Эл Чети</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="26075_1262380_1891360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A view that displays a profile photo of everyone who is part of an email thread or calendar item.</descrip></descripGrp><ntig><termGrp><term id="1262380">Gallery View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891360">Галерея Көрүнүшү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2608_30533_1493720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of characters that have some relationship in common.</descrip></descripGrp><ntig><termGrp><term id="30533">character set</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493720">символдор тобу</term><termNote type="geographicalUsage">KGZ</termNote><te