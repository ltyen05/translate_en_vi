Microsoft Hotmail</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1680668">Microsoft Hotmail</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24601_1136239_1376502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web service where users can share their thoughts, photographs, and interests with all members of a group. Members all contribute to a group profile, and can post blog entries, photos, and other items, just as they can to an individual profile.</descrip></descripGrp><ntig><termGrp><term id="1136239">Windows Live Groups</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1376502">Windows Live топтору</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24603_1136241_1376503"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The set of Microsoft software for email, instant messaging, photos, and personal movies available to customers in a single download and installation.</descrip></descripGrp><ntig><termGrp><term id="1136241">Windows Live Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1376503">Windows Live негизги компоненттери</term><termNote type="geographicalUsage">KGZ</te