try><termEntry id="21334_2675561_2676796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="2675561">Microsoft Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2676796">Microsoft Чаптооч Белгилер</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_770408_2402777"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="770408">Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2402777">Чаптооч белгилер</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21334_770408_2676796"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft app that creates sticky notes that can be shared between devices, that cloud sync, that are stored on Exchange, and that provide contextual reminders and actions that can be performed based on the content.</descrip></descripGrp><ntig><termGrp><term id="770408">Sticky Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2676796">Microsoft Чаптооч Белгилер</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21335_770428_2412171"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual piece of content that resembles a physical sticky note, is displayed across multiple apps and platforms, and that is created using Sticky Notes.</descrip></descripGrp><ntig><termGrp><term id="770428">sticky note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2412171">чаптооч белги</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21353_1177078_1944331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables presenters in the rich client to broadcast a slide show to remote viewers watching in a Web browser. Throughout the presentation, the remote attendees will see the current slide being shown by the presenter.</descrip></descripGrp><ntig><termGrp><term id="1177078">PowerPoint Broadcast Slide Show</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><ter