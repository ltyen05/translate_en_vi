-US"><descripGrp><descrip type="definition">A control designed to contain content such as placeholder or sample text or images that is updated by the user, or pre-defined lists of items from which users can select.</descrip></descripGrp><ntig><termGrp><term id="494725">content control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2096440">мазмунду башкаруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1944_321903_1493691"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to an operation or feature that involves moving objects on the screen with a mouse, a similar input device or a eventually a finger.</descrip></descripGrp><ntig><termGrp><term id="321903">drag-and-drop</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493691">сүйрөө-ыргытуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19488_659968_1496197"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect that applies a halo of color around the perimeter of an object.</descrip></descripGrp><ntig><termGrp><term id="659968">outer glow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496197">жаркыроо</term><termNote type="geogr