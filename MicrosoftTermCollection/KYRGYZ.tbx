73"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The representation of information and data in the form of an image, diagram, or animation. For example, some databases can interpret and show data in the form of a two- or three-dimensional model.</descrip></descripGrp><ntig><termGrp><term id="2626823">data visualization</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2630873">айтымдар көрүнөөрлүгү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17823_650183_1495694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format, such as cell shading or font color, that Excel automatically applies to cells if a specified condition is true.</descrip></descripGrp><ntig><termGrp><term id="650183">conditional format</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495694">шарттуу формат</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17826_650186_1495695"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The type of Web Part connection. For example, the Provide Row To connection type passes a row of data from one Web Part to another Web Part.</descrip></descripGrp><ntig><termGrp><term id="650186">connection type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig><