"grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462325">шифрлөө</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3366_694688_462325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A process of converting readable data (plaintext) into a coded form (ciphertext) to prevent it from being read by an unauthorized party.</descrip></descripGrp><ntig><termGrp><term id="694688">data encryption</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462325">шифрлөө</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3367_297187_1493754"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software designed to provide access to a computer from a remote location. These programs are often installed by the computer owner or administrator, and are only a risk if unexpected.</descrip></descripGrp><ntig><termGrp><term id="297187">remote control software</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493754">алыстан башкаруунун программа жабдыгы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33697_1808999_2021366"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To put your finger on a touchscreen and then swipe it quickly, lifting your finger off the screen, in the direction you want.</descrip></descripGrp><ntig><termGrp><term id="1808999">flick</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2021366">жылдыруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33700_1809907_2075262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Skype feature that allows users to call directly from Skype to landlines and mobile phones.</descrip></descripGrp><ntig><termGrp><term id="1809907">call phones</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2075262">телефондорго чалуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33701_1809933_2075353"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to store video clips.</descrip></descripGrp><ntig><termGrp><term id="1809933">video storage</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2075353">видео сактоо жайы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33702_1810821_2075340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The document that covers how users may use Skype software, Skype products, and the Skype website.</descrip></descripGrp><ntig><termGrp><term id="1810821">Terms of Use</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2075340">Колдонуу эрежелери</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33703_1810823_2075332"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables the user to connect to public WiFi hotspots, paying per minute with Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1810823">Skype WiFi</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2075332">Skype WiFi</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33707_1810831_2075331"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An electronic coupon that can be bought from selected retail outlets to top up Skype Credit.</descrip></descripGrp><ntig><termGrp><term id="1810831">Skype voucher</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2075331">Skype купону</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33708_1811255_2075334"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A free internet call between two or more Skype users.</descrip></descripGrp><ntig><termGrp><term id="1811255">Skype-to-Skype call</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2075334">Skype’тан Skype’ка чалуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3371_142397_1495456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A data-entry field on a page. A site visitor supplies information in a field either by typing text or by selecting a field.</descrip></descripGrp><ntig><termGrp><term id="142397">form field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495456">форма талаасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="33711_1814023_2075265"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A path enabling one inbound or outbound call and is a means of having concurrent calls on PBX.</descrip></descr