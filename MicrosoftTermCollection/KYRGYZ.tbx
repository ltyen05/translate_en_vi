ip></descripGrp><ntig><termGrp><term id="2707490">Transform to Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2636628">Вебге басып чыгаруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46572_2707490_2712573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Premium service that allows users to publish a Sway from within Word.</descrip></descripGrp><ntig><termGrp><term id="2707490">Transform to Web</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2712573">Веб үчүн формасын алмаштыруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46573_2620858_2622077"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The OneDrive feature that allows users to access cloud files without downloading them, allows online files to be visible in File Explorer, and that, when needed, automatically downloads them so that they are locally available.</descrip></descripGrp><ntig><termGrp><term id="2620858">OneDrive Files On-Demand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2622077">OneDrive Files сурам боюнча</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech