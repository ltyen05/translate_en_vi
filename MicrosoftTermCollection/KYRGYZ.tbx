om commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232859">Word Add-in Library</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891067">WLL</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232860_1891066"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232860">WLL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891066">Word Add-in Library</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12562_232860_1891067"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A stand-alone, dynamic-link library that, when loaded, can add custom commands that extend the functionality of Microsoft Word. Commands and functions in a loaded WLL are also available to Microsoft Visual Basic projects.</descrip></descripGrp><ntig><termGrp><term id="232860">WLL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNo