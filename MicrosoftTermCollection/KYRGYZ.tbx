at isn't included with InfoPath by default. Form designers can add or remove custom controls by using the Controls task pane.</descrip></descripGrp><ntig><termGrp><term id="234305">custom control</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494304">керектөөчүнүн башкаруу элементи</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15834_83662_1494305"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An area of an application window that enables the user to navigate quickly to different parts of the program.</descrip></descripGrp><ntig><termGrp><term id="83662">navigation pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494305">навигация панели</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15842_210445_1496161"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A function that verifies the technology is compatible with the target browser.</descrip></descripGrp><ntig><termGrp><term id="210445">compatibility checker</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496161">шайкештикти текшергич</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatical