efinition">The recognizer specific part of the shape trainer. Typically every recognizer claiming to support shape personalization must supply a Shape Client DLL. All the Microsoft Latin recognizers will all use the same Shape Client.</descrip></descripGrp><ntig><termGrp><term id="263078">Shape Client</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463935">символдорду таануу клиенти</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8869_87023_1494020"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network status that indicates a client is not connected to a server.</descrip></descripGrp><ntig><termGrp><term id="87023">offline</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494020">оф-лайн</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="8871_73980_462956"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The { character.</descrip></descripGrp><ntig><termGrp><term id="73980">left brace</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462956">сол кашаа</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote>