e that opens a preview window of the scrolling destination page when the user taps on the Thumb Scroll and that only updates the main view once the user lets go.​</descrip></descripGrp><ntig><termGrp><term id="2436155">Scroll Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2440138">Scroll Preview</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42993_2436156_2596730"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism to set up clients to the cloud service.</descrip></descripGrp><ntig><termGrp><term id="2436156">onboarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2596730">кошуу, кошулуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42994_2436157_2596729"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A mechanism to remove clients from the cloud service.</descrip></descripGrp><ntig><termGrp><term id="2436157">offboarding</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2596729">чыгарып салуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</term