A standard Windows control that combines the characteristics of a text box with a drop-down list box.</descrip></descripGrp><ntig><termGrp><term id="48513">drop-down combo box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462762">ачылуучу тизме менен кутуча</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44418_2501250_2504588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that displays information about a person such as their picture and contact information.</descrip></descripGrp><ntig><termGrp><term id="2501250">profile card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2504588">профиль картасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44418_2877864_2504588"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A card that displays information about a person such as their picture and contact information.</descrip></descripGrp><ntig><termGrp><term id="2877864">Live Persona Card</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2504588">профиль картасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected<