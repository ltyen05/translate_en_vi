ng record source.</descrip></descripGrp><ntig><termGrp><term id="140798">detail field</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890923">тасмия талаасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="565_144149_1890947"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A page of information about the broadcast that is displayed in the viewer's browser before the broadcast begins. It can contain a title, subject, host's name, information about the broadcast, and a countdown to the time of the broadcast.</descrip></descripGrp><ntig><termGrp><term id="144149">lobby page</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890947">кириш баракча</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5652_142152_2766539"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A complete path that allows users to find a file that doesn't depend on context.</descrip></descripGrp><ntig><termGrp><term id="142152">fixed file location</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2766539">бекитилген файл жердиги</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender