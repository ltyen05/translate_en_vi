ected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38691_2254280_2258011"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prerelease build of Windows 10 made available to customers in April 2015 or later. This is the most basic edition of Windows 10 Insider Preview.</descrip></descripGrp><ntig><termGrp><term id="2254280">Windows 10 Home Insider Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2258011">Windows 10 Home Insider Preview</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38694_2254283_2258012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The prerelease build of Windows 10 for phones that was made available to Insiders.</descrip></descripGrp><ntig><termGrp><term id="2254283">Windows 10 Mobile Insider Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2258012">Windows 10 Mobile Insider Preview</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38695_2254284_2258013"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The professional edition of Windows 10 Insider Preview released in April 2015 or later.</descrip></descripGrp><ntig><termGrp><term id="2254284">Windows 10 Pro Insider Preview</term><termNote type="partOfS