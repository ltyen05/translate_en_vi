egins from the topmost level for that disk drive.</descrip></descripGrp><ntig><termGrp><term id="1119178">\</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494278">кайырма слэш</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15279_19094_1494278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used to separate directory names in MS-DOS and UNIX path specifications. When used as a leading character, it means that the path specification begins from the topmost level for that disk drive.</descrip></descripGrp><ntig><termGrp><term id="19094">backslash</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494278">кайырма слэш</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15279_318431_1494278"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character used to separate directory names in MS-DOS and UNIX path specifications. When used as a leading character, it means that the path specification begins from the topmost level for that disk drive.</descrip></descripGrp><ntig><termGrp><term id="318431">REVERSE SOLIDUS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1494278">кайырма слэш</term><termNote type="geograph