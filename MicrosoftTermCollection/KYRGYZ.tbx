 id="13220_210458_1891015"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that changes a 2-dimensional linear expression, such as 5^2, to a built-up (3-dimensional) format.</descrip></descripGrp><ntig><termGrp><term id="210458">linear expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891015">сызыктуу туюнтма</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13221_50960_462783"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ultimate user of a computer or computer application in its finished, marketable form.</descrip></descripGrp><ntig><termGrp><term id="50960">end user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462783">соңку колдонуучу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13224_138502_1890909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to a specific legal case, statute, or other legal document.</descrip></descripGrp><ntig><termGrp><term id="138502">citation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890909">сөз келтирүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="gramma