></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463187">сериялык номур</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14727_168754_1793318"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical network connection between two entities such as a user or computer, that has a defined lifetime and associated state, and that might involve multiple physical connections.</descrip></descripGrp><ntig><termGrp><term id="168754">session</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1793318">сеанс</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14733_31389_462604"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To pick a command or an option from within a graphical user interface, as by clicking a button in a dialog box or pulling down a menu and then releasing the mouse button on one of its options.</descrip></descripGrp><ntig><termGrp><term id="31389">choose</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462604">тандоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14738_124210_1890893"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of measure used in typesetting and desktop publishing, equal to one-twentieth of a printer's point, or 1/1440th of an inch.</descrip></descripGrp><ntig><termGrp><term id="124210">twip</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890893">твип</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14761_143306_1495651"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web page editor command that inserts a horizontal line onto a Web page.</descrip></descripGrp><ntig><termGrp><term id="143306">Horizontal Line</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495651">Горизонталдуу сызык</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14763_141747_463420"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A tool that enables a user to sample the color of any pixel on a screen and apply that color to an object.</descrip></descripGrp><ntig><termGrp><term id="141747">eyedropper</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463420">пипетка</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Not