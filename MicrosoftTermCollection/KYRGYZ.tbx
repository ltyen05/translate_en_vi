tically or upon command, that contains the second-most-recent version of a file and that bears the same file name.</descrip></descripGrp><ntig><termGrp><term id="1133045">.bak</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2700463">.bak</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2446_1253_1493712"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A document listing common questions and answers on a particular subject.</descrip></descripGrp><ntig><termGrp><term id="1253">FAQ</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493712">FAQ</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24503_1133568_2700466"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The file name extension of ASCII text files. In most cases, a document with a .txt extension does not include any formatting commands, so it is readable in any text editor or word processing program.</descrip></descripGrp><ntig><termGrp><term id="1133568">.txt</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">Other</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2700466">.txt</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</ter