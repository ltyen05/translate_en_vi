27_2609623_2529641"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2609623">Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2529641">Microsoft алыскы иш тактасын алдын ала көрүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44827_2609623_2611400"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The pre-release version of Microsoft Remote Desktop app.</descrip></descripGrp><ntig><termGrp><term id="2609623">Remote Desktop Preview</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2611400">Алыскы иш тактаны алдын ала көрүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44828_2524681_2529636"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The period of time when users are required to schedule a restart.</descrip></descripGrp><ntig><termGrp><term id="2524681">Engaged restart</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2529636">Күчтөндүрүлгөн кайра күйгүзүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44829_2524692_2529646"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system service that enables spatial perception, spatial input, and holographic rendering.</descrip></descripGrp><ntig><termGrp><term id="2524692">Windows Perception Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2529646">Windows'ту кабыл алуу кызматы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4483_55751_1493814"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A structured document or template with spaces reserved for entering information and often containing special coding (e.g. to trigger data processing).</descrip></descripGrp><ntig><termGrp><term id="55751">form</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1493814">форма</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44832_2524734_2659314"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft interactive livestreaming platform for gaming communities.</descrip></descripGrp><ntig><termGrp><term id="2524734">Mixer</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2659314">Mixer</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44842_2524849_2539909"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A presentation of visual elements in an image, especially the placement of the subject in relation to other objects.</descrip></descripGrp><ntig><termGrp><term id="2524849">frame</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2539909">алкак</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2524926_2529642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2524926">mixed reality headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2529642">аралаш чындыктын кулактыгы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2524926_2576381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2524926">mixed reality headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2576381">кулактык</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2526431_2529642"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2526431">headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2529642">аралаш чындыктын кулактыгы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44843_2526431_2576381"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays mixed reality experiences. Used inclusively to denote both Microsoft HoloLens and OEM devices, whether they blend virtual content within the physical world (holographic headsets), or display virtual content with a degree (big or small) of environmental awareness (immersive headsets)​. Plus, these headsets can either be self-contained (like Microsoft HoloLens - the whole computing power is contained into the headset) or PC-connected (the computing power comes from the PC and the headset cannot work without that associated PC).</descrip></descripGrp><ntig><termGrp><term id="2526431">headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2576381">кулактык</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44844_2524930_2529639"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A head-mounted display (HMD) that displays virtual content only and with a degree (big or small) of environmental awareness. This is a subset of "mixed reality headset."​ This is to be looked at in contrast with "holographic headsets".</descrip></descripGrp><ntig><termGrp><term id="2524930">immersive headset</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2529639">ичинде жүргөндөй эффект менен камсыздалган кулактык</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44845_2524937_2529643"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of moving from a lower version of a system to a higher version. A configuration shift where the user becomes able to change default settings which were locked before the shift.</descrip></descripGrp><ntig><termGrp><term id="2524937">switch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2529643">котормо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44846_2524939_2529644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To move from a lower version of a system to a higher one, or to shift system configuration in order to change default settings locked before the shift.</descrip></descripGrp><ntig><termGrp><term id="2524939">switch</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2529644">которуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44861_2528507_2539910"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To arrange visual elements in an image, especially the subject.</descrip></descripGrp><ntig><termGrp><term id="2528507">frame</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2539910">алкак түзүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44863_2529677_2530274"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Microsoft marketing campaign that emphasizes seamless use of Microsoft applications across all devices because users have just one account no matter what device they are using.</descrip></descripGrp><ntig><termGrp><term id="2529677">One Microsoft</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2530274">One Microsoft</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44869_2530865_2542478"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A state of an application when no documents or content is open.</descrip></descripGrp><ntig><termGrp><term id="2530865">zero state</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2542478">нөл абалы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4487_15671_462469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The * character. Indicates multiplication in programming languages and also serves as a wildcard character representing one or more characters.</descrip></descripGrp><ntig><termGrp><term id="15671">asterisk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462469">жылдызча</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4487_318433_462469"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The * character. Indicates multiplication in programming languages and also serves as a wildcard character representing one or more characters.</descrip></descripGrp><ntig><termGrp><term id="318433">ASTERISK</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462469">жылдызча</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4489_298007_464049"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to send a snapshot of your calendar to someone outside your Exchange organization and allow them to see the data on your calendar and schedule against it.</descrip></descripGrp><ntig><termGrp><term id="298007">Calendar Snapshot</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464049">календардын сүрөту</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="449_318772_464248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ÷ character.</descrip></descripGrp><ntig><termGrp><term id="318772">division sign</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464248">бөлүү белгиси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="449_318773_464248"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ÷ character.</descrip></descripGrp><ntig><termGrp><term id="318773">DIVISION SIGN</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="464248">бөлүү белгиси</term><termNote type="geographicalUsage">KGZ</termN