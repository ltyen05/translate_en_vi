at implies Kerberos only, a principal's secret key.</descrip></descripGrp><ntig><termGrp><term id="1506854">secret key</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1587747">Жашыруун ачкыч</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="293_147704_1495396"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A reference to data stored in a document from another program.</descrip></descripGrp><ntig><termGrp><term id="147704">remote reference</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495396">алыскы шилтеме</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2930_58202_462833"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A category for grouping or describing multimedia or games, such as music categorized as "classical" or "jazz".</descrip></descripGrp><ntig><termGrp><term id="58202">genre</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462833">жанр</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2939_7912_1890826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selected cell in which data is entered when you begin typing. Only one cell is active at a time. The active cell is bounded by a heavy border.</descrip></descripGrp><ntig><termGrp><term id="7912">active cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890826">активдүү уяча</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2939_7912_1890827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selected cell in which data is entered when you begin typing. Only one cell is active at a time. The active cell is bounded by a heavy border.</descrip></descripGrp><ntig><termGrp><term id="7912">active cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890827">учурдагы уяча</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2939_7913_1890826"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selected cell in which data is entered when you begin typing. Only one cell is active at a time. The active cell is bounded by a heavy border.</descrip></descripGrp><ntig><termGrp><term id="7913">current cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890826">активдүү уяча</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2939_7913_1890827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The selected cell in which data is entered when you begin typing. Only one cell is active at a time. The active cell is bounded by a heavy border.</descrip></descripGrp><ntig><termGrp><term id="7913">current cell</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890827">учурдагы уяча</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179726_463585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179726">scroll arrow button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463585">жылдыруу жебе баскычы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179726_463586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179726">scroll arrow button</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463586">жылдыруу жебеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179727_463585"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179727">scroll arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463585">жылдыруу жебе баскычы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2940_179727_463586"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A component of a scroll bar that allows the information to be scrolled by defined increments when the user clicks it. The direction of the arrow indicates the direction in which the information scrolls.</descrip></descripGrp><ntig><termGrp><term id="179727">scroll arrow</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463586">жылдыруу жебеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29420_1507690_1891406"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office Web Component that provides interactive charting functionality on a Web page. You can illustrate data in a chart and give users the ability to change data, change chart options, and see changes reflected in the chart.</descrip></descripGrp><ntig><termGrp><term id="1507690">Chart Component</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891406">Диаграмма Бөлүгү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29429_1508178_1891407"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A character that is part of the set that makes up a particular language, such as vowels and consonants.</descrip></descripGrp><ntig><termGrp><term id="1508178">strong character</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891407">катуу тамга</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29439_1508552_1891408"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An application that parses code and markup in a page to help ensure that only trusted code and markup is run on a computer, server farm, or server cluster.</descrip></descripGrp><ntig><termGrp><term id="1508552">safe mode parser</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891408">коопсуз режимдеги талдоочу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29440_1508555_1891409"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area of the Help window that contains a Help topic.</descrip></descripGrp><ntig><termGrp><term id="1508555">topic pane</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891409">тема чети</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29442_1508557_1891410"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A list that identifies which assemblies and types are allowed to run on Web Parts pages in a server farm. The list is stored in the web.config file for the server farm.</descrip></descripGrp><ntig><termGrp><term id="1508557">SafeControl list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891410">КоопсузКөзөмөл тизмеги</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29455_1508759_1891411"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A measure whose value is calculated at run time by using an expression.</descrip></descripGrp><ntig><termGrp><term id="1508759">calculated measure</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891411">эсептелген ченем</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29459_1508807_1891412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The folder in which various translated files are stored. Each language has a different subfolder that corresponds to its locale identification number (LCID). For example, in a U.S. English installation, the LCID is 1033.</descrip></descripGrp><ntig><termGrp><term id="1508807">language folder</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891412">тил папкасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29462_1508810_1891413"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A toolbar with buttons and options used to apply text formatting. To display the toolbar, point to Toolbars on the View menu, and then click Formatting.</descrip></descripGrp><ntig><termGrp><term id="1508810">Formatting toolbar</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891413">Форматтоо курал тилкеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29464_1508812_1891414"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Visual Basic identifier that's defined in the host application or by using the #Const compiler directive, and used by other compiler directives to determine when or if certain blocks of code are compiled.</descrip></descripGrp><ntig><termGrp><term id="1508812">conditional compiler constant</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891414">шарттуу компилятордун константасы</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29465_1508813_1891415"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Naskh script that enriches the display of Arabic text. This script uses object linking and embedding (OLE) to create and add objects to a document.</descrip></descripGrp><ntig><termGrp><term id="1508813">DecoType Naskh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891415">DecoType Naskh</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29466_1508814_1891416"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Ruq'ah script that enriches the display of Arabic text. This script uses object linking and embedding (OLE) to create and add objects to a document.</descrip></descripGrp><ntig><termGrp><term id="1508814">DecoType Ruq'ah</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891416">DecoType Ruq'ah</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29473_1508823_1891417"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An administrative tool that examines a computer, server farm, or server cluster and provides statistics that indicate the degree to which the configuration meets expected demands.</descrip></descripGrp><ntig><termGrp><term id="1508823">health analyzer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891417">ден соолук талдоочусу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29474_1508825_1891419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A custom handler that calls and runs custom code during the creation process for a site.</descrip></descripGrp><ntig><termGrp><term id="1508825">site provisioning provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891419">сайт демилгелөө камсыздоочу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29476_1508830_2290714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Microsoft Office program that you can use to organize related documents. You can check spelling, number pages consecutively across all documents in the binder, and print the documents.</descrip></descripGrp><ntig><termGrp><term id="1508830">Binder</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2290714">Binder</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29480_1508864_1891421"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contiguous piece of text or string of characters sharing the same attributes. All characters in a run have the same directional properties.</descrip></descripGrp><ntig><termGrp><term id="1508864">run</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891421">топтом</term><termNote type="geographicalUsage">KGZ</termNote><t