efinition">An option that creates a meeting request from the selected email message.</descrip></descripGrp><ntig><termGrp><term id="1162909">Reply with Meeting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1944360">Чогулуш уюштуруп, жооп берүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24779_1162910_1891326"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that creates a meeting request from the selected email message.</descrip></descripGrp><ntig><termGrp><term id="1162910">Meeting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891326">Жыйын</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24779_1162910_1944360"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that creates a meeting request from the selected email message.</descrip></descripGrp><ntig><termGrp><term id="1162910">Meeting</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1944360">Чогулуш уюштуруп, жооп берүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24805_1162604_1496220"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A ribbon group that provides options for drawings created with pen and ink tools.</descrip></descripGrp><ntig><termGrp><term id="1162604">Ink Art</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496220">Сүрөт тартуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24825_1162703_1496221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scalable Web platform that enables users to publish an Access database application to a SharePoint site. Data in these databases can then be viewed and edited in a Web browser. This enables browser-based viewing and interaction with the databases on machines that do not have a database application installed.</descrip></descripGrp><ntig><termGrp><term id="1162703">Access Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496221">Access Services</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24825_1176677_1496221"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A scalable Web platform that enables users to publish an Access database application to a SharePoint site. Data in these databases can then be viewed and edited in a Web browser. This enables browser-based viewing and interaction with the databases on machines that do not have a database application installed.</descrip></descripGrp><ntig><termGrp><term id="1176677">Microsoft Access Services</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496221">Access Services</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24826_1162704_1950758"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A server technology enabling users to load, calculate, and display Excel workbooks on Microsoft Office SharePoint Server.</descrip></descripGrp><ntig><termGrp><term id="1162704">Excel Services</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1950758">Excel Services</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24856_1162836_1891323"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A removable storage device that has been configured with Office applications using the Office To-Go Device Manager.</descrip></descripGrp><ntig><termGrp><term id="1162836">Office enabled device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891323">Office иштеткен аспап</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2486_143220_1890937"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that heightens the color contrast of some text and images on your screen, making those items more distinct and easier to identify.</descrip></descripGrp><ntig><termGrp><term id="143220">High Contrast</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1890937">Жогору Айырмачылык</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24868_1162904_1891324"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The portion of data distribution that is determined to be more or less than some critical value. For example, the far left and far right areas of a bell curve.</descrip></descripGrp><ntig><termGrp><term id="1162904">tail</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891324">куйрук</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24869_1162906_1891325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into either tail of the probability distribution (i.e. is either less than a first critical value or greater than a second critical value).</descrip></descripGrp><ntig><termGrp><term id="1162906">two-tailed test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891325">эки куйруктуу сынамак</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24869_1162906_1891340"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into either tail of the probability distribution (i.e. is either less than a first critical value or greater than a second critical value).</descrip></descripGrp><ntig><termGrp><term id="1162906">two-tailed test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891340">эки жактуу сынамак</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="24869_1176836_1891325"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A test in which the null hypothesis is rejected if the value of the test statistic falls into either tail of the probability distribution (i.e. is either less than a first critical value or greater than a second critical value).</descrip></descripGrp><ntig><termGrp><term id="1176836">two-sided test</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber"