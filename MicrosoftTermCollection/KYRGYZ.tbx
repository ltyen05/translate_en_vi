en-US"><descripGrp><descrip type="definition">A combination of operators, constants, literal values, functions, and names of fields (columns), controls, and properties that evaluates to a single value.</descrip></descripGrp><ntig><termGrp><term id="2654592">language expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462792">туюнтма</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5613_52530_462792"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A combination of operators, constants, literal values, functions, and names of fields (columns), controls, and properties that evaluates to a single value.</descrip></descripGrp><ntig><termGrp><term id="52530">expression</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462792">туюнтма</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5620_212202_2596735"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of employees and contingent workers producing goods and services for an organization or company.</descrip></descripGrp><ntig><termGrp><term id="212202">workforce</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2596735">ресурстар</term><termNote type="geographicalUsage"