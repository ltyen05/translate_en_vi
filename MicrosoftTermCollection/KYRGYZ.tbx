server</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1495631">сервер</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13698_14395_462460"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A number that identifies each telephone service area in a country/region and is used as a dialing prefix.</descrip></descripGrp><ntig><termGrp><term id="14395">area code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462460">аймак коду</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13701_88326_463068"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To configure a device or application so that it performs better. For example, to fine-tune a program so that it runs more quickly or takes up less space.</descrip></descripGrp><ntig><termGrp><term id="88326">optimize</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="463068">оптималдаштыруу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1371_141114_1496101"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Properties, such as title, subject, and author, that are stored with each data access page.</descrip></descripGrp><ntig><termGrp><term id="141114">document properties</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1496101">документтин касиеттери</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13724_2346152_2799794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named set of deliverables (software components) produced, usually by compiling, from a discrete set of source versions.</descrip></descripGrp><ntig><termGrp><term id="2346152">BLD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2799794">курам</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="13724_24639_2799794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A named set of deliverables (software components) produced, usually by compiling, from a discrete set of source versions.</descrip></descripGrp><ntig><termGrp><term id="24639">build</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2799794">курам</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termN