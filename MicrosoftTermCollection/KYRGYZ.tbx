gSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables IT administrators to move Personal Folders files (.pst) to a mailbox in Office 365. A .pst file is a data file that stores your messages and other items on your computer.</descrip></descripGrp><ntig><termGrp><term id="2042671">PST import</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2055464">PST импорттоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35632_2045864_2052362"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A HIP challenge that requires a user to view an image and then type a set of characters contained in that image.</descrip></descripGrp><ntig><termGrp><term id="2045864">visual challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2052362">көрмө текшерүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="35633_2045865_2052358"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A security task that a user must complete to verify they are a human and not a machine.</descrip></descripGrp><ntig><termGrp><term id="2045865">challenge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2052358">текшерүү</term><termNote type=