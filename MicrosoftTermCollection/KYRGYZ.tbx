p><term id="61809">highlight</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462858">белгилөө</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14241_45676_462720"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computing, a characteristic of data that is represented as binary digits (zeros and ones).</descrip></descripGrp><ntig><termGrp><term id="45676">digital</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="462720">санариптик</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14244_115576_1982270"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To make a transmission appear to come from a user other than the user who performed the action.</descrip></descripGrp><ntig><termGrp><term id="115576">spoof</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1982270">окшотуп жасоо</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14246_343618_1495640"><langSet xml:lang="en-US"><descripGrp><des