ator. It contains tabs for each of their classes.</descrip></descripGrp><ntig><termGrp><term id="1624395">My Notes</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891482">Белгилерим</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31828_1624396_1891483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that enables users to present a document to remote viewers in a web browser or in Lync.</descrip></descripGrp><ntig><termGrp><term id="1624396">Present Online</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="1891483">Онлайн Тартуу</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="31838_1624428_2182205"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature to help monitor and save on battery usage.</descrip></descripGrp><ntig><termGrp><term id="1624428">Battery Saver</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2182205">батареяны үнөмдөгүч</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></term