3_2439180_2440485"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A bar, appearing at the top, that displays a small preview image (thumbnail) of the content in each open tab.</descrip></descripGrp><ntig><termGrp><term id="2439180">preview bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2440485">алдын ала көрүү тилкеси</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43054_2439181_2440487"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows you to see a small preview of the content in each open tab, shown in a persistent bar (not just on mouseover)​.</descrip></descripGrp><ntig><termGrp><term id="2439181">tab preview</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2440487">кыстарманы алдын ала көрүү</term><termNote type="geographicalUsage">KGZ</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="43055_2439182_2440486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To clear or remove all tabs that are currently displayed, and save them as a set of tabs that you can restore later.</descrip></descripGrp><ntig><termGrp><term id="2439182">set aside</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="ky"><ntig><termGrp><term id="2440486">четке орнотулган</term><te