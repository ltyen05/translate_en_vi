rmGrp></ntig></langSet></termEntry><termEntry id="44536_2505315_2576736"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a horizontal resolution of 3840 (or 4096) pixels and vertical resolution of 2160 pixels. Several 4K resolutions exist in the fields of digital television and digital cinematography.</descrip></descripGrp><ntig><termGrp><term id="2505315">4K</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2576736">4K</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44537_2505358_2505806"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Office Dictate button that allows users to override the Automatic Punctuation mode so that they can use voice commands (such as comma and period) to create punctuation in their document.</descrip></descripGrp><ntig><termGrp><term id="2505358">Manual Punctuation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2505806">Manual Punctuation</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44546_2506467_2509108"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A record of all purchases made by a user from an online store or portal.</descrip></descripGrp><ntig><termGrp><term id="2506467">order history</term><termNote type="partOfSpeech">Noun</termNote><