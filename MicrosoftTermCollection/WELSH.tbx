>Metadata pertaining to content across an enterprise.</descrip></descripGrp><ntig><termGrp><term id="1177489">enterprise metadata</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1519265">metaddata enterprise</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25683_1177653_1958714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service that runs Domain Name System (DNS) servers. Most, but not all, domain name registrars include DNS hosting service with registration.</descrip></descripGrp><ntig><termGrp><term id="1177653">DNS hosting service</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958714">gwasanaeth lletya DNS</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25695_1179897_1798873"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An online process that confirms whether installed software was properly activated.</descrip></descripGrp><ntig><termGrp><term id="1179897">validation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1798873">dilysu</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25710_1186375_1930898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service responsible for writing diagnostic logging and usage logging information from SharePoint applications to log files on disk.</descrip></descripGrp><ntig><termGrp><term id="1186375">Tracing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1930898">Gwasanaeth Olrhain</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25710_1186375_1930900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service responsible for writing diagnostic logging and usage logging information from SharePoint applications to log files on disk.</descrip></descripGrp><ntig><termGrp><term id="1186375">Tracing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1930900">Gwasanaeth Olrhain SharePoint</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25710_1186556_1930898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service responsible for writing diagnostic logging and usage logging information from SharePoint applications to log files on disk.</descrip></descripGrp><ntig><termGrp><term id="1186556">SharePoint Tracing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1930898">Gwasanaeth Olrhain</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25710_1186556_1930900"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service responsible for writing diagnostic logging and usage logging information from SharePoint applications to log files on disk.</descrip></descripGrp><ntig><termGrp><term id="1186556">SharePoint Tracing Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1930900">Gwasanaeth Olrhain SharePoint</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25721_1186432_1930899"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A capability that enables site collection administrators to manage and add new solutions to their site collections.</descrip></descripGrp><ntig><termGrp><term id="1186432">site collection solution gallery</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1930899">oriel atebion casgliad o safleoedd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25738_1231857_1824493"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A format for user assistance content that presents simple steps on a given topic that enable a user to begin using a feature quickly.</descrip></descripGrp><ntig><termGrp><term id="1231857">Quick start</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824493">Cychwyn cyflym</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1186759_1958626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1186759">Advanced Query Syntax</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958626">Cystrawen Ymholiad Uwch</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1186759_1985363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1186759">Advanced Query Syntax</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1985363">AQS</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1230149_1958626"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1230149">AQS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958626">Cystrawen Ymholiad Uwch</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25739_1230149_1985363"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A search query syntax that helps produce more precise search results by using targeted queries that search specific properties in a message type. AQS defines certain keywords which can be used to refine the search query, such as specifying boolean operations on searched terms (AND, OR, NOT) as well as to specify further filters based on file metadata or file type. It can also be used to limit results from specific information stores like regular files, offline files cache, or email stores.</descrip></descripGrp><ntig><termGrp><term id="1230149">AQS</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1985363">AQS</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2574_90847_508746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The quality of sameness or equivalence, in the case of computers usually referring to an error-checking procedure in which the number of 1s must always be the same --either even or odd-- for each group of bits transmitted without error.</descrip></descripGrp><ntig><termGrp><term id="90847">parity</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508746">paredd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1403948_1958738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1403948">Exchange Control Panel</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958738">Panel Rheoli Exchange</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1755528_1958738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1755528">Exchange admin center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958738">Panel Rheoli Exchange</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_1756842_1958738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="1756842">Exchange Administration Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958738">Panel Rheoli Exchange</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25740_2794247_1958738"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The web-based management tool for Microsoft Exchange administrators and enterprise email users.</descrip></descripGrp><ntig><termGrp><term id="2794247">EAC</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958738">Panel Rheoli Exchange</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25741_1186781_1958790"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The primary navigation tab for mail flow management features in Outlook Live: Transport rules, called “rules” in Outlook Live service; Supervision policies, including closed campus supervision policy and bad words supervision policy, and anti-bullying supervision policy; IP safelisting; Domain types: hosted or shared.</descrip></descripGrp><ntig><termGrp><term id="1186781">Mail Control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958790">Rheoli Post</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25742_1186782_1958820"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Web-based management interface for Live@edu administrators. Administrators enroll their domain there initially, and then use the portal to keep their contact information up to date; access DNS record information; view the status of enrolled domains; manage IP safelists; request support for single sign-on; submit or escalate a support request; link to all other resources.</descrip></descripGrp><ntig><termGrp><term id="1186782">Microsoft Live@edu Service Management Portal</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958820">Safle Porth Rheoli Gwasanaeth Microsoft Live@edu</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25743_1186784_1958931"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of email policy settings that can help primary and secondary school administrators comply with some requirements of the Children's Internet Protection Act (CIPA). Using these policy settings, administrators can control who can send email to and receive email from the users in their organization, and filter and reject email that contains objectionable words.</descrip></descripGrp><ntig><termGrp><term id="1186784">supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958931">polisi goruchwylio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25744_1187169_1958667"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail policy settings that apply inbound and outbound email restrictions so students can send email to or receive email from addresses inside the organization only. Administrators can set up organization-wide exceptions so email can be sent to or from specific domains and public groups. Administrators can also configure per-user exceptions so students can send email to and receive email from specific addresses outside the organization.</descrip></descripGrp><ntig><termGrp><term id="1187169">closed campus supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958667">polisi goruchwylio campws caeëdig</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25745_1187170_1958627"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An email policy that administrators use to prevent a bully from sending email messages to specific people by adding the bully's email address as an entry on the "victim's" supervision list. This functionality supports anti-harassment policies in schools and other organizations.</descrip></descripGrp><ntig><termGrp><term id="1187170">anti-bullying supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958627">polisi goruchwylio gwrth-fwlio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25747_1188776_1958930"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An individual item on the list of email addresses or users that are subject to or excepted from the actions of the closed campus supervision policy or anti-bullying supervision policy. For example, a bully's email address would be an entry on the supervision list of a "victim", and a parent's email address might be added as an entry on the supervision list of their child, who is a student subject to the closed campus supervision policy.</descrip></descripGrp><ntig><termGrp><term id="1188776">supervision list entry</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958930">cofnod rhestr goruchwylio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25748_1188777_1958929"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The list of email addresses or users that are subject to or excepted from the actions of the closed campus supervision policy or anti-bullying supervision policy.</descrip></descripGrp><ntig><termGrp><term id="1188777">supervision list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958929">rhestr goruchwylio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25749_1188778_1958644"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">E-mail policy settings that prevent sending and receiving email that has specifically banned content. Administrators can use this policy to reject email that contains profanity or other objectionable words, also known as "bad words".</descrip></descripGrp><ntig><termGrp><term id="1188778">bad word supervision policy</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958644">polisi goruchwylio geiriau drwg</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25750_1188779_1958827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of user accounts that are being submitted in a CSV file for migration from an on-premises messaging system to an email system in the cloud.</descrip></descripGrp><ntig><termGrp><term id="1188779">migration batch</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958827">swp mudo</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25751_1188780_1958828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The action of submitting a migration batch for migration from an on-premises messaging system to an email system in the cloud.</descrip></descripGrp><ntig><termGrp><term id="1188780">migration batch request</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958828">cais swp mudo</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25752_1188782_1519295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A threshold in the Resource Throttling feature that specifies the maximum number of items that a database operation can involve at one time. Operations that exceed this limit are prohibited.</descrip></descripGrp><ntig><termGrp><term id="1188782">List View Threshold</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1519295">Trothwy Gwedd Rhestr</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25753_1188783_1958693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The time span between the start and end dates.</descrip></descripGrp><ntig><termGrp><term id="1188783">date range</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958693">ystod dyddiadau</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote t