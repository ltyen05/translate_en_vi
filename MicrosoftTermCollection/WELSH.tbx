escrip type="definition">A collection of keys or key and value pairs that is used for content or query processing in search.</descrip></descripGrp><ntig><termGrp><term id="1653507">dictionary</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824722">geiriadur</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32334_1653508_1824723"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of detecting the file type of an item during content processing, and converting the item to text.</descrip></descripGrp><ntig><termGrp><term id="1653508">document parsing</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824723">dosrannu dogfen</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="32335_1653509_1824724"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of extracting information from unstructured text in an item and storing that information as additional managed properties for the item.</descrip></descripGrp><ntig><termGrp><term id="1653509">entity extraction</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824724">echdynnu endid</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</ter