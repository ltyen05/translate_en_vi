uests information from SNMP agents.</descrip></descripGrp><ntig><termGrp><term id="163636">management console</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509180">system rheoli</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2252_163637_509179"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network-enabled host running Simple Network Management Protocol (SNMP) management software. This software requests information from SNMP agents.</descrip></descripGrp><ntig><termGrp><term id="163637">management system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509179">consol rheoli</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2252_163637_509180"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A network-enabled host running Simple Network Management Protocol (SNMP) management software. This software requests information from SNMP agents.</descrip></descripGrp><ntig><termGrp><term id="163637">management system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509180">system rheoli</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22533_1047904_1930828"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that allows users to build business logic in a new and easy-to-use authoring environment. The declarative, macro-style logic will run on client and server and includes both UI-level and data-level actions.</descrip></descripGrp><ntig><termGrp><term id="1047904">Data Macros</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1930828">Macros Data</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22536_1047907_1167043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that provides one-click filtering controls that make it easy to narrow down the portion of a data set that's being looked at.</descrip></descripGrp><ntig><termGrp><term id="1047907">Slicers</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1167043">Holltwyr</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22541_1047912_1167044"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A miniature chart that can be inserted into text or embedded within a cell on a worksheet to illustrate highs, lows, and trends in your data.</descrip></descripGrp><ntig><termGrp><term id="1047912">sparkline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1167044">siart llinell patrwm</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22543_1047914_1167045"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Outlook Calendar view in which each calendar is listed vertically (not side-by-side). This view is optimized for viewing a schedule for a group and scheduling a meeting for a group.</descrip></descripGrp><ntig><termGrp><term id="1047914">Schedule View</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1167045">Gweld Amserlen</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="22545_1047918_1167046"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A feature that converts each slide in a presentation into a single image and rebuilds a new, compressed PPT presentation that can easily be shared, but not edited.</descrip></descripGrp><ntig><termGrp><term id="1047918">Picture Presentation</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1167046">Cyflwyniad Lluniau</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><te