20638"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A piece of handheld equipment such as a portable music or video player, PDA (personal digital assistant), mobile phone, tablet or warehouse device that works on its own but can also be connected to a computer.</descrip></descripGrp><ntig><termGrp><term id="81161">mobile device</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2420638">symudol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12349_26421_508262"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of temporarily storing recently accessed information in a special memory subsystem for quicker access.</descrip></descripGrp><ntig><termGrp><term id="26421">caching</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508262">storio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="12359_235413_509426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A modular unit of code that acts as part of a larger system or structure.</descrip></descripGrp><ntig><termGrp><term id="235413">component</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509426">cydran</term><termNote type="geographicalUsage">