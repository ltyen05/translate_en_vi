<termEntry id="7764_1975517_1978486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard disk that contains a small amount of solid-state nonvolatile memory which, when used as a cache, can realize significant benefits such as faster booting, extended battery life, and a more rugged PC.</descrip></descripGrp><ntig><termGrp><term id="1975517">hybrid drive</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1978486">gyriant hybrid</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7764_314130_1978486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard disk that contains a small amount of solid-state nonvolatile memory which, when used as a cache, can realize significant benefits such as faster booting, extended battery life, and a more rugged PC.</descrip></descripGrp><ntig><termGrp><term id="314130">hybrid hard disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1978486">gyriant hybrid</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7764_366903_1978486"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A hard disk that contains a small amount of solid-state nonvolatile memory which, when used as a cache, can realize significant benefits such as faster booting, extended battery life, and a more rugged PC.</descrip></descripGrp><ntig><termGrp><term id="366903">hybrid disk</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1978486">gyriant hybrid</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7781_179526_509206"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A control (composed of a text box and spin button control) that allows a user to adjust a value from a limited range of possible values.</descrip></descripGrp><ntig><termGrp><term id="179526">spin box</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509206">blwch sbin</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="7785_120062_508898"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The bar that contains the 'Start' button and appears by default at the bottom of the desktop. You can click the taskbar buttons to switch between programs. You can also hide the taskbar, move it to the sides or top of the desktop, and customize it in other ways.</descrip></descripGrp><ntig><termGrp><term id="120062">taskbar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508898">bar tasgau</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatica