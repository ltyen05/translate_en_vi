u create a view, you must first select one of five view types (table, timeline, day/week/month, card, or icon) to determine how information will be arranged and formatted in your new view.</descrip></descripGrp><ntig><termGrp><term id="149827">view type</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1166789">math o wedd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10492_251783_1540951"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collective grouping of projects, usually including a common set of goals, plans and measurement of success, that is managed and delivered in a coordinated way.</descrip></descripGrp><ntig><termGrp><term id="251783">program</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1540951">rhaglen</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10498_168444_1824250"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user who can schedule meetings, send invitations, do all the sharing activities in a meeting, and admit participants from the lobby.</descrip></descripGrp><ntig><termGrp><term id="168444">Organizer</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824250">trefnydd cyfarfod</te