langSet xml:lang="en-US"><descripGrp><descrip type="definition">To store data in such a way that it can be retrieved later by the same security support component, and only by that security support component.</descrip></descripGrp><ntig><termGrp><term id="338545">seal</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509958">selio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10928_359996_510051"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A table, query, form, report, macro, or module that remains in the replica or Design Master where it was created. Neither the object nor changes to the object are copied to other members in the replica set.</descrip></descripGrp><ntig><termGrp><term id="359996">local object</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="510051">gwrthrych lleol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10934_237291_509452"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An option that applies a read-only state to a document inside client applications.</descrip></descripGrp><ntig><termGrp><term id="237291">Mark as Final</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509452">Marcio'n Derfynol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10935_54757_508502"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To associate a flag with a message or other item.</descrip></descripGrp><ntig><termGrp><term id="54757">flag</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508502">fflagio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10945_139125_1824076"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A software program that reduces a file's size for storage on a disk. If a compressed file is too large to fit onto a single disk, the compression utility copies it onto multiple disks.</descrip></descripGrp><ntig><termGrp><term id="139125">compression utility</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824076">cyfleuster cywasgu</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10947_320488_508593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Erroneous or unrecognizable because of a flaw in reasoning or an error in input. Invalid results, for example, might occur if the logic in a program is faulty.</descrip></descripGrp><ntig><termGrp><term id="320488">not valid</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508593">annilys</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10947_70460_508593"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Erroneous or unrecognizable because of a flaw in reasoning or an error in input. Invalid results, for example, might occur if the logic in a program is faulty.</descrip></descripGrp><ntig><termGrp><term id="70460">invalid</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508593">annilys</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="10963_306412_509687"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A menu item in Internet Explorer that turns on the tool for Tablet PC users that allows the user to move the content of the page up and down, like a mouse scroll wheel.</descrip></descripGrp><ntig><termGrp><term id="306412">Panning Hand</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509687">Llaw Tremio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNot