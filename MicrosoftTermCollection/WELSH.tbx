ote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2532692">Beth uffach...</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44973_2531394_2532693"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The emoticon depicting a person practicing yoga.</descrip></descripGrp><ntig><termGrp><term id="2531394">yoga</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2532693">Ioga</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44974_2531395_2532694"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The emoticon depicting a dancing zombie.</descrip></descripGrp><ntig><termGrp><term id="2531395">zombie</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2532694">Zombie</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44979_2531469_2539232"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Windows feature for controlling the cursor, mouse clicks, text input, and communication with the movement of your eyes, using an on-screen keyboard and other software controls together with eye-tracking hardware​.</descrip></descripGrp><ntig><termGrp><term id="2531469">eye control</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2539232">rheolaeth llygad</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44981_2531623_2917306"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that presents data on who your players are and how they're engaging with Xbox features in your game. The reported statistics consider only the customers who are connected to Xbox Live, not all Xbox customers. The report only shows data if your game is published to Xbox or uses Xbox Live.</descrip></descripGrp><ntig><termGrp><term id="2531623">Xbox analytics</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2917306">dadansoddeg Xbox</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531624_2913798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox avatars, start fresh with brand new ones, or take pictures of their avatars to share with friends. Users can also export avatars as 3D models for 3D printing or for use in Paint 3D.</descrip></descripGrp><ntig><termGrp><term id="2531624">Xbox Avatars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2913798">Avatars</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531624_2917315"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox avatars, start fresh with brand new ones, or take pictures of their avatars to share with friends. Users can also export avatars as 3D models for 3D printing or for use in Paint 3D.</descrip></descripGrp><ntig><termGrp><term id="2531624">Xbox Avatars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2917315">Xbox Avatars</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="44982_2531625_2913798"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The app that allows users to change their Xbox avatars, start fresh with brand new ones, or take pictures of their avatars to share with friends. Users can also export avatars as 3D models for 3D printing or for use in Paint 3D.</descrip></descripGrp><ntig><termGrp><term id="2531625">Avatars</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2913798">Avatars</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine<