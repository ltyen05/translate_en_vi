icalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52349_2955561_2984454"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns a member or tuple in a cube hierarchy. Use to validate that the member or tuple exists in the cube.</descrip></descripGrp><ntig><termGrp><term id="2955561">CUBEMEMBER</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2984454">CUBEMEMBER</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52350_2955562_2984455"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the value of a member property in the cube. Use to validate that a member name exists within the cube and to return the specified property for this member.</descrip></descripGrp><ntig><termGrp><term id="2955562">CUBEMEMBERPROPERTY</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2984455">CUBEMEMBERPROPERTY</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52351_2955563_2984456"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Cube Excel function that returns the nth, or ranked, member in a set. Use to return one or more elements in a set, such as the top sale