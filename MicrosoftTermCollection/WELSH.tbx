it. The roles assigned to the role group are applied to each member who is added to the role group. This grants each user all the permissions allowed by the roles assigned to the role group.</descrip></descripGrp><ntig><termGrp><term id="1216623">role group member</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958894">aelod o grŵp rôl</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25787_1216679_1375717"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the Microsoft service agreement.</descrip></descripGrp><ntig><termGrp><term id="1216679">Terms of use</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1375717">Telerau defnyddio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25798_1216733_1375718"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The link to the personal page where users can store information (such as personal interests) and links (such as to friends and photos).</descrip></descripGrp><ntig><termGrp><term id="1216733">Profile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1375718">Proffil</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpee