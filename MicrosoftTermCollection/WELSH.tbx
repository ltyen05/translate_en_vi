cripGrp><descrip type="definition">The process of renewing one's energy over the course of a full night's sleep.</descrip></descripGrp><ntig><termGrp><term id="2862649">nightly recharge</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2863507">magu nerth newydd bob nos</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50560_2862871_2863516"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A section of the UI in which the user can store interface elements such as links to apps, folders, or messages in order to keep them in an easily accessible location.</descrip></descripGrp><ntig><termGrp><term id="2862871">dock</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2863516">doc</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50568_2863799_2864376"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of topics connected through shared resources and contributors that combines AI with human moderation to help your organization learn about itself.</descrip></descripGrp><ntig><termGrp><term id="2863799">knowledge network</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2864376">rhwydwaith gwybodaeth</term><termNote type="geo