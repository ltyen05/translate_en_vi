oun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25889_1230091_1930904"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The total number of objects that are currently active in the object cache. These objects can quickly be retrieved from the cache.</descrip></descripGrp><ntig><termGrp><term id="1230091">object cache live count</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1930904">cyfrif byw storfa gwrthrychau</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25890_1230093_1930905"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The total number of objects from the object cache that have been removed from memory by the garbage collector.</descrip></descripGrp><ntig><termGrp><term id="1230093">object cache GC count</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1930905">cyfrif GC storfa gwrthrychau</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="25900_1509435_1650451"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The device that runs Windows Phone Operating System.</descrip></descripGrp><ntig><termGrp><term id="1509435">Windows Phone</term><termNote type="partOfSpeech">ProperNoun</ter