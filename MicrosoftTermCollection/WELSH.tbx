p><descrip type="definition">The security feature that protects your device by providing startup and runtime protections that the operating system can validate and report on.</descrip></descripGrp><ntig><termGrp><term id="2615085">System Guard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2617073">Gwarchodwr y System</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46479_2615093_2617083"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The remote attestation service that checks the health of Windows 10-based devices to allow or deny access to networks, apps, or services, based on whether devices prove to be healthy.</descrip></descripGrp><ntig><termGrp><term id="2615093">Windows Health Attestation Service</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2617083">Gwasanaeth Prawf Iechyd Windows</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="46481_2615123_2617069"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The area in Windows Defender Security Center that helps customers keep their devices refreshed and up to date with the latest version of Windows 10. Device health advisor monitors the device and provides information and recommendations in a Health report to address common issues with storage capacity, device drivers, battery life, or Windows Update.</descrip></descripGrp><ntig><termGrp><term id="2615123">Device performance &amp; health</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2617069">Perfformiad ac iechyd y ddyfais</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="4649_50166_1824012"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A typographical unit of measure that is equal in width to the point size of a particular font. For many fonts, this is equal to the width of a capital M, from which the em space takes its name.</descrip></descripGrp><ntig><termGrp><term id="50166">em space</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824012">bwlch em</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="465_380990_1095078"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A group of users that can be created on a SharePoint site to manage permissions to the site and to provide an email distribution list for site users. A group can be used by many sites in one site collection.</descrip></descripGrp><ntig><termGrp><term id="380990">SharePoint group</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1095078">grŵp ShareP