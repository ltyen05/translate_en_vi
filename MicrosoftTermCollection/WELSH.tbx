 type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1426503">colofn cyfrifoldeb</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19234_652206_1798869"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any application or process that you want to model. Examples of systems include a computer game, a process for assembling microchips, and a library information system.</descrip></descripGrp><ntig><termGrp><term id="652206">system</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1798869">system</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19250_652222_1824339"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">One of a set of major and minor fonts that is applied to a file. Theme fonts, theme colors, and theme effects compose a theme.</descrip></descripGrp><ntig><termGrp><term id="652222">theme font</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824339">ffont thema</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="19251_652223_1824340"><langSet xml:lang="en-US"><descr