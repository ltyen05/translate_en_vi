rmEntry id="52960_3010666_3011512"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Describes an object, such as a file or email, that has been inspected and found to not contain any harmful or potentially harmful content.</descrip></descripGrp><ntig><termGrp><term id="3010666">no threats found</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3011512">heb ganfod unrhyw fygythiadau</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5297_107243_508822"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To write data (typically a file) to a storage medium.</descrip></descripGrp><ntig><termGrp><term id="107243">save</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508822">cadw</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52979_3011592_3011877"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The view in PowerPoint that allows users to read notes, which are hidden from the presentation, when a user is recording a video of their PowerPoint presentation.</descrip></descripGrp><ntig><termGrp><term id="3011592">Teleprompter</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3011877">Teleweinydd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5298_9459_508157"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A collection of contact information for particular individuals, groups or organizations.</descrip></descripGrp><ntig><termGrp><term id="9459">address book</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508157">llyfr cyfeiriadau</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52980_3011955_3012057"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A graphical control element in the form of a progress bar that shows playback progress and allows the user to move backward/forward along a slider in order to rewind/fast-forward video playback or click on a point along the slider to move to a particular point in time of the recording.</descrip></descripGrp><ntig><termGrp><term id="3011955">seek bar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3012057">bar cynnydd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52981_3011956_3012055"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The high-definition video format characterized by a display resolution of 1920x1080 pixels.</descrip></descripGrp><ntig><termGrp><term id="3011956">Full HD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3012055">HD llawn</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52982_3011957_3012056"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The duration of time in a music album or an audio disc.</descrip></descripGrp><ntig><termGrp><term id="3011957">run time</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3012056">amser rhedeg</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52984_3012061_3012475"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on available to Microsoft Viva Insights subscribers, which provides additional capacity for usage of custom analysis tools.</descrip></descripGrp><ntig><termGrp><term id="3012061">Microsoft Viva Insights Capacity</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3012475">Microsoft Viva Insights Capacity</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammati