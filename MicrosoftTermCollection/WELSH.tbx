<langSet xml:lang="cy-GB"><ntig><termGrp><term id="1988849">rhandy un trywydd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16496_592344_1988817"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of exactly one thread.</descrip></descripGrp><ntig><termGrp><term id="592344">STA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1988817">STA</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16496_592344_1988849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An apartment that consists of exactly one thread.</descrip></descripGrp><ntig><termGrp><term id="592344">STA</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1988849">rhandy un trywydd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="165_127792_2528978"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer graphics, a line drawn in a certain direction from a starting point to an endpoint, both of whose locations are identified by the computer using x-y-coordinates on a grid. Vectors are used in the output of some graphics programs instead of groups of dots (on paper) or pixels (on screen).</descrip></descripGrp><ntig><termGrp><term id="127792">vector</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2528978">fector</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1650_13978_2913770"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Any computer game designed to mimic the style of a coin-operated arcade game, such as games marketed for the home computer.</descrip></descripGrp><ntig><termGrp><term id="13978">arcade game</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2913770">gêm arcêd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16504_592353_1824288"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that shows a three dimensional surface that connects a set of data points. As in a topographic map, colors and patterns indicate areas that are in the same range of values.</descrip></descripGrp><ntig><termGrp><term id="592353">surface chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824288">siart arwyneb</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16505_592354_2765419"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to a resource in a failover cluster or server cluster that is in the process of being brought online or offline.</descrip></descripGrp><ntig><termGrp><term id="592354">pending</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2765419">yn disgwyl</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16506_592355_1824289"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A surface chart subtype that provides a view of the surface chart from above, with colors representing specific ranges of values.</descrip></descripGrp><ntig><termGrp><term id="592355">contour chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824289">siart cyflun</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16507_592356_1824290"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A contour chart displayed without color.</descrip></descripGrp><ntig><termGrp><term id="592356">wireframe contour chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824290">siart amlinell ffrâm wifren</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16508_2909978_1824291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that displays data in rings, where each ring represents a data series.</descrip></descripGrp><ntig><termGrp><term id="2909978">donut</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824291">siart toesen</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16508_592357_1824291"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A chart that displays data in rings, where each ring represents a data series.</descrip></descripGrp><ntig><termGrp><term id="592357">doughnut chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824291">siart toesen</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16511_592360_1824292"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A doughnut chart that displays the contribution of each value to a total while emphasizing individual values, by showing each slice of the doughnut as "pulled out," or separate, from the whole.</descrip></descripGrp><ntig><termGrp><term id="592360">exploded doughnut chart</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824292">siart toesen chwâl</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16513_592362_1824293"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A best-fit curved trendline that is used when the rate of change in the data increases or decreases quickly and then levels out.</descrip></descripGrp><ntig><termGrp><term id="592362">logarithmic trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824293">llinell tuedd logarithmig</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16514_592363_1824294"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used when data fluctuates.</descrip></descripGrp><ntig><termGrp><term id="592363">polynomial trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824294">llinell tuedd polynomaidd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16516_592365_1824295"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used with data sets that compare measurements that increase at a specific rate.</descrip></descripGrp><ntig><termGrp><term id="592365">power trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824295">llinell tuedd pŵer</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16518_592368_1824296"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A curved trendline that is used when data values rise or fall at constantly increasing rates.</descrip></descripGrp><ntig><termGrp><term id="592368">exponential trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824296">llinell tuedd esbonyddol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16519_592369_1824297"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A trendline that smoothes out fluctuations in data to show a pattern or trend more clearly.</descrip></descripGrp><ntig><termGrp><term id="592369">moving average trendline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824297">llinell tuedd cyfartaledd symudol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16525_592375_2702518"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A user whose account resides in an account partner organization and who can access federated applications that reside in a resource partner organization. In the context of Office 365, a federated user is one that is sourced (mastered, authenticated, created, and managed) in an organization’s on-premises Active Directory. The on-premises Active Directory has a trust relationship with the cloud that allows authenticated Active Directory users to access cloud resources (or “services,” such a SharePoint Online, Exchange Online, etc).</descrip></descripGrp><ntig><termGrp><term id="592375">federated user</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2702518">defnyddiwr ffederasiwn</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16533_592383_1958954"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that represents the public-key portion of a token-signing certificate. A verification certificate is stored in the trust policy and used by the federation server in one organization to verify that incoming security tokens have been issued by valid federation servers in the organization's farm and in other organizations.</descrip></descripGrp><ntig><termGrp><term id="592383">verification certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958954">tystysgrif dilysu</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1654_234919_509412"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wizard that allows third-party developers to achieve the same look in their dialog boxes as Aero.</descrip></descripGrp><ntig><termGrp><term id="234919">Aero Wizard</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509412">Dewin Aero</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16543_592397_2702505"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">For BitLocker Drive Encryption, a combination of one or more of the following elements, identified by a globally unique identifier (GUID): personal identification number (PIN), recovery password, recovery key, startup key, and Trusted Platform Module (TPM).</descrip></descripGrp><ntig><termGrp><term id="592397">authentication method</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2702505">dull dilysu</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16577_592433_1426483"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To ensure that all data sources that are used by a KPI or scorecard are available.</descrip></descripGrp><ntig><termGrp><term id="592433">validate</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1426483">dilysu</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1658_115875_1958922"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The process of running a management agent that imports data from a connected data source into the connector space, and then immediately stopping the run.</descrip></descripGrp><ntig><termGrp><term id="115875">staging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958922">llwyfannu</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16584_592444_2588837"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A directory name, used in an address, that corresponds to a physical directory on the server.</descrip></descripGrp><ntig><termGrp><term id="592444">virtual directory</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2588837">rhith gyfeiriadur</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16594_592578_2182173"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A service or feature that renders the audio content of a television or video program as text on the screen. These captions are usually visible only if decoded or activated.</descrip></descripGrp><ntig><termGrp><term id="592578">closed captioning</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2182173">capsiynau caeedig</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16607_592811_1166847"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A numeric or other designation appended to a product name to identify a particular release.​</descrip></descripGrp><ntig><termGrp><term id="592811">version</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1166847">fersiwn</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16609_592813_1166849"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An effect applied to a graphical object that typically reduces the difference between the outline of the object and the graphical area next to it.</descrip></descripGrp><ntig><termGrp><term id="592813">blur</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1166849">pylu</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16612_592816_1958913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wireless, mobile device that combines platform software, a browser, a modern chipset, and a telephone handset.</descrip></descripGrp><ntig><termGrp><term id="592816">smartphone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958913">ffôn clyfar</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16612_592837_1958913"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A wireless, mobile device that combines platform software, a browser, a modern chipset, and a telephone handset.</descrip></descripGrp><ntig><termGrp><term id="592837">phone</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958913">ffôn clyfar</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16647_594141_1988829"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Software that provides encryption for sensitive data, such as passwords, in applications.</descrip></descripGrp><ntig><termGrp><term id="594141">encryption provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1988829">darparwr amgryptio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16658_600620_1824298"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The round button in the lower left-hand corner of the Windows screen that allows the user to click and display the Start menu.</descrip></descripGrp><ntig><termGrp><term id="600620">Start button</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824298">botwm Cychwyn</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="16665_601385_2625714"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An attack by a malicious user or malicious software on a computer or operating system to find a secret password or a symmetric encryption key by guessing passwords or keys until the correct password or key is discovered.</descrip></descripGrp><ntig><termGrp><term id="601385">key search attack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp