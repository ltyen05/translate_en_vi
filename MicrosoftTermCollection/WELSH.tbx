0698_782774_1166906"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A password that helps prevent unauthorized access to homegroup files and printers.</descrip></descripGrp><ntig><termGrp><term id="782774">homegroup password</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1166906">cyfrinair grŵp cartref</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20702_746417_1166907"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A digital or paper format pack that usually consists of a proof of purchase, the description of the licensing terms and policies, and number of client access licenses (CALs) purchased in this pack.</descrip></descripGrp><ntig><termGrp><term id="746417">CAL pack</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1166907">pecyn CAL</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20703_746420_1166908"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An action that removes redundant messages from an email conversation to reduce information overload and improve readability.</descrip></descripGrp><ntig><termGrp><term id="746420">Clean Up</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig>