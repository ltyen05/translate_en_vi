n the service starts and stops.</descrip></descripGrp><ntig><termGrp><term id="334567">Process Control mediator</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1930762">cyfryngwr</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14526_360146_510059"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A query that asks a question about the data stored in your tables and returns a result set in the form of a datasheet, without changing the data.</descrip></descripGrp><ntig><termGrp><term id="360146">select query</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="510059">dewis ymholiad</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14528_276550_1995373"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A single location in Windows where you can adjust mobile PC settings.</descrip></descripGrp><ntig><termGrp><term id="276550">Windows Mobility Center</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1995373">Canolfan Symudedd Windows</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14532_361188_1094914"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that describes a database or Web service and includes connection settings, authentication mode, definitions of available entities, and other information.</descrip></descripGrp><ntig><termGrp><term id="361188">application definition</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1094914">diffiniad rhaglen</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14534_21247_508229"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A file that contains encoded information that is interpreted according to the application that created it. In general, a binary file can be edited only by the application in which it was created.</descrip></descripGrp><ntig><termGrp><term id="21247">binary file</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508229">ffeil ddeuaidd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="14540_373951_1950944"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An interactive technology in Microsoft Excel or Access that can show dynamic views of the same data from a list or a database.</descrip></descripGrp><ntig><termGrp><term id="373951">Microsoft PivotTable</term><termNote t