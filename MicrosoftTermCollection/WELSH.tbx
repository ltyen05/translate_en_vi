calNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508583">rhyngweithiol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15153_304427_1166835"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An exponentiation operator used in some programming languages. For example, the expression 3^2 represents the number 3 raised to the second power.</descrip></descripGrp><ntig><termGrp><term id="304427">caret</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1166835">to bach</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15154_2421378_1540957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work item that records a possible event with an undesirable outcome.</descrip></descripGrp><ntig><termGrp><term id="2421378">risk event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1540957">risg</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="15154_252099_1540957"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A work item that records a possible event with an undesirab