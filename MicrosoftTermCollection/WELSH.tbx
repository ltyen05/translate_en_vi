ne MSA-based SKU that will be available for both small businesses and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3007455">Microsoft Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3008435">Microsoft Teams Essentials</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52949_3007455_3122126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Teams standalone MSA-based SKU that will be available for both small businesses and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3007455">Microsoft Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3122126">Teams Essentials</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52949_3121608_3008435"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Teams standalone MSA-based SKU that will be available for both small businesses and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3121608">Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3008435">Microsoft Teams Essentials</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52949_3121608_3122126"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The paid Teams standalone MSA-based SKU that will be available for both small businesses and consumers to purchase.</descrip></descripGrp><ntig><termGrp><term id="3121608">Teams Essentials</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3122126">Teams Essentials</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52950_3007456_3008446"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature that allows users to publish full screen photo or short video content to their storyline, appearing in Viva Connections, Yammer, and elsewhere in Microsoft 365, allowing the user to express themselves, share their thoughts, or showcase an important moment or campaign to their followers or colleagues.</descrip></descripGrp><ntig><termGrp><term id="3007456">stories</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3008446">straeon</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52951_3007457_3008449"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A personal space for users to post thoughts and share ideas that are not confined to a specific community or event, allowing users to share their expertise on any subject of their choosing, build their personal brand within the company, or promote ideas and events that apply to more than one community, or even the entire network.</descrip></descripGrp><ntig><termGrp><term id="3007457">storyline</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3008449">llinell stori</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52952_3007458_3008422"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on with two associated SKUs that enables Microsoft 365 customers to store their Microsoft 365 user data at rest in their local geography at the tenant level​.</descrip></descripGrp><ntig><termGrp><term id="3007458">Advanced Data Residency Plan 1</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3008422">Cynllun Preswyl Data Uwch 1</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52953_3007459_3008426"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An add-on with two associated SKUs that enables Microsoft 365 customers to store their Microsoft 365 user data at rest in their local geography at the user account level​.</descrip></descripGrp><ntig><termGrp><term id="3007459">Advanced Data Residency Plan 2</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3008426">Cynllun Preswyl Data Uwch 2</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52954_3079521_3080090"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service that enables organizations to use a single SIM-enabled number for Teams Phone serving as desk phone number, mobile number and Teams number.</descrip></descripGrp><ntig><termGrp><term id="3079521">Microsoft Teams Phone Mobile</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3080090">Microsoft Teams Phone Mobile</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52955_3007461_3008450"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in the M365 Compliance Center used by customers to look up individuals as part of a Data Subject Access Request (DSAR), most commonly in response to a GDPR or CCPA data access request.</descrip></descripGrp><ntig><termGrp><term id="3007461">user data search</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3008450">chwiliad data defnyddwyr</term><termNote type="geographicalUsage">GBR</termNote><termNote type=