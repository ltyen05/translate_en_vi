7659_2702510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that identifies the certification authority (CA) that issues server and client authentication certificates to the servers and clients that request these certificates.</descrip></descripGrp><ntig><termGrp><term id="727659">signature certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2702510">Tystysgrif CA</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="20621_748022_2702510"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A certificate that identifies the certification authority (CA) that issues server and client authentication certificates to the servers and clients that request these certificates.</descrip></descripGrp><ntig><termGrp><term id="748022">site certificate</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2702510">Tystysgrif CA</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="2065_80862_508679"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An installation where only the necessary components are installed on a system.</descrip></descripGrp><ntig><termGrp><term id="80862">minimum installation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><l