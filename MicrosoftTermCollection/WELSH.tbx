ent is shown as a background to the video of the presenter.</descrip></descripGrp><ntig><termGrp><term id="2926584">Standout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2928198">Sefyll Allan</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51986_2926585_2928163"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The preview version of the Learning app in Microsoft Teams.</descrip></descripGrp><ntig><termGrp><term id="2926585">Learning (Preview)</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2928163">Dysgu (Rhagolwg)</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="51987_2926606_2928156"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The state of work in which one is able to focus completely on a task without distraction.</descrip></descripGrp><ntig><termGrp><term id="2926606">deep work</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2928156">gwaith dwfn</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry