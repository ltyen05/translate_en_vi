umber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23657_1088805_1958697"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer systems, a reduction in level of performance or service. Degradation in microcomputer performance is indicated by slow response times or frequent pauses for disk access because memory is insufficient to hold an entire program plus the data the program is using.</descrip></descripGrp><ntig><termGrp><term id="1088805">degradation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958697">dirywiad</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23692_1088842_2881984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of test cases and their associated test configuration information and the iteration when it is planned to run these tests.</descrip></descripGrp><ntig><termGrp><term id="1088842">test plan</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2881984">cynllun dilysu</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="23692_2749693_2881984"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A set of test cases and their associated test configuration information and the iteration when it is planned to run these tests.</descrip></descripGrp><ntig><termGrp><term id="274969