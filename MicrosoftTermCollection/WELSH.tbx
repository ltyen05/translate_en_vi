64_2232761"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A note, handwritten or typed, that can be added by the user directly on webpages from within the browser.</descrip></descripGrp><ntig><termGrp><term id="2227164">Web Note</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2232761">Nodyn Gwe</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38427_2227165_2232763"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 available through volume licensing, that is designed for education institutions, and includes all of the features of Windows 10 Pro, plus some other features like virtualization, management, DirectAccess, and BranchCache.</descrip></descripGrp><ntig><termGrp><term id="2227165">Windows 10 Education</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2232763">Windows 10 Education</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="38428_2227166_2232766"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The edition of Windows 10 that is available only through volume licensing, is designed for businesses, and includes all of the features of Windows 10 Pro, plus some other features like virtualization, management, DirectAccess, and BranchCache.</descrip></descripGrp><ntig><termGrp><term id="22271