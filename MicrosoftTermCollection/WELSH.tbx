<ntig><termGrp><term id="2868552">Dynamic 360° Hinge</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2870383">Dynamic 360° Hinge</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_160054_509168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="160054">color-space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509168">trawsnewid gofod lliw</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="5069_210048_509168"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A technique for converting a color in one color space to another color space. Typically, this conversion is from YUV colors from a video source to RGB for display.</descrip></descripGrp><ntig><termGrp><term id="210048">color space conversion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509168">trawsnewid gofod lliw</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type