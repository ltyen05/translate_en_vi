eech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2783091">Treial OneDrive for Business gydag Office ar y we (Prisiau'r Llywodraeth)</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3706_146703_1824129"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The calendar selected in the regional settings in Windows Control Panel, or the system calendar.</descrip></descripGrp><ntig><termGrp><term id="146703">primary calendar</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824129">prif galendr</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="3711_359685_510043"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A marker that can be associated with content or items, such as photos or text, to identify certain types of information, and that allows users to find, view, and sort marked content.</descrip></descripGrp><ntig><termGrp><term id="359685">note tag</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="510043">tag nodyn</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></nt