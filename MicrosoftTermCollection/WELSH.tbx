 uniquely identifies a scope within a site collection.</descrip></descripGrp><ntig><termGrp><term id="1506835">scope identifier</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1931051">dynodwr cwmpas</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29243_1506837_1519338"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unique group of search settings that is associated, one-to-one, with a shared service provider.</descrip></descripGrp><ntig><termGrp><term id="1506837">search application</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1519338">rhaglen chwilio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="29244_1506838_1931052"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">All of the crawl data that is associated with a given search application. A search catalog provides information that is used to generate query results.</descrip></descripGrp><ntig><termGrp><term id="1506838">search catalog</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1931052">catalog chwilio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</