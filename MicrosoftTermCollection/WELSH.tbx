"2396187">Windows Hello for Business</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2396251">Windows Hello for Business</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42352_2396192_2396228"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The gaming category where you can get clothing, weapons, tools or other useful items you can add to your game avatar.</descrip></descripGrp><ntig><termGrp><term id="2396192">Avatar items</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2396228">Eitemau Avatar</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="42353_2396193_2396241"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The game category with games that allow you to use your phone to interact with Xbox. You can browse and type on Xbox live using your phone instead of the controller.</descrip></descripGrp><ntig><termGrp><term id="2396193">Companion</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2396241">Cyd-reolydd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammat