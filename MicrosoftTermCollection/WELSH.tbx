<termEntry id="17007_637854_1095075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of shared services and their supporting resources.</descrip></descripGrp><ntig><termGrp><term id="637854">Shared Services Provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1095075">Darparwr Gwasanaethau a Rennir</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17007_637854_1095097"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of shared services and their supporting resources.</descrip></descripGrp><ntig><termGrp><term id="637854">Shared Services Provider</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1095097">SSP</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17007_637855_1095075"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A logical grouping of shared services and their supporting resources.</descrip></descripGrp><ntig><termGrp><term id="637855">SSP</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1095075">Darparwr Gwasanaethau a Rennir</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammatical