>Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1930764">hanes archwilio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="993_72941_508608"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The key arrangement used for a particular keyboard, including such factors as the number of keys (101 is the current standard) and the configuration of the keys (QWERTY is the United States standard). Some proprietary systems use different layouts, and many allow you to map the keys to characters according to your preferences.</descrip></descripGrp><ntig><termGrp><term id="72941">keyboard layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508608">cynllun bysellfwrdd</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9930_34655_508330"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A profile that contains the data needed for translating the values of a color gamut. This data includes information about color, hue, saturation, and brightness.</descrip></descripGrp><ntig><termGrp><term id="34655">color profile</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508330">proffil lliwiau</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">No