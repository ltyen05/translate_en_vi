/termGrp></ntig></langSet></termEntry><termEntry id="21348_771258_3045308"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To continue movement, as with the cursor or a search operation, to the beginning or to a new starting point rather than stopping when the end of a series is reached. For example, the screen cursor might wrap around to the first column of the next line rather than stopping when it reaches the last column of the current line. Likewise, a program starting a search or replace operation in the middle of a document might be instructed to wrap around to the beginning rather than stop when it reaches the end of the document.</descrip></descripGrp><ntig><termGrp><term id="771258">wrap around</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3045308">amlapio</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21350_771325_1094997"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Web Part that displays a browser-enabled InfoPath form.</descrip></descripGrp><ntig><termGrp><term id="771325">InfoPath Form Web Part</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1094997">Rhan Gwe'r Ffurflen InfoPath</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="21351_1119206_1519306"><langSet xml:lang="en-US"><descripGrp><descrip type="defin