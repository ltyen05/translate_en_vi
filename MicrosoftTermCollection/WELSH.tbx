tions to communicate in real time across network boundaries.</descrip></descripGrp><ntig><termGrp><term id="180264">federation</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2787746">ffederasiwn</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11968_1089155_509827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &amp; character.</descrip></descripGrp><ntig><termGrp><term id="1089155">&amp;</term><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509827">ampersand</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11968_318355_509827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &amp; character.</descrip></descripGrp><ntig><termGrp><term id="318355">ampersand</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509827">ampersand</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11968_318432_509827"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The &amp; character.</descrip></descripGrp><