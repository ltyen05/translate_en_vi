eech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2599585">dilysu cleientiaid</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="1716_84183_508702"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A computer hardware component providing access to a network.</descrip></descripGrp><ntig><termGrp><term id="84183">network adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508702">addasydd rhwydwaith</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17167_639982_1166850"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To eliminate an entity by removing it from a list, database, or other item, or by uninstalling it.</descrip></descripGrp><ntig><termGrp><term id="639982">remove</term><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1166850">tynnu</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="17184_640166_1166851"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To set an entity, such as a feature, configuration, or object, 