"partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1166241">Modd stereo sawl-sianel</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="989_210451_1945617"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A command that will use a print driver installed by OneNote to create an image of a wide variety of filetypes. Files are printed to the print driver and inserted as images into OneNote.</descrip></descripGrp><ntig><termGrp><term id="210451">File as Printout</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1945617">Ffeilio ar ffurf allbrint</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9891_269336_1166242"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An event triggered by Windows system components that is recorded in the system log, such as the failure of a driver or other system component to load during startup.</descrip></descripGrp><ntig><termGrp><term id="269336">system event</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1166242">digwyddiad system</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="990_26447_1798816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system of programs and workstations used in designing engineering, architectural, and scientific models ranging from simple tools to buildings, aircraft, integrated circuits, and molecules.</descrip></descripGrp><ntig><termGrp><term id="26447">CAD</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1798816">CAD</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="990_26448_1798816"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A system of programs and workstations used in designing engineering, architectural, and scientific models ranging from simple tools to buildings, aircraft, integrated circuits, and molecules.</descrip></descripGrp><ntig><termGrp><term id="26448">computer-aided design</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1798816">CAD</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="9900_185600_1375675"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The status that users can select to indicate that they are currently busy.</descrip></descripGrp><ntig><termGrp><term id="185600">Busy</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="gra