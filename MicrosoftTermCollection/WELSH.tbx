 arguments to text.</descrip></descripGrp><ntig><termGrp><term id="2955851">T</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2984769">T</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52640_2955852_2984772"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns the Student's t-distribution.</descrip></descripGrp><ntig><termGrp><term id="2955852">T.DIST.RT</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2984772">T.DIST.RT</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52641_2955853_2984773"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The Statistical Excel function that returns the t-value of the Student's t-distribution as a function of the probability and the degrees of freedom.</descrip></descripGrp><ntig><termGrp><term id="2955853">T.INV</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2984773">T.INV</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></term