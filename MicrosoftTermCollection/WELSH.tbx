lang="cy-GB"><ntig><termGrp><term id="2858788">hunaniaeth gyfunol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50476_2857364_2858839"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to take into account not just yourself and your teammates, but also the context that surrounds you.</descrip></descripGrp><ntig><termGrp><term id="2857364">situational awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2858839">ymwybyddiaeth sefyllfaol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50477_2857366_2858769"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The ability to sense the emotions of others and recognize the impact that one’s actions may have on others.</descrip></descripGrp><ntig><termGrp><term id="2857366">co-awareness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2858769">cyd-ymwybyddiaeth</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50478_2857368_2858794"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The productive force that emerges when a team harnesses their differences, as a result of nurturing and balancing the other key team dynamics: team purpose, collective identity, awareness, inclusion, trust and vulnerability.</descrip></descripGrp><ntig><termGrp><term id="2857368">constructive tension</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2858794">tensiwn cynhyrchiol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50479_2857369_2858746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The joint understanding of self and others that enables teams to navigate interpersonal dynamics and foster team cohesion.</descrip></descripGrp><ntig><termGrp><term id="2857369">awareness and inclusion</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2858746">ymwybyddiaeth a chynhwysiad</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="50480_2857376_2858741"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">UI label for inserting an Anyone link.</descrip></descripGrp><ntig><termGrp><term id="2857376">Anyone</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2858741">Unrhyw un</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGende