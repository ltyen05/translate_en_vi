Entry id="11160_358361_1958615"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An Active Directory object that contains information about an individual such as name, address, and job title. It can include a foreign email address.</descrip></descripGrp><ntig><termGrp><term id="358361">Active Directory contact</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958615">cyswllt Active Directory</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11163_73706_508622"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The overall plan or design of a document system.</descrip></descripGrp><ntig><termGrp><term id="73706">layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508622">cynllun</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11167_73681_508621"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">In computer design, the arrangement of circuits and other components of the system.</descrip></descripGrp><ntig><termGrp><term id="73681">layout</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508621">cynllun</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11175_377283_1426465"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Pertaining to characters that are formatted to appear darker and heavier than the surrounding text.</descrip></descripGrp><ntig><termGrp><term id="377283">bold</term><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1426465">trwm</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Adjective</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11186_59131_1685952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic components that generate the video signal sent through a cable to a video display. The video adapter is usually located on the computer's main system board or on an expansion board, but it is sometimes built into the terminal.</descrip></descripGrp><ntig><termGrp><term id="59131">video card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1685952">addasydd arddangos</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11186_59131_508527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic components that generate the video signal sent through a cable to a video display. The video adapter is usually located on the computer's main system board or on an expansion board, but it is sometimes built into the terminal.</descrip></descripGrp><ntig><termGrp><term id="59131">video card</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508527">cerdyn fideo</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11186_59134_1685952"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic components that generate the video signal sent through a cable to a video display. The video adapter is usually located on the computer's main system board or on an expansion board, but it is sometimes built into the terminal.</descrip></descripGrp><ntig><termGrp><term id="59134">display adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1685952">addasydd arddangos</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11186_59134_508527"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The electronic components that generate the video signal sent through a cable to a video display. The video adapter is usually located on the computer's main system board or on an expansion board, but it is sometimes built into the terminal.</descrip></descripGrp><ntig><termGrp><term id="59134">display adapter</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508527">cerdyn fideo</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11191_173848_1824152"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A unit of information transmitted as a whole from one device to another on a network.</descrip></descripGrp><ntig><termGrp><term id="173848">data packet</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1824152">pecyn data</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11192_4042_1095017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code that is executed by the common language runtime environment rather than directly by the operating system. Managed code applications gain common language runtime services such as automatic garbage collection, runtime type checking and security support, and so on. These services help provide uniform platform- and language-independent behavior of managed-code applications.</descrip></descripGrp><ntig><termGrp><term id="4042">managed code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1095017">cod wedi'i reoli</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11192_4043_1095017"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Code that is executed by the common language runtime environment rather than directly by the operating system. Managed code applications gain common language runtime services such as automatic garbage collection, runtime type checking and security support, and so on. These services help provide uniform platform- and language-independent behavior of managed-code applications.</descrip></descripGrp><ntig><termGrp><term id="4043">safe code</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1095017">cod wedi'i reoli</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet></termEntry><termEntry id="112_93994_1696032"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The logon name (and therefore the email address) of an account that is responsible for maintaining email services on a mail server. When an account holder is having trouble with email, a message to postmaster or "postmaster@machine.org.domain.name" will usually reach a human who can solve the problem.</descrip></descripGrp><ntig><termGrp><term id="93994">postmaster</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1696032">postmaster</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11201_235266_2587747"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A quantitative measure of performance that is used to compare the company's products, services, or processes to an external standard. Competitive benchmarks are based on industry best, and process benchmarks are based on best in class.</descrip></descripGrp><ntig><termGrp><term id="235266">benchmark</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2587747">meincnod</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11206_46548_1958710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An access control list that is controlled by the owner of an object and that specifies the access particular users or groups can have to the object.</descrip></descripGrp><ntig><termGrp><term id="46548">discretionary access control list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958710">rhestr rheoli mynediad dewisol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11206_46548_2289991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An access control list that is controlled by the owner of an object and that specifies the access particular users or groups can have to the object.</descrip></descripGrp><ntig><termGrp><term id="46548">discretionary access control list</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2289991">DACL</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11206_46549_1958710"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An access control list that is controlled by the owner of an object and that specifies the access particular users or groups can have to the object.</descrip></descripGrp><ntig><termGrp><term id="46549">DACL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1958710">rhestr rheoli mynediad dewisol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11206_46549_2289991"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">An access control list that is controlled by the owner of an object and that specifies the access particular users or groups can have to the object.</descrip></descripGrp><ntig><termGrp><term id="46549">DACL</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="2289991">DACL</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11208_102176_508813"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">Part of the integrated Routing and Remote Access service that provides remote networking for telecommuters, mobile workers, and system administrators who monitor and manage servers at multiple branch offices. Users can use Network Connections to dial in to remotely access their networks for services such as file and printer sharing, electronic mail, scheduling, and SQL database access.</descrip></descripGrp><ntig><termGrp><term id="102176">remote access</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508813">cysylltu o bell</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11216_564516_1375677"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of real-time communication over the Internet in which a sender types a message to one or more recipients and the recipient immediately receives the message in a chat area.</descrip></descripGrp><ntig><termGrp><term id="564516">instant messaging</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="1375677">IM</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Other</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11216_564516_1958774"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A method of real-time communication over the Internet in which a sender types a message to one or more recipients and the recipient immediately receives the message