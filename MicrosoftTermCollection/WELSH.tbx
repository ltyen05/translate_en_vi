lang="en-US"><descripGrp><descrip type="definition">A type of installation that allows the user to specify certain installation settings and options, such as which components will be installed.</descrip></descripGrp><ntig><termGrp><term id="41721">custom install</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508387">gosod personol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Verb</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">NotSelected</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11926_41721_509785"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A type of installation that allows the user to specify certain installation settings and options, such as which components will be installed.</descrip></descripGrp><ntig><termGrp><term id="41721">custom install</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="509785">gosodiad personol</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="11936_23875_508245"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The amount of light that is emitted by a computer monitor or picture displayed on the monitor.</descrip></descripGrp><ntig><termGrp><term id="23875">brightness</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Mass</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508245">disgleirdeb</term><termNote type="geographicalUsage">GBR</termN