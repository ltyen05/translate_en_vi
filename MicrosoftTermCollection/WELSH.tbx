er">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52798_3000152_3000744"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000152">Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3000744">Mesh</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52798_3000152_3000746"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The service, powered by Azure, that enables presence and shared experiences from anywhere – on any device – through mixed reality applications; the app for Hololens that lets people connect, share, and collaborate in mixed reality that runs on that service.</descrip></descripGrp><ntig><termGrp><term id="3000152">Mesh</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3000746">Microsoft Mesh</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="528_67425_508573"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The location where the user is currently directing input.</descrip></descripGrp><ntig><termGrp><term id="67425">input focus</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="508573">ffocws mewnbynnu</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52810_3001101_3002599"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams for Education that allows educators to quickly and easily communicate with their students’ parents and guardians.</descrip></descripGrp><ntig><termGrp><term id="3001101">Parents</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3002599">Rhieni</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">NotSelected</termNote><termNote type="grammaticalNumber">Plural</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52811_3001102_3002596"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Outlook that allows customers to book the time and means of transportation they need to travel between meetings or events, including options like walking, biking, driving, public transport, and even 3rd party resources like Lyft or Uber.</descrip></descripGrp><ntig><termGrp><term id="3001102">Commute</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3002596">Cymudo</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Masculine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52812_3001103_3002597"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The feature in Microsoft Teams Rooms that provides users in the room with an enhanced meeting layout by bringing meeting information gathered from fluid components to the forefront of the screen and bringing the gallery to the bottom so people can meet face to face.</descrip></descripGrp><ntig><termGrp><term id="3001103">Front row</term><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3002597">Rhes flaen</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">ProperNoun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52813_3001104_3002601"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">A Teams channel to which team owners can add users (people) who aren't members of the team.</descrip></descripGrp><ntig><termGrp><term id="3001104">shared channel</term><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet><langSet xml:lang="cy-GB"><ntig><termGrp><term id="3002601">sianel a rennir</term><termNote type="geographicalUsage">GBR</termNote><termNote type="partOfSpeech">Noun</termNote><termNote type="grammaticalGender">Feminine</termNote><termNote type="grammaticalNumber">Singular</termNote></termGrp></ntig></langSet></termEntry><termEntry id="52814_3001105_3002602"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">The last portion of the URL for a SharePoint site.</descrip></descr